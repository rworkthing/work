    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    MatDatepickerModule,
    BodCommonModule
  ],
  templateUrl: './transaction-category.component.html',
  styleUrl: './transaction-category.component.scss',
  schemas: [CUSTOM_ELEMENTS_SCHEMA]
})
export class TransactionCategoryComponent implements OnInit {
  public editactions: BodTableAction[] = editDeleteActions;
  public channels: any[] = [];
  public counters: any[] = [];
  public restrictions: any[] = [];
  public conditions: any[] = [];
  public communications: any[] = [];

  @ViewChild('systemMessage', { static: true }) systemMessage: any;
  @Input() status = '';
  @ViewChild('addNewTransactionCategoryTemplate')
  public addNewTransactionCategoryTemp: TemplateRef<any>;

  constructor(
    private bodConfirmAlertDialogsService: BodConfirmAlertDialogsService,
    private metadataService: MetadataService,
    private transactionCategoryService: TransactionCategoryService,
    private transactionTypeService: TransactionTypeService,
    private cdr: ChangeDetectorRef,
    private bodCommonDialogService: BodCommonDialogService
  ) {}

  public transactionCategoryTableActions: BodTableAction[] = TransactionCategoryTableActions;
  
  public TransactionCategoryMetaData: BodTableMetadata = {
    title: 'Transaction Category',
    columns: [...this.transactionCategoryService.columns],
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<any>(),
    noRecordsMessage: 'No Transaction Category Data Defined',
    rowLeftAction: RowLeftAction.expandableRows,
    enableSorting: true
  };

  ngOnInit() {
    this.loadDropdownData();
    this.transactionCategoryService.retrieveAll().subscribe((response: any) => {
      const firstStatus = response?.data?.[0]?.MetadataStatus;
      const statusToSet = firstStatus || 'NEW';
      this.statusControl.setValue(statusToSet);
      this.previousStatus = statusToSet;
      this.transactionCategoryService.updateCurrentStatus(statusToSet);
      console.log('TransactionCategory - Initial status set to:', statusToSet);
    });
    this.getTransactionCategories();
  }

  loadDropdownData() {
    // Load channels
    this.transactionTypeService.getDeliveryChannel().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      mappedData.sort((a, b) => a.label.localeCompare(b.label));
      this.channels = mappedData;
    });

    // Load counters
    this.transactionTypeService.getCounters().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        identifier: item.identifier,
        code: item.code,
        classificationType: item.classificationType
      }));
      mappedData.sort((a, b) => a.code.localeCompare(b.code));
      this.counters = mappedData;
    });

    // Load restrictions
    this.transactionTypeService.getRestrictions().subscribe(data => {
      this.restrictions = data;
    });

    // Load conditions
    this.transactionTypeService.getConditions().subscribe(data => {
      this.conditions = data;
    });

    // Load communications
    this.transactionTypeService.getCommunicationService().subscribe(data => {
      this.communications = data;
    });
  }

  isStatusEditable(): boolean {
    return this.status !== 'READY' && this.status !== 'GENERATED';
  }

  public commonDialogSize: string = 'Large';
  public closeOnCloseIconClick: boolean = false;
  
  private onCloseClick() {
    this.systemMessage.message = 'Custom Function called on close';
    this.systemMessage.show();
    this.dialogRef$.close();
  }

  private dialogRef$: MatDialogRef<CommonDialogComponent, any>;
  
  private openDialog(dialogModel: any) {
    let onClose = this.closeOnCloseIconClick ? this.onCloseClick.bind(this) : undefined;
    this.dialogRef$ = this.bodCommonDialogService.commonDialog(
      dialogModel,
      onClose,
      this.commonDialogSize
    );
  }

  isEdit = false;
  public messages: NotificationMessage[] = [];

  public onTableActionClicked1(event: BodTableAction) {
    this.isEdit = false;
    this.messages = [];
    if (event.id === 14) {
      this.addNewTransactionCategory();
    }
  }

  private addNewTransactionCategory() {
    this.editTransactionCategory = undefined;
    this.messages = [];
    let dialogModel: BodCommonDialogModel = {
      formTemplate: this.addNewTransactionCategoryTemp,
      title: 'Add New Transaction Category'
    };
    this.openDialog(dialogModel);
  }

  public msg: NotificationMessage | undefined;
  statusControl = new FormControl(null);
  public previousStatus: string | undefined;
  @Output() statusChanged = new EventEmitter<string>();

  addTransactionCategoryEvent(event: any) {
    if (event) {
      this.loadDropdownData();
      this.getTransactionCategories();
      const SuccessMsg = event.SuccessMsg;
      this.msg = {
        code: '',
        text: SuccessMsg,
        type: NotificationMessageType.SUCCESS
      };
      this.messages.push(this.msg);
      setTimeout(() => {
        this.messages = this.messages.filter(msg => msg.text !== SuccessMsg);
      }, 20000);
    }
    this.dialogRef$.close();

    this.metadataService.retrieveAll().subscribe((response: any) => {
      const firstStatus = response?.data && response.data.length > 0 && response.data[0]?.MetadataStatus
        ? response.data[0].MetadataStatus
        : null;
      const statusToSet = firstStatus || 'NEW';
      this.statusControl.setValue(statusToSet);
      this.previousStatus = statusToSet;
      this.statusChanged.emit(statusToSet);
      this.transactionCategoryService.updateCurrentStatus(statusToSet);
      console.log('TransactionCategory - Status updated to:', statusToSet);
    });
  }

  public rowExpanded(element: TransactionCategoryList) {
    // Handle row expansion logic if needed
    this.cdr.detectChanges();
  }

  transactionCategoryData: TransactionCategoryList[] = [];

  getTransactionCategories(): void {
    this.transactionCategoryService.retrieveTransactionCategory().subscribe(response => {
      if (response.status === 'SUCCESS' && response.data) {
        this.transactionCategoryData = response.data.map((item: any) => {
          const transactionCategory = item.TransactionCategory || {};
          
          const transactionCategoryData: TransactionCategoryList = {
            identifier: transactionCategory.identifier,
            code: transactionCategory.code || '',
            name: transactionCategory.name || '',
            description: transactionCategory.description || '',
            
            transactionCategoryInquiry: [
              {
                id: 0,
                label: 'Code',
                value: transactionCategory.code
              },
              {
                id: 1,
                label: 'Name',
                value: transactionCategory.name
              },
              ...(transactionCategory.description ? [{
                id: 2,
                label: 'Description',
                value: transactionCategory.description
              }] : [])
            ],

            // Channel relationships (reuse from transaction type structure)
            productTypePostingCategoryDSRltnpList: transactionCategory.productTypePostingCategoryDSRltnpList || [],
            productTypePostingCategoryDSCounterRltnp: transactionCategory.productTypePostingCategoryDSCounterRltnp || [],
            productTypePostingCategoryDSRestrcitionRltnp: transactionCategory.productTypePostingCategoryDSRestrcitionRltnp || [],
            productTypePostingCategoryDSCDRltnpList: transactionCategory.productTypePostingCategoryDSCDRltnpList || [],
            productTypePostingCategoryDSComsRltnp: transactionCategory.productTypePostingCategoryDSComsRltnp || []
          };

          return transactionCategoryData;
        });

        this.TransactionCategoryMetaData.datasource.data = this.transactionCategoryData;
      }
    });
  }

  public ConfirmData: BodConfirmDialogModel = {
    title: 'BOD.metadataconfig.title',
    message: 'BOD.metadataconfig.message',
    confirm: 'BOD.metadataconfig.delete',
    dismiss: 'BOD.metadataconfig.cancel'
  };

  iconActionClicked(event: BodTableAction, element: TransactionCategoryList) {
    this.isEdit = true;
    this.messages = [];
    if (event.id === BodTableActionType.EDIT) {
      this.editTransactionCategory(element);
    } else if (event.id === 1) {
      const confirmDataWithCode: BodConfirmDialogModel = {
        ...this.ConfirmData,
        message: `${'Are you sure you want to delete'} ${element.code}`
      };
      this.bodConfirmAlertDialogsService.confirm(confirmDataWithCode).subscribe(val => {
        if (val) {
          this.TransactionCategoryDelete(element);
        }
      });
    }
  }

  public message: NotificationMessage | undefined;
  
  TransactionCategoryDelete(element: TransactionCategoryList): void {
    if (element.identifier) {
      this.transactionCategoryService.deleteTransactionCategory('TransactionCategory', element.identifier)
        .subscribe(response => {
          const successMsg = `${element.code} Deleted Successfully`;
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(msg => msg.text !== successMsg);
          }, 20000);

          this.getTransactionCategories();
          this.metadataService.retrieveAll().subscribe((response: any) => {
            const firstStatus = response?.data && response.data.length > 0 && response.data[0]?.MetadataStatus
              ? response.data[0].MetadataStatus
              : null;
            const statusToSet = firstStatus || 'NEW';
            this.statusControl.setValue(statusToSet);
            this.previousStatus = statusToSet;
            this.statusChanged.emit(statusToSet);
            this.transactionCategoryService.updateCurrentStatus(statusToSet);
          });
        });
    }
  }

  editTransactionCategory: TransactionCategoryList | undefined;
  
  private editTransactionCategory(element: TransactionCategoryList) {
    this.editTransactionCategory = element;
    const dialogModel: BodCommonDialogModel = {
      formTemplate: this.addNewTransactionCategoryTemp,
      title: 'Edit Transaction Category'
    };
    this.openDialog(dialogModel);
  }
}




















