if (element.multiLingualTextInfoList && element.multiLingualTextInfoList.length > 0) {
    console.log("Processing multiLingualTextInfoList:", element.multiLingualTextInfoList);

    let updatedData = [];

    element.multiLingualTextInfoList.forEach(item => {
        let obj = {
            locale: item.localeCode,
            displayName: item.translationText,
            description: item.localeText
        };

        updatedData.push(obj);
    });

    // ✅ Update table data properly
    this.tableWithSimpleEdit.datasource = new MatTableDataSource(updatedData);

    // ✅ Ensure table refreshes in the UI
    this.changeDetectorRef.detectChanges();

    console.log("Final table data after change detection:", this.tableWithSimpleEdit.datasource.data);
}
