} else if (element.conditionType === 'CurrencyCondition') {
  const selectedCurrencyId = element.conditionDetail.value;
  const validCurrencyIds = element.conditionDetail.currencyValidValues || [];

  // Filter existing full currency list (currencyData1)
  const allCurrencies = [...this.currencyData1];

  // Filter and mark default
  const filteredCurrencies: CurrencyTableSingle[] = allCurrencies
    .filter(currency => validCurrencyIds.includes(currency.identifier))
    .map(currency => ({
      ...currency,
      default: currency.identifier === selectedCurrencyId
    }));

  // ✅ Update the table's data source
  this.currencyDataSingleSelect.datasource.data = filteredCurrencies;

  // ✅ Update selected row list for selection model
  this.selectedRowSingleSelect = filteredCurrencies.filter(c => c.default);

  // ✅ Optional: patch form control if needed
  this.addNewConditionFormGroup.patchValue({
    currencyValue: selectedCurrencyId
  });
}
