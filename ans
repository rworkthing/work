@Input() multivalueAllowed: boolean = false;

// Update the onEditTableAction method
public onEditTableAction(event) {
  this.commonDataService.updateMessage(
    'mbpBod.demo.microsite.table.editTableEvent',
    JSON.stringify(event.currentChanges)
  );
  console.log('CompleteDelta::', event.completeDelta);

  if (event.currentChanges) {
    const editedIndex = event.currentChanges.rowIndex;
    const currentRow = this.tableWithSimpleEdit.datasource.data[editedIndex];

    // Handle default selection based on multivalueAllowed setting
    if (currentRow.default) {
      if (!this.multivalueAllowed) {
        // Single default mode - unset all other defaults
        this.tableWithSimpleEdit.datasource.data.forEach((r, i) => {
          r.default = i === editedIndex;
        });
      }
      // If multivalueAllowed is true, we don't need to unset other defaults
      // The user can have multiple rows with default = true
    }

    this.completeDeltaChangeDuration.emit(
      this.tableWithSimpleEdit.datasource.data
    );
  }

  this.tableDirty.emit(true);
}

// Optional: Add helper methods
private validateDefaults(): boolean {
  const hasDefault = this.tableWithSimpleEdit.datasource.data.some(row => row.default);
  return hasDefault;
}

public getDefaultValues(): Duration[] {
  return this.tableWithSimpleEdit.datasource.data.filter(row => row.default);
}




// Update the DurationCondition handling in your submitForm method
else if (formValues.conditionType === 'DurationCondition') {
  const durationTableData =
    this.simpleEditTableDurationFix.getCurrentTableDuration?.() || [];

  // Get all default rows (supports multiple when multivalueallowed is true)
  const defaultRows = durationTableData.filter(row => row && row.default);

  if (!defaultRows || defaultRows.length === 0) {
    this.handleError1({
      errorCode: 'DEFAULT_VALUE_REQUIRED',
      status: 400
    });
    return;
  }

  const durationValidValues = durationTableData.reduce((acc, row) => {
    if ((row && row.durationType) || row.unitValue !== undefined) {
      acc.push({
        textValue: row.durationType,
        numberValue: row.unitValue
      });
    }
    return acc;
  }, []);

  // Handle single vs multiple defaults
  let durationDefinition;
  if (formValues.multivalueallowed && defaultRows.length > 1) {
    // Multiple defaults allowed - create array of definitions
    durationDefinition = defaultRows.map(defaultRow => ({
      durationType: defaultRow.durationType,
      unitValue: defaultRow.unitValue,
      businessDayRule: formValues.processingday || ''
    }));
  } else {
    // Single default (either multivalueallowed is false or only one default selected)
    const defaultRow = defaultRows[0];
    durationDefinition = {
      durationType: defaultRow.durationType,
      unitValue: defaultRow.unitValue,
      businessDayRule: formValues.processingday || ''
    };
  }

  conditionDetail = {
    conditionType: 'DurationCondition',
    durationDefinition: durationDefinition,
    durationValidValues: durationValidValues,
    multivalueAllowed: formValues.multivalueallowed || false
  };
}
