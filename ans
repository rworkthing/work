// Replace these methods in your ChannelsMainTableComponent

setDataForSingleLineEditMode(editIndex: number) {
  const row = this.dataWithSimpleEdit[editIndex];
  this.currentChannelRowId = row.id;
  
  if (!this.channelForms[row.id]) {
    this.channelForms[row.id] = this.formBuilder.group({
      id: [row.id],
      attributeForChannel: [row.attributeForChannel || ''],
      // ...other fields...
    });
  }
  
  this.addNewChannelForm = this.channelForms[row.id];
  
  // IMPORTANT: Create a fresh copy of counters for this specific channel
  this.dataWithSimpleCounter = this.counterMap[row.id] ? [...this.counterMap[row.id]] : [];
  this.tableWithSimpleCounter.datasource.data = [...this.dataWithSimpleCounter];
  
  this.singleRowEdit = {
    modeOptions: { input: true, reset: false },
    index: editIndex
  };
  this.pageModeSimple = PageMode.NONE;
}

public addCounterTableData() {
  if (this.currentChannelRowId == null) return; // No row selected

  this.addNewChannelForm.markAsDirty();
  this.transactionTypeService.getCounters().subscribe((response: any[]) => {
    const dialogTableMetadata: BodTableMetadata = {
      ...this.countersTableMetadata,
      datasource: new MatTableDataSource<CounterTable>(
        response.map((counter, idx) => ({
          id: idx + 1,
          code: counter.code,
          identifier: counter.identifier,
          classificationType: '',
          operatorType: ''
        }))
      )
    };

    // Use the counters for the current row ONLY
    const selectedCounters = this.counterMap[this.currentChannelRowId] || [];

    const dialogRef = this.dialog.open(CountersMultiselectDialogComponent, {
      width: '1000px',
      height: '600px',
      data: {
        countersDataSingleSelect: dialogTableMetadata,
        selectedRowSingleSelect: selectedCounters
      }
    });

    dialogRef.afterClosed().subscribe(result => {
      if (result?.selectedCounters) {
        const mapped = result.selectedCounters.map(row => ({
          id: row.id,
          code: row.code,
          identifier: row.identifier,
          classificationType: row.classificationType,
          operatorType: row.operatorType
        }));
        
        // Store counters for this specific channel row ONLY
        this.counterMap[this.currentChannelRowId!] = [...mapped];
        
        // Update the UI for the current row ONLY
        this.dataWithSimpleCounter = [...mapped];
        this.tableWithSimpleCounter.datasource.data = [...mapped];
        
        // Update the specific row in dataWithSimpleEdit
        const idx = this.dataWithSimpleEdit.findIndex(r => r.id === this.currentChannelRowId);
        if (idx !== -1) {
          this.dataWithSimpleEdit[idx] = {
            ...this.dataWithSimpleEdit[idx],
            counters: [...mapped]
          };
        }
      }
    });
  });
}

onSaveChannelRow(formValue: any) {
  const rowId = formValue.id || this.currentChannelRowId;
  const index = this.dataWithSimpleEdit.findIndex(row => row.id === rowId);
  
  if (index !== -1) {
    // Get the counters specific to this channel
    const channelCounters = this.counterMap[rowId] || [];
    
    this.dataWithSimpleEdit[index] = {
      ...this.dataWithSimpleEdit[index],
      ...formValue,
      attributeForChannel: this.addNewChannelForm.get('attributeForChannel')?.value,
      counters: [...channelCounters], // Use channel-specific counters
    };
    
    // Ensure the counterMap is updated for this specific channel
    this.counterMap[rowId] = [...channelCounters];
    
    // Update the table datasource
    this.tableWithSimpleEdit.datasource.data = [...this.dataWithSimpleEdit];
  }
  
  // Reset the single row edit mode
  this.singleRowEdit = { modeOptions: { input: false, reset: false }, index: -1 };
  this.currentChannelRowId = null; // Clear the current channel ID
}

// Add this method to properly initialize counter data when loading existing data
ngOnChanges(changes: SimpleChanges) {
  if (changes['channelData']) {
    // Update your table data source
    this.dataWithSimpleEdit = this.channelData || [];
    this.tableWithSimpleEdit.datasource.data = [...(this.channelData || [])];
    
    // Initialize counterMap with existing counter data
    this.dataWithSimpleEdit.forEach(channel => {
      if (channel.counters) {
        this.counterMap[channel.id] = [...channel.counters];
      }
    });
  }
}

// Add this method to clear data when needed
private clearCurrentChannelData() {
  this.currentChannelRowId = null;
  this.dataWithSimpleCounter = [];
  this.tableWithSimpleCounter.datasource.data = [];
}
