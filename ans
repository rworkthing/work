public deleteTableData(index: number): void {
  if (this.selectedTabIndex === 0) {
    this.simpleEditTableRef.deleteRow(index);
    this.tableWithSimpleEdit.datasource.data.splice(index, 1);
  }

  // Remove controls associated with the deleted row
  this.searchFieldFormCtrlKeys = this.removeFormControl(this.searchFieldColumnForm, this.searchFieldFormCtrlKeys, index);
  this.useExistingFormCtrlKeys = this.removeFormControl(this.useExistingColForm, this.useExistingFormCtrlKeys, index);
  this.overrideDefaultColFormCtrKeys = this.removeFormControl(this.overrideDefaultColumnForm, this.overrideDefaultColFormCtrKeys, index);
  this.requiredColFormCtrKeys = this.removeFormControl(this.requiredColumnForm, this.requiredColFormCtrKeys, index);

  this.searchFieldObjArr.splice(index, 1);

  // Rebuild forms to re-align indices properly
  this.setSearchFieldsData(false);
  this.setOverrideDefaultFieldsData(false);
  this.setRequiredFieldsData(false);
}
