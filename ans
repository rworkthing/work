public onDefaultToggleChange(event: any, rowIndex: number) {
  const data = [...this.currencyDataSingleSelect.datasource.data];
  const row = data.find(r => r.index === rowIndex);
  if (!row) return;

  if (event.checked) {
    // Uncheck default for all other rows
    data.forEach(item => item.default = item.index === rowIndex);

    // Ensure this row is selected
    if (this.currencyTable?.selection) {
      this.currencyTable.selection.select(row);

      // Add to selectedRowSingleSelect if not already there
      const isAlreadySelected = this.selectedRowSingleSelect.some(r => r.index === row.index);
      if (!isAlreadySelected) {
        this.selectedRowSingleSelect.push(row);
      }

      this.rowSelected.emit(this.selectedRowSingleSelect);
    }
  } else {
    // Just unset default for this row
    row.default = false;
  }

  this.currencyDataSingleSelect.datasource.data = data;
  this.defaultChanged.emit({ rowIndex, isDefault: event.checked });
}
