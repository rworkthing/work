import { Component, ViewChild, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { 
  BodPipeName, BodTableAction, BodTableComponent, BodTableDataSource, BodTableMetadata, 
  Column, ColumnType, ModeOptions, PageMode, SingleRowEdit 
} from '@bod/common';
import { MatTableDataSource } from '@angular/material/table';
import { BodEditableSampleTable, SearchFieldInputData } from '../bod-table-demo.model';
import { BodTableDemoCommonDataService } from '../bod-table-demo-common-data.service';
import { FormBuilder, FormControl, FormGroup, Validators } from '@angular/forms';
import { DemoTableDataService, SampleEC } from '../bod-table-demo.service';
import { HttpClient } from '@angular/common/http';

@Component({
  selector: 'bod-tablecomponent',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './tablecomponent.component.html',
  styleUrls: ['./tablecomponent.component.scss']
})
export class TablecomponentComponent implements OnInit {
  public searchFieldObjArr: SearchFieldInputData[] = [];
  public searchFieldFormCtrlKeys: string[] = [];
  public useExistingFormCtrlKeys: string[] = [];
  public useExistingArr: string[] = ['Yes', 'No'];
  public overrideDefaultColFormCtrKeys: string[] = [];
  public requiredColFormCtrKeys: string[] = [];
  public pageMode = PageMode.INQUIRY;
  public pageModeSimple = this.pageMode;
  public lastModifiedIndex: number = 0;

  showEdit = true;
  selectedTabIndex = 0;
  showExpandEdit = false;
  showSingleSelect = false;
  showMultiSelect = false;
  showExpandSingleSelect = false;
  showExpandMultiSelect = false;

  public searchFieldColumnForm!: FormGroup;
  public useExistingColForm!: FormGroup;
  public overrideDefaultColumnForm!: FormGroup;
  public requiredColumnForm!: FormGroup;

  constructor(
    public commonDataService: BodTableDemoCommonDataService,
    private http: HttpClient,
    private formBuilder: FormBuilder
  ) {}

  private dataForReset: BodEditableSampleTable[] = [];

  @ViewChild('simpleEditTableRef', { static: false })
  simpleEditTableRef!: BodTableComponent;

  public columns: Column[] = [
    { name: 'id', title: 'mbpBod.demo.microsite.label.id', width: 5 },
    {
      name: 'deliveryMethod',
      title: 'mbpBod.demo.microsite.table.deliveryMethod',
      inputModeOptions: {
        type: ColumnType.select,
        model: ['email', 'direct-mail', 'phone'],
        isNotEditable: false,
        existingDataNotEditable: false
      }
    },
    {
      name: 'usePreferred',
      title: 'mbpBod.demo.microsite.table.usePreferred',
      inputModeOptions: {
        type: ColumnType.select,
        model: ['Yes', 'No'],
        isNotEditable: false,
        existingDataNotEditable: false
      }
    }
  ];

  public columnSimpleEdit = this.columns;
  public dataWithSimpleEdit: BodEditableSampleTable[] = [
    { id: 1, deliveryMethod: 'email', usePreferred: 'No' }
  ];

  public tableWithSimpleEdit: BodTableMetadata = {
    title: 'mbpBod.demo.microsite.table.tableWithEdit',
    columns: this.columnSimpleEdit,
    datasource: new MatTableDataSource<BodEditableSampleTable>(
      this.dataWithSimpleEdit
    ),
    noRecordsMessage: 'mbpBod.demo.microsite.table.noRecordsMsg'
  };

  public actionsForSimple: BodTableAction[] = [
    { id: 1, icon: 'add', label: 'mbpBod.demo.microsite.tableActions.labels.add', mostCommon: false }
  ];

  public modeOptions: ModeOptions = { input: false, reset: false };
  public modeOptionsSimple = this.modeOptions;
  public singleRowEdit: SingleRowEdit = {
    modeOptions: { input: false, reset: false },
    index: 0
  };

  ngOnInit(): void {
    this.searchFieldColumnForm = this.formBuilder.group({});
    this.useExistingColForm = this.formBuilder.group({});
    this.overrideDefaultColumnForm = this.formBuilder.group({});
    this.requiredColumnForm = this.formBuilder.group({});
    this.lastModifiedIndex = this.tableWithSimpleEdit.datasource.data.length;
  }

  public addTableData() {
    this.lastModifiedIndex = this.tableWithSimpleEdit.datasource.data.length;
    const updatedData: BodEditableSampleTable = {
      id: ++this.lastModifiedIndex,
      deliveryMethod: 'email',
      usePreferred: 'No',
    };

    if (this.simpleEditTableRef) {
      setTimeout(() => {
        this.simpleEditTableRef.addRow(updatedData);
      });
    }
  }

  public addFormControl(
    form: FormGroup,
    columnName: string,
    index: number,
    isRequired: boolean,
    defaultValue: string
  ) {
    const controlName = columnName + index;
    if (form.controls[controlName]) {
      form.removeControl(controlName);
    }
    form.addControl(controlName, new FormControl(defaultValue, isRequired ? Validators.required : null));
    return Object.keys(form.controls);
  }
}
