if (isEditMode) {
  // Restore 'code' value and keep it disabled
  this.addNewAttributeFormGroup.get('code')?.setValue(this.retainedCode);
  this.addNewAttributeFormGroup.get('code')?.disable();
  this.addNewAttributeFormGroup.get('identifier')?.setValue(this.retainedIdentifier);
  this.addNewAttributeFormGroup.get('identifier')?.disable();

  const productTypeCodeControl = this.addExistingAttributeFormGroup.get('productTypeCode');
  if (productTypeCodeControl) {
    productTypeCodeControl.enable({ emitEvent: false });
    productTypeCodeControl.setValue(this.retainedCodeForExt);
    productTypeCodeControl.disable({ emitEvent: false });
  }

  const identifierControl = this.addExistingAttributeFormGroup.get('identifier');
  if (identifierControl) {
    identifierControl.enable({ emitEvent: false });
    identifierControl.setValue(this.retainedIdentifierForExt);
    identifierControl.disable({ emitEvent: false });
  }
}
