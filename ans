public saveTableData() {
  // Update the table data with the form values
  this.tableWithSimpleEdit.datasource.data = this.rows.controls.map((control, index) => ({
    id: control.get('id')?.value,
    locale: control.get('locale')?.value,
    displayName: control.get('displayName')?.value,
    description: control.get('description')?.value
  }));

  // Force Angular to detect changes
  this.tableWithSimpleEdit.datasource = new MatTableDataSource(this.tableWithSimpleEdit.datasource.data);

  // Log the saved data
  console.log('Table data saved:', this.tableWithSimpleEdit.datasource.data);

  // Reset form's dirty state
  this.rows.controls.forEach((control) => control.markAsPristine());
}


public addTableData() {
  const newRow = {
    id: this.tableWithSimpleEdit.datasource.data.length + 1,
    locale: '',
    displayName: '',
    description: ''
  };

  // Clone existing data and add new row
  const updatedData = [...this.tableWithSimpleEdit.datasource.data, newRow];

  // Update table data source
  this.tableWithSimpleEdit.datasource = new MatTableDataSource(updatedData);

  // Add new row to the form
  this.addRow(newRow);

  // Enable edit mode for the new row
  this.modeOptionsSimple = { input: true, reset: false };
  this.pageModeSimple = PageMode.INPUT;

  this.singleRowEdit = {
    modeOptions: { input: true, reset: false },
    index: updatedData.length - 1
  };
}
