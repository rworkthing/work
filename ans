public saveTableData() {
  // Map form values to the table data
  const updatedData = this.rows.controls.map((control, index) => ({
    id: control.get('id')?.value,
    locale: control.get('locale')?.value,
    displayName: control.get('displayName')?.value,
    description: control.get('description')?.value
  }));

  // Reassign MatTableDataSource (important for Angular change detection)
  this.tableWithSimpleEdit.datasource = new MatTableDataSource(updatedData);

  // Log saved data
  console.log('Table data saved:', updatedData);

  // Mark the form as pristine after saving
  this.rows.controls.forEach((control) => control.markAsPristine());

  // Exit edit mode
  this.singleRowEdit = { modeOptions: { input: false, reset: false }, index: -1 };
}

public addTableData() {
  const newRow: BodEditableSampleTable = {
    id: this.tableWithSimpleEdit.datasource.data.length + 1,
    locale: '',
    displayName: '',
    description: ''
  };

  // Clone existing data and add new row
  const updatedData = [...this.tableWithSimpleEdit.datasource.data, newRow];

  // Update the table data source
  this.tableWithSimpleEdit.datasource = new MatTableDataSource(updatedData);

  // Add new row to the form
  this.addRow(newRow);

  // Enable edit mode
  this.modeOptionsSimple = { input: true, reset: false };
  this.pageModeSimple = PageMode.INPUT;

  // Set edit mode for the new row
  this.singleRowEdit = {
    modeOptions: { input: true, reset: false },
    index: updatedData.length - 1
  };
}

public addRow(row: any) {
  const rowGroup = this.fb.group({
    id: [row?.id || ''],
    locale: [row?.locale || ''],
    displayName: [row?.displayName || ''],
    description: [row?.description || '']
  });

  this.rows.push(rowGroup);
}
