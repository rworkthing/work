// Add this method to handle adding communication table data
addCommunicationTableData() {
  this.addNewChannelForm.markAsDirty();
  this.transactionTypeService.getCommunications().subscribe((response: any[]) => {
    const dialogTableMetadata: BodTableMetadata = {
      ...this.communicationsTableMetadata,
      datasource: new MatTableDataSource<CommunicationTable>(
        response.map((communication, idx) => ({
          id: idx + 1,
          serviceElement: communication.serviceElement,
          communicationServices: communication.code,
          identifier: communication.identifier
        }))
      )
    };

    // Use the communications for the current row
    const selectedCommunications = this.communicationMap[this.currentChannelRowId!] || [];

    const dialogRef = this.dialog.open(CommunicationsMultiselectDialogComponent, {
      width: '1000px',
      height: '600px',
      data: {
        communicationsDataSingleSelect: dialogTableMetadata,
        selectedRowSingleSelect: selectedCommunications
      }
    });

    dialogRef.afterClosed().subscribe(result => {
      if (result?.selectedCommunications) {
        const mapped = result.selectedCommunications.map(row => ({
          id: row.id,
          serviceElement: row.serviceElement || 'Blank Alert',
          communicationServices: row.communicationServices,
          identifier: row.identifier
        }));
        // Store communications for this channel row only
        this.communicationMap[this.currentChannelRowId!] = mapped;
        // Update the UI for the current row
        this.dataWithSimpleCommunication = mapped;
        this.tableWithSimpleCommunication.datasource.data = [...mapped];
        // Optionally update the row in dataWithSimpleEdit
        const idx = this.dataWithSimpleEdit.findIndex(r => r.id === this.currentChannelRowId);
        if (idx !== -1) {
          this.dataWithSimpleEdit[idx].communications = mapped;
        }
        this.communicationDetails.emit(mapped);
      }
    });
  });
}

// Add this method to handle communication row level actions
handleCommunicationRowLevelActions($event: any, index: number) {
  if ($event === 'trash') {
    // Remove the row from your data array
    this.dataWithSimpleCommunication.splice(index, 1);
    // Update the table datasource
    this.tableWithSimpleCommunication.datasource.data = [...this.dataWithSimpleCommunication];
    // Emit the updated data if needed
    this.communicationDetails.emit(this.dataWithSimpleCommunication);
  }
  this.addNewChannelForm.markAsDirty();
  // You can add 'edit' or 'save' logic here if needed
}

// Update the inlineEditRowActionClick method to load communications
inlineEditRowActionClick(
  inlineEditOutput: InlineEditOutput,
  index: number,
  template?: any
) {
  const element = (this.editRowElement = inlineEditOutput.editRowElement);

  if (element && element.id) {
    this.addNewChannelForm.reset();
    this.addNewChannelForm.patchValue(element);
    this.currentChannelRowId = element.id; // Track the channel row being edited
  }

  this.editIndex = inlineEditOutput.editRowIndex ?? index;

  this.singleRowEdit = {
    modeOptions: { input: true, reset: false },
    index: this.editIndex
  };

  // Load counters for this channel row if you have them stored
  this.dataWithSimpleCounter = this.counterMap?.[element.id] ? [...this.counterMap[element.id]] : [];
  this.tableWithSimpleCounter.datasource.data = this.dataWithSimpleCounter;

  // Load conditions for this channel row if you have them stored
  this.dataWithSimpleCondition = this.conditionMap?.[element.id] ? [...this.conditionMap[element.id]] : [];
  this.tableWithSimpleCondition.datasource.data = this.dataWithSimpleCondition;

  // Load restrictions for this channel row if you have them stored
  this.dataWithSimpleRestriction = this.restrictionMap?.[element.id] ? [...this.restrictionMap[element.id]] : [];
  this.tableWithSimpleRestriction.datasource.data = this.dataWithSimpleRestriction;

  // Load communications for this channel row if you have them stored
  this.dataWithSimpleCommunication = this.communicationMap?.[element.id] ? [...this.communicationMap[element.id]] : [];
  this.tableWithSimpleCommunication.datasource.data = this.dataWithSimpleCommunication;
}

// Update the getAllCommunicationsWithChannelIdentifier method
public getAllCommunicationsWithChannelIdentifier(): any[] {
  // Flatten all communications from all channels, adding channelidentifier to each
  return (this.dataWithSimpleEdit || [])
    .filter(channel => Array.isArray(channel.communications))
    .map(channel =>
      (channel.communications ?? []).map(communication => ({
        ...communication,
        channelidentifier: channel.identifier
      }))
    )
    .reduce((acc, val) => acc.concat(val), []);
}

// Update the emitCompleteDelta method to include communications
emitCompleteDelta() {
  const currentData = this.getCurrentTableData();
  const allCounters = this.getAllCountersWithChannelIdentifier();
  const allConditions = this.getAllConditionsWithChannelIdentifier();
  const allRestrictions = this.getAllRestrictionsWithChannelIdentifier();
