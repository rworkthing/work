  // Update the currency data model
  if (this.currencyData1 && this.currencyData1.length) {
    this.currencyData1.forEach((item) => {
      if (item.index === event.rowIndex) {
        item.default = event.isDefault;
      } else if (event.isDefault) {
        // If another row is set as default, unset all others
        item.default = false;
      }
    });
  }
  
  // Mark the form as dirty so changes are tracked
  this.addNewConditionFormGroup.markAsDirty();
}


<bod-currency-condition
  *ngIf="
    addNewConditionFormGroup.get('conditionType')?.value ===
    'CurrencyCondition'
  "
  [currencyDataSingleSelect]="currencyDataSingleSelect"
  [selectedRowSingleSelect]="selectedRowSingleSelect"
  (rowSelected)="handleCurrencySelection($event)"
  (defaultChanged)="handleCurrencyDefaultChange($event)"
></bod-currency-condition>


export interface CurrencyTableSingle {
  index: number;
  identifier?: number;
  currencyISO4217Val: string;
  code: string;
  default?: boolean;  // Add this property
}
