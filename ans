autoSaveInlineEntry(formValues: any) {
  const currentIndex = this.dataWithlocale.length - 1; // Last entry being edited/added

  const updatedLocaleEntry: BodLocaleTable = {
    locale: formValues.localeCode ?? '',
    displayName: formValues.displayName ?? '',
    description: formValues.description ?? ''
  };

  // Update or Add the latest entry
  if (this.dataWithlocale[currentIndex]) {
    this.dataWithlocale[currentIndex] = updatedLocaleEntry;
  } else {
    this.dataWithlocale.push(updatedLocaleEntry);
  }

  // Update the datasource
  this.tableWithSimpleEdit.datasource.data = [...this.dataWithlocale];
}


