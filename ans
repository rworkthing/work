public addTableData() {
  this.lastModifiedIndex = this.tableWithSimpleEdit.datasource.data.length;

  const newRow = {
    locale: '',
    displayname: '',
    description: ''
  };

  // Add the new row to the table data
  this.tableWithSimpleEdit.datasource.data = [
    ...this.tableWithSimpleEdit.datasource.data,
    newRow
  ];

  // Automatically set the new row in edit mode
  this.singleRowEdit = {
    modeOptions: { input: true, reset: false },
    index: this.lastModifiedIndex
  };

  // Ensure search fields and required fields are updated
  this.setSearchFieldsData(false);
  this.setDataForSingleLineEditMode(this.lastModifiedIndex);
}
