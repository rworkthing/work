import { CommonModule } from '@angular/common';
import { Component, NO_ERRORS_SCHEMA, OnInit, ViewChild } from '@angular/core';
import { TranslateModule } from '@ngx-translate/core';
import {
  BodFormModule,
  BodPageContainerModule,
  BodTableAction,
  BodTableActionsModule,
  BodTableMetadata,
  BodTableModule,
  ControlGroupModule,
  InputLayoutModule,
  MessageContainerModule,
  SearchFieldModule
} from '@bod/common';
import { MatTableDataSource } from '@angular/material/table';
import {
  FormsModule,
  ReactiveFormsModule,
  FormBuilder,
  FormGroup
} from '@angular/forms';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatSelectModule } from '@angular/material/select';
import { MatDatepickerModule } from '@angular/material/datepicker';
import { MatInputModule } from '@angular/material/input';
import { BodEditableSampleTable } from '../bod-table-demo.model';

@Component({
  selector: 'bod-template-settings',
  standalone: true,
  imports: [
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    BodFormModule,
    BodTableActionsModule,
    InputLayoutModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    MatInputModule,
    FormsModule,
    SearchFieldModule,
    MessageContainerModule
  ],
  templateUrl: './template-settings.component.html',
  styleUrls: ['./template-settings.component.scss'],
  schemas: [NO_ERRORS_SCHEMA]
})
export class TemplateSettingsComponent implements OnInit {
  @ViewChild('simpleEditTableRef') simpleEditTableRef: any;

  showEdit = true;
  pageModeSimple = 'simple';
  messages = [];

  modeOptionsSimple = { input: false };
  singleRowEdit = { modeOptions: { input: false, reset: false }, index: 0 };

  searchFieldColumnForm: FormGroup;
  useExistingColForm: FormGroup;
  overrideDefaultColumnForm: FormGroup;
  requiredColumnForm: FormGroup;
  searchFieldObjArr = [];
  useExistingArr = ['Yes', 'No'];
  inputForSlideToggleValue = { options: [{ label: 'Yes' }, { label: 'No' }] };
  inputForAuthorizeCheckboxValue = { options: [{ label: 'Required', value: true }, { label: 'Not Required', value: false }] };
  requiredColFormCtrKeys = [];

  public tableWithSimpleEdit: BodTableMetadata;
  public actionsForSimple: BodTableAction[] = [
    {
      id: 1,
      icon: 'add',
      label: 'mbpBod.demo.microsite.tableActions.labels.add',
      mostCommon: false
    }
  ];

  constructor(private fb: FormBuilder) {
    this.tableWithSimpleEdit = {
      columns: [
        {
          name: 'id',
          title: 'ID',
          truncate: true,
          noOverflow: true,
          width: 12,
          widthUnit: 'rem'
        },
        {
          name: 'groupId',
          title: 'Group ID',
          width: 12,
          widthUnit: 'rem'
        },
        {
          name: 'groupName',
          title: 'Group Name',
          width: 12,
          widthUnit: 'rem'
        }
      ],
      datasource: new MatTableDataSource<BodEditableSampleTable>(),
      noRecordsMessage: 'mbpBod.demo.microsite.table.noRecordsMsg'
    };
  }

  ngOnInit() {
    this.searchFieldColumnForm = this.fb.group({});
    this.useExistingColForm = this.fb.group({});
    this.overrideDefaultColumnForm = this.fb.group({});
    this.requiredColumnForm = this.fb.group({});
  }

  handleRowLevelActions(action: string, index: number) {
    if (action === 'save') {
      this.saveTableData();
    } else if (action === 'reset') {
      this.reset();
    }
  }

  saveTableData() {
    console.log('Saving table data');
  }

  reset() {
    console.log('Resetting table data');
  }

  addTableData() {
    console.log('Adding new table row');
  }
}
