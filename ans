import { HttpClient, HttpHeaders } from '@angular/common/http';
import { Injectable } from '@angular/core';
import {
  Column,
  ColumnType,
  InquiryLayoutInput,
  UIContextService
} from '@bod/common';
import { BehaviorSubject, Observable, tap } from 'rxjs';
import { DataSharingService } from '../data-sharing-service.service';
import { ServiceElementList } from './add-edit-service-element-details/add-edit-service-element.model';

@Injectable({
  providedIn: 'root'
})
export class ServiceElementService {
  private saveUrl = '';
  private retrieveUrl = '';
  private deleteUrl = '';
  private updateUrl = '';
  private baseUrl = '';
  private retrieveAllUrl = '';
  private serviceElementExstUrl = '';
  private apiURL = '';

  private currentStatus: string = 'NEW';

  businessProductLine: any[] = [];
  private reqDfnId = '';
  private clientCode = '';
  private countryCode = '';
  private productLines: any[] = [];
  private productTypes: any[] = [];

  constructor(
    private http: HttpClient,
    private uiContextService: UIContextService,
    private readonly dataSharingService: DataSharingService
  ) {
    let url =
      this.uiContextService.getModuleDataById('fis.nextgen.sdkit').valueMap
        .sdkServiceUrl.value;

    this.dataSharingService.data$.subscribe(data => {
      if (data) {
        this.reqDfnId = data.reqDfnId;
        this.businessProductLine = data.reqDfnResponseDTO.businessProductLine;
        this.countryCode = data.countryCode;
        this.clientCode = data.countryCode;
        this.productLines = [
          ...new Set(this.businessProductLine.map(obj => obj.value))
        ];
        this.productTypes = [
          ...new Set(this.businessProductLine.map(obj => obj.type))
        ];

        this.baseUrl = url ?? '';
        this.saveUrl = url + '/metadata/create/' + this.reqDfnId;
        this.updateUrl = url + '/metadata/update/' + this.reqDfnId;

        this.retrieveUrl =
          url +
          '/metadata/retrieve/' + this.reqDfnId + '?metadata-config-type=ServiceElement';

        this.serviceElementExstUrl =
          url + '/basedata/serviceelement';
        this.deleteUrl = url + '/metadata/delete/' + this.reqDfnId;
        this.retrieveAllUrl =
          url +
          '/metadata/retrieve/' +
          this.reqDfnId;
        this.apiURL = url + '/basedata/serviceelement';
      }
    });
  }

  retrieveAll(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<any[]>(this.retrieveAllUrl, { headers }).pipe(
      tap((response: any) => {
        const firstStatus = response?.data && response.data.length > 0 && response.data[0]?.MetadataStatus
          ? response.data[0].MetadataStatus
          : 'NEW';
        this.currentStatus = firstStatus;
      })
    );
  }

  updateCurrentStatus(status: string): void {
    this.currentStatus = status;
  }

  createHeaders(): HttpHeaders {
    return new HttpHeaders({
      'country-code': this.countryCode,
      'client-code': this.clientCode,
      'product-line': this.productLines,
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID(),
      'requirement-id': this.reqDfnId
    });
  }

  private getCreateUrlWithStatus(status: string): string {
    return `${this.baseUrl}/metadata/create/${this.reqDfnId}?status=${status}`;
  }

  saveServiceElement(request: any, status?: string): Observable<any> {
    const headers = this.createHeaders();
    const statusToUse = status || this.currentStatus;
    const url = this.getCreateUrlWithStatus(statusToUse);
    return this.http.post(url, request, { headers });
  }

  retrieveServiceElement(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<ServiceElementList[]>(this.retrieveUrl, { headers });
  }

  getExistingServiceElements(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get(`${this.serviceElementExstUrl}`, { headers });
  }

  deleteServiceElement(
    metadataConfigType: string,
    metadataConfigIdfr: number
  ): Observable<any> {
    const headers = this.createHeaders();
    const params = {
      'metadata-config-type': metadataConfigType,
      'metadata-config-idfr': metadataConfigIdfr
    };

    return this.http.delete(this.deleteUrl, { headers, params });
  }

  updateServiceElement(request: any): Observable<any> {
    const headers = this.createHeaders();
    return this.http.put(this.updateUrl, request, { headers });
  }

  generateUUID(): string {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(
      /[xy]/g,
      function (c) {
        const r = (Math.random() * 16) | 0,
          v = c === 'x' ? r : (r & 0x3) | 0x8;
        return v.toString(16);
      }
    );
  }

  public getServiceElementData(
    element: ServiceElementList
  ): Observable<InquiryLayoutInput[]> {
    const groups: InquiryLayoutInput[] = [];
    let setIsLink = false;
    for (let i = 0; i < element.serviceElementInquiry.length; i++) {
      groups.push({
        id: element.serviceElementInquiry[i].id,
        label: element.serviceElementInquiry[i].label,
        value: element.serviceElementInquiry[i].value,
        isLink: setIsLink
      });
    }

    const $groups = new BehaviorSubject<InquiryLayoutInput[]>(groups);
    return $groups;
  }

  getServiceElements(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get(`${this.apiURL}`, { headers });
  }

  public columns: Column[] = [
    {
      name: 'code',
      title: 'Service Elements',
      truncate: true,
      noOverflow: true,
      width: 70,
      widthUnit: 'rem'
    },
    {
      name: 'actions',
      title: ' ',
      hasAction: true
    }
  ];
}































