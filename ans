public getCurrentTableData(): BodLocaleTable[] {
  return this.tableWithSimpleEdit?.datasource?.data || [];
}


@ViewChild('simpleEditTableRef')
simpleEditTableRef: SimpleEditTableComponent;


<bod-simple-edit-table
  #simpleEditTableRef
  [localeData]="localeTableData"
>
</bod-simple-edit-table>


onSave() {
  const localeTableData = this.simpleEditTableRef.getCurrentTableData();
  console.log('🌍 Locale table data being submitted:', localeTableData);

  // Add to the payload or form submission logic
  const payload = {
    ...this.addNewAttributeFormGroup.value,
    multiLingualTextInfoList: localeTableData
  };

  console.log('📦 Final submission payload:', payload);
  this.metadataService.submitAttribute(payload).subscribe(...);
}


const localeTableData = this.simpleEditTableRef.getCurrentTableData?.() || [];

const multiLingualTextInfoList: MultiLingualTextInfo[] = localeTableData.map(item => ({
  localeCode: item.locale,
  localeText: item.description,
  translationText: item.displayName,
  identifier: formValue.identifier,
  objectType: formValue.type,
  attributeType: formValue.datatype
}));

