private addNewRoleType() {
    this.isAdd = true;

    // ✅ Force a fresh instance of the form (instead of just resetting)
    this.addNewRoleTypeFormGroup = this.fb.group({
        roleTypeCode: new UntypedFormControl('', [Validators.required]),
        roleTypeIdentifier: new UntypedFormControl({ value: '', disabled: true }),
        roleTypeName: new UntypedFormControl(''),
        roleTypeShortName: new UntypedFormControl(''),
        category: new UntypedFormControl('', [Validators.required]),
        classification: new UntypedFormControl('', [Validators.required]),
        systemDefined: new UntypedFormControl(''),
        isCalculated: new UntypedFormControl(''),
        category1: new UntypedFormControl([])
    });

    console.log("After Reset (Add New Role):", this.addNewRoleTypeFormGroup.value);

    this.cdr.detectChanges();  // ✅ Force UI refresh to ensure the new form state is applied

    let dialogModel: BodCommonDialogModel = {
        formTemplate: this.addNewRoleTypeTemp,
        title: 'Add New Role Type'
    };

    setTimeout(() => {  
        this.openDialog(dialogModel);
    });
}
