import { ChannelTable, CounterTable, RestrictionTable, ConditionTable, CommunicationTable } from '../../transaction-type/transaction-type.model';
import { TransactionTypeService } from '../../transaction-type/transaction-type.service';

@Component({
  selector: 'bod-add-edit-transactioncategory',
  standalone: true,
  imports: [
    ChannelsMainTableComponent,
    MatRadioModule,
    CommonModule,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    BodCommonModule
  ],
  templateUrl: './add-edit-transactioncategory.component.html',
  styleUrl: './add-edit-transactioncategory.component.scss'
})
export class AddEditTransactionCategoryComponent implements OnInit {
  @Input() editTransactionCategoryRow: TransactionCategoryList;

  public translationKey = TranslationKey;
  public addNewTransactionCategoryFormGroup: UntypedFormGroup;

  public channelData: ChannelTable[] = [];
  public isChannelTableDirty = false;
  
  public counterData: CounterTable[] = [];
  public restrictionData: RestrictionTable[] = [];
  public conditionData: ConditionTable[] = [];
  public communicationData: CommunicationTable[] = [];

  public channels: any[] = [];
  public counters: any[] = [];
  public restrictions: any[] = [];
  public conditions: any[] = [];
  public communications: any[] = [];
  public communicationsMasterList: any[] = [];

  @ViewChild('channelsMainTable') channelsMainTable: ChannelsMainTableComponent;

  // Retained values for edit mode
  @Input() retainedCode = '';
  @Input() retainedTransactionCategoryIdentifier = 0;
  @Input() retainedName = '';
  @Input() retainedDescription = '';
  @Input() retainedChannels: any[] = [];
  @Input() retainedCounters: any[] = [];
  @Input() retainedRestrictions: any[] = [];
  @Input() retainedConditions: any[] = [];
  @Input() retainedCommunicationServices: any[] = [];

  formType: BodFormTypes = BodFormTypes.SUBMIT;
  
  constructor(
    private metadataService: MetadataService,
    private cdr: ChangeDetectorRef,
    private fb: UntypedFormBuilder,
    private http: HttpClient,
    private bodCommonDialogService: BodCommonDialogService,
    private transactionCategoryService: TransactionCategoryService,
    private transactionTypeService: TransactionTypeService
  ) {}

  ngOnInit() {
    this.initForm();
    this.loadDropdownData();
    
    if (this.editTransactionCategoryRow) {
      this.transactionCategoryForm(this.editTransactionCategoryRow);
    }
  }

  private initForm(): void {
    this.addNewTransactionCategoryFormGroup = this.fb.group({
      code: new UntypedFormControl('', [
        Validators.required,
        this.noSpecialCharactersValidator(),
        this.maxLengthValidator(32)
      ]),
      name: new UntypedFormControl('', [
        Validators.required,
        this.maxLengthValidator(120)
      ]),
      description: new UntypedFormControl('', [this.maxLengthValidator(254)]),
      transactionCategoryIdentifier: [{ value: '', disabled: true }]
    });
  }

  loadDropdownData(): void {
    // Load channels
    this.transactionTypeService.getDeliveryChannel().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      mappedData.sort((a, b) => a.label.localeCompare(b.label));
      this.channels = mappedData;
    });

    // Load counters
    this.transactionTypeService.getCounters().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        identifier: item.identifier,
        code: item.code,
        classificationType: item.classificationType
      }));
      mappedData.sort((a, b) => a.code.localeCompare(b.code));
      this.counters = mappedData;
    });

    // Load restrictions
    this.transactionTypeService.getRestrictions().subscribe(data => {
      this.restrictions = data;
    });

    // Load conditions
    this.transactionTypeService.getConditions().subscribe(data => {
      this.conditions = data;
    });

    // Load communications
    this.transactionTypeService.getCommunicationService().subscribe(data => {
      this.communications = data;
      this.communicationsMasterList = data;
    });
  }

  /**
   * Handle channel table dirty state
   */
  public onChannelTableDirty(): void {
    this.isChannelTableDirty = true;
    this.addNewTransactionCategoryFormGroup.markAsDirty();
  }

  /**
   * Handle channel data changes
   */
  public handleChannelDataChange(data: any) {
    this.channelData = data.channels;
    this.counterData = data.counters;
    this.restrictionData = data.restrictions;
    this.conditionData = data.conditions;
    this.communicationData = data.communications;

    console.log('Received Channel Data from child (JSON):\n', JSON.stringify(this.channelData, null, 2));
    console.log('Received All Counters with Channel Identifier (JSON):\n', JSON.stringify(this.counterData, null, 2));
    console.log('Received All Restrictions with Channel Identifier (JSON):\n', JSON.stringify(this.restrictionData, null, 2));
    console.log('Received All Conditions with Channel Identifier (JSON):\n', JSON.stringify(this.conditionData, null, 2));
    console.log('Received All Communications with Channel Identifier (JSON):\n', JSON.stringify(this.communicationData, null, 2));
  }

  /**
   * Get current channel table data
   */
  public getCurrentChannelData(): ChannelTable[] {
    return this.channelsMainTable?.getCurrentTableData() || [];
  }

  onReset(isAdd: boolean): void {
    const isEditMode = this.isEdit;

    this.addNewTransactionCategoryFormGroup.reset();
    this.channelData = [];
    this.counterData = [];
    this.restrictionData = [];
    this.conditionData = [];
    this.communicationData = [];
    this.isChannelTableDirty = false;
    
    if (this.channelsMainTable) {
      this.channelsMainTable.resetTableForm();
    }

    if (isEditMode) {
      // Restore retained form values
      this.addNewTransactionCategoryFormGroup.patchValue({
        code: this.retainedCode,
        transactionCategoryIdentifier: this.retainedTransactionCategoryIdentifier,
        name: this.retainedName,
        description: this.retainedDescription
      });

      // Restore channel data similar to transaction type
      this.restoreChannelData();

      // Disable code in edit mode
      this.addNewTransactionCategoryFormGroup.get('code')?.disable();
      this.addNewTransactionCategoryFormGroup.get('transactionCategoryIdentifier')?.disable();
    } else {
      // Enable code in add mode
      this.addNewTransactionCategoryFormGroup.get('code')?.enable();
      this.addNewTransactionCategoryFormGroup.get('transactionCategoryIdentifier')?.enable();
    }

    this.addNewTransactionCategoryFormGroup.markAsPristine();
    this.addNewTransactionCategoryFormGroup.markAsUntouched();
  }

  private restoreChannelData() {
    // Similar logic to transaction type component for restoring channel relationships
    const enrichedRetainedCounters = (this.retainedCounters || []).map(counter => {
      const counterObj = this.counters?.find(c => String(c.identifier) === String(counter.counterIdentifier));
      return {
        id: counter.counterIdentifier,
        code: counterObj ? counterObj.code : String(counter.counterIdentifier),
        identifier: counter.counterIdentifier,
        classificationType: counterObj ? counterObj.classificationType : '',
        operatorType: counter.counterOperationType || '',
        channelidentifier: counter.resourceItemIdentifier
      };
    });

    // Similar for restrictions, conditions, communications...
    // (Implementation similar to transaction type component)

    this.channelData = (this.retainedChannels || []).map(retainedChannel => {
      const channelObj = this.channels?.find(c => String(c.value) === String(retainedChannel.resourceItemIdentifier));
      const channelId = retainedChannel.resourceItemIdentifier;
      const isAllChannel = String(channelId) === '0';

      return {
        id: channelId,
        identifier: String(channelId),
        code: isAllChannel ? 'All' : channelObj ? channelObj.label : String(channelId),
        channel: isAllChannel ? 'All' : channelObj ? channelObj.label : String(channelId),
        option: retainedChannel.optionalityType || '',
        attributeForChannel: '',
        counters: enrichedRetainedCounters.filter(c => String(c.channelidentifier) === String(channelId)),
        restrictions: [], // Similar logic
        conditions: [], // Similar logic
        communications: [] // Similar logic
      };
    });

    // Update the child tables
    if (this.channelsMainTable && this.channelsMainTable.tableWithSimpleEdit) {
      this.channelsMainTable.tableWithSimpleEdit.datasource.data = [...this.channelData];
    }
  }

  identifierSearch(field: string): Promise<void> {
    return new Promise((resolve, reject) => {
      this.metadataService.idfrSearch().subscribe(
        (response: string) => {
          if (field === 'transactionCategoryIdentifier') {
            this.addNewTransactionCategoryFormGroup.controls['transactionCategoryIdentifier'].setValue(response);
            this.addNewTransactionCategoryFormGroup.controls['transactionCategoryIdentifier'].disable();
          }
          resolve();
        },
        error => {
          console.error('Error:', error);
          reject(error);
        }
      );
    });
  }

  isAdd = true;
  isEdit = false;

  onAddNewTransactionCategory(isAdd: boolean) {
    if (isAdd) {
      this.identifierSearch('transactionCategoryIdentifier').then(() => {
        this.submitForm(isAdd);
      });
    } else {
      this.submitForm(isAdd);
    }
  }

  submitForm(isAdd: boolean) {
    // Force the child to emit the latest data
    this.channelsMainTable?.emitCompleteDelta();

    this.errorMessages = [];

    const requiredFields = ['code', 'name'];
    let hasError = false;

    requiredFields.forEach(field => {
      const control = this.addNewTransactionCategoryFormGroup.get(field);
      if (control?.invalid || control?.value === '' || control?.value === null || control?.value === undefined) {
        control?.markAsTouched();
        hasError = true;
      }
    });

    if (hasError) {
      return;
    }

    const formValue = this.addNewTransactionCategoryFormGroup.getRawValue();
    this.addNewTransactionCategoryFormGroup.controls['transactionCategoryIdentifier'].enable();

    // Get channel data
    const channelData = this.getCurrentChannelData();

    // Build the transaction category data structure
    const productTypeIdentifiers = this.metadataService.getProductTypeValues();

    const transactionCategoryData = {
      metadataType: 'TransactionCategory',
      transactionCategoryList: [
        {
          transactionCategory: {
            identifier: formValue.transactionCategoryIdentifier,
            code: formValue.code,
            name: formValue.name,
            ...(formValue.description && { description: formValue.description })
          },

          // Channel relationships (similar to transaction type)
          productTypePostingCategoryDSRltnpList: productTypeIdentifiers
            .map(productTypeIdentifier =>
              (this.channelData || []).map(channel => ({
                productTypeIdentifier: productTypeIdentifier ?? null,
                postingCategoryIdentifier: formValue.transactionCategoryIdentifier,
                resourceItemIdentifier: channel.identifier,
                optionalityType: channel.option
              }))
            )
            .reduce((acc, val) => acc.concat(val), []),

          productTypePostingCategoryDSCounterRltnp: productTypeIdentifiers
            .map(productTypeIdentifier =>
              (this.counterData || []).map(counter => ({
                productTypeIdentifier: productTypeIdentifier ?? null,
                postingCategoryIdentifier: formValue.transactionCategoryIdentifier,
                resourceItemIdentifier: counter.channelidentifier,
                counterIdentifier: counter.identifier,
                counterOperationType: counter.operatorType
              }))
            )
            .reduce((acc, val) => acc.concat(val), []),

          productTypePostingCategoryDSRestrcitionRltnp: productTypeIdentifiers
            .map(productTypeIdentifier =>
              (this.restrictionData || []).map(restriction => ({
                productTypeIdentifier: productTypeIdentifier ?? null,
                postingCategoryIdentifier: formValue.transactionCategoryIdentifier,
                resourceItemIdentifier: restriction.channelidentifier,
                restrictionIdentifier: restriction.identifier,
                restrictionClassificationType: restriction.type
              }))
            )
            .reduce((acc, val) => acc.concat(val), []),

          productTypePostingCategoryDSCDRltnpList: productTypeIdentifiers
            .map(productTypeIdentifier =>
              (this.conditionData || []).map(condition => ({
                productTypeIdentifier: productTypeIdentifier ?? null,
                postingCategoryIdentifier: formValue.transactionCategoryIdentifier,
                resourceItemIdentifier: condition.channelidentifier,
                conditionIdentifier: condition.identifier,
                cdarValue: condition.code,
                optionalityType: condition.relationshipType
              }))
            )
            .reduce((acc, val) => acc.concat(val), []),

          productTypePostingCategoryDSComsRltnp: productTypeIdentifiers
            .map(productTypeIdentifier =>
              (this.communicationData || []).map(communication => {
                const master = this.communicationsMasterList.find(
                  m => m.code === communication.communicationServices
                );
                return {
                  productTypeIdentifier: productTypeIdentifier ?? null,
                  postingCategoryIdentifier: formValue.transactionCategoryIdentifier,
                  resourceItemIdentifier: communication.channelidentifier,
                  serviceElementIdentifier: master?.serviceElementIdentifier ?? null,
                  commServiceIdentifier: communication.identifier
                };
              })
            )
            .reduce((acc, val) => acc.concat(val), [])
        }
      ],

      productTypeList: this.metadataService.getProductTypeKeys().map((code, index) => ({
        identifier: this.metadataService.getProductTypeValues()[index],
        code: code
      }))
    };

    console.log('transactionCategoryData(JSON):\n', JSON.stringify(transactionCategoryData, null, 2));

    const serviceCall = isAdd
      ? this.transactionCategoryService.saveTransactionCategory(transactionCategoryData)
      : this.transactionCategoryService.updateTransactionCategory(transactionCategoryData);

    serviceCall.subscribe({
      next: resp => this.successResponse(resp, transactionCategoryData, isAdd),
      error: (err: NotificationMessage[]) => this.handleError(err, isAdd)
    });

    this.addNewTransactionCategoryFormGroup.controls['transactionCategoryIdentifier'].disable();
  }

  @Output() apiResponse: EventEmitter<NotificationMessage[]> = new EventEmitter<NotificationMessage[]>();

  private successResponse(resp, transactionCategoryData, isAdd) {
    const transactionCategoryCode = transactionCategoryData.transactionCategoryList[0].transactionCategory.code;
    const SuccessMsg = isAdd
      ? `${transactionCategoryCode} Added successfully`
      : `${transactionCategoryCode} Updated successfully`;
    this.apiResponse.emit({ ...transactionCategoryData, SuccessMsg });
  }

  public errorMessages: NotificationMessage[] = [];
  public message: NotificationMessage | undefined;
  
  private handleError(error: any, isAdd: boolean) {
    const errorMsg = error?.error?.errorDescription || 'An unexpected error occurred.';
    this.message = {
      code: error?.error?.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };

    if (errorMsg) {
      this.errorMessages.push(this.message);
    }

    setTimeout(() => {
      this.errorMessages = this.errorMessages.filter(msg => msg.text !== errorMsg);
    }, 20000);
  }

  transactionCategoryForm(element: TransactionCategoryList) {
    console.log('transactionCategoryForm element:', JSON.stringify(element, null, 2));
    this.isAdd = false;

    this.retainedTransactionCategoryIdentifier = element.identifier ?? 0;
    this.retainedCode = element.code || '';
    this.retainedName = element.name || '';
    this.retainedDescription = element.description || '';
    
    // Set retained channel relationships
    this.retainedChannels = element.productTypePostingCategoryDSRltnpList || [];
    this.retainedCounters = element.productTypePostingCategoryDSCounterRltnp || [];
    this.retainedRestrictions = element.productTypePostingCategoryDSRestrcitionRltnp || [];
    this.retainedConditions = element.productTypePostingCategoryDSCDRltnpList || [];
    this.retainedCommunicationServices = element.productTypePostingCategoryDSComsRltnp || [];

    // Set form values
    this.addNewTransactionCategoryFormGroup.patchValue({
      code: element.code,
      transactionCategoryIdentifier: element.identifier,
      name: element.name,
      description: element.description
    });

    // Restore channel data
    this.restoreChannelData();

    this.isEdit = true;
  }

  public getError(control: string, formGroup: UntypedFormGroup): string {
    if (formGroup) {
      const fc: AbstractControl = formGroup.get(control);
      if (fc && fc.errors && fc.touched) {
        return FormUtilityService.getCommonFCErrorMsg(fc);
      }
    }
  }

  noSpecialCharactersValidator(): ValidatorFn {
    return (control: AbstractControl): { [key: string]: any } | null => {
      const forbidden = /[^a-zA-Z0-9]/.test(control.value);
      return forbidden ? { noSpecialCharacters: { value: control.value } } : null;
    };
  }

  maxLengthValidator(maxLength: number) {
    return (control: AbstractControl): ValidationErrors | null => {
      const value = control.value;
      if (value == null) return null;
      const valueStr = value.toString().replace(/^0+/, '');
      return valueStr.length > maxLength ? { maxLength: true } : null;
    };
  }
}





































