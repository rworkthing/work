private addNewRoleType() {
    this.isAdd = true;

    // ✅ Force a fresh instance of the form (instead of just resetting)
    this.addNewRoleTypeFormGroup = this.fb.group({
        roleTypeCode: new UntypedFormControl('', [Validators.required]),
        roleTypeIdentifier: new UntypedFormControl({ value: '', disabled: true }),
        roleTypeName: new UntypedFormControl(''),
        roleTypeShortName: new UntypedFormControl(''),
        category: new UntypedFormControl('', [Validators.required]),
        classification: new UntypedFormControl('', [Validators.required]),
        systemDefined: new UntypedFormControl(''),
        isCalculated: new UntypedFormControl(''),
        category1: new UntypedFormControl([])
    });

    console.log("After Reset (Add New Role):", this.addNewRoleTypeFormGroup.value);

    this.cdr.detectChanges();  // ✅ Force UI refresh to ensure the new form state is applied

    let dialogModel: BodCommonDialogModel = {
        formTemplate: this.addNewRoleTypeTemp,
        title: 'Add New Role Type'
    };

    setTimeout(() => {  
        this.openDialog(dialogModel);
    });
}


private editRoleTypes(element: RoleTypeList) {
    this.isAdd = false;
    this.editRoleType = element;

    console.log("FOR NEW EDIT", element);

    let selectedTemplate: TemplateRef<any>;
    let dialogTitle: string;

    if (element.shortName) {
        selectedTemplate = this.addNewRoleTypeTemp;
        dialogTitle = 'Edit Role Type';

        // ✅ Instead of just resetting, recreate the form for a clean edit instance
        this.addNewRoleTypeFormGroup = this.fb.group({
            roleTypeCode: new UntypedFormControl(element.code, [Validators.required]),
            roleTypeIdentifier: new UntypedFormControl({ value: element.identifier, disabled: true }),
            roleTypeName: new UntypedFormControl(element.name),
            roleTypeShortName: new UntypedFormControl(element.shortName),
            category: new UntypedFormControl(element.category, [Validators.required]),
            classification: new UntypedFormControl(element.classification, [Validators.required]),
            systemDefined: new UntypedFormControl(element.systemDefined),
            isCalculated: new UntypedFormControl(element.calculated),
            category1: new UntypedFormControl(element.productTypeRoleTypeCatRelationshipList.map(rel => rel.categoryIdentifier))
        });

    } else {
        selectedTemplate = this.addExstRoleTypeTemp;
        dialogTitle = 'Edit Existing Role Type';

        this.addExistingRoleTypeFormGroup = this.fb.group({
            existingRoleCode: new UntypedFormControl(element.code, [Validators.required]),
            category1: new UntypedFormControl(element.productTypeRoleTypeCatRelationshipList.map(rel => rel.categoryIdentifier))
        });
    }

    console.log("After Reset (Edit Role Type):", this.addNewRoleTypeFormGroup.value);

    this.cdr.detectChanges();  // ✅ Ensure the UI updates before opening the dialog

    const dialogModel: BodCommonDialogModel = {
        formTemplate: selectedTemplate,
        title: dialogTitle
    };

    setTimeout(() => {  
        this.openDialog(dialogModel);
    });
}
