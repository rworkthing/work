// transaction-category.service.ts
import { Injectable } from '@angular/core';
import { HttpClient, HttpHeaders } from '@angular/common/http';
import { Column, InquiryLayoutInput, UIContextService } from '@bod/common';
import { BehaviorSubject, Observable, tap } from 'rxjs';
import { DataSharingService } from '../data-sharing-service.service';
import { TransactionCategoryList } from './transaction-category.model';

@Injectable({
  providedIn: 'root'
})
export class TransactionCategoryService {
  public columns: Column[] = [
    {
      name: 'code',
      title: 'Transaction Category Code',
      truncate: true,
      noOverflow: true,
      width: 20,
      widthUnit: 'rem'
    },
    {
      name: 'name',
      title: 'Name',
      truncate: true,
      noOverflow: true,
      width: 15,
      widthUnit: 'rem'
    },
    {
      name: 'actions',
      title: ' ',
      hasAction: true
    }
  ];

  private baseUrl = '';
  private saveUrl = '';
  private updateUrl = '';
  private retrieveUrl = '';
  private deleteUrl = '';
  private retrieveAllUrl = '';
  private currentStatus: string = 'NEW';
  
  private reqDfnId = '';
  private clientCode = '';
  private countryCode = '';
  private productLines: any[] = [];
  private productTypes: any[] = [];
  private productTypeValues: number[] = [];
  private businessProductLine: any[] = [];

  constructor(
    private http: HttpClient,
    private uiContextService: UIContextService,
    private readonly dataSharingService: DataSharingService
  ) {
    let url = this.uiContextService.getModuleDataById('fis.nextgen.sdkit').valueMap.sdkServiceUrl.value;

    this.dataSharingService.data$.subscribe(data => {
      if (data) {
        this.reqDfnId = data.reqDfnId;
        this.businessProductLine = data.reqDfnResponseDTO.businessProductLine;
        this.countryCode = data.countryCode;
        this.clientCode = data.countryCode;
        this.productLines = [...new Set(this.businessProductLine.map(obj => obj.value))];
        this.productTypes = [...new Set(this.businessProductLine.map(obj => obj.type))];
        
        if (data.identifier) {
          try {
            const parsedIdentifiers: { key: string; value: number }[] = JSON.parse(data.identifier);
            this.productTypeValues = parsedIdentifiers.map((item: { key: string; value: number }) => item.value);
          } catch (e) {
            console.error('Failed to parse identifier JSON:', e);
          }
        }

        this.saveUrl = url + '/metadata/create/' + this.reqDfnId;
        this.updateUrl = url + '/metadata/update/' + this.reqDfnId;
        this.retrieveUrl = url + '/metadata/retrieve/' + this.reqDfnId + '?metadata-config-type=TransactionCategory';
        this.deleteUrl = url + '/metadata/delete/' + this.reqDfnId;
        this.baseUrl = url ?? '';
        this.retrieveAllUrl = url + '/metadata/retrieve/' + this.reqDfnId;
      }
    });
  }

  retrieveAll(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<any[]>(this.retrieveAllUrl, { headers }).pipe(
      tap((response: any) => {
        const firstStatus = response?.data && response.data.length > 0 && response.data[0]?.MetadataStatus
          ? response.data[0].MetadataStatus
          : 'NEW';
        this.currentStatus = firstStatus;
      })
    );
  }

  updateCurrentStatus(status: string): void {
    this.currentStatus = status;
  }

  private getCreateUrlWithStatus(status: string): string {
    return `${this.baseUrl}/metadata/create/${this.reqDfnId}?status=${status}`;
  }

  saveTransactionCategory(request: any, status?: string): Observable<any> {
    const headers = this.createHeaders();
    const statusToUse = status || this.currentStatus;
    const url = this.getCreateUrlWithStatus(statusToUse);
    return this.http.post(url, request, { headers });
  }

  updateTransactionCategory(request: any): Observable<any> {
    const headers = this.createHeaders();
    return this.http.put(this.updateUrl, request, { headers });
  }

  deleteTransactionCategory(metadataConfigType: string, metadataConfigIdfr: number): Observable<any> {
    const headers = this.createHeaders();
    const params = {
      'metadata-config-type': metadataConfigType,
      'metadata-config-idfr': metadataConfigIdfr
    };
    return this.http.delete(this.deleteUrl, { headers, params });
  }

  retrieveTransactionCategory(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<TransactionCategoryList[]>(this.retrieveUrl, { headers });
  }

  createHeaders(): HttpHeaders {
    return new HttpHeaders({
      'country-code': this.countryCode,
      'client-code': this.clientCode,
      'product-line': this.productLines,
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID(),
      'requirement-id': this.reqDfnId
    });
  }

  generateUUID(): string {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
      const r = (Math.random() * 16) | 0,
        v = c === 'x' ? r : (r & 0x3) | 0x8;
      return v.toString(16);
    });
  }

  public getProductTypeValues(): number[] {
    return this.productTypeValues;
  }

  public getTransactionCategoryData(element: TransactionCategoryList): Observable<InquiryLayoutInput[]> {
    const groups: InquiryLayoutInput[] = [];
    let setIsLink = false;
    for (let i = 0; i < element.transactionCategoryInquiry.length; i++) {
      groups.push({
        id: element.transactionCategoryInquiry[i].id,
        label: element.transactionCategoryInquiry[i].label,
        value: element.transactionCategoryInquiry[i].value,
        isLink: setIsLink
      });
    }
    const $groups = new BehaviorSubject<InquiryLayoutInput[]>(groups);
    return $groups;
  }
}



































