export const nonNegativeValidator: ValidatorFn = (control: AbstractControl): ValidationErrors | null => {
  const value = control.value;
  return value != null && value < 0 ? { negativeValue: 'Negative numbers are not allowed' } : null;
};


this.inputLayoutForm.addControl(
  'additionaldatavalue',
  new FormControl('', [Validators.required, nonNegativeValidator])
);

this.inputLayoutForm.addControl(
  'percentagevalue',
  new FormControl('', [nonNegativeValidator])
);

this.inputLayoutForm.addControl(
  'sequencenumber',
  new FormControl('', [nonNegativeValidator])
);


<mat-error *ngIf="control.hasError('negativeValue')">
  Negative numbers are not allowed
</mat-error>
