ngOnChanges(): void {
  this.trySelectWhenReady();
}
  private trySelectWhenReady(): void {
  const interval = setInterval(() => {
    const tableData = this.currencyDataSingleSelect?.datasource?.data || [];
    const selection = this.currencyTable?.selection;

    if (tableData.length > 0 && selection && this.selectedRowSingleSelect?.length > 0) {
      console.log('✅ Ready for selection');
      this.selectCurrencyRows();
      clearInterval(interval); // Stop polling
    } else {
      console.log('⏳ Waiting... tableData:', tableData.length, ' selection:', !!selection, ' selectedRowSingleSelect:', this.selectedRowSingleSelect?.length);
    }
  }, 100); // check every 100ms
}
private selectCurrencyRows(): void {
  const tableData = this.currencyDataSingleSelect?.datasource?.data || [];
  const selection = this.currencyTable?.selection;

  tableData.forEach(dataRow => {
    const match = this.selectedRowSingleSelect.find(
      sel => sel.identifier === dataRow.identifier
    );
    if (match) {
      selection.select(dataRow);
    }
  });

  console.log('✅ Finished selecting matching rows');
}
