  standalone: true,
  imports: [
    CommonModule,
    AddEditTransactionCategoryComponent,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
