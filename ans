import { Component, EventEmitter, Input, OnChanges, OnInit, Output, SimpleChanges, ViewChild } from '@angular/core';
import { CommonModule } from '@angular/common';
import { BodPageContainerModule, BodTableComponent, BodTableMetadata, BodTableModule, RowLeftAction, SelectPageMode } from '@bod/common';
import { MatSlideToggleModule } from '@angular/material/slide-toggle';
import { MatSelectModule } from '@angular/material/select'; // Add this import
import { MatFormFieldModule } from '@angular/material/form-field'; // Add this import
import { FormBuilder, FormGroup, FormsModule, ReactiveFormsModule, UntypedFormGroup } from '@angular/forms';
import { CurrencyTableSingle } from '../../../conditions/add-edit-conditions/add-edit-conditions.model';
import { ConditionDetailService } from '../../../conditions/condition-detail.service';
import { MatTableDataSource } from '@angular/material/table';
import { TransactionTypeService } from '../../transaction-type.service';
import { Channels } from '../../transaction-type.model';

@Component({
  selector: 'bod-channels-multiselect-table',
  standalone: true,
  imports: [
    CommonModule,
    BodTableModule,
    BodPageContainerModule,
    MatSlideToggleModule,
    MatSelectModule, // Add this
    MatFormFieldModule, // Add this
    ReactiveFormsModule,
    FormsModule
  ],
  templateUrl: './channels-multiselect-table.component.html',
  styleUrl: './channels-multiselect-table.component.scss'
})
export class ChannelsMultiselectTableComponent implements OnInit, OnChanges {

  @Input() currencyDataSingleSelect: BodTableMetadata;
  @Input() selectedRowSingleSelect: Channels[] = [];
  @Output() rowSelected = new EventEmitter<Channels[]>();
  @Output() optionChanged = new EventEmitter<{ element: any, newValue: string }>(); // Add this output

  @ViewChild('channelsMultiselectTable', { static: false }) // Update ref name to match template
  currencyTable: BodTableComponent;

  public addChannlesFormGroup: UntypedFormGroup | undefined;

  options = [
    { label: 'Proposed', value: 'Proposed' },
    { label: 'Mandatory', value: 'Mandatory' }
  ];

  ngAfterViewInit(): void {
    setTimeout(() => this.selectCurrencyRows(), 0);
  }

  ngOnChanges(changes: SimpleChanges): void {
    if (changes['selectedRowSingleSelect'] && this.selectedRowSingleSelect?.length) {
      console.log('📥 selectedRowSingleSelect changed:', this.selectedRowSingleSelect);
      setTimeout(() => this.selectCurrencyRows(), 0);
    }
  }

  private selectCurrencyRows(): void {
    const tableData = this.currencyDataSingleSelect?.datasource?.data || [];
    const selection = this.currencyTable?.selection;

    if (!selection || tableData.length === 0) {
      return;
    }

    // Clear current selection first
    selection.clear();

    // Select the new rows
    tableData.forEach(dataRow => {
      const match = this.selectedRowSingleSelect.find(
        sel => sel.id === dataRow.id
      );
      if (match) {
        selection.select(dataRow);
      }
    });
  }

  public allowRowSelection = true;
  public rowSelectionStrategy: SelectPageMode = SelectPageMode.ALL_PAGES;
  public showEdit = true;
  public defaultForm: FormGroup;

  constructor(
    private fb: FormBuilder,
    private transactionTypeService: TransactionTypeService
  ) {}

  ngOnInit() {
    this.defaultForm = this.fb.group({});
    
    // Initialize option property for all table data if not present
    if (this.currencyDataSingleSelect?.datasource?.data) {
      this.currencyDataSingleSelect.datasource.data.forEach(item => {
        if (!item.option) {
          item.option = 'Proposed'; // Set default value
        }
      });
    }
  }

  // Add this method to handle option changes
  public onOptionChange(element: any, newValue: string): void {
    console.log('Option changed for element:', element, 'New value:', newValue);
    
    // Update the element's option value
    element.option = newValue;
    
    // Update the datasource to reflect the change
    const data = [...this.currencyDataSingleSelect.datasource.data];
    const index = data.findIndex(item => item.id === element.id);
    if (index !== -1) {
      data[index].option = newValue;
      this.currencyDataSingleSelect.datasource.data = data;
    }
    
    // Emit the change event
    this.optionChanged.emit({ element, newValue });
  }

  public resetSelection() {
    if (this.currencyTable?.selection) {
      this.currencyTable.selection.clear();
    }
    this.selectedRowSingleSelect = [];
  }

  public rowSelectionSingleSelect(element: Channels[]) {
    this.selectedRowSingleSelect = element;
    this.rowSelected.emit(this.selectedRowSingleSelect);
  }
}






<bod-table
  #channelsMultiselectTable
  [data]="currencyDataSingleSelect"
  [modeOptions]="{ input: true }"
  (onRowSelect)="rowSelectionSingleSelect($event)"
  [rowSelectionStrategy]="rowSelectionStrategy"
  [allowSelectAll]="allowRowSelection"
  [alignContent]="'top'"
  [customColumnTemplates]="[
    { columnName: 'option', templateName: optionTemplate }
  ]"
>

<ng-template
  #optionTemplate
  let-element="element"
  let-column="column"
  let-index="index"
>
  <mat-form-field appearance="outline" style="width: 120px;">
    <mat-select
      [value]="element.option || 'Proposed'"
      (selectionChange)="onOptionChange(element, $event.value)"
      [disableRipple]="false"
    >
      <mat-option *ngFor="let option of options" [value]="option.value">
        {{ option.label }}
      </mat-option>
    </mat-select>
  </mat-form-field>
</ng-template>

</bod-table>






import { Component, Inject } from '@angular/core';
import { MAT_DIALOG_DATA, MatDialogRef } from '@angular/material/dialog';
import { ChannelsMultiselectTableComponent } from './channels-multiselect-table/channels-multiselect-table.component';

@Component({
  selector: 'bod-channels-multiselect-dialog',
  standalone: true,
  imports: [ChannelsMultiselectTableComponent],
  template: `
    <div mat-dialog-content>
      <h2 mat-dialog-title>Select Channels</h2>
      <bod-channels-multiselect-table
        [currencyDataSingleSelect]="data.currencyDataSingleSelect"
        [selectedRowSingleSelect]="data.selectedRowSingleSelect"
        (rowSelected)="onRowSelected($event)"
        (optionChanged)="onOptionChanged($event)"
      ></bod-channels-multiselect-table>
    </div>
    <div mat-dialog-actions>
      <button mat-button (click)="onCancel()">Cancel</button>
      <button mat-button color="primary" (click)="onConfirm()">OK</button>
    </div>
  `
})
export class ChannelsMultiselectDialogComponent {
  selectedRows: any[] = [];

  constructor(
    public dialogRef: MatDialogRef<ChannelsMultiselectDialogComponent>,
    @Inject(MAT_DIALOG_DATA) public data: any
  ) {
    console.log('[Dialog] Received data for table:', data.currencyDataSingleSelect);
    this.selectedRows = data.selectedRowSingleSelect || [];
  }

  onRowSelected(selectedRows: any[]) {
    this.selectedRows = selectedRows;
    console.log('Selected rows updated:', this.selectedRows);
  }

  onOptionChanged(event: { element: any, newValue: string }) {
    console.log('Option changed in dialog:', event);
    // Handle option change if needed
  }

  onCancel() {
    this.dialogRef.close(null);
  }

  onConfirm() {
    this.dialogRef.close(this.selectedRows);
  }
}







public addTableData() {
  // Ensure the data has the correct structure with option property
  const dialogData = {
    ...this.currencyDataSingleSelect,
    datasource: {
      ...this.currencyDataSingleSelect.datasource,
      data: this.currencyDataSingleSelect.datasource.data.map(item => ({
        ...item,
        option: item.option || 'Proposed' // Ensure option property exists
      }))
    }
  };

  // Open the dialog
  const dialogRef = this.dialog.open(ChannelsMultiselectDialogComponent, {
    width: '900px',
    data: {
      currencyDataSingleSelect: dialogData,
      selectedRowSingleSelect: this.selectedRowSingleSelect || []
    }
  });

  dialogRef.afterClosed().subscribe(result => {
    if (result) {
      console.log('Dialog closed with result:', result);
      // Handle selected rows from multiselect table
      result.forEach(selectedRow => {
        const exists = this.dataWithSimpleEdit.some(row => row.id === selectedRow.id);
        if (!exists) {
          this.dataWithSimpleEdit.push({
            id: this.generateUniqueId(this.dataWithSimpleEdit),
            channel: selectedRow.code || selectedRow.channel,
            option: selectedRow.option || 'Proposed'
          });
        }
      });
      this.tableWithSimpleEdit.datasource.data = [...this.dataWithSimpleEdit];
    }
  });
}
