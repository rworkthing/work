inlineFormAddSubmit(event: any, index: number) {
  if (event && event.formGroup.valid) {
    const formValue = event.formGroup.value; // Get values directly from the inline form

    const newLocaleEntry = {
      locale: formValue.localeCode,
      displayName: formValue.displayName,
      description: formValue.description
    };

    if (newLocaleEntry.locale && newLocaleEntry.displayName && newLocaleEntry.description) {
      this.dataWithlocale.push(newLocaleEntry);
      this.tableWithSimpleEdit.datasource.data = [...this.dataWithlocale];
    } else {
      alert('Please fill all required fields before adding!');
    }
  }
}
