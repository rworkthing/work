export class ConditionsMultiselectDialogComponent {
  public translationKey = TranslationKey;

  formType: BodFormTypes = BodFormTypes.FORM;
  @ViewChild('conditionsTable', { static: false }) conditionsTable: ConditionsMultiselectTableComponent;
  @Output() rowSelected = new EventEmitter<ConditionTable[]>();

  selectedRows: Conditions[] = [];
  public addConditionsFormGroup: UntypedFormGroup;
  isDirty = false;

  constructor(
    public dialogRef: MatDialogRef<ConditionsMultiselectDialogComponent>,
    @Inject(MAT_DIALOG_DATA) public data: any,
    private fb: UntypedFormBuilder
  ) {
    this.initForm();
  }

  private initForm(): void {
    const controls: { [key: string]: any } = {};
    // Always get the latest data
    const allRows = this.data?.conditionsDataSingleSelect?.datasource?.data || [];
    allRows.forEach((row: any, idx: number) => {
     
      controls['relationshipType_' + row.id] = [row.relationshipType || null];
    });
    this.addConditionsFormGroup = this.fb.group(controls);
    console.log('Dialog initForm - Form controls:', Object.keys(controls));
  }

  ngOnChanges(changes: SimpleChanges) {
    if (changes['data'] || changes['conditionData']) {
      this.initForm();
    }
  }

  onTableDirtyChange(dirty: boolean) {
    this.isDirty = dirty;
    if (dirty) {
      this.addConditionsFormGroup.markAsDirty();
    }
  }

  public isTableDirty = false;

  public onTableDirty(): void {
    this.isTableDirty = true;
    this.addConditionsFormGroup.markAsDirty();
  }

  onRowSelected(selectedRows: Conditions[]) {
    console.log('onRowSelected called with:', selectedRows);
    this.selectedRows = selectedRows;
    this.isDirty = true;
    this.initForm();
  }

  onSubmit() {
    // Pass the selectedRows object when closing the dialog
    this.dialogRef.close({ selectedConditions: this.selectedRows });
  }

  onReset() {
    this.isDirty = false;
  }
}















