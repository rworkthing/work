inlineFormAddSubmit(formGroupValid: boolean, index) {
  if (formGroupValid) {
    const formValue = this.inputLocaleLayoutForm.value;
    const newLocaleEntry = {
      locale: formValue.localeCode,
      displayName: formValue.displayName,
      description: formValue.description
    };

    this.dataWithlocale.push(newLocaleEntry);
    this.tableWithSimpleEdit.datasource.data = [...this.dataWithlocale];
    this.inputLocaleLayoutForm.reset();
  }
}
