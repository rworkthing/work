    { columnName: 'isExclude', templateName: isCalculatedDisplayTemplate }
  ]"
>
  <ng-template #isCalculatedDisplayTemplate let-element="element">
    {{ element.isExclude ? 'Yes' : 'No' }}
  </ng-template>
      </bod-table>
   
  </ng-template>
</bod-table>

