this.roleTypeService.getRoleCat().subscribe(data => {
    console.log('API Response:', data); // Debugging - Check API response

    const mappedData = data.map((item: any) => ({
      label: item.code,
      value: item.identifier
    }));

    this.roleCategoryValues = mappedData;
    this.categorys = mappedData; // 🔹 Ensure categorys is assigned correctly

    console.log('Categorys Data:', this.categorys); // Debugging
  });
