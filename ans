
@ViewChild('currencyConditionsForCurr', { static: false })
currencyTable: BodTableComponent;

@Input() selectedRowSingleSelect: CurrencyTableSingle[] = [];

ngAfterViewInit(): void {
  setTimeout(() => {
    if (this.currencyTable && this.selectedRowSingleSelect.length > 0) {
      this.selectedRowSingleSelect.forEach(row => {
        this.currencyTable.selection.select(row);
      });
    }
  });
}
