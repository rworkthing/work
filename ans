  productTypePostingCategoryDSCounterRltnp?: any[];
  productTypePostingCategoryDSRestrcitionRltnp?: any[];
  productTypePostingCategoryDSCDRltnpList?: any[];
  productTypePostingCategoryDSComsRltnp?: any[];
  status?: string;
}

export interface TransactionCategoryInquiry {
  id: number;
  label: string;
  value: string;
}

