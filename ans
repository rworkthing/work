<bod-page-container
  [pageMode]="pageModeSimple"
  (pageAction)="onPageAction($event)"
  [messages]="messages"
  *ngIf="showEdit"
>
  <bod-table
    [data]="tableWithSimpleEdit"
    [tableActions]="showActionsForSimple ? actionsForSimple : []"
    [modeOptions]="modeOptionsSimple"
    [singleRowEdit]="singleRowEdit"
    [customColumnTemplates]="[
      {
        columnName: 'taxType',
        templateName: taxTypeTemplate
      },
      {
        columnName: 'businessRule',
        templateName: businessRuleTemplate
      },
      { columnName: 'actions', templateName: editActionsTemplate1 }
    ]"
    (inputValidationStatus)="checkStatus($event)"
    (editTableEvent)="onEditTableAction($event)"
    (onTableActionClick)="addTableData()"
    [primaryColumnName]="'id'"
    #simpleEditTableRef
  >
    <ng-template
      #editActionsTemplate1
      let-element="element"
      let-column="column"
      let-index="index"
    >
      <div
        *ngIf="
          !this.singleRowEdit.modeOptions?.input ||
          (this.singleRowEdit?.modeOptions?.input &&
            this.singleRowEdit?.index !== index)
        "
      >
        <bod-table-actions
          [actions]="rowLevelActionsForBasicEdit"
          (onActionClick)="handleRowLevelActions($event.icon, index)"
        >
        </bod-table-actions>
      </div>
      <div
        *ngIf="
          this.singleRowEdit?.modeOptions?.input &&
          this.singleRowEdit?.index === index
        "
      >
      </div>
    </ng-template>
  </bod-table>

  <ng-template
    #taxTypeTemplate
    let-element="element"
    let-column="column"
  >
    <mat-form-field appearance="outline" fisStyle style="min-width: 200px">
      <mat-select
        panelClass="fis-style"
        [(ngModel)]="element.taxType"
        [ngModelOptions]="{ updateOn: 'change' }"
        (ngModelChange)="onTaxTypeChange()"
        required
        #taxTypeModel="ngModel"
        [errorStateMatcher]="matcher"
      >
        <mat-option
          *ngFor="let taxType of taxTypes"
          [value]="taxType.value"
        >
          {{ taxType.label }}
        </mat-option>
      </mat-select>
      <mat-error
        *ngIf="
          taxTypeModel.invalid &&
          (taxTypeModel.touched || taxTypeModel.dirty)
        "
      >
        Tax Type is required
      </mat-error>
    </mat-form-field>
  </ng-template>

  <ng-template
    #businessRuleTemplate
    let-element="element"
    let-column="column"
  >
    <mat-form-field appearance="outline" fisStyle style="min-width: 200px">
      <mat-select
        panelClass="fis-style"
        [(ngModel)]="element.businessRule"
        [ngModelOptions]="{ updateOn: 'change' }"
        (ngModelChange)="onBusinessRuleChange()"
        required
        #businessRuleModel="ngModel"
        [errorStateMatcher]="matcher"
      >
        <mat-option
          *ngFor="let businessRule of businessRules"
          [value]="businessRule.value"
        >
          {{ businessRule.label }}
        </mat-option>
      </mat-select>
      <mat-error
        *ngIf="
          businessRuleModel.invalid &&
          (businessRuleModel.touched || businessRuleModel.dirty)
        "
      >
        Business Rule is required
      </mat-error>
    </mat-form-field>
  </ng-template>
</bod-page-container>






















