@Component({
  selector: 'bod-existing-counters',
  standalone: true,
  imports: [
    CounterComponent,
    PeriodTypeComponent,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    MatDatepickerModule,
    BodCommonModule
  ],
  templateUrl: './existing-counters.component.html',
  styleUrl: './existing-counters.component.scss'
})
export class ExistingCountersComponent implements OnInit {
  public translationKey = TranslationKey;
  public existingCounterFormGroup: UntypedFormGroup;
  formType: BodFormTypes = BodFormTypes.SUBMIT;

  @Output() apiResponse: EventEmitter<NotificationMessage[]> = new EventEmitter<
    NotificationMessage[]
  >();
  
  public errorMessages: NotificationMessage[] = [];
  public modeOptions: ModeOptions = { input: false, reset: false };
  
  @ViewChild('systemMessage', { static: true }) systemMessage: any;
  @ViewChild('periodTypeRef') periodTypeRef: PeriodTypeComponent;
  
  public messages: NotificationMessage[] = [];
  public message: NotificationMessage | undefined;
  private dialogRef$: MatDialogRef<CommonDialogComponent, any>;

  // Available counters for dropdown
  public availableCounters: ExistingCounter[] = [];
  public selectedCounterDetails: ExistingCounter | null = null;
  
  statusControl = new FormControl(null); 
  public previousStatus: string | undefined;
  public isTableDirty = false;

  // Period Type table data
  public periodTypeTableData: PeriodType[] = [];

  constructor(
    private changeDetectorRef: ChangeDetectorRef,
    private bodFormStateService: BodFormStateService,
    public counterService: CounterService,
    private fb: FormBuilder,
    private bodCommonDialogService: BodCommonDialogService,
    private metadataService: MetadataService
  ) {}

  ngOnInit() {
    this.initForm();
    this.loadAvailableCounters();

    this.metadataService.retrieveAll().subscribe((response: any) => {
      const firstStatus = response?.data?.[0]?.MetadataStatus;
      const statusToSet = firstStatus || 'NEW';
      this.statusControl.setValue(statusToSet);
      this.previousStatus = statusToSet;
    });
  }

  private initForm(): void {
    this.existingCounterFormGroup = this.fb.group({
      counterCode: new UntypedFormControl('', [Validators.required]),
      counterIdentifier: [{ value: '', disabled: true }],
      counterName: new UntypedFormControl('', [Validators.required]),
      classificationtype: new UntypedFormControl('', [Validators.required]),
      rulecheck: new UntypedFormControl(false)
    });
  }

  private loadAvailableCounters(): void {
    // This would typically call a service to get available counters
    // For now, using mock data - replace with actual service call
    this.counterService.getAvailableCounters().subscribe({
      next: (counters) => {
        this.availableCounters = counters;
      },
      error: (error) => {
        console.error('Error loading available counters:', error);
        // Fallback to mock data if service fails
        this.availableCounters = [
          { identifier: 1, code: 'COUNTER001', name: 'Sample Counter 1', classificationType: 'PostingCounter' },
          { identifier: 2, code: 'COUNTER002', name: 'Sample Counter 2', classificationType: 'ManualBumpUpCounter' },
          { identifier: 3, code: 'COUNTER003', name: 'Sample Counter 3', classificationType: 'OverdraftCounter' }
        ];
      }
    });
  }

  onCounterCodeChange(event: any): void {
    const selectedCode = event.value;
    this.selectedCounterDetails = this.availableCounters.find(counter => counter.code === selectedCode) || null;
    
    if (this.selectedCounterDetails) {
      this.existingCounterFormGroup.patchValue({
        counterIdentifier: this.selectedCounterDetails.identifier,
        counterName: this.selectedCounterDetails.name,
        classificationtype: this.selectedCounterDetails.classificationType
      });
    } else {
      this.existingCounterFormGroup.patchValue({
        counterIdentifier: '',
        counterName: '',
        classificationtype: ''
      });
    }
  }

  public getError(control: string, formGroup: UntypedFormGroup): string {
    if (formGroup) {
      const fc: AbstractControl = formGroup.get(control);
      if (fc && fc.errors && fc.touched) {
        return FormUtilityService.getCommonFCErrorMsg(fc);
      }
    }
  }

  public onTableDirty(): void {
    this.isTableDirty = true;
    this.existingCounterFormGroup.markAsDirty();
  }

  // Handle period type table data changes
  public completeDeltaPeriodTypeData: any;
  handleCompleteDeltaChangePeriodType(data: any) {
    this.completeDeltaPeriodTypeData = data;
    console.log('Received CompleteDelta from period type child:', this.completeDeltaPeriodTypeData);
  }

  onRelateExistingCounter() {
    this.submitForm();
  }

  submitForm() {
    this.errorMessages = [];

    if (this.existingCounterFormGroup.invalid) {
      this.existingCounterFormGroup.markAllAsTouched();
      const missingFields = this.getInvalidRequiredFields(this.existingCounterFormGroup);
      this.handleError(
        {
          errorCode: 'FORM_INVALID',
          status: 400,
          missingFields
        }
      );
      return;
    }

    if (!this.selectedCounterDetails) {
      this.handleError({
        errorCode: 'NO_COUNTER_SELECTED',
        status: 400
      });
      return;
    }

    const formValue = this.existingCounterFormGroup.getRawValue();

    // Get product type data from metadata service
    const productTypeKeys = this.metadataService.getProductTypeKeys();
    const productTypeValues = this.metadataService.getProductTypeValues();

    // Build the relationship structure for existing counter
    const counterRelationshipData = {
      metadataType: 'CounterRelationship',
      existingCounterIdentifier: this.selectedCounterDetails.identifier,
      counterCode: this.selectedCounterDetails.code,
      productElementCounterTypeRltnpList: productTypeKeys.map((code, index) => ({
        productTypeIdentifier: productTypeValues[index],
        counterIdentifier: this.selectedCounterDetails.identifier,
        counterCode: this.selectedCounterDetails.code,
        ruleCheck: formValue.rulecheck ? 'Y' : 'N'
      })),
      productElementCounterTypePeriodList: (this.periodTypeRef?.getCurrentTablePeriodType() || []).map(period => ({
        productTypeIdentifier: productTypeValues[0], // or map for each product type if needed
        counterIdentifier: this.selectedCounterDetails.identifier,
        periodType: period.periodType,
        isCalculate: period.isCalculated ? 'Y' : 'N'
      })),
      productTypeList: productTypeKeys.map((code, index) => ({
        identifier: productTypeValues[index],
        code: code
      }))
    };

    console.log('Counter relationship data to be sent:', JSON.stringify(counterRelationshipData, null, 2));

    // Call service to relate existing counter
    this.counterService.relateExistingCounter(counterRelationshipData).subscribe({
      next: resp => this.successResponse(resp, counterRelationshipData),
      error: (err: NotificationMessage[]) => this.handleError(err)
    });
  }

  private getInvalidRequiredFields(formGroup: FormGroup): string[] {
    const invalidFields: string[] = [];

    Object.keys(formGroup.controls).forEach(key => {
      const control = formGroup.get(key);
      if (control && control.errors?.['required']) {
        invalidFields.push(key);
      }
    });

    return invalidFields;
  }

  private successResponse(resp, counterData) {
    const counterCode = this.selectedCounterDetails?.code;
    const SuccessMsg = `${counterCode} related successfully`;
    this.apiResponse.emit({ ...counterData, SuccessMsg });
  }

  private handleError(error: any) {
    let errorMsg = '';

    if (error.errorCode === 'FORM_INVALID' || error.status === 400) {
      if (error.missingFields?.length) {
        errorMsg = `Please fill the required fields.`;
      } else {
        errorMsg = 'Please fill the required fields.';
      }
    } else if (error.errorCode === 'NO_COUNTER_SELECTED') {
      errorMsg = 'Please select a counter from the dropdown.';
    } else if (error.errorCode === 'PERIOD_TYPE_REQUIRED') {
      errorMsg = 'Period type is required for all rows.';
    } else if (error.errorCode === 'DUPLICATE_PERIOD_TYPE') {
      errorMsg = 'Duplicate period types found. Please ensure all period types are unique.';
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_005") {
      errorMsg = 'Counter relationship already exists.';
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_004") {
      errorMsg = error.error?.errorDescription || 'Counter relationship already exists.';
    } else {
      errorMsg = 'Unknown error occurred.';
    }

    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };
    this.errorMessages.push(this.message);

    // Auto-remove error messages after 10 seconds
    setTimeout(() => {
      this.errorMessages = this.errorMessages.filter(msg => msg.text !== errorMsg);
    }, 10000);
  }

  onReset(): void {
    // Reset error messages
    this.errorMessages = [];
    
    // Reset the form
    this.existingCounterFormGroup.reset();
    this.existingCounterFormGroup.markAsPristine();
    this.existingCounterFormGroup.markAsUntouched();

    // Reset selected counter details
    this.selectedCounterDetails = null;

    // Reset table dirty state
    this.isTableDirty = false;

    // Clear period type data
    this.periodTypeTableData = [];
    
    // Reset the period type table if it exists
    if (this.periodTypeRef) {
      this.periodTypeRef.reset();
    }

    this.changeDetectorRef.detectChanges();
  }
}
























