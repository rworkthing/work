private editRoleTypes(element: RoleTypeList) {
    this.isAdd = false;
    this.editRoleType = element;
    console.log("FOR NEW EDIT", element);

    let selectedTemplate: TemplateRef<any>;
    let dialogTitle: string;

    if (element.shortName) {
        selectedTemplate = this.addNewRoleTypeTemp;
        dialogTitle = 'Edit Role Type';

        // ✅ Reset form before patching values
        this.addNewRoleTypeFormGroup.reset();
        
        this.addNewRoleTypeFormGroup.patchValue({
            roleTypeCode: element.code,
            roleTypeName: element.name,
            roleTypeShortName: element.shortName,
            category: element.category,
            classification: element.classification,
            systemDefined: element.systemDefined,
            isCalculated: element.calculated
        });

    } else {
        selectedTemplate = this.addExstRoleTypeTemp;
        dialogTitle = 'Edit Existing Role Type';

        // ✅ Reset form before patching values
        this.addExistingRoleTypeFormGroup.reset();

        this.addExistingRoleTypeFormGroup.patchValue({
            existingRoleCode: element.code,
            category1: element.productTypeRoleTypeCatRelationshipList.map(rel => rel.categoryIdentifier)
        });
    }

    const dialogModel: BodCommonDialogModel = {
        formTemplate: selectedTemplate,
        title: dialogTitle
    };

    this.openDialog(dialogModel);
}
