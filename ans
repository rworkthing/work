export class CommunicationsMultiselectTableComponent implements OnInit, OnChanges {

  public modeOptions: ModeOptions = { input: false, reset: false };
  public modeOptionsSimple = this.modeOptions;

  @Input() communicationsDataSingleSelect: BodTableMetadata;
  @Input() selectedRowSingleSelect: Communications[] = [];
  @Output() rowSelected = new EventEmitter<Communications[]>();
  @Output() defaultChanged = new EventEmitter<{ rowIndex: number, isDefault: boolean }>();
  @Output() dirtyChange = new EventEmitter<boolean>();
  @Input() formGroup: UntypedFormGroup;

  @ViewChild('communicationsMultiselectTable', { static: false })
  communicationsTable: BodTableComponent;

  private isDirty = false;

  communicationServicesOptions = [
    { label: 'Email', value: 'Email' },
    { label: 'SMS', value: 'SMS' },
    { label: 'Push Notification', value: 'Push Notification' },
    { label: 'In-App Message', value: 'In-App Message' }
  ];

  ngAfterViewInit(): void {
    setTimeout(() => this.selectCommunicationsRows(), 0);
  }

  ngOnChanges(changes: SimpleChanges): void {
    if (changes['selectedRowSingleSelect'] && this.selectedRowSingleSelect?.length) {
      console.log('📥 selectedRowSingleSelect changed:', this.selectedRowSingleSelect);
      setTimeout(() => this.selectCommunicationsRows(), 0);
    }
  }

  private selectCommunicationsRows(): void {
    const tableData = this.communicationsDataSingleSelect?.datasource?.data || [];
    const selection = this.communicationsTable?.selection;

    if (!selection || tableData.length === 0) {
      return;
    }

    selection.clear();

    tableData.forEach(dataRow => {
      const match = this.selectedRowSingleSelect.find(
        sel => sel.id === dataRow.id
      );
      if (match) {
        selection.select(dataRow);
      }
    });
  }

  public allowRowSelection = true;
  public rowSelectionStrategy: SelectPageMode = SelectPageMode.ALL_PAGES;
  public showEdit = true;
  public defaultForm: FormGroup;

  constructor(
    private fb: FormBuilder,
    private transactionTypeService: TransactionTypeService
  ) { }

  ngOnInit() {
    this.defaultForm = this.fb.group({});
  }

  public onCommunicationServicesChange(element: any, value: string) {
    element.communicationServices = value;
    this.setDirty(true);
  }

  private loadCommunicationData() {
    // This could be replaced with an actual API call if communication services come from backend
    // For now, we'll use hardcoded data since Service Element is "Blank Alert"
    const communicationData = this.communicationServicesOptions.map((service, index) => ({
      id: index + 1,
      serviceElement: 'Blank Alert',
      communicationServices: service.value,
      default: false
    }));

    this.communicationsDataSingleSelect.datasource.data = communicationData;
  }

  public resetSelection() {
    if (this.communicationsTable?.selection) {
      this.communicationsTable.selection.clear();
    }
    this.selectedRowSingleSelect = [];
    this.setDirty(false);
  }

  public rowSelectionSingleSelect(element: Communications[]) {
    console.log('rowSelectionSingleSelect called with:', element);
    this.selectedRowSingleSelect = element;
    this.rowSelected.emit(this.selectedRowSingleSelect);
    this.setDirty(true);
  }

  public rowSelection(element: Communications[]) {
    console.log('rowSelection called with:', element);
    if (element.length !== 0) {
      this.selectedRowSingleSelect = element;
    } else {
      this.selectedRowSingleSelect = [];
    }
    this.rowSelected.emit(this.selectedRowSingleSelect);
    this.setDirty(true);
    console.log('Communications selectedRowSingleSelect:', this.selectedRowSingleSelect);
  }

  public onDefaultToggleChange(event: any, rowIndex: number) {
    const data = [...this.communicationsDataSingleSelect.datasource.data];
    const row = data.find(r => r.index === rowIndex);

    if (!row) return;

    if (event.checked) {
      data.forEach(item => {
        item.default = item.index === rowIndex;
      });
    } else {
      row.default = false;
    }

    this.communicationsDataSingleSelect.datasource.data = data;

    this.defaultChanged.emit({
      rowIndex: rowIndex,
      isDefault: event.checked
    });
  }

  private setDirty(dirty: boolean) {
    this.isDirty = dirty;
    this.dirtyChange.emit(this.isDirty);
  }
}











