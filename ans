private editLocale(locale, name, desc) {
    console.log("editLocale called with ", locale, name, desc);

    // ✅ Find the existing row by matching the locale
    const existingRow = this.tableWithSimpleEdit.datasource.data.find(row => row.locale === locale);

    if (existingRow) {
        // ✅ Modify the existing row directly
        existingRow.displayName = name;
        existingRow.description = desc;
        console.log("editLocale: Row updated:", existingRow);
    } else {
        console.log("editLocale: Row not found, keeping existing logic.");
        
        let updatedData = {
            id: this.lastModifiedIndex,
            locale: locale,
            action: EditTableAction.ADD,
            displayName: name,
            description: desc
        };

        this.tableWithSimpleEdit.datasource.data.push(updatedData);
        ++this.lastModifiedIndex;
    }

    // ✅ Ensure UI updates
    setTimeout(() => {
        this.changeDetectorRef.detectChanges();
    }, 100);

    console.log("Updated Table Data:", this.tableWithSimpleEdit.datasource.data);
}
