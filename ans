// Dynamic columns based on multivalueallowed
private getColumns(): Column[] {
  const baseColumns: Column[] = [
    {
      name: 'durationType',
      title: 'Duration Type'
    },
    {
      name: 'minimum',
      title: 'Minimum',
      truncate: true,
      noOverflow: true,
      width: 10,
      widthUnit: 'rem',
      inputModeOptions: {
        type: ColumnType.input,
        model: null,
        validators: {
          required: true,
          max: 20,
          maxLengthStrategy: this.selectedStrategy
        }
      }
    },
    {
      name: 'maximum',
      title: 'Maximum',
      truncate: true,
      noOverflow: true,
      width: 10,
      widthUnit: 'rem',
      inputModeOptions: {
        type: ColumnType.input,
        model: null,
        validators: {
          required: true,
          max: 20,
          maxLengthStrategy: this.selectedStrategy
        }
      }
    },
    {
      name: 'unitValue',
      title: 'Unit Value',
      truncate: true,
      noOverflow: true,
      width: 10,
      widthUnit: 'rem',
      inputModeOptions: {
        type: ColumnType.input,
        model: null,
        validators: {
          required: true,
          max: 20,
          maxLengthStrategy: this.selectedStrategy
        }
      }
    }
  ];

  // Only add default column if multivalueallowed is false
  if (!this.multivalueallowed) {
    baseColumns.push({
      name: 'default',
      title: 'Default',
      inputModeOptions: {
        type: ColumnType.slideToggle,
        model: {
          data: this.inputForSlideToggleValue
        },
        validators: {
          max: 20,
          maxLengthStrategy: this.selectedStrategy
        },
        isNotEditable: false,
        existingDataNotEditable: false
      }
    });
  }

  // Always add actions column at the end
  baseColumns.push({
    name: 'actions',
    title: ' ',
    hasAction: true,
    width: 7
  });

  return baseColumns;
}




<bod-page-container
  [pageMode]="pageModeSimple"
  (pageAction)="onPageAction($event)"
  [messages]="messages"
  *ngIf="showEdit"
>
  <bod-table
    [data]="tableWithSimpleEdit"
    [tableActions]="showActionsForSimple ? actionsForSimple : []"
    [modeOptions]="modeOptionsSimple"
    [singleRowEdit]="singleRowEdit"
    [customColumnTemplates]="getCustomColumnTemplates()"
    (inputValidationStatus)="checkStatus($event)"
    (editTableEvent)="onEditTableAction($event)"
    (onTableActionClick)="addTableData()"
    [primaryColumnName]="'id'"
    #simpleEditTableRef
  >
    <ng-template
      #editActionsTemplate1
      let-element="element"
      let-column="column"
      let-index="index"
    >
      <!-- Your existing edit actions template content -->
      <div
        *ngIf="
          !this.singleRowEdit.modeOptions?.input ||
          (this.singleRowEdit?.modeOptions?.input &&
            this.singleRowEdit?.index !== index)
        "
      >
        <bod-table-actions
          [actions]="rowLevelActionsForBasicEdit"
          (onActionClick)="handleRowLevelActions($event.icon, index)"
        >
        </bod-table-actions>
      </div>
      <div
        *ngIf="
          this.singleRowEdit?.modeOptions?.input &&
          this.singleRowEdit?.index === index
        "
      >
        <button
          matTooltip="{{ 'mbpBod.demo.microsite.buttons.save' | translate }}"
          [matTooltipPosition]="'below'"
          rufId
          mat-mini-fab
          color="primary"
          fisStyle
          (click)="handleRowLevelActions('save', index)"
        >
          <mat-icon fisStyle rufIconStyle="sm" fisIcon="check"></mat-icon>
        </button>
        <button
          rufId
          fisStyle
          mat-icon-button
          matTooltip="{{ 'mbpBod.demo.microsite.buttons.cancel' | translate }}"
          [matTooltipPosition]="'below'"
          class="ruf-ghost-button"
          (click)="handleRowLevelActions('reset', index)"
        >
          <mat-icon rufIconStyle="sm" fisIcon="close"></mat-icon>
        </button>
      </div>
    </ng-template>

    <ng-template
      #durationTypeTemplate
      let-element="element"
      let-column="column"
    >
      <mat-form-field appearance="outline" fisStyle style="min-width: 200px">
        <mat-select 
        panelClass="fis-style"
        [(ngModel)]="element.durationType"
        (selectionChange)="onDurationChange(element)">
          <mat-option *ngFor="let val of durationOptions" [value]="val.value">
             {{ val.label }}
          </mat-option>
        </mat-select>
      </mat-form-field>
    </ng-template>

    <ng-template #unitValueColumnTemplate let-element="element">
      <mat-form-field appearance="outline" fisStyle>
        <input
          matInput
          fisStyle
          type="number"
          [(ngModel)]="element.unitValue"
          [disabled]="!element.default"
        />
      </mat-form-field>
    </ng-template>

    <ng-template #minimumColumnTemplate let-element="element">
      <mat-form-field appearance="outline" fisStyle>
        <input
          matInput
          fisStyle
          type="number"
          [(ngModel)]="element.minimum"
          [disabled]="disabledDurations.includes(element.durationType)"
          (blur)="validateMinMax(element)"
        />
      </mat-form-field>
    </ng-template>

    <ng-template #maximumColumnTemplate let-element="element">
      <mat-form-field appearance="outline" fisStyle>
        <input
          matInput
          fisStyle
          type="number"
          [(ngModel)]="element.maximum"
          [disabled]="disabledDurations.includes(element.durationType)"
          (blur)="validateMinMax(element)"
        />
      </mat-form-field>
    </ng-template>

    <!-- Default column template - only used when multivalueallowed is false -->
    <ng-template #defaultColumnTemplate let-element="element">
      <mat-slide-toggle
        fisStyle
        color="primary"
        [(ngModel)]="element.default"
        (change)="onDefaultChange(element)"
      >
      </mat-slide-toggle>
    </ng-template>
  </bod-table>
</bod-page-container>






// Method to get custom column templates dynamically
getCustomColumnTemplates() {
  const templates = [
    {
      columnName: 'durationType',
      templateName: 'durationTypeTemplate'
    },
    { columnName: 'actions', templateName: 'editActionsTemplate1' },
    { columnName: 'unitValue', templateName: 'unitValueColumnTemplate' },
    { columnName: 'minimum', templateName: 'minimumColumnTemplate' },
    { columnName: 'maximum', templateName: 'maximumColumnTemplate' }
  ];

  // Only add default column template if multivalueallowed is false
  if (!this.multivalueallowed) {
    templates.push({
      columnName: 'default',
      templateName: 'defaultColumnTemplate'
    });
  }

  return templates;
}

// Handle default toggle changes
onDefaultChange(element: RangeDuration): void {
  if (!this.multivalueallowed && element.default) {
    // Single default mode - unset all other defaults
    this.tableWithSimpleEdit.datasource.data.forEach((row, index) => {
      if (row.id !== element.id) {
        row.default = false;
      }
    });
  }

  // Emit the change
  this.completeDeltaChangeRangeDuration.emit(
    this.tableWithSimpleEdit.datasource.data
  );
  this.tableDirty.emit(true);
}

// Update the onEditTableAction method to handle default toggle logic
public onEditTableAction(event) {
  this.commonDataService.updateMessage(
    'mbpBod.demo.microsite.table.editTableEvent',
    JSON.stringify(event.currentChanges)
  );
  console.log('CompleteDelta::', event.completeDelta);

  if (event.currentChanges) {
    const editedIndex = event.currentChanges.rowIndex;
    const currentRow = this.tableWithSimpleEdit.datasource.data[editedIndex];

    // Validate min/max values
    if (currentRow.minimum !== null && currentRow.maximum !== null) {
      if (currentRow.minimum > currentRow.maximum) {
        console.error('Minimum cannot be greater than maximum');
        return;
      }
    }

    // Handle default toggle logic only if multivalueallowed is false
    if (currentRow.default && !this.multivalueallowed) {
      // Single default mode - unset all other defaults
      this.tableWithSimpleEdit.datasource.data.forEach((r, i) => {
        r.default = i === editedIndex;
      });
    }
    
    this.completeDeltaChangeRangeDuration.emit(
      this.tableWithSimpleEdit.datasource.data
    );
  }

  this.tableDirty.emit(true);
}




/**
 * Method to add a new row
 */
public addTableData() {
  this.lastModifiedIndex = this.tableWithSimpleEdit.datasource.data.length;
  console.log('valid Value Data', this.tableWithSimpleEdit.datasource);

  const updatedData: RangeDuration = {
    id: ++this.lastModifiedIndex,
    durationType: '',
    unitValue: null,
    minimum: null,
    maximum: null,
    // Set default to false, or true if it's the first row and multivalueallowed is false
    default: !this.multivalueallowed && this.tableWithSimpleEdit.datasource.data.length === 0
  };

  this.simpleEditTableRef.addRow(updatedData);

  if (this.modeOptionsSimple?.input) {
    this.updateCustomColumnFormFields();
  } else {
    this.singleRowEdit = {
      modeOptions: { input: true, reset: false },
      index: this.tableWithSimpleEdit.datasource.data.length - 1
    };
  }
}






