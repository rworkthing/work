@Input() set localeData(data: BodLocaleTable[]) {
  this.dataWithSimpleEdit = data || [];
  this.tableWithSimpleEdit.datasource.data = this.dataWithSimpleEdit;
}


const localeList: BodLocaleTable[] = (element.multiLingualTextInfoList || []).map(locale => ({
  locale: locale.localeCode,
  displayName: locale.translationText,
  description: locale.localeText
}));

this.dataWithSimpleEdit = localeList; // optional if still used elsewhere
this.localeTableData = localeList;    // <-- new variable


<bod-simple-edit-table [localeData]="localeTableData"></bod-simple-edit-table>


this.tableWithSimpleEdit.datasource.data.push(obj);
