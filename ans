import { AbstractControl, ValidatorFn } from '@angular/forms';

export function localeDuplicateValidator(getRows: () => any[], getCurrentRowId: () => number): ValidatorFn {
  return (control: AbstractControl) => {
    const currentValue = control.value;
    if (!currentValue) return null;

    const rows = getRows();
    const currentId = getCurrentRowId();

    const isDuplicate = rows.some(row =>
      row.locale === currentValue && row.id !== currentId
    );

    return isDuplicate ? { duplicateLocale: 'This locale is already selected.' } : null;
  };
}
