inlineFormAddSubmit(formGroupValid: boolean, index) {
  if (formGroupValid) {
    const formGroup = this.getTableFormGroup(index);
    const newRow: BodLocaleTable = {
      locale: formGroup.value.localeCode ?? '',
      displayName: formGroup.value.displayName ?? '',
      description: formGroup.value.description ?? ''
    };

    this.dataWithlocale.push(newRow);
    this.tableWithSimpleEdit.datasource.data = [...this.dataWithlocale];
  } else {
    this.displayInlineFormErrorMessage(index);
  }
}

