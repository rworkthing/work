 serviceCall.subscribe(
        response => {
            console.log("API Response:", response); // Debugging log

            // ✅ Ensure table updates with the new data
            this.tableWithSimpleEdit.datasource.data = response.attributeList[0].multiLingualTextInfoList.map(item => ({
                locale: item.localeCode,
                displayName: item.translationText,
                description: item.localeText
            }));

            // ✅ Force UI update
            setTimeout(() => {
                this.changeDetectorRef.detectChanges();
            }, 100);

            this.handleSuccess(response);
        },
        error => this.handleError(error)
    );
