private roleTypeForm(element: RoleTypeList): void {
  this.isAdd = false;

  // Ensure dropdown data is available before setting form values
  if (!this.categorys.length || !this.classifications.length) {
    this.roleTypeService.getRoleCat().subscribe(data => {
      this.categorys = data.map((item: any) => ({ label: item.code, value: item.identifier }));
      this.setDropdownValues(element); // Set values after data loads
    });

    this.roleTypeService.getAccountClassification().subscribe(data => {
      this.classifications = data.map((item: any) => ({ label: item.code, value: item.identifier }));
      this.setDropdownValues(element);
    });
  } else {
    this.setDropdownValues(element); // Data is already available, set values immediately
  }
}

// New helper method to set dropdown values
private setDropdownValues(element: RoleTypeList) {
  const selectedCategory = this.categorys.find(cat => cat.value === element.category);
  const selectedClassification = this.classifications.find(cls => cls.value === element.classification);

  this.addNewRoleTypeFormGroup.patchValue({
    category: selectedCategory ? selectedCategory.value : null,
    classification: selectedClassification ? selectedClassification.value : null
  });
}
