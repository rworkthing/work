  standalone: true,
  imports: [
    InquiryLayoutModule,
    AddEditServiceElementComponent,
    ExistingServiceElementComponent,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,

    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    MatDatepickerModule,
    BodCommonModule
  ],
  templateUrl: './service-element-details.component.html',
  styleUrl: './service-element-details.component.scss',
  schemas: [CUSTOM_ELEMENTS_SCHEMA, NO_ERRORS_SCHEMA]
})
export class ServiceElementDetailsComponent implements OnInit {
  public translationKey = TranslationKey;
  public editactions: BodTableAction[] = editDeleteActions;
  public addNewServiceElementFormGroup: UntypedFormGroup;
  private existingServiceElementsMap: {
    [code: string]: { name: string; optionality: string };
  } = {};

  @Input() status: string = '';

  @ViewChild('addNewServiceElementTemplate')
  public addNewServiceElementTemp: TemplateRef<any>;
  @ViewChild('relateExistingServiceElementTemplate')
  public relateExistingServiceElementTemp: TemplateRef<any>;
  private adminTableRef: BodTableComponent | undefined;
  @ViewChild('systemMessage', { static: true }) systemMessage: any;
  public messages: NotificationMessage[] = [];
  public message: NotificationMessage | undefined;
  public relationshipColumns = [
    { name: 'childServiceElement', title: 'Child Service Element' },
    { name: 'isExclude', title: 'Is Exclude' }
  ];

  public ConfirmData: BodConfirmDialogModel = {
    title: 'BOD.metadataconfig.title',
    message: 'BOD.metadataconfig.message',
    confirm: 'BOD.metadataconfig.delete',
    dismiss: 'BOD.metadataconfig.cancel'
  };

  constructor(
    private confirmDialogService: BodConfirmAlertDialogsService,
    private bodConfirmAlertDialogsService: BodConfirmAlertDialogsService,
    public serviceElementService: ServiceElementService,
    private fb: FormBuilder,
    public ServiceElementService: ServiceElementService,
    private bodCommonDialogService: BodCommonDialogService,
    private metadataService: MetadataService
  ) {}

  ngOnInit() {
    this.serviceElementService.getServiceElements().subscribe((serviceElements: any[]) => {
      this.existingServiceElementsMap = {};
      serviceElements.forEach(serviceElement => {
        this.existingServiceElementsMap[serviceElement.code] = {
          name: serviceElement.name,
          optionality: serviceElement.optionality
        };
      });

      // Now fetch and map the main service elements
      this.getNewServiceElement();
      this.loadDropDownData();
    });
    this.serviceElementService.retrieveAll().subscribe((response: any) => {
      const firstStatus = response?.data?.[0]?.MetadataStatus;
      const statusToSet = firstStatus || 'NEW';
      this.statusControl.setValue(statusToSet);
      this.previousStatus = statusToSet;
      this.serviceElementService.updateCurrentStatus(statusToSet);
    });

    this.getNewServiceElement();
  }
  public childServiceElement: any[] = [];

  loadDropDownData(): void {
    this.ServiceElementService.getServiceElements().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      this.childServiceElement = mappedData;
    });
  }

  public serviceElementTableActions: BodTableAction[] = ServiceElementTableLevelActions;
  public serviceElementTableMetaData: BodTableMetadata = {
    title: 'Service Element Details',
    columns: [...this.serviceElementService.columns],
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<BodSampleTable>(),
    noRecordsMessage: 'No Service Element Data Defined',
    rowLeftAction: RowLeftAction.expandableRows,
    enableSorting: true
  };

  public relationshipTableMetaData: BodTableMetadata = {
    title: 'Service Element Relationship',
    columns: this.relationshipColumns,
    enablePagination: false,
    datasource: new MatTableDataSource([]),
    noRecordsMessage: 'No Service Element Relationship Defined'
  };

  public rowExpanded(element: ServiceElementList) {
    this.messages = [];
    
    const relationshipRows = (element.serviceElementRelationshipList || []).map(relationship => {
      // Find the dropdown item by identifier
      const dropdownItem = this.childServiceElement?.find(
        item => item.value === relationship.childServiceElement
      );
      return {
        childServiceElement: dropdownItem
          ? dropdownItem.label
          : relationship.childServiceElement,
        isExclude: relationship.isExclude ? 'Yes' : 'No'
      };
    });
    this.relationshipTableMetaData.datasource.data = relationshipRows;
  }

  public msg: NotificationMessage | undefined;

  isStatusEditable(): boolean {
    return this.status !== 'READY' && this.status !== 'GENERATED';
  }
  statusControl = new FormControl(null);
  public previousStatus: string | undefined;

  @Output() statusChanged = new EventEmitter<string>();
  addServiceElementEvent(event: any) {
    if (event) {
      this.getNewServiceElement();

      this.metadataService.retrieveAll().subscribe((response: any) => {
        const firstStatus = response?.data?.[0]?.MetadataStatus;
        const statusToSet = firstStatus || 'NEW';
        this.statusControl.setValue(statusToSet);
        this.previousStatus = statusToSet;
        this.statusChanged.emit(statusToSet);
        this.serviceElementService.updateCurrentStatus(statusToSet);
      });
      const SuccessMsg = event.SuccessMsg;
      this.msg = {
        code: '',
        text: SuccessMsg,
        type: NotificationMessageType.SUCCESS
      };
      this.messages.push(this.msg);
      setTimeout(() => {
        this.messages = this.messages.filter(msg => msg.text !== SuccessMsg);
      }, 20000);
    }
    this.dialogRef$.close();
  }

  public commonDialogSize: string = 'Large';
  public closeOnCloseIconClick: boolean = false;
  private onCloseClick() {
    this.systemMessage.message = 'Custom Function called on close';
    this.systemMessage.show();
    this.dialogRef$.close();
  }
  private dialogRef$: MatDialogRef<CommonDialogComponent, any>;
  private openDialog(dialogModel: any) {
    let onClose = this.closeOnCloseIconClick
      ? this.onCloseClick.bind(this)
      : undefined;
    this.dialogRef$ = this.bodCommonDialogService.commonDialog(
      dialogModel,
      onClose,
      this.commonDialogSize
    );
  }

  private addNewServiceElement() {
    this.editServiceElement = undefined;
    this.messages = [];
    let dialogModel: BodCommonDialogModel = {
      formTemplate: this.addNewServiceElementTemp,
      title: 'Add New Service Element'
    };
    this.openDialog(dialogModel);
  }

  public onTableActionClicked1(event: BodTableAction) {
    this.isEdit = false;
    this.messages = [];
    if (event.id === 12) {
      this.addNewServiceElement();
    } else if (event.id === 13) {
      this.relateExistingServiceElement();
    }
  }

  private relateExistingServiceElement() {
    this.editServiceElement = undefined;
    this.messages = [];
    let dialogModel: BodCommonDialogModel = {
      formTemplate: this.relateExistingServiceElementTemp,
      title: 'Relate Existing Service Element'
    };
    this.openDialog(dialogModel);
  }

  // Add method to handle existing service element events
  relateExistingServiceElementEvent(event: any) {
    if (event) {
      this.getNewServiceElement();

      this.metadataService.retrieveAll().subscribe((response: any) => {
        const firstStatus = response?.data?.[0]?.MetadataStatus;
        const statusToSet = firstStatus || 'NEW';
        this.statusControl.setValue(statusToSet);
        this.previousStatus = statusToSet;
        this.statusChanged.emit(statusToSet);
        this.serviceElementService.updateCurrentStatus(statusToSet);
      });

      const SuccessMsg = event.SuccessMsg;
      this.msg = {
        code: '',
        text: SuccessMsg,
        type: NotificationMessageType.SUCCESS
      };
      this.messages.push(this.msg);
      setTimeout(() => {
        this.messages = this.messages.filter(msg => msg.text !== SuccessMsg);
      }, 20000);
    }
    this.dialogRef$.close();
  }

  serviceElementData: ServiceElementList[] = [];
  getNewServiceElement(): void {
    this.serviceElementService.retrieveServiceElement().subscribe(response => {
      if (response.status === 'SUCCESS' && response.data) {
        this.serviceElementData = response.data.map((item: any) => {
          const serviceElement = item.ServiceElement;
          
          // Build serviceElementInquiry array
          const serviceElementInquiry = [
            {
              id: 0,
              label: 'Name',
              value: serviceElement?.name || ''
            },
            {
              id: 1,
              label: 'Optionality',
              value: serviceElement?.optionality || ''
            }
          ];

          // Build serviceElementRelationshipList
          const serviceElementRelationshipList = (serviceElement?.relationshipList || []).map(relationship => ({
            childServiceElement: relationship.childServiceElement,
            isExclude: relationship.isExclude === 'Y'
          }));

          // Build service element data object
          return {
            identifier: serviceElement?.identifier,
            code: serviceElement?.code,
            name: serviceElement?.name,
            optionality: serviceElement?.optionality,
            serviceElementInquiry,
            serviceElementRelationshipList,
            metadataStatus: item.MetadataStatus
          };
        });

        // Assign to table datasource
        this.serviceElementTableMetaData.datasource.data = this.serviceElementData;
      }
    });
  }

  isEdit = false;
  iconActionClicked(event: BodTableAction, element: ServiceElementList) {
    this.isEdit = true;
    this.messages = [];
    if (event.id === BodTableActionType.EDIT) {
      this.editServiceElements(element);
    } else if (event.id === 1) {
      const confirmDataWithCode: BodConfirmDialogModel = {
        ...this.ConfirmData,
        message: `${'Are you sure you want to delete'} ${element.code}`
      };
      this.bodConfirmAlertDialogsService
        .confirm(confirmDataWithCode)
        .subscribe(val => {
          if (val) {
            this.serviceElementDelete(element);
          }
        });
    }
  }

  editServiceElement: ServiceElementList | undefined;
  retainedCode: string = '';
  retainedIdentifier: number = 0;
  retainedName: string = '';
  retainedOptionality: string = '';

  private editServiceElements(element: ServiceElementList) {
    this.editServiceElement = element;
    this.retainedCode = element.code || '';
    this.retainedIdentifier = element.identifier ?? 0;
    this.retainedName = element.name || '';
    this.retainedOptionality = element.optionality || '';

    const dialogModel: BodCommonDialogModel = {
      formTemplate: this.addNewServiceElementTemp,
      title: 'Edit Service Element'
    };
    this.openDialog(dialogModel);
  }

  serviceElementDelete(element: ServiceElementList): void {
    this.serviceElementService
      .deleteServiceElement('ServiceElement', element.identifier)
      .subscribe({
        next: response => {
          const successMsg = `${element.code} Deleted Successfully`;
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(
              msg => msg.text !== successMsg
            );
          }, 20000);

          this.getNewServiceElement();

          this.metadataService.retrieveAll().subscribe((response: any) => {
            const firstStatus =
              response?.data &&
              response.data.length > 0 &&
              response.data[0]?.MetadataStatus
                ? response.data[0].MetadataStatus
                : null;
            const statusToSet = firstStatus || 'NEW';
            this.statusControl.setValue(statusToSet);
            this.previousStatus = statusToSet;
            this.statusChanged.emit(statusToSet);
            this.serviceElementService.updateCurrentStatus(statusToSet);
          });
        },
        error: error => {
          const errorMsg =
            error?.error?.errorDescription ||
            `Failed to delete ${element.code}. Please try again.`;
          this.message = {
            code: error?.error?.errorCode || 'ERROR',
            text: errorMsg,
            type: NotificationMessageType.ERROR
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(msg => msg.text !== errorMsg);
          }, 20000);
        }
      });
  }
}



























