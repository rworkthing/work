public onDefaultToggleChange(event: any, rowIndex: number) {
    // Get current data
    const data = [...this.currencyDataSingleSelect.datasource.data];
    const row = data.find(r => r.index === rowIndex);
    
    if (!row) return;
    
    // Update default status
    if (event.checked) {
      // If this row is now default, unmark all others
      data.forEach(item => {
        item.default = item.index === rowIndex;
      });
      
      // Make sure this row is selected without affecting other selections
      if (this.currencyTable && this.currencyTable.selection) {
        // Check if this row is already selected
        const isRowSelected = this.currencyTable.selection.isSelected(row);
        
        // If not already selected, add it to the selection
        if (!isRowSelected) {
          this.currencyTable.selection.select(row);
          
          // Update selectedRowSingleSelect to include this row if not already included
          if (!this.selectedRowSingleSelect.some(item => item.index === row.index)) {
            this.selectedRowSingleSelect = [...this.selectedRowSingleSelect, row];
            
            // Emit the updated selection
            this.rowSelected.emit(this.selectedRowSingleSelect);
          }
        }
      }
    } else {
      // If toggle is turned off, do NOT change selection
      // Only update the default status back to false
      row.default = false;
    }
    
    // Update the data source
    this.currencyDataSingleSelect.datasource.data = data;
    
    // Emit the change
    this.defaultChanged.emit({
      rowIndex: rowIndex,
      isDefault: event.checked
    });
  }
