// Add these methods to the existing CounterService class

export class CounterService {
  // ... existing properties and methods

  // Method to get available counters for the dropdown
  getAvailableCounters(): Observable<any[]> {
    const headers = this.createHeaders();
    // This should be a different endpoint that returns all available counters
    // For now, using the same retrieve endpoint - you may need to adjust this
    const availableCountersUrl = `${this.baseUrl}/counters/available/${this.reqDfnId}`;
    
    return this.http.get<any[]>(availableCountersUrl, { headers }).pipe(
      // Transform the response to the expected format
      tap((response: any) => {
        if (response?.data) {
          return response.data.map((item: any) => ({
            identifier: item.identifier || item.Counter?.counterType?.identifier,
            code: item.code || item.Counter?.counterType?.code,
            name: item.name || item.Counter?.counterType?.name,
            classificationType: item.classificationType || item.Counter?.counterType?.classificationType
          }));
        }
        return [];
      })
    );
  }

  // Method to relate an existing counter
  relateExistingCounter(request: any): Observable<any> {
    const headers = this.createHeaders();
    const relateUrl = `${this.baseUrl}/metadata/relate/${this.reqDfnId}`;
    return this.http.post(relateUrl, request, { headers });
  }

  // Alternative method if you have a specific endpoint for counter relationships
  createCounterRelationship(request: any): Observable<any> {
    const headers = this.createHeaders();
    const relationshipUrl = `${this.baseUrl}/metadata/counter-relationship/${this.reqDfnId}`;
    return this.http.post(relationshipUrl, request, { headers });
  }

  // Method to get counter details by code
  getCounterByCode(code: string): Observable<any> {
    const headers = this.createHeaders();
    const counterByCodeUrl = `${this.baseUrl}/counter/${this.reqDfnId}/${code}`;
    return this.http.get(counterByCodeUrl, { headers });
  }

  // ... rest of existing methods
}
