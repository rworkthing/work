private roleTypeForm(element: RoleTypeList): void {
    this.isAdd = false;

    if (!this.categorys.length || !this.classifications.length) {
      this.roleTypeService.getRoleCat().subscribe(data => {
        this.categorys = data.map((item: any) => ({ label: item.code, value: item.identifier }));
        if (!this.isAdd) {  // ✅ Only call this when editing
          this.setDropdownValues(element);
        }
      });

      this.roleTypeService.getAccountClassification().subscribe(data => {
        this.classifications = data.map((item: any) => ({ label: item.code, value: item.identifier }));
        if (!this.isAdd) {  // ✅ Only call this when editing
          this.setDropdownValues(element);
        }
      });
    } else {
      if (!this.isAdd) {  // ✅ Only call this when editing
        this.setDropdownValues(element);
      }
    }
    
    this.loadRoleRelationshipData(element);
    this.isEdit = true;
}



private setDropdownValues(element: RoleTypeList) {
    console.log("🚀 setDropdownValues() is running! isAdd =", this.isAdd);

    if (this.isAdd) {
        console.log("⚠️ Skipping because it's Add Mode!");
        return;  // ✅ Prevents execution in Add Mode
    }

    const selectedCategory = this.categorys.find(cat => cat.label === element.category);
    const selectedClassification = this.classifications.find(cls => cls.label === element.classification);

    const categoryLabels = element.productTypeRoleTypeCatRelationshipList.map(rel => {
        const matchedCategory = this.categorys.find(cat => cat.value === rel.categoryIdentifier);
        return matchedCategory ? matchedCategory.label : rel.categoryIdentifier.toString();
    });

    this.addNewRoleTypeFormGroup.patchValue({
        roleTypeCode: element.code,
        roleTypeIdentifier: element.identifier,
        roleTypeName: element.name,
        roleTypeShortName: element.shortName,
        category: selectedCategory?.value || '',
        classification: selectedClassification?.value || '',
        systemDefined: element.systemDefined,
        isCalculated: element.calculated,
        category1: categoryLabels
    });

    console.log("✅ Updated Form Values:", this.addNewRoleTypeFormGroup.value);
}
