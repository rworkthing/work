private clearForm() {
    Object.keys(this.addNewRoleTypeFormGroup.controls).forEach(key => {
        this.addNewRoleTypeFormGroup.controls[key].setValue(null); // Clear all fields
        this.addNewRoleTypeFormGroup.controls[key].markAsPristine(); // Mark all as pristine
        this.addNewRoleTypeFormGroup.controls[key].markAsUntouched(); // Mark all as untouched
    });
}
