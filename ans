private editLocale(locale, name, desc) {
    console.log("editLocale called with ", locale, name, desc);

    // ✅ Find the existing row
    const existingRowIndex = this.tableWithSimpleEdit.datasource.data.findIndex(
        row => row.locale === locale
    );

    if (existingRowIndex !== -1) {
        // ✅ Update the existing row
        this.tableWithSimpleEdit.datasource.data[existingRowIndex] = {
            ...this.tableWithSimpleEdit.datasource.data[existingRowIndex], // Preserve other values
            displayName: name,
            description: desc
        };
        console.log("editLocale: Row updated at index", existingRowIndex);
    } else {
        // ✅ If row does not exist, add a new one
        console.log("editLocale: Adding a new row.");
        let updatedData = {
            id: this.lastModifiedIndex,
            locale: locale,
            action: EditTableAction.ADD,
            displayName: name,
            description: desc
        };

        this.tableWithSimpleEdit.datasource.data = [
            ...this.tableWithSimpleEdit.datasource.data,
            updatedData
        ];
        ++this.lastModifiedIndex;
    }

    // ✅ Trigger UI refresh
    setTimeout(() => {
        this.changeDetectorRef.detectChanges();
    }, 100);

    console.log("Updated Table Data:", this.tableWithSimpleEdit.datasource.data);
}
