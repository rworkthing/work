const existingRowIndex = this.tableWithSimpleEdit.datasource.data.findIndex(
    row => row.locale === locale
);
if (existingRowIndex !== -1) {
    console.log("✅ Updating existing row in editLocale:", locale);
    this.tableWithSimpleEdit.datasource.data[existingRowIndex].displayName = name;
    this.tableWithSimpleEdit.datasource.data[existingRowIndex].description = desc;
} else {
    console.log("✅ Adding new row in editLocale:", locale);
    this.tableWithSimpleEdit.datasource.data.push({ locale, displayName: name, description: desc });
}

// ✅ Force UI refresh
this.tableWithSimpleEdit.datasource.data = [...this.tableWithSimpleEdit.datasource.data];
this.changeDetectorRef.detectChanges();
