import { Component, NO_ERRORS_SCHEMA, ViewChild } from '@angular/core';
import { TranslateService } from '@ngx-translate/core';
import { BodTableComponent, BodTableMetadata, PageMode, ModeOptions, SingleRowEdit, BodTableAction, PageAction } from '@bod/common';
import { MatTableDataSource } from '@angular/material/table';
import { FormBuilder, FormArray, FormGroup } from '@angular/forms';
import { Subscription } from 'rxjs';

@Component({
  selector: 'bod-template-settings',
  standalone: true,
  templateUrl: './template-settings.component.html',
  styleUrl: './template-settings.component.scss',
  schemas: [NO_ERRORS_SCHEMA],
})
export class TemplateSettingsComponent {
  @ViewChild('simpleEditTableRef', { static: false }) simpleEditTableRef: BodTableComponent;
  public tableWithSimpleEdit: BodTableMetadata;
  public pageModeSimple = PageMode.INQUIRY;
  public modeOptionsSimple: ModeOptions = { input: false, reset: false };
  public singleRowEdit: SingleRowEdit = { modeOptions: { input: false, reset: false }, index: -1 };
  public tableForm: FormGroup;
  private subscriptions: Subscription = new Subscription();

  constructor(private translate: TranslateService, private fb: FormBuilder) {
    this.tableForm = this.fb.group({ rows: this.fb.array([]) });
    this.tableWithSimpleEdit = {
      columns: [
        { name: 'locale', title: 'Locale', width: 12 },
        { name: 'displayName', title: 'Display Name', width: 6 },
        { name: 'description', title: 'Description', width: 12 }
      ],
      datasource: new MatTableDataSource([]),
      noRecordsMessage: 'No records found.'
    };
  }

  ngOnInit(): void {
    this.initializeTable();
  }

  get rows(): FormArray {
    return this.tableForm.get('rows') as FormArray;
  }

  initializeTable() {
    this.tableWithSimpleEdit.datasource.data.forEach(row => this.addRow(row));
  }

  addRow(row?: any) {
    const newRow = this.fb.group({
      id: [row?.id || this.rows.length + 1],
      locale: [row?.locale || ''],
      displayName: [row?.displayName || ''],
      description: [row?.description || '']
    });
    this.rows.push(newRow);
    this.updateTableData();
  }

  addTableData() {
    this.addRow();
    this.modeOptionsSimple.input = true;
    this.pageModeSimple = PageMode.INPUT;
  }

  updateTableData() {
    this.tableWithSimpleEdit.datasource.data = this.rows.controls.map(control => control.value);
    this.tableWithSimpleEdit.datasource = new MatTableDataSource(this.tableWithSimpleEdit.datasource.data);
  }

  updateColumnData(columnName: string, value: any, index: number) {
    this.rows.at(index).get(columnName)?.setValue(value);
    this.rows.at(index).markAsDirty();
    this.updateTableData();
  }

  saveTableData() {
    console.log('Saved Data:', this.tableWithSimpleEdit.datasource.data);
    this.rows.controls.forEach(control => control.markAsPristine());
  }

  reset() {
    this.rows.clear();
    this.initializeTable();
  }

  handleRowLevelActions(action: string, index: number) {
    if (action === 'save') {
      this.singleRowEdit = { modeOptions: { input: false, reset: false }, index: -1 };
    } else if (action === 'reset') {
      this.rows.at(index).reset();
    }
  }

  onPageAction(event: PageAction) {
    if (event === PageAction.ADD) {
      this.addTableData();
    } else if (event === PageAction.EDIT) {
      this.modeOptionsSimple.input = true;
      this.pageModeSimple = PageMode.INPUT;
    } else {
      this.modeOptionsSimple.input = false;
      this.pageModeSimple = PageMode.INQUIRY;
    }
  }
}
