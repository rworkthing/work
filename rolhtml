})
export class CountersMultiselectTableComponent implements OnInit, OnChanges {

  public modeOptions: ModeOptions = { input: false, reset: false };
  public modeOptionsSimple = this.modeOptions;

  @Input() countersDataSingleSelect: BodTableMetadata;
  @Input() selectedRowSingleSelect: Counters[] = [];
  @Output() rowSelected = new EventEmitter<Counters[]>();
  @Output() defaultChanged = new EventEmitter<{ rowIndex: number, isDefault: boolean }>();
  @Output() dirtyChange = new EventEmitter<boolean>();
  @Input() formGroup: UntypedFormGroup;

  @ViewChild('countersMultiselectTable', { static: false })
  countersTable: BodTableComponent;

  private isDirty = false;

  classificationTypeOptions = [
    { label: 'Internal', value: 'Internal' },
    { label: 'External', value: 'External' },
    { label: 'Mixed', value: 'Mixed' }
  ];

  operatorTypeOptions = [
    { label: 'Increment', value: 'Increment' },
    { label: 'Decrement', value: 'Decrement' },
    { label: 'Reset', value: 'Reset' }
  ];

  ngAfterViewInit(): void {
    setTimeout(() => this.selectCountersRows(), 0);
  }

  ngOnChanges(changes: SimpleChanges): void {
    if (changes['selectedRowSingleSelect'] && this.selectedRowSingleSelect?.length) {
      console.log('📥 selectedRowSingleSelect changed:', this.selectedRowSingleSelect);
      setTimeout(() => this.selectCountersRows(), 0);
    }
  }

  public selectCountersRows(): void {
    const tableData = this.countersDataSingleSelect?.datasource?.data || [];
    const selection = this.countersTable?.selection;

    if (!selection || tableData.length === 0) {
      return;
    }

    selection.clear();

    tableData.forEach(dataRow => {
      const match = this.selectedRowSingleSelect.find(
        sel => sel.identifier === dataRow.identifier
      );
      if (match) {
        selection.select(dataRow);
      }
    });
  }

  public allowRowSelection = true;
  public rowSelectionStrategy: SelectPageMode = SelectPageMode.ALL_PAGES;
  public showEdit = true;
  public defaultForm: FormGroup;

  constructor(
    private fb: FormBuilder,
    private transactionTypeService: TransactionTypeService
  ) { }

  ngOnInit() {
    this.defaultForm = this.fb.group({});
  }

  public onClassificationTypeChange(element: any, value: string) {
    element.classificationType = value;
    this.setDirty(true);
  }

  public onOperatorTypeChange(element: any, value: string) {
    element.operatorType = value;
    this.setDirty(true);
  }

  private loadCounterData() {
    this.transactionTypeService.getCounters().subscribe((counters: any[]) => {
      this.countersDataSingleSelect.datasource.data = counters.map((item: any, index: number) => ({
        id: index + 1,
        code: item.code,
        classificationType: '',
        operatorType: '',
        default: false
      }));
    });
  }

  public resetSelection() {
    if (this.countersTable?.selection) {
      this.countersTable.selection.clear();
    }
    this.selectedRowSingleSelect = [];
    this.setDirty(false);
  }

  public rowSelectionSingleSelect(element: Counters[]) {
    console.log('rowSelectionSingleSelect called with:', element);
    this.selectedRowSingleSelect = element;
    this.rowSelected.emit(this.selectedRowSingleSelect);
    this.setDirty(true);
    this.dirtyChange.emit(true);
  }

  public rowSelection(element: Counters[]) {
    console.log('rowSelection called with:', element);
    if (element.length !== 0) {
      this.selectedRowSingleSelect = element;
    } else {
      this.selectedRowSingleSelect = [];
    }
    this.rowSelected.emit(this.selectedRowSingleSelect);
    this.setDirty(true);
    this.dirtyChange.emit(true);
    console.log('Counters selectedRowSingleSelect:', this.selectedRowSingleSelect);

    // Dynamically update validators for selected rows only
    this.updateValidatorsForSelectedRows();
  }

  private updateValidatorsForSelectedRows() {
    if (!this.formGroup) return;
    const controls = this.formGroup.controls;

    // Remove required validator from all controls
    Object.keys(controls).forEach(key => {
      if (key.startsWith('operatorType_')) {
        controls[key].clearValidators();
        controls[key].updateValueAndValidity({ emitEvent: false });
      }
    });

    // Add required validator only for selected rows
    (this.selectedRowSingleSelect || []).forEach(row => {
      const controlName = 'operatorType_' + (row.id ?? '');
      if (controls[controlName]) {
        controls[controlName].setValidators([Validators.required]);
        controls[controlName].updateValueAndValidity({ emitEvent: false });
      }
    });
  }

  public onDefaultToggleChange(event: any, rowIndex: number) {
    const data = [...this.countersDataSingleSelect.datasource.data];
    const row = data.find(r => r.index === rowIndex);

    if (!row) return;

    if (event.checked) {
      data.forEach(item => {
        item.default = item.index === rowIndex;
      });
    } else {
      row.default = false;
    }

    this.countersDataSingleSelect.datasource.data = data;

    this.defaultChanged.emit({
      rowIndex: rowIndex,
      isDefault: event.checked
    });
  }

  private setDirty(dirty: boolean) {
    this.isDirty = dirty;
    this.dirtyChange.emit(this.isDirty);
  }
}


















