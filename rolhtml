<form [formGroup]="formGroup">
    <bod-table
      #countersMultiselectTable
      [data]="countersDataSingleSelect"
      (onRowSelect)="rowSelection($event)"
      [rowSelectionStrategy]="rowSelectionStrategy"
      [allowSelectAll]="allowRowSelection"
      [alignContent]="'top'"
      [customColumnTemplates]="[
        { columnName: 'operatorType', templateName: operatorTypeTemplate }
      ]"
      [modeOptions]="{selection: true }"
    >
    
      <ng-template
        #operatorTypeTemplate
        let-element="element"
        let-column="column"
        let-index="index"
      >
      <mat-form-field appearance="outline" fisStyle style="width: 120px;">
        <mat-select
          [formControlName]="'operatorType_' + (element.id ?? index)"
          (selectionChange)="onOperatorTypeChange(element, $event.value)"
          panelClass="fis-style"
          name="operatorType"
          (click)="$event.stopPropagation()"
        >
            <mat-option *ngFor="let option of operatorTypeOptions" [value]="option.value">
              {{ option.label }}
            </mat-option>
          </mat-select>
          <mat-error *ngIf="formGroup.get('operatorType_' + (element.id ?? index))?.hasError('required') && formGroup.get('operatorType_' + (element.id ?? index))?.touched">
            Required field
          </mat-error>
        </mat-form-field>
      </ng-template>
    </bod-table>
    </form>













