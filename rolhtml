@Component({
  selector: 'bod-counters-multiselect-dialog',
  standalone: true,
  imports: [
    CountersMultiselectTableComponent,
    ReactiveFormsModule,
    BodFormModule,
    FormsModule,
    BodAutoCompleteModule,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    BodCommonModule
  ],
  templateUrl: './counters-multiselect-dialog.component.html',
  styleUrls: ['./counters-multiselect-dialog.component.scss']
})
export class CountersMultiselectDialogComponent {
  public translationKey = TranslationKey;

  formType: BodFormTypes = BodFormTypes.FORM;
  @ViewChild('countersTable', { static: false }) countersTable: CountersMultiselectTableComponent;
  @Output() rowSelected = new EventEmitter<CounterTable[]>();
  public initialSelectedRows: Counters[] = [];
  selectedRows: Counters[] = [];
  public addCountersFormGroup: UntypedFormGroup;
  isDirty = false;

  constructor(
    public dialogRef: MatDialogRef<CountersMultiselectDialogComponent>,
    @Inject(MAT_DIALOG_DATA) public data: any,
    private fb: UntypedFormBuilder
  ) {
    this.initForm();
    // Store initial selection for reset
    this.initialSelectedRows = [...(data.selectedRowSingleSelect || [])];
    this.selectedRows = [...this.initialSelectedRows];
  }

  private initForm(): void {
    const controls: { [key: string]: any } = {};
    // Always get the latest data
    const allRows = this.data?.countersDataSingleSelect?.datasource?.data || [];
    allRows.forEach((row: any, idx: number) => {
     
      controls['operatorType_' + row.id] = [row.operatorType || null];
    });
    this.addCountersFormGroup = this.fb.group(controls);
    console.log('Dialog initForm - Form controls:', Object.keys(controls));
  }

  ngOnChanges(changes: SimpleChanges) {
    if (changes['data'] || changes['counterData']) {
      this.initForm();
    }
  }

  onTableDirtyChange(dirty: boolean) {
    this.isTableDirty = true;
    this.addCountersFormGroup.markAsDirty();
  }

  public isTableDirty = false;
  @Output() tableDirty = new EventEmitter<void>(); // <-- ADD THIS

  public onTableDirty(): void {
    this.isTableDirty = true;
    this.addCountersFormGroup.markAsDirty();
    this.tableDirty.emit();
  }

  onRowSelected(selectedRows: Counters[]) {
    console.log('onRowSelected called with:', selectedRows);
    this.selectedRows = selectedRows;
    this.isDirty = true;
    this.addCountersFormGroup.markAsDirty(); // <-- Add this line
    // this.initForm();
  }

  onSubmit() {
    if (this.addCountersFormGroup.invalid) {
      this.addCountersFormGroup.markAllAsTouched();
      return; // Prevent closing the dialog
    }
    // Pass the selectedRows object when closing the dialog
    this.dialogRef.close({ selectedCounters: this.selectedRows });
  }

 onReset() {
  this.isDirty = false;
  // Restore to initial selection instead of clearing all
  this.selectedRows = [...this.initialSelectedRows];

  // Use identifier for matching
  Object.keys(this.addCountersFormGroup.controls).forEach(key => {
    const rowId = Number(key.replace('operatorType_', ''));
    // Find the table row by id
    const tableRow = this.data.countersDataSingleSelect?.datasource?.data.find(row => row.id === rowId);
    // Find the initial row by identifier
    const initialRow = this.initialSelectedRows.find(row => row.identifier === tableRow?.identifier);
    this.addCountersFormGroup.get(key)?.setValue(initialRow ? initialRow.operatorType : null);
  });

  // Also clear selection in the child table and re-select initial rows
  if (this.countersTable) {
    this.countersTable.resetSelection();
    setTimeout(() => {
      this.countersTable.selectedRowSingleSelect = [...this.initialSelectedRows];
      this.countersTable.selectCountersRows?.();
    }, 0);
  }
}
}
