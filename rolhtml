  getPostingSTD(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get(`${this.pstgSTDUrl}`, { headers });
  }
  getRelationshipType(): Observable<any> {
    const headers = this.createHeaders();

    return this.http.get(`${this.rltnpUrl}`, { headers });
  }

  // saveBalanceType(request: any): Observable<any> {
  //   const headers = this.createHeaders();
  //   return this.http.post(this.saveUrl, request, { headers });
  // }

  retrieveBalanceType(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<BalanceTypeList[]>(this.retrieveUrl, { headers });
  }
  deleteBalanceType(
    metadataConfigType: string,
    metadataConfigIdfr: number
  ): Observable<any> {
    const headers = this.createHeaders();
    const params = {
      'metadata-config-type': metadataConfigType,
      'metadata-config-idfr': metadataConfigIdfr
    };

    return this.http.delete(this.deleteUrl, { headers, params });
  }
  updateBalanceType(request: any): Observable<any> {
    const headers = this.createHeaders();
    return this.http.put(this.updateUrl, request, { headers });
  }

  generateUUID(): string {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(
      /[xy]/g,
      function (c) {
        const r = (Math.random() * 16) | 0,
          v = c === 'x' ? r : (r & 0x3) | 0x8;
        return v.toString(16);
      }
    );
  }

  public getExpandedaggregateData(
    element: AggregateSampleTable
  ): Observable<InquiryLayoutInput[]> {
    const groups: InquiryLayoutInput[] = [];
    let setIsLink = false;
    for (let i = 0; i < element.aggregates.length; i++) {
      //setIsLink = !setIsLink;
      groups.push({
        id: element.aggregates[i].id,
        label: element.aggregates[i].label,
        value: element.aggregates[i].value,
        isLink: setIsLink
      });
    }

    const $groups = new BehaviorSubject<InquiryLayoutInput[]>(groups);

    return $groups;
  }

