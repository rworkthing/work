<bod-page-container
  [pageMode]="pageModeSimple"
  (pageAction)="onPageAction($event)"
  [messages]="messages"
  *ngIf="showEdit"
>
  <bod-table
    [data]="tableWithSimpleEdit"
    [tableActions]="showActionsForSimple ? actionsForSimple : []"
    [modeOptions]="modeOptionsSimple"
    [singleRowEdit]="singleRowEdit"
    [customColumnTemplates]="[
      { columnName: 'channel', templateName: channelTemplate1 },
      { columnName: 'option', templateName: optionTemplate1 },
      { columnName: 'actions', templateName: editActionsTemplate1 }
    ]"
    (inputValidationStatus)="checkStatus($event)"
    (editTableEvent)="onEditTableAction($event)"
    (onTableActionClick)="addTableData()"
    [primaryColumnName]="'id'"
    #simpleEditTableRef
    [expandedRowTemplate]="expandedRowTemplate1"
    [inlineModal]="{
      formGroup: addNewChannelForm,
      formTemplateName: addNewChannelTemplate
    }"
    (onInlineFormEditSubmit)="onAddChannel($event)"
  >
    <ng-template #channelTemplate1 let-element="element" let-column="column">
      <span>{{ element.channel }}</span>
    </ng-template>
    <ng-template
      #optionTemplate1
      let-element="element"
      let-column="column"
      let-index="index"
    >
      <mat-form-field appearance="outline" fisStyle style="min-width: 120px">
        <mat-select
          panelClass="fis-style"
          [(ngModel)]="element.option"
          #optionModel="ngModel"
          [ngModelOptions]="{ updateOn: 'change' }"
          (ngModelChange)="onValueChange()"
          required
          (click)="$event.stopPropagation()"
        >
          <mat-option
            *ngFor="let opt of column.inputModeOptions.model"
            [value]="opt.value"
          >
            {{ opt.label }}
          </mat-option>
        </mat-select>
      </mat-form-field>
    </ng-template>

    <ng-template
      #editActionsTemplate1
      let-element="element"
      let-column="column"
      let-index="index"
    >
      <bod-table-actions
        [actions]="rowLevelActionsForBasicEdit"
        (onActionClick)="handleRowLevelActions($event.icon, index)"
      >
      </bod-table-actions>
    </ng-template>
  </bod-table>
  <!-- ...existing code... -->
  <form [formGroup]="addNewChannelForm">
    <ng-template #addNewChannelTemplate>
      <bod-input-layout col="2">
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.attributeForChannel'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <mat-select
              panelClass="fis-style"
              formControlName="attributeForChannel"
              name="attributeForChannel"
              required
            >
              <mat-option
                *ngFor="let attributeForChannel of attributeForChannels"
                [value]="attributeForChannel.value"
              >
                {{ attributeForChannel.label }}
              </mat-option>
            </mat-select>
          </mat-form-field>
        </bod-control-group>
      </bod-input-layout>

      <!-- Counters Table -->
      <bod-table
        #counterTable
        [data]="counterData"
        [tableActions]="actionsForChannels"
        (onTableActionClick)="addTableData()"
        [modeOptions]="modeOptionsSimple"
        [singleRowEdit]="singleRowEdit"
        (onRowSelect)="rowSelection($event)"
        [rowSelectionStrategy]="rowSelectionStrategy"
        [alignContent]="'top'"
        [customColumnTemplates]="[
          { columnName: 'option', templateName: optionTemplate }
        ]"
        [modeOptions]="{ selection: true }"
      >
        <ng-template
          #optionTemplate
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <mat-form-field appearance="outline" fisStyle style="width: 120px">
            <mat-select
              [formControlName]="'option_' + (element.id ?? index)"
              (selectionChange)="onOptionChange(element, $event.value)"
              panelClass="fis-style"
              name="option"
              (click)="$event.stopPropagation()"
            >
              <mat-option *ngFor="let option of options" [value]="option.value">
                {{ option.label }}
              </mat-option>
            </mat-select>
          </mat-form-field>
        </ng-template>
      </bod-table>
      <!-- End counters table -->
    </ng-template>
  </form>
</bod-page-container>
