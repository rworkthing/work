// 6. Example service method to save condition relationships:
export class ServiceElementService {
  
  saveServiceElementWithConditions(serviceElementData: any): Observable<any> {
    const payload = {
      serviceElement: {
        // ... service element basic data
        name: serviceElementData.name,
        description: serviceElementData.description,
        // ... other fields
      },
      conditionRelationships: serviceElementData.conditionRelationships?.map(rel => ({
        conditionCode: rel.conditionCode,
        optionality: rel.optionality,
        // Add any additional mapping as needed
      })) || []
    };

    return this.http.post(`${this.apiUrl}/service-elements`, payload);
  }
}

// 7. Example of form validation that includes condition relationships:
export class ServiceElementFormValidator {
  
  static validateServiceElementForm(formData: any): ValidationResult {
    const errors: string[] = [];
    
    // Validate condition relationships
    if (formData.conditionRelationships) {
      const conditionErrors = this.validateConditionRelationships(formData.conditionRelationships);
      errors.push(...conditionErrors);
    }
    
    return {
      isValid: errors.length === 0,
      errors: errors
    };
  }
  
  private static validateConditionRelationships(relationships: ServiceElementCondTable[]): string[] {
    const errors: string[] = [];
    
    // Check for duplicates
    const conditionCodes = relationships.map(r => r.conditionCode);
    const duplicates = conditionCodes.filter((code, index) => conditionCodes.indexOf(code) !== index);
    
    if (duplicates.length > 0) {
      errors.push(`Duplicate conditions found: ${duplicates.join(', ')}`);
    }
    
    // Check for empty required fields
    relationships.forEach((rel, index) => {
      if (!rel.conditionCode) {
        errors.push(`Condition is required for row ${index + 1}`);
      }
      if (!rel.optionality) {
        errors.push(`Optionality is required for row ${index + 1}`);
      }
    });
    
    return errors;
  }
}

interface ValidationResult {
  isValid: boolean;
  errors: string[];
}






















