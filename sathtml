          [truncate]="false"
          [label]="translationKey + 'metadataconfig.othercurrency'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="othercurrency"
            name="othercurrency"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.reverse'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="reverse"
            name="reverse"
          >
          </mat-slide-toggle>
        </bod-control-group>
      </bod-input-layout>
    </ng-template>
