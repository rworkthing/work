  // Data for the condition relationship table
  public serviceElementConditionData: ServiceElementCondTable[] = [];
  
  // ViewChild reference to access the component methods
  @ViewChild('serviceElementConditionRef') 
  serviceElementConditionRef: ServiceElementConditionRelationshipComponent;

  // Handle when table data changes
  public onServiceElementConditionChange(data: ServiceElementCondTable[]) {
    this.serviceElementConditionData = data;
    console.log('Service Element Condition Relationship Data:', data);
    
    // Mark form as dirty or handle validation
    this.markFormAsDirty();
  }

  // Handle when table becomes dirty (user made changes)
  public onServiceElementConditionTableDirty(isDirty: boolean) {
    if (isDirty) {
      this.markFormAsDirty();
    }
  }

  // Method to get current condition relationship data
  public getCurrentServiceElementConditionData(): ServiceElementCondTable[] {
    return this.serviceElementConditionRef?.getCurrentTableData() || [];
  }

  // Method to reset the condition relationship table
  public resetServiceElementConditionTable() {
    this.serviceElementConditionRef?.resetTableForm();
    this.serviceElementConditionData = [];
  }

  // Method to validate condition relationships
  public validateConditionRelationships(): boolean {
    const data = this.getCurrentServiceElementConditionData();
    
    // Check for duplicate conditions
    const conditionCodes = data.map(item => item.conditionCode);
    const hasDuplicates = conditionCodes.length !== new Set(conditionCodes).size;
    
    if (hasDuplicates) {
      console.error('Duplicate conditions found in service element condition relationships');
      return false;
    }

    // Check if all required fields are filled
    const hasEmptyFields = data.some(item => !item.conditionCode || !item.optionality);
    if (hasEmptyFields) {
      console.error('Some condition relationships have empty required fields');
      return false;
    }

    return true;
  }

  // Example of form submission with condition relationship data
  public onSubmitForm() {
    if (!this.validateConditionRelationships()) {
      return;
    }

    const formData = {
      // ... your other form data
      conditionRelationships: this.getCurrentServiceElementConditionData(),
    };

    // Submit your form data
    console.log('Submitting form with condition relationships:', formData);
  }

  private markFormAsDirty() {
    // Implement your form dirty logic here
    console.log('Form marked as dirty due to condition relationship changes');
  }
}

