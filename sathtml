  <bod-table
    #aggregateTable
    [data]="aggregateTabledata"
    [tableActions]="aggregateTableActions"
    (onTableActionClick)="onValidTableActionClicked($event)"
    [expandedRowTemplate]="expandedRowTemplate"
    [inlineModal]="{
      addNewInlineRowTitle: 'New Aggregate Value' | translate,
      formGroup: aggregateForm,
      formTemplateName: aggregateTemplate
    }"
    (onInlineFormAddSubmit)="onAddAggregate(aggregateForm.value)"
    (onInlineFormEditSubmit)="onAddAggregate(aggregateForm.value)"
    (onInlineEditRowActionClick)="inlineEditRowActionClick($event)"
    (onInlineAddRowActionClick)="inlineAddRowActionClick()"
    [customColumnTemplates]="[
      {
        columnName: 'actions',
        templateName: deleteaggegateActionTemplate
      }
    ]"
    [alignContent]="'top'"
  >
    <ng-template
      #deleteaggegateActionTemplate
      let-element="element"
      let-column="column"
      let-index="index"
    >
      <bod-table-actions
        [actions]="rowLevelActionsForBasicEdit"
        (onActionClick)="handleRowLevelActionsforaggergate($event.icon, index)"
      >
      </bod-table-actions>
    </ng-template>
    <ng-template #expandedRowTemplate let-context="context">
      <div fullwidth>
        <bod-inquiry-layout
          [columns]="2"
          [groups]="
            balanceTypeService.getExpandedaggregateData(context.element)
          "
          [softSeparator]="false"
          [direction]="direction"
          [information]="[]"
          (linkClick)="commonDataService.inquiryLayoutClick($event)"
        >
        </bod-inquiry-layout>
      </div>
    </ng-template>
  </bod-table>
