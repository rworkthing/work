onAdd(formValues: any) {
    if (this.inputLayoutForm.invalid) {
      // alert('Please fill all the required fields.');
      return;
    }
    this.dataWithValidvalues = this.dataWithValidvalues || [];
    const newValidValue: BodSampleTable1 = {
      additionaldatavalue: formValues.additionaldatavalue || '',
      defaultindicator: formValues.defaultindicator ?? false,
      primaryindicator: formValues.primaryindicator ?? false,
      overrideindicator: formValues.overrideindicator ?? false,
      percentagevalue: formValues.percentagevalue ?? null,
      sequencenumber: formValues.sequencenumber ?? null
    };

    this.dataWithValidvalues.push(newValidValue);
    if (this.ValidvalueArray && this.ValidvalueArray.datasource) {
      this.ValidvalueArray.datasource.data = [...this.dataWithValidvalues];
    } else {
      this.inputLayoutForm.reset();
      // this.changeDetectorRef.detectChanges();
      // alert('Valid values added successfully!');
    }
    this.changeDetectorRef.detectChanges();
    this.inputLayoutForm.reset();
  }
