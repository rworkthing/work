    [retainedChargeBaseForExt]="retainedChargeBaseForExt"
    [retainedPersistedForExt]="retainedPersistedForExt"
    [retainedCalculatedForExt]="retainedCalculatedForExt"
    [retainedAutoCreationForExt]="retainedAutoCreationForExt"
    [retainedLogHistoryForExt]="retainedLogHistoryForExt"
    [retainedDailySnapshotForExt]="retainedDailySnapshotForExt"
    [retainedInquiryRequiredForExt]="retainedInquiryRequiredForExt"
    [retainedGenerateFinancialResultsForExt]="retainedGenerateFinancialResultsForExt"
    [retainedGLMappingForExt]="retainedGLMappingForExt"
    [retainedSummaryRequiredForExt]="retainedSummaryRequiredForExt"
  >
  </bod-existing-balance-type>
</ng-template>
