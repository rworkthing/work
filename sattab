      obj.aggregates = element.aggregateInquiry1.map(aggr => ({
        id: aggr.id,
        label: aggr.label,
        value: aggr.value
      }));
      this.exstAggregateTabledata.datasource.data.push(obj);
      this.dataWithAggregatevalues.push(obj);
    });
    if (this.exstAggregateForm) {
      // Store the current balanceTypeCode
      const currentBalanceTypeCode =
        this.addExistingBalanceTypeFormGroup.get('exstcode')?.value;

      // Reset the form
      this.exstAggregateForm.reset();

      // Set aggregationname to the stored balanceTypeCode
      this.exstAggregateForm
        .get('aggregationname')
        ?.setValue(currentBalanceTypeCode);
    }
    this.isEdit = true;
  }
