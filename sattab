  transactionTypeForm(element: TransactionTypeList) {
    console.log('transactionTypeForm element:', JSON.stringify(element, null, 2));
    this.isAdd = false;

    const postingCategories =
      Array.from(
        new Set(
          element.productTypePostingSTDCategoryRltnpList
