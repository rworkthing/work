  onAddRoleType(formValues: any) {
    this.errorMessages = [];
  
    // Apply validator dynamically
    this.exstRoleTypeForm.setValidators([
      this.duplicateRoleTypeValidator(this.dataWithRoleTypevalues, this.roletypes)
    ]);
    this.exstRoleTypeForm.updateValueAndValidity();
  
    if (this.exstRoleTypeForm.invalid) {
      const errors = this.exstRoleTypeForm.errors;
      const duplicateValue = errors?.['duplicateRoleType'];
  
      if (duplicateValue) {
        this.handleError1({
          errorCode: 'ROLE_TYPE_ALREADY_EXISTS',
          status: 400,
          duplicateValue
        });
      }
      return;
    }
  
    const selectedRoleType = this.roletypes.find(
      item => item.value === formValues.exstRoletype
    );
    const roleTypeCode = selectedRoleType ? selectedRoleType.label : '';
  
    const selectedAccountClassification = this.exstaccntclassifications.find(
      item => item.value === formValues.exstRoleaccountclassification
    );
    const accountClassificationCode = selectedAccountClassification
      ? selectedAccountClassification.label
      : '';
  
    const newValidValue: RoleTypeSampleTable = {
      type: roleTypeCode || '',
      accountingClassification: accountClassificationCode ?? '',
      obligator: formValues.exstObligator ? 'Y' : 'N',
      beneficiary: formValues.exstBeneficiary ? 'Y' : 'N',
      visibility: formValues.exstIsvisible ? 'Y' : 'N'
    };
  
    this.dataWithRoleTypevalues.push(newValidValue);
  
    if (this.exstRoleTypetabledata && this.exstRoleTypetabledata.datasource) {
      this.exstRoleTypetabledata.datasource.data = [
        ...this.dataWithRoleTypevalues
      ];
    }
  
    this.changeDetectorRef.detectChanges();
    this.exstRoleTypeForm.reset();
    this.addExistingBalanceTypeFormGroup.markAsDirty();
  }
  
  private handleError1(error: any) {
    let errorMsg = '';
    switch (error.errorCode) {
      case 'ROLE_TYPE_ALREADY_EXISTS':
        errorMsg = `Role type "${error.duplicateValue}" already exists.`;
        break;
      default:
        errorMsg = 'Unknown error occurred.';
    }
  
    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };
    this.errorMessages2.push(this.message);
  
    setTimeout(() => {
      this.errorMessages2 = this.errorMessages2.filter(
        msg => msg.text !== errorMsg
      );
    }, 20000);
  }
  
