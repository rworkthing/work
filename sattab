  nonNegativeValidator(): ValidatorFn {
    return (control: AbstractControl): { [key: string]: any } | null => {
      const value = control.value;
      return value < 0 ? { negativeValue: { value: value } } : null;
    };
  }
  duplicateRoleTypeValidator(existingValues: any[], roletypes: any[]): ValidatorFn {
    return (group: AbstractControl): ValidationErrors | null => {
      const roleTypeControl = group.get('exstRoletype');
      if (!roleTypeControl) return null;
  
      const selectedRoleType = roletypes.find(
        item => item.value === roleTypeControl.value
      );
      const roleTypeLabel = selectedRoleType ? selectedRoleType.label : '';
  
      const isDuplicate = existingValues.some(item => item.type === roleTypeLabel);
  
      if (isDuplicate) {
        roleTypeControl.setErrors({ duplicateRoleType: roleTypeLabel });
        return { duplicateRoleType: roleTypeLabel };
      } else {
        if (roleTypeControl.hasError('duplicateRoleType')) {
          const errors = { ...roleTypeControl.errors };
          delete errors['duplicateRoleType'];
          roleTypeControl.setErrors(Object.keys(errors).length ? errors : null);
        }
        return null;
      }
    };
  }
  
  maxValueValidator(maxValue: number): ValidatorFn {
    return (control: AbstractControl): { [key: string]: any } | null => {
      const value = control.value;
      return value > maxValue ? { maxValueExceeded: { value: value } } : null;
    };
  }

