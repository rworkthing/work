  public getTransactionTypeData(
    element: TransactionTypeList
  ): Observable<InquiryLayoutInput[]> {
    const groups: InquiryLayoutInput[] = [];
    let setIsLink = false;
    for (let i = 0; i < element.transactionTypeInquiry.length; i++) {
      //setIsLink = !setIsLink;
      groups.push({
        id: element.transactionTypeInquiry[i].id,
        label: element.transactionTypeInquiry[i].label,
        value: element.transactionTypeInquiry[i].value,
        isLink: setIsLink
      });
    }

    const $groups = new BehaviorSubject<InquiryLayoutInput[]>(groups);

    return $groups;
  }

