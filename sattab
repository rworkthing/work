    const balTypeIdentifier = selectedBalance?.value || selectedBalanceCode;
    const balTypeLabel = selectedBalance?.label || selectedBalanceCode;
    const productTypeIdentifiers = this.metadataService.getProductTypeValues();

// 1. balanceAggregationInsertionList
const balanceAggregationInsertionList =
  this.dataWithAggregatevalues.length > 0
    ? this.dataWithAggregatevalues.map((item, index) => {
        const productType = this.producttypes.find(
          pt =>
            pt.label ===
            item.aggregates.find(aggregate => aggregate.label === 'Product Type')?.value
        )?.value;
        const debitTransactionType = this.debittransactiontypes.find(
          dt =>
            dt.label ===
            item.aggregates.find(aggregate => aggregate.label === 'Debit Transaction Type')?.value
        )?.value;
        const creditTransactionType = this.credittransactiontypes.find(
          ct =>
            ct.label ===
            item.aggregates.find(aggregate => aggregate.label === 'Credit Transaction Type')?.value
        )?.value;
        const otherCurrency = item.aggregates.find(aggregate => aggregate.label === 'Other Currency')?.value;
        const reverse = item.aggregates.find(aggregate => aggregate.label === 'Reverse')?.value;
        const balanceTypeIdentifier = this.balancetypes.find(bt => bt.label === item.balancetype)?.value;

        return {
          balanceTypeIdentifier: balanceTypeIdentifier || null,
          productTypeIdentifier: productTypeIdentifiers[index] ?? null,
          name: item.aggregationname,
          productTypeAggrIdfr: productType || null,
          aggrBalanceTypeIdentifier: balanceTypeIdentifier || null,
          relationshipType: this.relationshiptypes.find(rt => rt.label === item.relationshiptype)?.value || null,
          relationshipTypeCode: item.relationshiptype,
          aggregationLevel: item.aggregationLevel ?? null,
          balanceTypeCode: item.balancetype,
          otherCurrencyAggregation: otherCurrency === 'Y' ? 'Y' : 'N',
          reverseAggregation: reverse === 'Y' ? 'Y' : 'N',
          postingStandardIdentifierForDebit: debitTransactionType || null,
          postingStandardIdentifierForCredit: creditTransactionType || null
        };
      })
    : [];

// 2. productTypeBalanceTypeRelationshipList
const productTypeBalanceTypeRelationshipList = productTypeIdentifiers.map(id => ({
  identifier: id,
  balanceTypeIdentifier: balTypeIdentifier,
  balanceTypeCode: balTypeLabel,
  persisted: formValue.exstpersisted ? 'Y' : 'N',
  calculated: formValue.exstcalculated ? 'Y' : 'N',
  autoCreated: formValue.exstautocreation ? 'Y' : 'N',
  statementProcess: formValue.exststatementdisplay ? 'Y' : 'N',
  accountingClassification: formValue.exstaccntclassification,
  snapshotRequired: formValue.exstdailysnapshot ? 'Y' : 'N',
  payerIdentifier: formValue.exstpayer,
  payeeIdentifier: formValue.exstpayee,
  chargeCalculation: formValue.exstchargebase ? 'Y' : 'N',
  logAudit: formValue.exstloghistory ? 'Y' : 'N',
  financialResultRequired: formValue.exstgeneratefinancialresults ? 'Y' : 'N',
  glRequired: formValue.exstglmapping ? 'Y' : 'N',
  dateValue: formValue.exstdatevalue,
  enquiryRequired: formValue.exstinquiryrequired ? 'Y' : 'N',
  summaryRequired: formValue.exstsummaryrequired ? 'Y' : 'N'
}));


 // 3. productTypeBalanceSubTypeRelationshipList


    const productTypeBalanceSubTypeRelationshipList: ProductTypeBalanceSubTypeRelationship[] = [];

    formValue.balsubtype.forEach((subtype: string) => {
      const selectedBalanceType = this.subBalancetypes.find(item => item.label === subtype);

      productTypeIdentifiers.forEach((productTypeIdentifier: any) => {
        productTypeBalanceSubTypeRelationshipList.push({
          productTypeIdentifier: productTypeIdentifier ?? null,
          balanceTypeIdentifier: balTypeIdentifier,
          balanceSubTypeIdentifier: selectedBalanceType?.value ?? null,
          balanceSubTypeCode: selectedBalanceType?.label ?? null
        });
      });
    });

    // 4. productTypeBalanceTypePeriodList

    let productTypeBalanceTypePeriodList: ProductTypeBalanceTypePeriod[] = [];

    if (formValue.balperiodtype && formValue.balperiodtype.length > 0) {
      productTypeBalanceTypePeriodList = [];
      formValue.balperiodtype.forEach((periodType: string) => {
        productTypeIdentifiers.forEach((productTypeIdentifier: any) => {
          productTypeBalanceTypePeriodList.push({
            productTypeIdentifier: productTypeIdentifier ?? null,
            balanceTypeIdentifier: balTypeIdentifier,
            periodType: periodType
          });
        });
      });
    }
    
// 5. productTypeBalanceTypeRoletypeRelationshipList
const productTypeBalanceTypeRoletypeRelationshipList =
  this.dataWithRoleTypevalues.length > 0
    ? this.dataWithRoleTypevalues.map((roleType, index) => ({
        productTypeIdentifier: productTypeIdentifiers[index] ?? null,
        balanceTypeIdentifier: balTypeIdentifier,
        roleType: this.roletypes.find(rt => rt.label === roleType.type)?.value,
        roleTypeCode: roleType.type,
        accountingClassification: this.exstaccntclassifications.find(
          ac => ac.label === roleType.accountingClassification
        )?.value,
        accountingClassificationCode: roleType.accountingClassification,
        visible: roleType.visibility === 'Y' ? 'Y' : 'N',
        payee: roleType.beneficiary === 'Y' ? 'Y' : 'N',
        payer: roleType.obligator === 'Y' ? 'Y' : 'N'
      }))
    : [];

// 6. productTypeList
const productTypeKeys = this.metadataService.getProductTypeKeys();
    const productTypeValues = this.metadataService.getProductTypeValues();
// 7. Final balanceTypeData
const balanceTypeData = {
  metadataType: 'BalanceType',
  balanceTypeList: [
    {
      balanceAggregationInsertionList,
      productTypeBalanceTypeRelationshipList,
      productTypeBalanceSubTypeRelationshipList,
      productTypeBalanceTypePeriodList,
      productTypeBalanceTypeRoletypeRelationshipList
    }
  ],
  productTypeList: productTypeKeys.map((code, index) => ({
    identifier: productTypeValues[index],
    code: code
  }))
};

    if (productTypeBalanceTypeRoletypeRelationshipList.length === 0) {
      this.handleError(
        {
          errorCode: 'ROLE_TABLE_EMPTY',
          status: 409
        },
        isAdd
      );
      return;
    }
    console.log('balance Data:', JSON.stringify(balanceTypeData, null, 2));
    const serviceCall = isAdd
      ? this.balanceTypeService.saveBalanceType(balanceTypeData)
      : this.balanceTypeService.updateBalanceType(balanceTypeData);

    serviceCall.subscribe({
      next: resp => this.successResponse(resp, balanceTypeData, isAdd),
      error: (err: NotificationMessage[]) => this.handleError(err, isAdd)
    });
    // this.addNewBalanceTypeFormGroup.controls['balTypeIdentifier'].disable();
  }
  private successResponse(resp, _balanceTypeData, isAdd) {
    const balanceTypeCode =
      _balanceTypeData.balanceTypeList[0]
        .productTypeBalanceTypeRelationshipList[0].balanceTypeCode;
    const SuccessMsg = isAdd
      ? `${balanceTypeCode} Added successfully`
      : `${balanceTypeCode} Updated successfully`;
    this.apiResponse.emit({ ..._balanceTypeData, SuccessMsg });
  }
  private handleError(error: any, isAdd: boolean) {
    let errorMsg = 'Balance Type Code already exists.';
    if (error.errorCode === 'MBP_SDK_BUS_ERR_005') {
      errorMsg = 'Code already exists.';
    }else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_004") {
      errorMsg = error.error?.errorDescription || 'Code already exists.';
    } else if (error.status === 400) {
      errorMsg = 'Please fill the Role Type fields.';
    }else if (error.errorCode === 'ROLE_TABLE_EMPTY') {
      errorMsg = 'AtLeast One Role Type is required.';
    }else {
      errorMsg = 'Unknown error occurred.';
    }
    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };
    this.errorMessages.push(this.message);
    // setTimeout(() => {
    //   this.errorMessages = this.errorMessages.filter(
    //     msg => msg.text !== errorMsg
    //   );
    // }, 20000);
  }
  onReset(isAdd: boolean): void {
    const isEditMode = this.isEdit;


    if (isEditMode) {
      // Restore 'code' value and keep it disabled
      this.addExistingBalanceTypeFormGroup.get('exstcode')?.setValue(this.retainedCodeForExt);
      this.addExistingBalanceTypeFormGroup.get('exstcode')?.disable();
      this.addExistingBalanceTypeFormGroup.get('roleTypeIdentifier')?.setValue(this.retainedIdentifierForExt);
      this.addExistingBalanceTypeFormGroup.get('roleTypeIdentifier')?.disable();
      this.addExistingBalanceTypeFormGroup.get('exstaccntclassification')?.setValue(this.retainedAccountClassificationForExt);
      this.addExistingBalanceTypeFormGroup.get('exstdatevalue')?.setValue(this.retainedDateValueForExt);
      this.addExistingBalanceTypeFormGroup.get('exstpayer')?.setValue(this.retainedPayerForExt);
      this.addExistingBalanceTypeFormGroup.get('exstpayee')?.setValue(this.retainedPayeeForExt);
      this.addExistingBalanceTypeFormGroup.get('exststatementdisplay')?.setValue(this.retainedStatementDisplayForExt);
      this.addExistingBalanceTypeFormGroup.get('exstchargebase')?.setValue(this.retainedChargeBaseForExt);
      this.addExistingBalanceTypeFormGroup.get('exstpersisted')?.setValue(this.retainedPersistedForExt);
      this.addExistingBalanceTypeFormGroup.get('exstcalculated')?.setValue(this.retainedCalculatedForExt);
      this.addExistingBalanceTypeFormGroup.get('exstautocreation')?.setValue(this.retainedAutoCreationForExt);
      this.addExistingBalanceTypeFormGroup.get('exstloghistory')?.setValue(this.retainedLogHistoryForExt);
      this.addExistingBalanceTypeFormGroup.get('exstdailysnapshot')?.setValue(this.retainedDailySnapshotForExt);
      this.addExistingBalanceTypeFormGroup.get('exstinquiryrequired')?.setValue(this.retainedInquiryRequiredForExt);
      this.addExistingBalanceTypeFormGroup.get('exstgeneratefinancialresults')?.setValue(this.retainedGenerateFinancialResultsForExt);
      this.addExistingBalanceTypeFormGroup.get('exstglmapping')?.setValue(this.retainedGLMappingForExt);
      this.addExistingBalanceTypeFormGroup.get('exstsummaryrequired')?.setValue(this.retainedSummaryRequiredForExt);
      this.addExistingBalanceTypeFormGroup.get('balsubtype')?.setValue(this.retainedBalanceSubTypeDataForExt);
      this.addExistingBalanceTypeFormGroup.get('balperiodtype')?.setValue(this.retainedBalancePeriodTypeForExt);

    } else {
      this.addExistingBalanceTypeFormGroup.get('exstcode')?.enable();
      this.addExistingBalanceTypeFormGroup.get('roleTypeIdentifier')?.enable();

    }
    this.changeDetectorRef.detectChanges();
  }

  public getError(control: string, formGroup: UntypedFormGroup): string {
    if (formGroup) {
      const fc: AbstractControl = formGroup.get(control);
      if (fc && fc.errors && fc.touched) {
        return FormUtilityService.getCommonFCErrorMsg(fc);
      }
    }
  }

  isAdd = true;
  isEdit = false;
  private balanceTypeForm(element: BalanceTypeList): void {
    this.isAdd = false;
     // Deduplicate balance subtypes
     const balanceSubTypes =
     element.productTypeBalanceSubTypeRelationshipList
       ?.filter(
         item =>
           item.balanceTypeIdentifier ===
           element.productTypeBalanceSubTypeRelationshipList?.[0]
             .balanceTypeIdentifier
       )
       .map(item => item.balanceSubTypeCode) || [];
   const periodTypes =
     element.productTypeBalanceTypePeriodList
       ?.filter(
         item =>
           item.balanceTypeIdentifier ===
           element.productTypeBalanceTypePeriodList?.[0].balanceTypeIdentifier
       )
       .map(item => item.periodType) || [];
    const additionalData = element.productTypeBalanceTypeRelationshipList?.[0];
    this.retainedIdentifierForExt = additionalData?.balanceTypeIdentifier ?? 0;
    this.retainedCodeForExt = additionalData?.balanceTypeCode || '';
    this.retainedAccountClassificationForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.accountingClassification ?? 0;
    this.retainedDateValueForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.dateValue || '';
    this.retainedPayerForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.payerIdentifier ?? 0;
    this.retainedPayeeForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.payeeIdentifier ?? 0;
    this.retainedStatementDisplayForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.statementProcess === 'Y';
    this.retainedChargeBaseForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.chargeCalculation === 'Y';
    this.retainedPersistedForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.persisted === 'Y';
    this.retainedCalculatedForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.calculated === 'Y';
    this.retainedAutoCreationForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.autoCreated === 'Y';
    this.retainedLogHistoryForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.logAudit === 'Y';
    this.retainedDailySnapshotForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.snapshotRequired === 'Y';
    this.retainedInquiryRequiredForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.enquiryRequired === 'Y';
    this.retainedGenerateFinancialResultsForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.financialResultRequired === 'Y';
    this.retainedGLMappingForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.glRequired === 'Y';
    this.retainedSummaryRequiredForExt = element.productTypeBalanceTypeRelationshipList?.[0]?.summaryRequired === 'Y';
    this.retainedBalanceSubTypeDataForExt = balanceSubTypes
    
    this.retainedBalancePeriodTypeForExt = periodTypes

    
    this.addExistingBalanceTypeFormGroup.reset();

    

    this.addExistingBalanceTypeFormGroup.patchValue({
      // exstcode: element.code,
      exstcode:
        element.productTypeBalanceTypeRelationshipList?.[0]?.balanceTypeCode ||
        '',
      exstaccntclassification:
        element.productTypeBalanceTypeRelationshipList?.[0]
          ?.accountingClassification || '',
      exstdatevalue:
        element.productTypeBalanceTypeRelationshipList?.[0]?.dateValue || '',
      exstpayer:
        element.productTypeBalanceTypeRelationshipList?.[0]?.payerIdentifier ||
        '',
      exstpayee:
        element.productTypeBalanceTypeRelationshipList?.[0]?.payeeIdentifier ||
        '',
      exstchargebase:
        element.productTypeBalanceTypeRelationshipList?.[0]
          ?.chargeCalculation === 'Y',
      exststatementdisplay:
        element.productTypeBalanceTypeRelationshipList?.[0]
          ?.statementProcess === 'Y',
      exstpersisted:
        element.productTypeBalanceTypeRelationshipList?.[0]?.persisted === 'Y',
      exstcalculated:
        element.productTypeBalanceTypeRelationshipList?.[0]?.calculated === 'Y',
      exstautocreation:
        element.productTypeBalanceTypeRelationshipList?.[0]?.autoCreated === 'Y',
      exstloghistory:
        element.productTypeBalanceTypeRelationshipList?.[0]?.logAudit === 'Y',
      exstdailysnapshot:
        element.productTypeBalanceTypeRelationshipList?.[0]
          ?.snapshotRequired === 'Y',
