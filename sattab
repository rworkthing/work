  <bod-table
  #exstAggregateTable
  [data]="exstAggregateTabledata"
  [tableActions]="exstAggregateTableActions"
  (onTableActionClick)="onValidTableActionClicked($event)"
  [expandedRowTemplate]="expandedRowTemplate"
  [inlineModal]="{
    addNewInlineRowTitle: 'New Aggregate Value' | translate,
    formGroup: exstAggregateForm,
    formTemplateName: exstAggregateTemplate
  }"
  (onInlineFormAddSubmit)="onAddExstAggregate(exstAggregateForm.value)"
  (onInlineFormEditSubmit)="onAddExstAggregate(exstAggregateForm.value)"
  (onInlineEditRowActionClick)="inlineEditRowActionClick($event)"
  (onInlineAddRowActionClick)="inlineAddRowActionClick()"
  [customColumnTemplates]="[
    {
      columnName: 'actions',
      templateName: deleteaggegateActionTemplate
    }
  ]"
  [alignContent]="'top'"
>
  <ng-template
    #deleteaggegateActionTemplate
    let-element="element"
    let-column="column"
    let-index="index"
  >
    <bod-table-actions
      [actions]="rowLevelActionsForBasicEdit"
      (onActionClick)="handleRowLevelActionsforaggergate($event.icon, index)"
    >
    </bod-table-actions>
  </ng-template>
  <ng-template #expandedRowTemplate let-context="context">
    <div fullwidth>
      <bod-inquiry-layout
        [columns]="2"
        [groups]="
          balanceTypeService.getExpandedaggregateData(context.element)
        "
        [softSeparator]="false"
        [direction]="direction"
        [information]="[]"
        (linkClick)="commonDataService.inquiryLayoutClick($event)"
      >
      </bod-inquiry-layout>
    </div>
  </ng-template>
</bod-table>
<form [formGroup]="exstAggregateForm">
  <ng-template #exstAggregateTemplate>
    <bod-input-layout col="2">
      <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.aggregationname'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="text"
              matInput
              fisStyle
              formControlName="aggregationname"
              name="aggregationname"
              [disabled]="true"
            />
          </mat-form-field>
        </bod-control-group>
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.producttype'"
        [forTextOnly]="true"
        [required]="false"
      >
        <mat-form-field appearance="outline" fisStyle>
          <mat-select
          panelClass="fis-style"
          formControlName="producttype"
          name="producttype"
        >
          <mat-option
            *ngFor="let producttype of producttypes"
            [value]="producttype.value"
          >
            {{ producttype.label }}
          </mat-option>
        </mat-select>
        </mat-form-field>
      </bod-control-group>
      <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.balancetype'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <mat-select
              panelClass="fis-style"
              formControlName="balancetype"
              name="balancetype"
            >
              <mat-option
                *ngFor="let balancetype of balancetypes"
                [value]="balancetype.value"
              >
                {{ balancetype.label }}
              </mat-option>
            </mat-select>
            <!-- <mat-error>
        {{ getError('balancetype') | translate }}
      </mat-error> -->
          </mat-form-field>
        </bod-control-group>
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.relationshiptype'"
        [forTextOnly]="true"
        [required]="false"
      >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
            panelClass="fis-style"
            formControlName="relationshiptype"
            name="relationshiptype"
          >
            <mat-option
              *ngFor="
                let relationshiptype of relationshiptypes
              "
              [value]="relationshiptype.value"
            >
              {{ relationshiptype.label }}
            </mat-option>
          </mat-select>
      </mat-form-field>
      </bod-control-group>
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.aggregationlevel'"
        [forTextOnly]="true"
        [required]="true"
      >
      <mat-form-field appearance="outline" fisStyle>
        <input
          type="number"
          matInput
          fisStyle
          formControlName="aggregationlevel"
          name="aggregationlevel"
        />
        <mat-error *ngIf="exstAggregateForm.get('aggregationlevel').hasError('maxValueExceeded')">
          Exceeds maximum length            
        </mat-error>
        <mat-error *ngIf="exstAggregateForm.get('aggregationlevel').hasError('negativeValue')">
          Aggregation level cannot be negative.
        </mat-error>
      </mat-form-field>
      </bod-control-group>
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.debittransactiontype'"
        [forTextOnly]="true"
        [required]="false"
      >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="debittransactiontype"
          name="debittransactiontype"
        >
          <mat-option
            *ngFor="let debittransactiontype of debittransactiontypes"
            [value]="debittransactiontype.value"
          >
            {{ debittransactiontype.label }}
          </mat-option>
        </mat-select>
      </mat-form-field>
      </bod-control-group>
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.credittransactiontype'"
        [forTextOnly]="true"
        [required]="false"
      >
        <mat-form-field appearance="outline" fisStyle>
          <mat-select
            panelClass="fis-style"
            formControlName="credittransactiontype"
            name="credittransactiontype"
          >
          <mat-option
                *ngFor="let credittransactiontype of debittransactiontypes"
                [value]="credittransactiontype.value"
              >
                {{ credittransactiontype.label }}
              </mat-option>
          </mat-select>
        </mat-form-field>
      </bod-control-group>
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.othercurrency'"
        [forTextOnly]="true"
        [required]="false"
      >
        <mat-slide-toggle
          fisStyle
          color="primary"
          formControlName="othercurrency"
          name="othercurrency"
        >
        </mat-slide-toggle>
      </bod-control-group>
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.reverse'"
        [forTextOnly]="true"
        [required]="false"
      >
        <mat-slide-toggle
          fisStyle
          color="primary"
          formControlName="reverse"
          name="reverse"
        >
        </mat-slide-toggle>
      </bod-control-group>
    </bod-input-layout>
  </ng-template>
</form>
