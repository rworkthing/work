  public dataWithBalSubTypevalues: BalSybTypeTable[] = [];
  onAddBalSubType(formValues: any) {
    if (this.balanceSubtypeForm.invalid) {
      // alert('Please fill all the required fields.');
      return;
    }
    this.dataWithBalSubTypevalues = this.dataWithBalSubTypevalues || [];
    this.balanceSubtypeForm.controls['balsubtypeIdentifier'].enable();
    const updatedFormValues = this.balanceSubtypeForm.getRawValue();
    this.balanceSubtypeForm.controls['balsubtypeIdentifier'].disable();
    const newValidValue: BalSybTypeTable = {
      code: formValues.balancesubtypename || '',
      name: formValues.balancesubtypecode || '',
      identifier: updatedFormValues.balsubtypeIdentifier || ''
    };

    this.dataWithBalSubTypevalues.push(newValidValue);
    if (this.balanceSubTypeData && this.balanceSubTypeData.datasource) {
      this.balanceSubTypeData.datasource.data = [
        ...this.dataWithBalSubTypevalues
      ];
    }
    if (this.balanceSubtypeForm) {
      this.balanceSubtypeForm.reset();
    }
    this.addNewBalanceTypeFormGroup.markAsDirty();
  }
  public dataWithRoleTypevalues: RoleTypeSampleTable[] = [];
  onAdd(formValues: any) {
    this.errorMessages = [];
    const selectedRoleType = this.roletypes.find(
      item => item.value === formValues.roletype
    );
    const roleTypeCode = selectedRoleType ? selectedRoleType.label : '';
    const selectedAccountClassification = this.accountclassifications.find(
      item => item.value === formValues.roleaccountclassification
    );
    const accountClassificationCode = selectedAccountClassification
      ? selectedAccountClassification.label
      : '';
    if (this.roleTypeForm.invalid) {
      // alert('Please fill all the required fields.');
      return;
    }
    const existingRoleType = this.dataWithRoleTypevalues.find(
      item => item.type === roleTypeCode
    );
    if (existingRoleType) {
      this.handleError1({
        errorCode: 'ROLE_TYPE_ALREADY_EXISTS',
        status: 400
      });
      return;
    }
    this.dataWithRoleTypevalues = this.dataWithRoleTypevalues || [];
    const newValidValue: RoleTypeSampleTable = {
      type: roleTypeCode || '',
      accountingClassification: accountClassificationCode ?? '',
      obligator: formValues.obligator ? 'Y' : 'N',
      beneficiary: formValues.beneficiary ? 'Y' : 'N',
      visibility: formValues.isvisible ? 'Y' : 'N'
    };

    this.dataWithRoleTypevalues.push(newValidValue);
    if (this.roleTypetabledata && this.roleTypetabledata.datasource) {
      this.roleTypetabledata.datasource.data = [...this.dataWithRoleTypevalues];
    }
    if (this.roleTypeForm) {
      this.roleTypeForm.reset();
    }
    this.addNewBalanceTypeFormGroup.markAsDirty();
  }

  public errorMessages2: NotificationMessage[] = [];
  private handleError1(error: any) {
    let errorMsg = '';
    switch (error.errorCode) {
      case 'ROLE_TYPE_ALREADY_EXISTS':
        errorMsg = 'Error: Role type already exists.';
        break;
      default:
        errorMsg = 'Unknown error occurred.';
    }
    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };
    this.errorMessages2.push(this.message);
    setTimeout(() => {
      this.errorMessages2 = this.errorMessages2.filter(
        msg => msg.text !== errorMsg
      );
    }, 4000);
  }
  initialAggregationName: string | null = null;
  public dataWithAggregatevalues: AggregateSampleTable[] = [];


  onAddAggregate(formValues: any) {
    //convert from idfr to code
    const selectedBalanceType = this.balancetypes.find(
      item => item.value === formValues.balancetype
    );

    const balTypeName = selectedBalanceType ? selectedBalanceType.label : '';
    const selectedProductType = this.producttypes.find(
      item => item.value === formValues.producttype
    );
    const prdtTypeName = selectedProductType ? selectedProductType.label : '';
    const selecteDebitType = this.debittransactiontypes.find(
      item => item.value === formValues.debittransactiontype
    );
    const debitTransType = selecteDebitType ? selecteDebitType.label : '';
    const selecteCreditType = this.credittransactiontypes.find(
      item => item.value === formValues.credittransactiontype
    );
    const creditTransType = selecteCreditType ? selecteCreditType.label : '';

    const selecteRltnpType = this.relationshiptypes.find(
      item => item.value === formValues.relationshiptype
    );
    const rltnType = selecteRltnpType ? selecteRltnpType.label : '';
    if (!this.initialAggregationName) {
      this.initialAggregationName =
        this.aggregateForm.get('aggregationname')?.value || '';
    }
    if (this.aggregateForm.invalid || !this.initialAggregationName) {
      // alert('Please fill all the required fields.');
      return;
    }
    this.dataWithAggregatevalues = this.dataWithAggregatevalues || [];
    const newValidValue: AggregateSampleTable = {
      aggregationname: this.initialAggregationName || '',
      balancetype: balTypeName || '',
      aggregationLevel:
        formValues.aggregationlevel !== undefined
          ? formValues.aggregationlevel
          : '',
      relationshiptype: rltnType || '',
      aggregates: [
        {
          id: 0,
          label: 'Product Type',
          value: prdtTypeName
        },
        {
          id: 1,
          label: 'Debit Transaction Type',
          value: debitTransType
        },
        {
          id: 2,
          label: 'Credit Transaction Type',
          value: creditTransType
        },
        {
          id: 3,
          label: 'Other Currency',
          value: formValues.othercurrency ? 'Y' : 'N'
        },
        {
          id: 4,
          label: 'Reverse',
          value: formValues.reverse ? 'Y' : 'N'
        }
      ]
    };
    this.dataWithAggregatevalues.push(newValidValue);
    if (this.aggregateTabledata && this.aggregateTabledata.datasource) {
      this.aggregateTabledata.datasource.data = [
        ...this.dataWithAggregatevalues
      ];
    }
    if (this.aggregateForm) {
      // Reset the form but keep the aggregationname value
      const currentAggregationName =
        this.aggregateForm.get('aggregationname')?.value;
      this.aggregateForm.reset();
      this.aggregateForm
        .get('aggregationname')
        ?.setValue(currentAggregationName);
    }
    this.addNewBalanceTypeFormGroup.markAsDirty();
  }

