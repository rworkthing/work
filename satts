<form [formGroup]="formGroup">
    <bod-table
      #restrictionsMultiselectTable
      [data]="restrictionsDataSingleSelect"
      (onRowSelect)="rowSelection($event)"
      [rowSelectionStrategy]="rowSelectionStrategy"
      [allowSelectAll]="allowRowSelection"
      [alignContent]="'top'"
      [customColumnTemplates]="[
        { columnName: 'type', templateName: typeTemplate }
      ]"
      [modeOptions]="{selection: true }"
    >
    
    <ng-template
    #typeTemplate
    let-element="element"
    let-column="column"
    let-index="index"
  >
    <!-- Show as readonly text instead of dropdown -->
    <span style="padding-left: 8px; font-weight: 500;">
      {{ element.type || 'ERROR' }}
    </span>
  </ng-template>
    </bod-table>
</form>

import { Component, EventEmitter, Input, OnChanges, OnInit, Output, SimpleChanges, ViewChild } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormBuilder, FormGroup, FormsModule, ReactiveFormsModule, UntypedFormGroup } from '@angular/forms';
import { TransactionTypeService } from '../../transaction-type.service';
import { Restrictions } from '../../transaction-type.model';
import {
  BOD_DATE_RANGE,
  BodAutoCompleteModule,
  BodCommonDialogModel,
  BodCommonDialogService,
  BodCommonModule,
  BodCurrencyControlModule,
  BodDateRange,
  BodDynamicFormModule,
  BodFormModule,
  BodFormStateService,
  BodFormTypes,
  BodPageContainerModule,
  BodTableAction,
  BodTableActionType,
  BodTableActionsModule,
  BodTableComponent,
  BodTableFilterType,
  BodTableMetadata,
  BodTableModule,
  CommonDialogComponent,
  ControlGroupModule,
  DirectivesModule,
  EditTableAction,
  InlineEditOutput,
  InputLayoutModule,
  InquiryLayoutModule,
  MessageContainerModule,
  ModeOptions,
  NotificationMessage,
  NotificationMessageType,
  RowLeftAction,
  SearchFieldModule,
  SectionContainerModule,
  SelectPageMode
} from '@bod/common';
import { MatIconModule } from '@angular/material/icon';
import { RufIconModule } from '@ruf/shell/icon';
import {
  MatSlideToggle,
  MatSlideToggleChange,
  MatSlideToggleModule
} from '@angular/material/slide-toggle';
import { MatButtonModule } from '@angular/material/button';
import { MatTabsModule } from '@angular/material/tabs';
import { TranslateModule } from '@ngx-translate/core';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatSelectModule } from '@angular/material/select';
import { MatDatepickerModule } from '@angular/material/datepicker';
import { MatInputModule } from '@angular/material/input';
import { MatButtonToggleModule } from '@angular/material/button-toggle';
import { MatTableDataSource } from '@angular/material/table';

@Component({
  selector: 'bod-restrictions-multiselect-table',
  standalone: true,
  imports: [
    CommonModule,
    BodTableModule,
    BodPageContainerModule,
    MatSlideToggleModule,
    ReactiveFormsModule,
    FormsModule,
    BodAutoCompleteModule,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    BodCommonModule
  ],
  templateUrl: './restrictions-multiselect-table.component.html',
  styleUrl: './restrictions-multiselect-table.component.scss'
})
export class RestrictionsMultiselectTableComponent implements OnInit, OnChanges {

  public modeOptions: ModeOptions = { input: false, reset: false };
  public modeOptionsSimple = this.modeOptions;

  @Input() restrictionsDataSingleSelect: BodTableMetadata;
  @Input() selectedRowSingleSelect: Restrictions[] = [];
  @Output() rowSelected = new EventEmitter<Restrictions[]>();
  @Output() defaultChanged = new EventEmitter<{ rowIndex: number, isDefault: boolean }>();
  @Output() dirtyChange = new EventEmitter<boolean>();
  @Input() formGroup: UntypedFormGroup;

  @ViewChild('restrictionsMultiselectTable', { static: false })
  restrictionsTable: BodTableComponent;

  private isDirty = false;

  typeOptions = [
    { label: 'ERROR', value: 'ERROR' }, 
    { label: ' ', value: ' ' }
  ];

  ngAfterViewInit(): void {
    setTimeout(() => this.selectRestrictionsRows(), 0);
  }

  ngOnChanges(changes: SimpleChanges): void {
    if (changes['selectedRowSingleSelect'] && this.selectedRowSingleSelect?.length) {
      console.log('📥 selectedRowSingleSelect changed:', this.selectedRowSingleSelect);
      setTimeout(() => this.selectRestrictionsRows(), 0);
    }
  }

  private selectRestrictionsRows(): void {
    const tableData = this.restrictionsDataSingleSelect?.datasource?.data || [];
    const selection = this.restrictionsTable?.selection;

    if (!selection || tableData.length === 0) {
      return;
    }

    selection.clear();

    tableData.forEach(dataRow => {
      const match = this.selectedRowSingleSelect.find(
        sel => sel.id === dataRow.id
      );
      if (match) {
        selection.select(dataRow);
      }
    });
  }

  public allowRowSelection = true;
  public rowSelectionStrategy: SelectPageMode = SelectPageMode.ALL_PAGES;
  public showEdit = true;
  public defaultForm: FormGroup;

  constructor(
    private fb: FormBuilder,
    private transactionTypeService: TransactionTypeService
  ) { }

  ngOnInit() {
    this.defaultForm = this.fb.group({});
  }

  public onTypeChange(element: any, value: string) {
    element.type = value;
    this.setDirty(true);
  }

  private loadRestrictionData() {
    this.transactionTypeService.getRestrictions().subscribe((restrictions: any[]) => {
      this.restrictionsDataSingleSelect.datasource.data = restrictions.map((item: any, index: number) => ({
        id: index + 1,
        code: item.code,
        type: 'ERROR', // Default to ERROR
        default: false
      }));
    });
  }

  public resetSelection() {
    if (this.restrictionsTable?.selection) {
      this.restrictionsTable.selection.clear();
    }
    this.selectedRowSingleSelect = [];
    this.setDirty(false);
  }

  public rowSelectionSingleSelect(element: Restrictions[]) {
    console.log('rowSelectionSingleSelect called with:', element);
    this.selectedRowSingleSelect = element;
    this.rowSelected.emit(this.selectedRowSingleSelect);
    this.setDirty(true);
  }

  public rowSelection(element: Restrictions[]) {
    console.log('rowSelection called with:', element);
    if (element.length !== 0) {
      this.selectedRowSingleSelect = element;
    } else {
      this.selectedRowSingleSelect = [];
    }
    this.rowSelected.emit(this.selectedRowSingleSelect);
    this.setDirty(true);
    console.log('Restrictions selectedRowSingleSelect:', this.selectedRowSingleSelect);
  }

  public onDefaultToggleChange(event: any, rowIndex: number) {
    const data = [...this.restrictionsDataSingleSelect.datasource.data];
    const row = data.find(r => r.index === rowIndex);

    if (!row) return;

    if (event.checked) {
      data.forEach(item => {
        item.default = item.index === rowIndex;
      });
    } else {
      row.default = false;
    }

    this.restrictionsDataSingleSelect.datasource.data = data;

    this.defaultChanged.emit({
      rowIndex: rowIndex,
      isDefault: event.checked
    });
  }

  private setDirty(dirty: boolean) {
    this.isDirty = dirty;
    this.dirtyChange.emit(this.isDirty);
  }
}
