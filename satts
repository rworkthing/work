    this.balanceTypeService.retrieveBalanceType().subscribe(response => {
      if (response.status === 'SUCCESS' && response.data) {
        console.log('Response Data:', response.data);
        this.balanceTypeData = response.data.map((item: any) => {
          const balanceType = item.BalanceType.balanceType || {};
          const balanceSubTypeList = item.BalanceType.balanceSubTypeList || [];
