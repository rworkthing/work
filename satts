import { Component, CUSTOM_ELEMENTS_SCHEMA, NO_ERRORS_SCHEMA, TemplateRef, ViewChild } from '@angular/core';
import { TranslationKey } from '../metadat-config/codegen-config.constant';
import { FormBuilder, FormsModule, ReactiveFormsModule, UntypedFormGroup } from '@angular/forms';
import { BodCommonDialogModel, BodCommonDialogService, BodCommonModule, BodCurrencyControlModule, BodDynamicFormModule, BodFormModule, BodPageContainerModule, BodTableAction, BodTableActionsModule, BodTableComponent, BodTableMetadata, BodTableModule, CommonDialogComponent, ControlGroupModule, DirectivesModule, InputLayoutModule, InquiryLayoutModule, MessageContainerModule, RowLeftAction, SearchFieldModule, SectionContainerModule } from '@bod/common';
import { RoleTypeTableLevelActions } from './role-type-constants';
import { BodSampleTable } from '../bod-table-demo.model';
import { MetadataService } from '../metadat-config/metada-config.service';
import { MatTableDataSource } from '@angular/material/table';
import { MatDialogRef } from '@angular/material/dialog';
import { TranslateModule } from '@ngx-translate/core';
import { MatIconModule } from '@angular/material/icon';
import { RufIconModule } from '@ruf/shell/icon';
import { MatButtonModule } from '@angular/material/button';
import { MatSlideToggleModule } from '@angular/material/slide-toggle';
import { MatTabsModule } from '@angular/material/tabs';
import { CommonModule } from '@angular/common';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatSelectModule } from '@angular/material/select';
import { MatDatepickerModule } from '@angular/material/datepicker';
import { MatInputModule } from '@angular/material/input';
import { MatButtonToggleModule } from '@angular/material/button-toggle';
import { RoleTypeService } from './role-type-service';
import { AddEditRoletypeComponent } from '../add-edit-roletype/add-edit-roletype.component';
import { ExistingRoleTypeComponent } from '../existing-role-type/existing-role-type.component';
import { AddEditRoleService } from '../add-edit-roletype/add-edit-role-service';
import { RoleTypeList } from '../add-edit-roletype/add-edit-roletype.mode';


@Component({
  selector: 'bod-role-type',
  standalone: true,
  imports: [
    AddEditRoletypeComponent,
    ExistingRoleTypeComponent,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    BodCommonModule
  ],
  templateUrl: './role-type.component.html',
  styleUrl: './role-type.component.scss',
  schemas: [CUSTOM_ELEMENTS_SCHEMA, NO_ERRORS_SCHEMA]
})
export class RoleTypeComponent {
  public translationKey = TranslationKey;
  public addNewRoleTypeFormGroup: UntypedFormGroup | undefined;
  public addExistingRoleTypeFormGroup: UntypedFormGroup | undefined;

  @ViewChild('addNewRoleTypeTemplate')
  public addNewRoleTypeTemp: TemplateRef<any> | undefined;
  @ViewChild('addExistingRoleTypeTemplate')
  public addExstRoleTypeTemp: TemplateRef<any> | undefined;
  private adminTableRef: BodTableComponent | undefined;
  @ViewChild('systemMessage', { static: true }) systemMessage: any;

  constructor(
    public roleTypeService: RoleTypeService,
    private fb: FormBuilder,
    private bodCommonDialogService: BodCommonDialogService,
    private metadataService: MetadataService,
    public addEditRoleService: AddEditRoleService
  ) { }

  // ngOnInit(): void {
  //   this.initForm();
  // }

  public roleTypeTableActions: BodTableAction[] =
    RoleTypeTableLevelActions;
  public roleTypeTableMetaData: BodTableMetadata = {
    title: 'Role Type Details',
    columns: [...this.roleTypeService.columns],
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<BodSampleTable>(),
    noRecordsMessage: 'No data Define',
    rowLeftAction: RowLeftAction.expandableRows,
    enableSorting: true
  };
  onRoleTypeDataReceived(data: any): void {
    console.log('Received Data in parent:', data);
    this.roleTypeTableMetaData.datasource.data = data;
  }
  public roleRelationshipTable: BodTableMetadata = {
    title: 'Role Relationship Details',
    columns: [...this.addEditRoleService.roleRelationshipInquiry],
    enablePagination: false,
    datasource: new MatTableDataSource<BodSampleTable>(),
    noRecordsMessage: 'No data Defined'
  };

  public rowExpanded(element: RoleTypeList) {
    console.log("expanded element", element);
    this.roleRelationshipTable.datasource.data = 
    element.productTypeRoleTypeRelationshipList || [];
  }



  public commonDialogSize: string = 'Large';
  public closeOnCloseIconClick: boolean = false;
  private onCloseClick() {
    this.systemMessage.message = 'Custom Function called on close';
    this.systemMessage.show();
    this.dialogRef$.close();
  }
  private dialogRef$: MatDialogRef<CommonDialogComponent, any>;
  private openDialog(dialogModel: any) {
    let onClose = this.closeOnCloseIconClick
      ? this.onCloseClick.bind(this)
      : undefined;
    this.dialogRef$ = this.bodCommonDialogService.commonDialog(
      dialogModel,
      onClose,
      this.commonDialogSize
    );
  }

  public onTableActionClicked1(event: BodTableAction) {
    if (event.id === 12) {
      this.addNewRoleType();
    } else if (event.id === 13) {
      this.addExistingRoleType();
    }
  }
  private addNewRoleType() {
    // this.isAdd = true;
    let dialogModel: BodCommonDialogModel = {
      formTemplate: this.addNewRoleTypeTemp,
      title: 'Add New Role Type'
    };
    this.openDialog(dialogModel);
  }
  private addExistingRoleType() {
    // this.editAttribute = null;
    let dialogModel: BodCommonDialogModel = {
      formTemplate: this.addExstRoleTypeTemp,
      title: 'Relate Existing Role'
    };
    this.openDialog(dialogModel);
  }


}
