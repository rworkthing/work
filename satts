  identifierSearch(field: string): Promise<void> {
    return new Promise((resolve, reject) => {
      this.metadataService.idfrSearch().subscribe(
        (response: string) => {
          if (field === 'balTypeIdentifier') {
            this.addNewBalanceTypeFormGroup.controls[
              'balTypeIdentifier'
            ].setValue(response);
          } else if (field === 'balsubtypeIdentifier') {
            this.balanceSubtypeForm.controls['balsubtypeIdentifier'].setValue(
              response
            );
          }
          this.addNewBalanceTypeFormGroup.markAsDirty();
          resolve();
        },
        error => {
          console.error('Error:', error);
          reject(error);
        }
      );
    });
  }

