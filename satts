      item => item.value === identifier
    );
    return item ? item.label : undefined;
  }
  private convertPrdttypeidfrtoCde(identifier: any): string | undefined {
    const item = this.producttypes.find(
      item => item.value === identifier
    );
    return item ? item.label : undefined;
  }


  isEdit = false;
  iconActionClicked(event: BodTableAction, element: BalanceTypeList) {
    this.isEdit = true;
    this.messages = [];
    if (event.id === BodTableActionType.EDIT) {
      // this.editAttributes(element);
      this.editBalanceTypes(element);
    } else if (event.id === 1) {
      this.bodConfirmAlertDialogsService
        .confirm(this.ConfirmData)
        .subscribe(val => {
          if (val) {
            this.balanceTypeDelete(element);
          }
        });
    }
  }
  editBalanceType: BalanceTypeList | undefined;
  private editBalanceTypes(element: BalanceTypeList) {
    this.editBalanceType = element;
    let selectedTemplate: TemplateRef<any>;
    let dialogTitle: string;
    if (element.name) {
      selectedTemplate = this.addNewBalanceTypeTemp;
      dialogTitle = 'Edit Balance Type';
    } else {
      selectedTemplate = this.addExstBalanceTypeTemp;
      dialogTitle = 'Edit Existing Balance Type';
    }
    const dialogModel: BodCommonDialogModel = {
      formTemplate: selectedTemplate,
      title: dialogTitle
    };
    this.openDialog(dialogModel);
  }

  balanceTypeDelete(element: BalanceTypeList): void {
    if (
      element.code ===
      element.productTypeBalanceTypeRelationshipList[0].balanceTypeCode
    ) {
      this.balanceTypeService
        .deleteBalanceType(
          'BalanceType',
          element.productTypeBalanceTypeRelationshipList[0]
            .balanceTypeIdentifier
        )
        .subscribe(response => {
          const successMsg = `${element.code} Deleted Successfully`;
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(
              msg => msg.text !== successMsg
            );
          }, 4000);

          this.getNewBalanceType();
        });
    } else {
      this.balanceTypeService
        .deleteBalanceType('BalanceType', element.identifier)
        .subscribe(response => {
          const successMsg = `${element.code} Deleted Successfully`;
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(
              msg => msg.text !== successMsg
            );
          }, 4000);
          this.getNewBalanceType();

        });
        
    }
  }
}
