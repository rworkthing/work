  standalone: true,
  imports: [
    BalanceTypeComponent,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,

    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    MatDatepickerModule,
    BodCommonModule
  ],
  templateUrl: './add-edit-balancetype.component.html',
  styleUrl: './add-edit-balancetype.component.scss'
})
export class AddEditBalancetypeComponent implements OnInit {
  public translationKey = TranslationKey;
  public addNewBalanceTypeFormGroup: UntypedFormGroup;
  public balanceSubtypeForm: UntypedFormGroup;
  public aggregateForm: UntypedFormGroup;
  public roleTypeForm: UntypedFormGroup | undefined;
  public postingApplicationForm: UntypedFormGroup | undefined;
  formType: BodFormTypes = BodFormTypes.SUBMIT;
  public accountclassifications: any[] = [];
  public roletypes: any[] = [];
  public roleaccountclassifications: any[] = [];
  public postingapplicationmethods: any[] = [];
  public producttypes: any[] = [];
  public balancetypes: any[] = [];
  public debittransactiontypes: any[] = [];
  public credittransactiontypes: any[] = [];
  public payees: any[] = [];
  public payers: any[] = [];

  public roleTypetableActions: BodTableAction[] = roletypeaction;
  public aggregateTableActions: BodTableAction[] = roletypeaction;
  public postingAppTableActions: BodTableAction[] = roletypeaction;
  public balanceSubTypeTableActions: BodTableAction[] = roletypeaction;
  public rowLevelActionsForBasicEdit: BodTableAction[] = roletypeactionDelete;

  public onValidTableActionClicked(event: BodTableAction): void {}
  // onAdd(formValues: any) {}

  public inlineAddRowActionClick() {}
  public inlineEditRowActionClick(_event: InlineEditOutput) {}

  dateValues = [
    { value: 'EffectiveDate', label: 'Effective Date' },
    { value: 'ValueDate', label: 'Value Date' },
    { value: 'BookingDate', label: 'Booking Date' }
  ];
  applicationTypes = [
    { value: 'MaximumBalance', label: 'Maximum Balance' },
    { value: 'RemainingAmount', label: 'Remaining Amount' },
    { value: 'Amount', label: 'Amount' }
  ];
  customizationTypes = [
    { value: 'Before', label: 'Before' },
    { value: 'None', label: 'None' },
    { value: 'After', label: 'After' },
    { value: 'CustomOnly', label: 'Custom Only' }
  ];

  constructor(
    public balanceTypeService: BalanceTypeService,
    private fb: FormBuilder,
    private bodCommonDialogService: BodCommonDialogService,
    private metadataService: MetadataService //roleTypetabledata
  ) {}

  ngOnInit(): void {
    this.initForm();
    this.loadDropdownData();
    this.addNewBalanceTypeFormGroup
      .get('balanceTypeCode')
      ?.valueChanges.subscribe(value => {
        this.aggregateForm.get('aggregationname')?.setValue(value);
      });
  }
  loadDropdownData(): void {
    this.balanceTypeService.getAccntClassification().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      this.accountclassifications = mappedData;
      this.roleaccountclassifications = mappedData;
    });

    this.balanceTypeService.getRoletype().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      this.roletypes = mappedData;
      this.payers = mappedData;
      this.payees = mappedData;
    });

    this.balanceTypeService.getPostMethod().subscribe(data => {
      this.postingapplicationmethods = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
    });
    this.balanceTypeService.getProductType().subscribe(data => {
      this.producttypes = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
    });
    this.balanceTypeService.getBalanceType().subscribe(data => {
      this.balancetypes = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
    });

    this.balanceTypeService.getPostingSTD().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      this.debittransactiontypes = mappedData;
      this.credittransactiontypes = mappedData;
    });
  }
  public dataWithRoleTypevalues: RoleTypeSampleTable[] = [];
  onAdd(formValues: any) {
    const selectedRoleType = this.roletypes.find(
      item => item.value === formValues.roletype
    );
    const roleTypeCode = selectedRoleType ? selectedRoleType.label : '';
    const selectedAccountClassification = this.accountclassifications.find(
      item => item.value === formValues.roleaccountclassification
    );
    const accountClassificationCode = selectedAccountClassification
      ? selectedAccountClassification.label
      : '';

    this.dataWithRoleTypevalues = this.dataWithRoleTypevalues || [];
    const newValidValue: RoleTypeSampleTable = {
      type: roleTypeCode || '',
      accountingClassification: accountClassificationCode ?? '',
      obligator: formValues.obligator ?? false,
      beneficiary: formValues.beneficiary ?? false,
      visibility: formValues.isvisible ?? false
    };

    this.dataWithRoleTypevalues.push(newValidValue);
    if (this.roleTypetabledata && this.roleTypetabledata.datasource) {
      this.roleTypetabledata.datasource.data = [...this.dataWithRoleTypevalues];
    }
    if (this.roleTypeForm) {
      this.roleTypeForm.reset();
    }
  }
  public dataWithAggregatevalues: AggregateSampleTable[] = [];
  onAddAggregate(formValues: any) {
    //convert from idfr to code
    const selectedBalanceType = this.balancetypes.find(
      item => item.value === formValues.balancetype
    );
    const balTypeName = selectedBalanceType ? selectedBalanceType.label : '';

    const selectedProductType = this.producttypes.find(
      item => item.value === formValues.producttype
    );
    const prdtTypeName = selectedProductType ? selectedProductType.label : '';

    const selecteDebitType = this.debittransactiontypes.find(
      item => item.value === formValues.debittransactiontype
    );
    const debitTransType = selecteDebitType ? selecteDebitType.label : '';

    const selecteCreditType = this.credittransactiontypes.find(
      item => item.value === formValues.credittransactiontype
    );
    const creditTransType = selecteCreditType ? selecteCreditType.label : '';

    this.dataWithAggregatevalues = this.dataWithAggregatevalues || [];
    const newValidValue: AggregateSampleTable = {
      aggregationname: this.aggregateForm.get('aggregationname')?.value || '',
      balancetype: balTypeName || '',
      aggregationLevel: formValues.aggregationlevel || '',
      relationshiptype: formValues.relationshiptype || '',
      aggregates: [
        {
          id: 0,
          label: 'Product Type',
          value: prdtTypeName
        },
        {
          id: 1,
          label: 'Debit Transaction Type',
          value: debitTransType
        },
        {
          id: 2,
          label: 'Debit Transaction Type',
          value: creditTransType
        },
        {
          id: 3,
          label: 'Other Currency',
          value: formValues.othercurrency
        },
        {
          id: 4,
          label: 'Reverse',
          value: formValues.reverse
        }
      ]
    };
    this.dataWithAggregatevalues.push(newValidValue);
    if (this.aggregateTabledata && this.aggregateTabledata.datasource) {
      this.aggregateTabledata.datasource.data = [
        ...this.dataWithAggregatevalues
      ];
    }
    if (this.aggregateForm) {
      this.aggregateForm.reset();
    }
  }
  public dataWithPostngStdvalues: PstgSampleTable[] = [];
  onAddPstgStd(formValues: any) {
    const selectedPstgStd = this.postingapplicationmethods.find(
      item => item.value === formValues.postingapplicationmethod
    );
    const pstgApplicationName = selectedPstgStd ? selectedPstgStd.label : '';

    this.dataWithPostngStdvalues = this.dataWithPostngStdvalues || [];
    const newValidValue: PstgSampleTable = {
      postingapplicationmethod: pstgApplicationName || '',
      postingapplicationtype: formValues.applicationtype || '',
      customizationtype: formValues.customizationtype || '',
      instructionorder: formValues.instructionorder || ''
    };
    this.dataWithPostngStdvalues.push(newValidValue);
    if (
      this.postingApplicationTabledata &&
      this.postingApplicationTabledata.datasource
    ) {
      this.postingApplicationTabledata.datasource.data = [
        ...this.dataWithPostngStdvalues
      ];
    }
    if (this.postingApplicationForm) {
      this.postingApplicationForm.reset();
    }
  }
  public balanceSubTypeData: BodTableMetadata = {
    title: 'Balance Sub Type Details',
    columns: [...this.balanceTypeService.balanceSubTypeColumn],
    enablePagination: true,

    datasource: new MatTableDataSource<BalSybTypeTable>(),
    noRecordsMessage: 'No data Defined'
  };

  public roleTypetabledata: BodTableMetadata = {
    title: 'Role Type Details',
    columns: [...this.balanceTypeService.roletypecolumns],
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      // pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<RoleTypeSampleTable>(
      this.dataWithRoleTypevalues
    ),
    noRecordsMessage: 'No data Defined'
  };
  public aggregateTabledata: BodTableMetadata = {
    title: 'Aggregate Details',
    columns: [...this.balanceTypeService.aggregatecolmn],
    rowLeftAction: RowLeftAction.expandableRows,
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      // pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<AggregateSampleTable>(
      this.dataWithAggregatevalues
    ),
    noRecordsMessage: 'No data Defined'
  };
  public postingApplicationTabledata: BodTableMetadata = {
    title: 'Posting Application Instruction',
    columns: [...this.balanceTypeService.postingAppcolumn],
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<PstgSampleTable>(
      this.dataWithPostngStdvalues
    ),
    noRecordsMessage: 'No data Defined'
  };

  private initForm(): void {
    this.addNewBalanceTypeFormGroup = this.fb.group({
      balanceTypeCode: new UntypedFormControl('', [Validators.required]),
      balTypeIdentifier: [{ value: '', disabled: true }],
      balanceTypeName: new UntypedFormControl('', [Validators.required]),
      balancesubtype: new UntypedFormControl(),

      systembalance: new UntypedFormControl(),
      accountclassification: new UntypedFormControl('', [Validators.required]),
      datevalue: new UntypedFormControl('', [Validators.required]),
      payer: new UntypedFormControl('', [Validators.required]),
      payee: new UntypedFormControl('', [Validators.required]),
      statementdisplay: new UntypedFormControl(),
      chargebase: new UntypedFormControl(),
      persisted: new UntypedFormControl(),
      calculated: new UntypedFormControl(),
      autocreation: new UntypedFormControl(),
      systembal: new UntypedFormControl(),
      loghistory: new UntypedFormControl(),
      dailysnapshot: new UntypedFormControl(),
      inquiryrequired: new UntypedFormControl(),
      generatefinancialresults: new UntypedFormControl(),
      glmapping: new UntypedFormControl(),
      summaryrequired: new UntypedFormControl()
    });
    this.balanceSubtypeForm = this.fb.group({
      balancesubtypecode: new UntypedFormControl('', [Validators.required]),
      balsubtypeIdentifier: [{ value: '', disabled: true }],
      balancesubtypename: new UntypedFormControl('', [Validators.required])
    });

    this.roleTypeForm = this.fb.group({
      roletype: new UntypedFormControl('', [Validators.required]),
      roleaccountclassification: new UntypedFormControl('', [
        Validators.required
      ]),
      obligator: new UntypedFormControl(),
      beneficiary: new UntypedFormControl(),
      isvisible: new UntypedFormControl()
    });
    this.aggregateForm = this.fb.group({
      aggregationname: new UntypedFormControl({ value: '', disabled: true }),
      producttype: new UntypedFormControl(''),
      balancetype: new UntypedFormControl('', [Validators.required]),
      relationshiptype: new UntypedFormControl(),
      aggregationlevel: new UntypedFormControl('', [Validators.required]),
      debittransactiontype: new UntypedFormControl(''),
      credittransactiontype: new UntypedFormControl(''),
      othercurrency: new UntypedFormControl(''),
      reverse: new UntypedFormControl('')
    });
    this.postingApplicationForm = this.fb.group({
      postingapplicationmethod: new UntypedFormControl('', [
        Validators.required
      ]),
      applicationtype: new UntypedFormControl('', [Validators.required]),
      instructionorder: new UntypedFormControl('', [Validators.required]),
      customizationtype: new UntypedFormControl('', [Validators.required])
    });
  }
  identifierSearch(field: string) {
    this.metadataService.idfrSearch().subscribe(
      (response: string) => {
        if (field === 'balTypeIdentifier') {
          this.addNewBalanceTypeFormGroup.controls[
            'balTypeIdentifier'
          ].setValue(response);
          this.addNewBalanceTypeFormGroup.controls[
            'balTypeIdentifier'
          ].disable();
        } else if (field === 'balsubtypeIdentifier') {
          this.balanceSubtypeForm.controls['balsubtypeIdentifier'].setValue(
            response
          );
          this.balanceSubtypeForm.controls['balsubtypeIdentifier'].disable();
        }
      },
      error => {
        console.error('Error:', error);
      }
    );
  }
  handleRowLevelActionsforRoletype(action: string, index: number) {
    if (action === 'trash') {
      this.deleteRow(index);
    }
  }
  handleRowLevelActionsforaggergate(action: string, index: number) {
    if (action === 'trash') {
      this.deleteAggregateRow(index);
    }
  }
  handleRowLevelActionsforPstgStd(action: string, index: number) {
    if (action === 'trash') {
      this.deletePstStdRow(index);
    }
  }
  deleteRow(index: number) {
    this.dataWithRoleTypevalues.splice(index, 1);
    this.roleTypetabledata.datasource.data = [...this.dataWithRoleTypevalues];
  }
  deleteAggregateRow(index: number): void {
    this.dataWithAggregatevalues.splice(index, 1);
    if (this.aggregateTabledata && this.aggregateTabledata.datasource) {
      this.aggregateTabledata.datasource.data = [
        ...this.dataWithAggregatevalues
      ];
    }
  }
  deletePstStdRow(index: number): void {
    this.dataWithPostngStdvalues.splice(index, 1);
    if (
      this.postingApplicationTabledata &&
      this.postingApplicationTabledata.datasource
    ) {
      this.postingApplicationTabledata.datasource.data = [
        ...this.dataWithPostngStdvalues
      ];
    }
  }

  public isBalanceSubtypeEnabled = false;
  toggleBalanceSubtype(event: { checked: boolean }) {
    this.isBalanceSubtypeEnabled = event.checked;
  }
  onAddNewBalanceType() {}
  getError(formControl: string, formValidatorKey?: string, customkey?: string) {
    const fc: AbstractControl = this.addNewBalanceTypeFormGroup.get(
      `${formControl}`
    );
    if (fc.errors && fc.errors !== null) {
      let error = '';
      Object.keys(fc.errors).forEach(
        key =>
          (error = key
            ? key == formValidatorKey
              ? `BOD.error.${customkey}`
              : key !== null
              ? `BOD.error.${key}`
              : ''
            : ``)
      );
      return error;
    }
  }
}
