export class ConditionDetailComponent {
  public currencies: any[] = [];
  public messages: NotificationMessage[] = [];
  public message: NotificationMessage | undefined;
  public editactions: BodTableAction[] = editDeleteActions;
  public currencyData1: CurrencyTableSingle[] = [];

  public onValidTableActionClicked(event: BodTableAction): void { }

  public retainedCode: string = '';
  public retainedIdentifier: number = 0;
  @ViewChild('addNewConditionTemplate')
  public addNewConditionTemp: TemplateRef<any>;
  @ViewChild('addExistingConditionTemplate')
  public addExistingConditionTemp: TemplateRef<any>;
  private adminTableRef: BodTableComponent | undefined;
