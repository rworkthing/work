      return obj;
    }) || [];


    this.retainedRoleTypeData = element.productTypeBalanceTypeRoletypeRelationshipList?.map(element => {
      let obj = {} as RoleTypeSampleTable;
      obj.type = element.roleTypeCode;
      obj.accountingClassification = element.accountingClassificationCode;
      obj.beneficiary = element.payer;
      obj.obligator = element.payee;
      obj.visibility = element.visible;
      return obj;
    }) || [];

    this.retainedAggregateDetailsData = element.balanceAggregationInsertionList?.map(element => {
      let obj = {} as AggregateSampleTable;
      obj.aggregationname = String(element.name);
      obj.balancetype = element.balanceTypeCode;
      obj.aggregationLevel = String(element.aggregationLevel);
      obj.relationshiptype = element.relationshipTypeCode;
      obj.aggregates = element.aggregateInquiry1.map(aggr => ({
        id: aggr.id,
        label: aggr.label,
        value: aggr.value
      }));
      return obj;
    }) || [];
    // this.addNewBalanceTypeFormGroup.reset();

    // this.addNewBalanceTypeFormGroup.removeControl('balancesubtype');
    const balanceSubTypes =
      element.productTypeBalanceSubTypeRelationshipList
        ?.filter(item => item.balanceTypeIdentifier === element.identifier)
        .map(item => item.balanceSubTypeCode) || [];
    const periodTypes =
      element.productTypeBalanceTypePeriodList
        ?.filter(item => item.balanceTypeIdentifier === element.identifier)
        .map(item => item.periodType) || [];


    this.retainedBalancePeriodType = periodTypes

    this.addNewBalanceTypeFormGroup.reset();
    this.addNewBalanceTypeFormGroup.removeControl('balancesubtype');



    this.addNewBalanceTypeFormGroup.patchValue({
      balTypeIdentifier: element.identifier,
      balanceTypeCode: element.code,
      balanceTypeName: element.name,
      systembalance: element.systemBalance === 'Y',
      accountclassification:
        element.productTypeBalanceTypeRelationshipList?.[0]
          ?.accountingClassification || '',
      datevalue:
        element.productTypeBalanceTypeRelationshipList?.[0]?.dateValue || '',
      payer:
        element.productTypeBalanceTypeRelationshipList?.[0]?.payerIdentifier ||
        '',
      payee:
        element.productTypeBalanceTypeRelationshipList?.[0]?.payeeIdentifier ||
        '',
      chargebase:
        element.productTypeBalanceTypeRelationshipList?.[0]
          ?.chargeCalculation === 'Y',
      statementdisplay:
        element.productTypeBalanceTypeRelationshipList?.[0]
          ?.statementProcess === 'Y',
      persisted:
        element.productTypeBalanceTypeRelationshipList?.[0]?.persisted === 'Y',
      calculated:
        element.productTypeBalanceTypeRelationshipList?.[0]?.calculated === 'Y',
      autocreation:
        element.productTypeBalanceTypeRelationshipList?.[0]?.autoCreated === 'Y',
      loghistory:
        element.productTypeBalanceTypeRelationshipList?.[0]?.logAudit === 'Y',
      dailysnapshot:
        element.productTypeBalanceTypeRelationshipList?.[0]
          ?.snapshotRequired === 'Y',
      summaryrequired:
        element.productTypeBalanceTypeRelationshipList?.[0]?.summaryRequired ===
        'Y',
      inquiryrequired:
        element.productTypeBalanceTypeRelationshipList?.[0]?.enquiryRequired ===
        'Y',
      generatefinancialresults:
        element.productTypeBalanceTypeRelationshipList?.[0]
          ?.financialResultRequired === 'Y',
      glmapping:
        element.productTypeBalanceTypeRelationshipList?.[0]?.glRequired === 'Y',
      // balsubtype:
      // element.productTypeBalanceSubTypeRelationshipList?.[0]?.balanceSubTypeIdentifier||''
      // balsubtype: balanceSubTypes,
      balsubtype: balanceSubTypes,
      balperiodtype: periodTypes
    });
    this.balancesubtype =
      element?.balanceSubTypeList?.length > 0 ? true : false;
    this.addNewBalanceTypeFormGroup.addControl(
      'balancesubtype',
      this.fb.control(this.balancesubtype)
    );
    this.balanceSubTypeData.datasource.data = [];
    this.dataWithBalSubTypevalues = [];
    element.balanceSubTypeList?.forEach(element => {
      let obj = {} as BalSybTypeTable;
      obj.identifier = element.identifier;
      obj.code = element.code;
      obj.name = element.name;
      this.balanceSubTypeData.datasource.data.push(obj);
      this.dataWithBalSubTypevalues.push(obj);
    });
    this.roleTypetabledata.datasource.data = [];
    this.dataWithRoleTypevalues = [];
    element.productTypeBalanceTypeRoletypeRelationshipList?.forEach(element => {
      let obj = {} as RoleTypeSampleTable;

      obj.type = element.roleTypeCode;
      obj.accountingClassification = element.accountingClassificationCode;
      obj.beneficiary = element.payer;
      obj.obligator = element.payee;
      obj.visibility = element.visible;
      this.roleTypetabledata.datasource.data.push(obj);
      this.dataWithRoleTypevalues.push(obj);
    });

    this.aggregateTabledata.datasource.data = [];
    this.dataWithAggregatevalues = [];
    element.balanceAggregationInsertionList?.forEach(element => {
      let obj = {} as AggregateSampleTable;
      obj.aggregationname = String(element.name);
      obj.balancetype = element.balanceTypeCode;
      obj.aggregationLevel = String(element.aggregationLevel);
      obj.relationshiptype = element.relationshipTypeCode;
      obj.aggregates = element.aggregateInquiry1.map(aggr => ({
        id: aggr.id,
        label: aggr.label,
        value: aggr.value
      }));
      this.aggregateTabledata.datasource.data.push(obj);
      this.dataWithAggregatevalues.push(obj);
    });

    if (this.aggregateForm) {
      // Store the current balanceTypeCode
      const currentBalanceTypeCode =
        this.addNewBalanceTypeFormGroup.get('balanceTypeCode')?.value;

      // Reset the form
      this.aggregateForm.reset();

      // Set aggregationname to the stored balanceTypeCode
      this.aggregateForm
        .get('aggregationname')
        ?.setValue(currentBalanceTypeCode);
    }

    this.isEdit = true;
  }

  private convertAccntclassIdfrToCode(identifier: any): string | undefined {
    const item = this.accountclassifications.find(
      item => item.value === identifier
    );
    return item ? item.label : undefined;
  }
}
