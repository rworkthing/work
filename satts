            [];

          console.log(
            'Product Type Balance Type Role Type Relationship List:',
            productTypeBalanceTypeRoletypeRelationshipList
          );
          let balanceSubTypeListMapped = null;
          if (balanceSubTypeList.length > 0) {
            balanceSubTypeListMapped = balanceSubTypeList.map(
              (subType: any) => ({
                identifier: subType.identifier,
                code: subType.code,
                name: subType.name
              })
            );
