export class AddEditRoletypeComponent implements OnInit{
  public translationKey = TranslationKey;
  public addNewRoleTypeFormGroup: UntypedFormGroup;
  public roleRelationshipForm: UntypedFormGroup;
  public roleCategoryTableData: BodTableMetadata;
  formType: BodFormTypes = BodFormTypes.SUBMIT;
  public customerTypes: any[] = [];
  public roleCategoryValues: any[] = [];
  public modeOptions: ModeOptions = { input: false, reset: false };

  public roleCategoryTableActions: BodTableAction[] = roleCategoryTableActions;
  public rowLevelActionsForRoleCategory: BodTableAction[] = roleCategoryTableActionsForDelete;
  
  public dataWithRoleCategory: BodRoleCategoryTable[] = [];
  private lastModifiedIndex: number = 0;
  roleCategoryIdForm: UntypedFormGroup = new UntypedFormGroup({});
  roleCategoryValueForm: UntypedFormGroup = new UntypedFormGroup({});
  roleCategoryFormCtrlKeysId: string[] = [];
  roleCategoryFormCtrlKeysValue: string[] = [];

  @ViewChild('roleCategoryTable',  { static: false })
    public roleCategoryTable: BodTableComponent;
  
  public roleRelationshipTableActions: BodTableAction[] = roletypeaction;
  public rowLevelActionsForBasicEdit: BodTableAction[] = roletypeactionDelete;

  public onValidTableActionClicked(event: BodTableAction): void {}

  public inlineAddRowActionClick() {}
  public inlineEditRowActionClick(_event: InlineEditOutput) {}

   public onRoleCategoryTableActionClicked(event: BodTableAction) {
      if (event.id === BodTableActionType.ADD) {
        this.addRoleCategory('','');
      }
      //  else if (event.id === BodTableActionType.EDIT) {
      //   console.log('edit')
      // }
    }

  constructor(
    public roleTypeService: RoleTypeService,
    private fb: FormBuilder,
    private bodCommonDialogService: BodCommonDialogService,
    private metadataService: MetadataService //roleTypetabledata

  ) {

    this.roleCategoryTableData = {
      columns: [
        {
          name: 'roleCategoryId',
          title: 'Id',
          truncate: true,
          noOverflow: true,
          width: 12,
          widthUnit: 'rem',
          inputModeOptions: {
            type: ColumnType.select
          }
        },
        {
          name: 'roleCategoryValue',
          title: 'Value',
          truncate: true,
          noOverflow: true,
          width: 6,
          widthUnit: 'rem',
          inputModeOptions: {
            type: ColumnType.select
          }
        },
        { name: 'actionBtns', title: ' ', hasAction: true }
      ],
      datasource: new MatTableDataSource<BodRoleCategoryTable>(this.dataWithRoleCategory),
      noRecordsMessage: 'No Data Defined'
    };
  }
  ngOnInit(): void {
    this.initForm();
    this.loadDropdownData();
    // this.addNewRoleTypeFormGroup
    //   .get('roleTypeCode')
    //   ?.valueChanges.subscribe(value => {
    //     this.aggregateForm.get('aggregationname')?.setValue(value);
    //   });

    this.roleCategoryValueForm = this.fb.group({});
    this.roleCategoryIdForm = this.fb.group({});
  }
  loadDropdownData(): void {
    
    this.roleTypeService.getRoletype().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      this.customerTypes = mappedData;
    });
    this.roleTypeService.getRoleCat().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      this.roleCategoryValues = mappedData;
    });

  }

  private addRoleCategory(roleCategoryId: string,roleCategoryValue: string) {
      let updatedData = {
        id: this.lastModifiedIndex,
        roleCategoryId: '',
        action: EditTableAction.ADD,
        roleCategoryValue: ''
      };
      this.roleCategoryTable.addRow(updatedData);
      console.log(this.roleCategoryTable)
      this.roleCategoryFormCtrlKeysId = FormUtilityService.addFormControl(
        this.roleCategoryIdForm,
        'roleCategoryId',
        this.lastModifiedIndex,
        true,
        roleCategoryId
      );
      this.roleCategoryFormCtrlKeysValue = FormUtilityService.addFormControl(
        this.roleCategoryValueForm,
        'roleCategoryValue',
        this.lastModifiedIndex,
        true,
        roleCategoryValue
      );
  
      ++this.lastModifiedIndex;
      // this.addNewAttributeFormGroup.markAsDirty();
    }

    deleteRoleCategory(index: number, element: Partial<BodRoleCategoryTable>) {
        console.log(this.roleCategoryTable);
        console.log('Before deleteRow:', this.roleCategoryTable);
        console.log('Deleting row at index:', index);
    
        if (index !== undefined && index >= 0) {
          this.roleCategoryTable.deleteRow(index);
          console.log('After deleteRow:', this.roleCategoryTable);
        } else {
          console.error('Invalid index:', index);
        }
        this.roleCategoryFormCtrlKeysId = FormUtilityService.removeFormControl(
          this.roleCategoryIdForm,
          this.roleCategoryFormCtrlKeysId,
          index
        );
        this.roleCategoryFormCtrlKeysValue =
          FormUtilityService.removeFormControl(
            this.roleCategoryValueForm,
            this.roleCategoryFormCtrlKeysValue,
            index
          );
       
        // this.addNewAttributeFormGroup.markAsDirty();
      }

  private initForm(): void {
    this.addNewRoleTypeFormGroup = this.fb.group({
      roleTypeCode: new UntypedFormControl('', [Validators.required]),
      roleTypeIdentifier: [{ value: '', disabled: true }],
      roleTypeName: new UntypedFormControl(''),
      roleTypeShortName: new UntypedFormControl(''),
      systemDefined: new UntypedFormControl(''),
      isCalculated: new UntypedFormControl(''),

    });
    this.roleRelationshipForm = this.fb.group({
      customerType: new UntypedFormControl('', [Validators.required]),
      maximumAccountAllowed: new UntypedFormControl(''),
      minimum: new UntypedFormControl(''),
      maximum: new UntypedFormControl(''),
      primary: new UntypedFormControl(''),
      percentageAllowed: new UntypedFormControl(''),
      applicableOrder: new UntypedFormControl(''), 
      signatureRequired: new UntypedFormControl(''),
      ownerCategory: new UntypedFormControl(''),
      ownerSubCategory: new UntypedFormControl(''),
      additionalDetails: new UntypedFormControl('')
    });
  }
  identifierSearch(field: string) {
    this.metadataService.idfrSearch().subscribe(
      (response: string) => {
        if (field === 'roleTypeIdentifier') {
          this.addNewRoleTypeFormGroup.controls[
            'roleTypeIdentifier'
          ].setValue(response);
          this.addNewRoleTypeFormGroup.controls[
            'roleTypeIdentifier'
          ].disable();
        } else if (field === 'roleTypeIdentifier') {
          this.addNewRoleTypeFormGroup.controls[
            'roleTypeIdentifier'
          ].setValue(response);
          this.addNewRoleTypeFormGroup.controls[
            'roleTypeIdentifier'
          ].disable();
        }
      },
      error => {
        console.error('Error:', error);
      }
    );
  }

  handleRowLevelActionsforRoleRelationship(action: string, index: number) {
    if (action === 'trash') {
      this.deleteRoleRelationshipRow(index);
    }
  }
  deleteRoleRelationshipRow(index: number): void {
    this.dataWithRoleRelationshipvalues.splice(index, 1);
    if (this.roleRelationshipTabledata && this.roleRelationshipTabledata.datasource) {
      this.roleRelationshipTabledata.datasource.data = [
        ...this.dataWithRoleRelationshipvalues
      ];
    }
  }
  onAddNewRoleType() {}

  public dataWithRoleRelationshipvalues: RoleRelationshipSampleTable[] = [];
  onAddRoleRelationship(formValues: any) {
    //convert from idfr to code

    console.log("form value:", formValues);
    console.log("before push:", this.dataWithRoleRelationshipvalues);

    const selectedCustomerType = this.customerTypes.find(
      item => item.value === formValues.customerType
    );
    const custTypeName = selectedCustomerType ? selectedCustomerType.label : '';
    const newValidValue: RoleRelationshipSampleTable = {
      customerType: custTypeName || '',
      maximumAccountAllowed: formValues.maximumAccountAllowed || '',
      minimum: formValues.minimum || '',
      maximum: formValues.maximum || '',
      roleType: [
        {
          id: 0,
          label: 'Primary',
          value: formValues.primary
        },
        {
          id: 1,
          label: 'Percentage Allowed',
          value: formValues.percentageAllowed
        },
        {
          id: 2,
          label: 'Applicable Order',
          value: formValues.applicableOrder
        },
        {
          id: 3,
          label: 'Signature Required',
          value: formValues.signatureRequired
        },
        {
          id: 4,
          label: 'Owner Category',
          value: formValues.ownerCategory
        },
        {
          id: 5,
          label: 'Owner Sub Category',
          value: formValues.ownerSubCategory
        },
        {
          id: 6,
          label: 'Additional Details',
          value: formValues.additionalDetails
        }
      ]
    };
    this.dataWithRoleRelationshipvalues.push(newValidValue);
    console.log("after push:", this.dataWithRoleRelationshipvalues);
    if (this.roleRelationshipTabledata && this.roleRelationshipTabledata.datasource) {
      this.roleRelationshipTabledata.datasource.data = [
        ...this.dataWithRoleRelationshipvalues
      ];
      console.log("uodated table data:", this.roleRelationshipTabledata);
    }
    if (this.roleRelationshipForm) {
      this.roleRelationshipForm.reset();
    }
  }

  public roleRelationshipTabledata: BodTableMetadata = {
    title: 'Role Relationship Details',
    columns: [...this.roleTypeService.roleTypecolumn],
    rowLeftAction: RowLeftAction.expandableRows,
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      // pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<RoleRelationshipSampleTable>(
      this.dataWithRoleRelationshipvalues
    ),
    noRecordsMessage: 'No data Defined'
  };


  public roleRelationshipeTabledata: BodTableMetadata = {
    title: 'Aggregate Details',
    columns: [...this.roleTypeService.roleTypecolumn],
    rowLeftAction: RowLeftAction.expandableRows,
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      // pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<RoleRelationshipSampleTable>(
      this.dataWithRoleRelationshipvalues
    ),
    noRecordsMessage: 'No data Defined'
  };
  getError(formControl: string, formValidatorKey?: string, customkey?: string) {
    const fc: AbstractControl = this.addNewRoleTypeFormGroup.get(
      `${formControl}`
    );
    if (fc.errors && fc.errors !== null) {
      let error = '';
      Object.keys(fc.errors).forEach(
        key =>
          (error = key
            ? key == formValidatorKey
              ? `BOD.error.${customkey}`
              : key !== null
              ? `BOD.error.${key}`
              : ''
            : ``)
      );
      return error;
    }
  }
}
