  /** Initialize Add Balance Hold Form  */
  private initForm(): void {
    this.addEditBalanceHoldFormGroup1 = this.fb.group({});

    this.addEditBalanceHoldFormGroup = this.fb.group({
      code: new UntypedFormControl('', [Validators.required]),
      identifier: new UntypedFormControl(false, [Validators.required]),
      description: new UntypedFormControl(''),
      type: new UntypedFormControl(''),
      datatype: new UntypedFormControl(''),
      calculate: new UntypedFormControl(''),
      searchable: new UntypedFormControl(''),
      multivalueallowed: new UntypedFormControl(''),
      percentageallowed: new UntypedFormControl(''),
      classificationtype: new UntypedFormControl(''),
      // validvaluestype: new UntypedFormControl(''),
      relatetoproducttype: new UntypedFormControl(''),
      low: [''],
      high: [''],
      name: [''],
      descriptions: [''],
      validvaluestype: [''],
      productTypeCode: [{ value: '', disabled: true }],
      max: [''],
      min: [''],
      GLcategorizationAllowed: [''],
      validtype: ['']
    });
    this.addEditBalanceHoldFormGroup
      .get('code')
      ?.valueChanges.subscribe(value => {
        this.addEditBalanceHoldFormGroup
          .get('productTypeCode')
          ?.setValue(value);
      });

    this.addEditBalanceHoldFormGroup
      .get('relatetoproducttype')
      ?.valueChanges.subscribe(value => {
        this.isRelateToProductTemplate = value;
        if (!value) {
          this.isValidValueTypes = false;
          this.addEditBalanceHoldFormGroup
            .get('validtype')
            ?.setValue(false, { emitEvent: false });
        }
      });

    this.addEditBalanceHoldFormGroup
      .get('validtype')
      ?.valueChanges.subscribe(value => {
        if (this.isRelateToProductTemplate) {
          this.isValidValueTypes = value;
        } else {
          this.isValidValueTypes = false;
        }
      });
  }

  /** On click of Add Button*/
  public inlineAddRowActionClick(): void {
    this.updateMessages([]);
    this.currentMode = EditTableAction.ADD;
    this.disableAmount = false;
    this.isRequired = true;
    this.amountIsRequired = true;
    this.isHoldExpirationDateTime = false;
    this.addEditBalanceHoldFormGroup.reset();
    this.addEditBalanceHoldFormGroup.addControl(
      'referenceId',
      new FormControl('')
    );
    this.addEditBalanceHoldFormGroup.addControl(
      'referenceType',
      new FormControl('', Validators.required)
    );
    this.addEditBalanceHoldFormGroup.get('expirationDate')?.enable();
    this.addEditBalanceHoldFormGroup.get('amount')?.enable();
    this.changeDetectorRef.detectChanges();
    this.setDefaultFormValue();
  }
  private setDefaultFormValue(): void {
    this.addEditBalanceHoldFormGroup.patchValue({
      amount: new Amount(this.defaultCurrency, null),
      isHoldAll: false,
      isExpire: false
    });
    // this.effectiveDate = DateUtilityService.updateDateFormat(
    //   new Date(this.bookingDate),
    //   'MM/dd/YYYY'
    // );
    this.addEditBalanceHoldFormGroup.markAsUntouched();
    this.addEditBalanceHoldFormGroup.markAsPristine();
  }

