  public addFormControl(form, columnName, index, isRequired, defaultValue) {
    isRequired
      ? form.addControl(
        columnName + index,
        new UntypedFormControl(defaultValue, Validators.required)
      )
      : form.addControl(
        columnName + index,
        new UntypedFormControl(defaultValue)
      );
    return Object.keys(form.controls);
  }

