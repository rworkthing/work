            productTypeBalanceSubTypeRelationshipListMapped =
              productTypeBalanceSubTypeRelationshipList.map(
                (subTypeRelationship: any) => ({
                  productTypeIdentifier:
                    subTypeRelationship.productTypeIdentifier,
                  balanceTypeIdentifier:
                    subTypeRelationship.balanceTypeIdentifier,
                  balanceSubTypeIdentifier:
                    subTypeRelationship.balanceSubTypeIdentifier
                })
              );
          }

          let productTypeBalanceTypePeriodListMapped = null;
          if (productTypeBalanceTypePeriodList.length > 0) {
            productTypeBalanceTypePeriodListMapped =
