  selector: 'bod-tax-type-table',
  standalone: true,
  imports: [
    TaxTypeDefinitionDialogComponent,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    BodFormModule,
    BodTableActionsModule,
    CommonModule,
    BodTableModule,
    BodPageContainerModule,
    TranslateModule,
    BodFormModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
