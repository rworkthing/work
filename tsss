// Add this method to handle inline editing
public handleRowLevelActions(action: string, index: number) {
  if (action === 'edit') {
    this.setDataForSingleLineEditMode(index); // Enable edit mode for the specific row
  } else if (action === 'save') {
    this.saveRow(index); // Save the edited row
  } else if (action === 'delete') {
    this.deleteRow(index); // Delete the row
  } else if (action === 'reset') {
    this.resetRow(index); // Reset the row to its original state
  }
}

// Method to save the edited row
public saveRow(index: number) {
  const updatedData = this.tableWithSimpleEdit.datasource.data;
  // Perform any validation or data processing here
  this.singleRowEdit.modeOptions.input = false; // Disable edit mode
  this.simpleEditTableRef.updateDeltaForCustomColumn(EditTableAction.EDIT, index);
}

// Method to delete a row
public deleteRow(index: number) {
  const updatedData = this.tableWithSimpleEdit.datasource.data;
  updatedData.splice(index, 1); // Remove the row
  (this.tableWithSimpleEdit.datasource as MatTableDataSource<BodEditableSampleTable>).data = updatedData;
}

// Method to reset a row to its original state
public resetRow(index: number) {
  const updatedData = this.tableWithSimpleEdit.datasource.data;
  updatedData[index] = { ...this.dataForReset[index] }; // Reset to original data
  (this.tableWithSimpleEdit.datasource as MatTableDataSource<BodEditableSampleTable>).data = updatedData;
  this.singleRowEdit.modeOptions.input = false; // Disable edit mode
}
