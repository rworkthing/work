<ng-template #unitValueColumnTemplate let-element="element">
  <mat-form-field appearance="outline" fisStyle>
    <input
      matInput
      fisStyle
      type="number"
      [(ngModel)]="element.unitValue"
      [disabled]="!isDefaultToggleEnabled || disabledDurations.includes(element.durationType)"
    />
  </mat-form-field>
</ng-template>

<mat-slide-toggle [(ngModel)]="isDefaultToggleEnabled">
  Enable Unit Value
</mat-slide-toggle>


isDefaultToggleEnabled: boolean = false; // Default to disabled
