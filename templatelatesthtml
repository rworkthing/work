onPageAction(event) {
    switch (event) {
      case PageAction.EDIT:
        this.currentMode = this.pageMode = PageMode.INPUT;
        this.modeOptionsTable = { input: true, reset: false };

        this.basicDetailForm.patchValue({
          nickName: this.basicInfo[0]?.value
        });

        this.cdr.detectChanges();
        if (this.basicDetailForm.get('accountTitles')) {
          this.basicDetailForm.setControl(
            'accountTitles',
            this.accountListTableRef.tableFormGroup
          );
        } else {
          this.basicDetailForm.addControl(
            'accountTitles',
            this.accountListTableRef.tableFormGroup
          );
        }
        this.basicDetailForm.markAsPristine();
        this.setRowLevelActionButton();
        this.messages = [];
        break;
      case PageAction.CANCEL:
        this.messages = [];
        this.onReset();
        this.currentMode = this.pageMode = PageMode.INQUIRY;
        this.modeOptionsTable = { input: false, reset: false };
        break;
    }
  }




 public onPageAction(event) {
    if (event === PageAction.EDIT) {
      this.messages = [];
      this.modeOptionsSimple = { input: true, reset: false };
      this.pageModeSimple = PageMode.INPUT;
      this.rowLevelActionsForBasicEdit[0].disabled = true;
      this.dataForReset = this.tableWithSimpleEdit.datasource.data.map(obj => ({
        ...obj
      }));
      this.setSearchFieldsData(false);
      this.setOverrideDefaultFieldsData(false);
      this.setRequiredFieldsData(false);
    } else {
      this.checkStatus(false);
      this.modeOptionsSimple = { input: false, reset: true };
      this.pageModeSimple = PageMode.INQUIRY;
      this.rowLevelActionsForBasicEdit[0].disabled = false;
    }
  }
