import { Injectable } from '@angular/core';
import { HttpClient, HttpHeaders } from '@angular/common/http';
import { Observable, of } from 'rxjs';
import { BodTableAction, UIContextService } from '@bod/common';
import { Attribute } from './attribute.model';

@Injectable({
  providedIn: 'root'
})
export class MetadataService {
  private apiURL = '';
  private dataTypesUrl = '';
  private additionalDataTypesUrl = '';
  private ExistingUrl = '';
  private localeUrl = '';
  private idfrUrl = '';
  private saveUrl = '';
  private retrieveUrl = '';
  private UpdateUrl = '';
  private deleteUrl = '';

  constructor(
    private http: HttpClient,
    private uiContextService: UIContextService
  ) {
    let url =
      this.uiContextService.getModuleDataById('fis.nextgen.sdkit').valueMap
        .sdkServiceUrl.value;

    this.apiURL = url + '/basedata/attrobjtype';
    this.dataTypesUrl = url + '/basedata/attrfrmttype';
    this.additionalDataTypesUrl = url + '/basedata/attributetype';
    this.ExistingUrl = url + '/metadata/create/requirement501';
    this.localeUrl = url + '/basedata/multilingualinfo';
    this.idfrUrl = url + '/metadata/getIdentifier/req1?product-type=CASA';
    this.saveUrl = url + '/metadata/create/requirement501';
    this.retrieveUrl =
      url + '/metadata/retrieve/requirement501?metadata-config-type=Attribute';
    this.UpdateUrl = url + '/metadata/update/requirement501';
    this.deleteUrl = url + '/metadata/delete/requirement501';
  }
  idfrSearch(): Observable<string> {
    const headers = new HttpHeaders({
      'product-type': 'CASA',
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.get<string>(`${this.idfrUrl}`, { headers });
  }

  getTypes(): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.get(`${this.apiURL}`, { headers });
  }
  generateUUID(): string {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(
      /[xy]/g,
      function (c) {
        const r = (Math.random() * 16) | 0,
          v = c === 'x' ? r : (r & 0x3) | 0x8;
        return v.toString(16);
      }
    );
  }
  getDataTypes(): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.get(`${this.dataTypesUrl}`, { headers });
  }
  getProductCodes(): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.get(`${this.additionalDataTypesUrl}`, { headers });
  }
  getLocaleCodes(): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.get(`${this.localeUrl}`, { headers });
  }

  saveExistingAttribute(request: any): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.post(this.ExistingUrl, request, { headers });
  }

  getClassificationTypes(): Observable<any> {
    const classificationtypes = [
      { label: '', value: '' },
      { label: 'System Defined', value: 'systemDefined' },
      { label: 'User Defined', value: 'userDefined' }
    ];
    return of(classificationtypes);
  }

  getValidvalueTypes(): Observable<any> {
    const validvaluestypes = [
      { label: '', value: 'empty' },
      { label: 'Set Values', value: 'setvalues' },
      { label: 'Range Values', value: 'rangevalues' }
    ];
    return of(validvaluestypes);
  }

  saveAttribute(request: any): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.post(this.saveUrl, request, { headers });
  }
  retrieveAttribute(): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.get<Attribute[]>(this.retrieveUrl, { headers });
  }
  updateAttribute(request: any): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.put(this.UpdateUrl, request, { headers });
  }
  deleteAttribute(
    metadataConfigType: string,
    metadataConfigIdfr: number
  ): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    const params = {
      'metadata-config-type': metadataConfigType,
      'metadata-config-idfr': metadataConfigIdfr
    };

    return this.http.delete(this.deleteUrl, { headers, params });
  }

