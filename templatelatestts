  public onPageAction(event) {
    if (event === PageAction.EDIT) {
      this.messages = [];
      this.modeOptionsSimple = { input: true, reset: false };
      this.pageModeSimple = PageMode.INPUT;
      this.showActionsForSimple = true;
    } else {
