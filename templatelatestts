  }

  const durationValidValues = durationTableData.reduce((acc, row) => {
    if ((row && row.durationType) || row.unitValue !== undefined) {
      acc.push({
        textValue: row.durationType,
        numberValue: row.unitValue
      });
    }
    return acc;
  }, []);

  conditionDetail = {
    conditionType: 'DurationCondition',
    durationDefinition: {
      durationType: defaultRow?.durationType,
      unitValue: defaultRow?.unitValue,
      businessDayRule: formValues.processingday || ''
    },
    durationValidValues: durationValidValues
  };
