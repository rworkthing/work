    this.isAdd = false;

    if (!this.categorys.length || !this.classifications.length) {
      this.roleTypeService.getRoleCat().subscribe(data => {
        this.categorys = data.map((item: any) => ({ label: item.code, value: item.identifier }));
        this.setDropdownValues(element); // ✅ Set values after dropdown data loads
      });
    }
      else {
        this.setDropdownValues(element); // ✅ If data already exists, set values immediately
      }
      this.loadRoleRelationshipData(element);
      this.isEdit = true;
  }
