  getError(formControl: string, formValidatorKey?: string, customkey?: string) {
    const fc: AbstractControl = this.addExistingRoleTypeFormGroup.get(
      `${formControl}`
    );
    if (fc.errors && fc.errors !== null) {
      let error = '';
      Object.keys(fc.errors).forEach(
        key =>
        (error = key
          ? key == formValidatorKey
            ? `BOD.error.${customkey}`
            : key !== null
              ? `BOD.error.${key}`
              : ''
          : ``)
      );
      return error;
    }
  }

