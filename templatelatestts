      element.productTypeRoleTypeRelationshipList?.forEach(relationship => {
        let obj = {} as RoleRelationshipSampleTable;
        obj.customerType = String(relationship.customerType);
        obj.maximumAccountAllowed = relationship.maximumAccountAllowed;
        obj.minimumRequired = relationship.minimumRequired;
        obj.maximumAllowed = relationship.maximumAllowed;
        obj.roleTypes = relationship.productTypeRole.map(role => ({
          id: role.id,
          label: role.label,
          value: role.value
        }));
    
        // ✅ Add the data to the table and list
        this.roleRelationshipTabledataForExisting.datasource.data.push(obj);
        this.dataWithRoleRelationshipvaluesForExisting.push(obj);
      });
    
