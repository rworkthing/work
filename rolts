  private conditionForm(element: ConditionList): void {
    console.log('conditionForm called with element:', JSON.stringify(element));
    this.suppressSelectionDirty = true;
    this.restoringSelection = true;

    this.addNewConditionFormGroup.removeControl('curspecificvalue');

    this.isAdd = false;
    this.retainedIdentifier = element.identifier ?? 0;
    this.retainedCode = element.cdarValue || '';
    this.retainedName = element.name || '';
    this.retainedClassificationType = element.classificationType || '';
    this.retainedConditionType = element.conditionType || '';
    this.retainedOptionality = element.conditionOptionalityType || '';
    this.retainedApplicableTO = element.applicableLevel || '';
    this.retainedCustomizable = element.customizationLevel === 'Yes';
    this.retainedDefaultFlag = element.conditionDetail.value === true;
    this.retainedDefaultDate = element.conditionDetail.value || '';
    // When setting up for edit (in conditionForm or similar)
    this.retainedDurationTableData = JSON.parse(
      JSON.stringify(this.durationTableData)
    );
    // ...existing code...

    // Normalize multiAllowed to boolean
    const rawMultiAllowed =
      element.conditionDetail.checkMultipleDurationValueAllowed;
    const multiAllowed = rawMultiAllowed === 'Y' || rawMultiAllowed === 'true';

    // Retain duration fields
    this.retainedDurationClassification =
      element.conditionDetail.durationClassificationType || '';
    this.retainedProcessingdayForDuration =
      element.conditionDetail.businessDayRule || '';
    this.retainedMultivalueallowed = multiAllowed;

    const detail = element.conditionDetail;
    const durationClassification = detail.durationClassificationType;
    const validValues = detail.durationValidValues || [];
    const selectedValues = detail.durationSelectedValue || [];

    // Helper for default toggle (fixed)
    const isDefaultFixed = row =>
      selectedValues.some(
        sel =>
          sel.durationUnitType === row.durationUnitType &&
          sel.unit === row.upperLimit
      );

    // Helper for default toggle (range, single)
    const isDefaultRange = row =>
      selectedValues.some(
        sel =>
          sel.durationUnitType === row.durationUnitType &&
          sel.unit === row.unitValue
      );

    if (durationClassification === 'fixed') {
      this.durationTableData = validValues.map((row, index) => ({
        id: index,
        durationType: row.durationUnitType,
        unitValue: row.upperLimit,
        default: isDefaultFixed(row)
      }));
      this.retainedDurationTableData = JSON.parse(
        JSON.stringify(this.durationTableData)
      );
      this.toggleValue = multiAllowed;
    } else if (durationClassification === 'range') {
      if (!multiAllowed) {
        this.rangeDurationTableData = validValues.map((row, index) => ({
          id: index,
          durationType: row.durationUnitType,
          minimum: row.lowerLimit,
          maximum: row.upperLimit,
          unitValue: (() => {
            const sel = selectedValues.find(
              s => s.durationUnitType === row.durationUnitType
            );
            return sel ? sel.unit : null;
          })(),
          default:
            isDefaultRange({
              durationUnitType: row.durationUnitType,
              unitValue: (() => {
                const sel = selectedValues.find(
                  s => s.durationUnitType === row.durationUnitType
                );
                return sel ? sel.unit : null;
              })()
            }) === true
        }));
        this.retainedRangeDurationTableData = [...this.rangeDurationTableData];
      } else {
        this.multipleRangeDurationTableData = validValues.map((row, index) => ({
          id: index,
          durationType: row.durationUnitType,
          minimum: row.lowerLimit,
          maximum: row.upperLimit,
          unitValue: (() => {
            const sel = selectedValues.find(
              s => s.durationUnitType === row.durationUnitType
            );
            return sel ? sel.unit : null;
          })()
        }));
        this.retainedMultipleRangeDurationTableData = [
          ...this.multipleRangeDurationTableData
        ];
        this.toggleValue = true;
      }
    }

    // ...existing code...

    //number Condition

    const conditionDetail = element.conditionDetail;

    if (conditionDetail && typeof conditionDetail === 'object') {
      const hasValidValues =
        Array.isArray(conditionDetail.numberValidValues) &&
        conditionDetail.numberValidValues.length > 0;
      const hasMax = conditionDetail.maxValue != null;
      const hasValue = conditionDetail.value != null;

      if (hasValidValues) {
        this.retainedValidValuesTypeNumber = 'set';
      } else if (hasMax) {
        this.retainedValidValuesTypeNumber = 'range';
      } else if (hasValue) {
        this.retainedValidValuesTypeNumber = 'none';
      } else {
        this.retainedValidValuesTypeNumber = '';
      }
    } else {
      this.retainedValidValuesTypeNumber = '';
    }

    this.retainednumberValue = element.conditionDetail.value ?? 0;
    this.retainednumberLow = element.conditionDetail.minValue ?? 0;
    this.retainednumberHigh = element.conditionDetail.maxValue ?? 0;
    this.retainednumberdefaultValue = element.conditionDetail.value ?? 0;

    const details = Array.isArray(element.conditionDetail)
      ? element.conditionDetail
      : [element.conditionDetail];

    const flatSetNumberCondition: any[] = [];

    details.forEach((item, i) => {
      if (Array.isArray(item.numberValidValues)) {
        item.numberValidValues.forEach((val, index) => {
          flatSetNumberCondition.push({
            id: index,
            validvalues: val,
            default: item.value === val,
            disabled: false
          });
        });
      }
    });

    this.retainedSetNumberCondition = flatSetNumberCondition;

    // --- Primary Frequency Condition ---
    const flatSetPrimaryFrequency: primaFreq[] = [];
    const frequencyDef1 = element.conditionDetail.frequencyDefinition;
    const primaryFrequencyValidValues =
      element.conditionDetail.primaryFrequencyValidValues || [];
    primaryFrequencyValidValues.forEach((freq, index) => {
      flatSetPrimaryFrequency.push({
        id: index,
        primaryfrequency: freq.textValue,
        value: freq.numberValue ?? null,
