  conditionType: ConditionList | undefined;
  private editCondition(element: ConditionList) {
    this.conditionType = element;
    this.retainedIdentifier = element.identifier ?? 0;
    this.retainedCode = element.cdarValue || '';
    let selectedTemplate: TemplateRef<any>;
    let dialogTitle: string;
    if (element.name) {
      selectedTemplate = this.addNewConditionTemp;
      dialogTitle = 'Edit Condition';
    } else {
      selectedTemplate = this.addExistingConditionTemp;
      dialogTitle = 'Edit Existing Condition';
    }
    const dialogModel: BodCommonDialogModel = {
      formTemplate: selectedTemplate,
      title: dialogTitle
    };
    this.openDialog(dialogModel);
  }
  conditionDelete(element: ConditionList): void {
    this.conditionDetailService
      .deleteCondition('Condition', element.identifier)
      .subscribe({
        next: response => {
          const successMsg = `${element.cdarValue} Deleted Successfully`;
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(
              msg => msg.text !== successMsg
            );
          }, 4000);

          this.getNewCondition();
          this.metadataService.retrieveAll().subscribe((response: any) => {
            const firstStatus =
              response?.data &&
              response.data.length > 0 &&
              response.data[0]?.MetadataStatus
                ? response.data[0].MetadataStatus
                : null;
            const statusToSet = firstStatus || 'NEW';
            this.statusControl.setValue(statusToSet);
            this.previousStatus = statusToSet;
            this.statusChanged.emit(statusToSet);
            this.conditionDetailService.updateCurrentStatus(statusToSet);
          });
        },
        error: err => {
          // Use errorDescription from the service if available
          const errorMsg =
            err?.error?.errorDescription ||
            err?.error?.message ||
            'Delete failed due to validation error.';
          this.message = {
            code: err?.error?.errorCode || err?.status?.toString() || '400',
            text: errorMsg,
            type: NotificationMessageType.ERROR
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(msg => msg.text !== errorMsg);
          }, 20000);
        }
      });
  }
