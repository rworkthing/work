  isEdit = false;
  iconActionClicked(event: BodTableAction, element: ConditionList) {
    this.isEdit = true;
    this.messages = [];
    if (event.id === BodTableActionType.EDIT) {
      // this.editAttributes(element);
      this.editCondition(element);
    } else if (event.id === 1) {
      // Append the code to the confirm dialog message
      const confirmDataWithCode: BodConfirmDialogModel = {
        ...this.ConfirmData,
        message: `${'Are you sure you want to delete'} ${element.cdarValue}`
      };
      this.bodConfirmAlertDialogsService
        .confirm(confirmDataWithCode)
        .subscribe(val => {
          if (val) {
            this.conditionDelete(element);
          }
        });
    }
