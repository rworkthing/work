      const hasDuplicateFreq =
        new Set(freqTextValues).size !== freqTextValues.length;
      if (hasDuplicateFreq) {
        this.handleError1({
          errorCode: 'DUPLICATE_FREQUENCY_VALID_VALUE',
          status: 400
        });
        return;
      }

      conditionDetail = {
        conditionType: 'FrequencyCondition',
        frequencyDefinition: {
          primaryFrequencyType: defaultRow?.primaryfrequency,
          primaryUnits: defaultRow?.value,
          startDate: formValues.startDate || null,
          subtractSecondary: formValues.subtract,
          maxiterations: formValues.maxiterations || null,
          maxIterationDate: formValues.maxIterationDate || null,
          dateAdjustType: formValues.dateAdjustType || null,
          businessDayRule: formValues.processingday || ''
        },
        primaryFrequencyValidValues: primaryValidValues
      }; // ✅ Add secondary frequency only if toggle is enabled

      // ✅ Add secondary frequency only if toggle is enabled
      if (formValues.secondaryfre) {
        const secFreqTableData =
          this.simpleEditTableSecFre.getCurrentTableSecFreq?.() || [];

        // Check if at least one secondary frequency value is provided
        const hasSecondaryFreq = secFreqTableData.some(
          row => row && row.secondaryfrequency
        );
        if (!hasSecondaryFreq) {
          this.handleError1({
            errorCode: 'SECONDARY_FREQUENCY_REQUIRED',
            status: 400
          });
          return;
        }

        const secondaryValidValues = secFreqTableData.reduce((acc, row) => {
          if (row && row.secondaryfrequency && row.value !== undefined) {
            acc.push({
              textValue: row.secondaryfrequency,
              numberValue: Number(row.value)
            });
          }
          return acc;
        }, []);

        // Check for duplicate secondaryfrequency (textValue) only
        const secFreqTextValues = secondaryValidValues.map(v => v.textValue);
        const hasDuplicateSecFreq =
          new Set(secFreqTextValues).size !== secFreqTextValues.length;
        if (hasDuplicateSecFreq) {
          this.handleError1({
            errorCode: 'DUPLICATE_FREQUENCY_VALID_VALUE',
            status: 400
          });
          return;
        }

        const firstSecondaryRow = secondaryValidValues[0] || {};

        conditionDetail.secondaryFrequencyValidValues = secondaryValidValues;
        conditionDetail.frequencyDefinition.secondaryFrequencyType =
          firstSecondaryRow.textValue || '';
        conditionDetail.frequencyDefinition.secondaryUnits =
          firstSecondaryRow.numberValue ?? null;
      }
    } else if (formValues.conditionType === 'TextAndNumberCondition') {
      if (formValues.textnumbervalidvalue === false) {
        conditionDetail = {
          conditionType: formValues.conditionType,

          textNumberValue: {
            textValue: formValues.defaultText || '',
            numberValue: formValues.defaultNumber || 0
          }
        };
      } else {
        const localeData1 =
          this.simpleEditTableRefTextNum.getCurrentTableTextNum?.() || [];
        // const completeDeltaData1 = this.completeDeltaData1 || [];

        const hasValidValues = localeData1.some(
          row => row.validvalues && row.numbervalidvalues
        );

        if (!hasValidValues) {
          this.handleError1({
            errorCode: 'VALID_VALUE_REQUIRED',
            status: 400
          });
          return;
        } else {
          const aggregatedValidValues = localeData1.reduce((acc, row) => {
            if (row && (row.validvalues || row.numbervalidvalues)) {
              acc.push({
                textNumberValue: {
                  textValue: row.validvalues || '',
                  numberValue: row.numbervalidvalues || 0
                }
              });
            }
            return acc;
          }, []);

          // Check for duplicate text values in textAndNumberValidValues

          const defaultRow = localeData1.find(row => row && row.default);
          if (!defaultRow) {
            this.handleError1({
              errorCode: 'DEFAULT_VALUE_REQUIRED',
              status: 400
            });
            return;
          }
          const textValues = aggregatedValidValues.map(
            item => item.textNumberValue.textValue
          );
          const hasDuplicateTextValues =
            new Set(textValues).size !== textValues.length;
          if (hasDuplicateTextValues) {
            this.handleError1({
              errorCode: 'DUPLICATE_TEXT_VALID_VALUE',
              status: 400
            });
            return;
          }

          conditionDetail = {
            conditionType: formValues.conditionType,
            textNumberValue: defaultRow
              ? {
                  textValue: defaultRow.validvalues || '',
                  numberValue: defaultRow.numbervalidvalues || 0
                }
              : null,
            textAndNumberValidValues: aggregatedValidValues.reduce(
              (acc, item) => {
                acc.push(item.textNumberValue);
                return acc;
              },
              []
            )
          };
        }
        // else {
        //   this.handleError1({
        //     errorCode: 'VALID_VALUE_REQUIRED',
        //     status: 400
        //   });
      }
    } else if (formValues.conditionType === 'PercentCondition') {
      if (formValues.validValuesTypePercentage === 'none') {
        conditionDetail = {
          conditionType: formValues.conditionType,
          value: formValues.percentageValue
        };
      } else if (formValues.validValuesTypePercentage === 'range') {
        const min = formValues.percentageLow;
        const max = formValues.percentageHigh;
        const def = formValues.percentageDefaultValue;
        if (min > max) {
          this.handleErrorforMaxandMinAmt({
            errorCode: 'MAXVAL_LESS_THAN_MINVAL',
            status: 400
          });
          return;
        }

        if (def < min || def > max) {
          this.handleErrorforMaxandMinAmt({
            errorCode: 'DEFAULT_OUT_OF_RANGEPERCENT',
            status: 400
          });
          return;
        }
        conditionDetail = {
          conditionType: formValues.conditionType,
          value: formValues.percentageDefaultValue,
          minValue: formValues.percentageLow,
          maxValue: formValues.percentageHigh
        };
      }
    } else if (formValues.conditionType === 'AmountCondition') {
      // const selectedCurrency = this.currencies.find(
      //   c => c.label === formValues.currencyCode
      // );
      // const currencyIdfr = selectedCurrency ? selectedCurrency.value : null;

      if (formValues.validValuesTypeAmount === 'none') {
        conditionDetail = {
          conditionType: formValues.conditionType,
          currencyIdfr: formValues.currency,
          value: formValues.amountValue
        };
      } else if (formValues.validValuesTypeAmount === 'range') {
        const min = formValues.amountLow;
        const max = formValues.amountHigh;
        const def = formValues.amountDefaultValue;

        if (min >= max) {
          this.handleErrorforMaxandMinAmt({
            errorCode: 'MAX_LESS_THAN_MIN',
            status: 409
          });
          return;
        }

        if (def < min || def > max) {
          this.handleErrorforMaxandMinAmt({
            errorCode: 'DEFAULT_OUT_OF_RANGE',
            status: 400
          });
          return;
        }

        conditionDetail = {
          conditionType: formValues.conditionType,
          currencyIdfr: formValues.currency,
          value: def,
          minValue: min,
          maxValue: max
        };
      }
    } else if (formValues.conditionType === 'CurrencySpecificCondition') {
      if (!formValues.curspecificvalue) {
        // Only set conditionDetail and skip the rest
        conditionDetail = {
          conditionType: formValues.conditionType
        };
      } else {
        // All of this only runs if curspecificvalue is true
        if (!this.selectedRow || this.selectedRow.length === 0) {
          this.handleErrorCurrency({
            errorCode: 'NO_CURRENCY_SELECTED',
            status: 400
          });
          return;
        }

        const selectedRows = this.selectedRow as CurrencyTable[];

        const filteredRows = Object.values(
          selectedRows.reduce((acc, row) => {
            const key = row.index;
            if (
              !acc[key] ||
              (row.currencyInquiry && row.currencyInquiry.length > 0)
            ) {
              acc[key] = row;
            }
            return acc;
          }, {} as { [key: number]: CurrencyTable })
        ) as CurrencyTable[];

        const hasMissingCurrencyInquiry = filteredRows.some(
          row => !row.currencyInquiry || row.currencyInquiry.length === 0
        );

        if (hasMissingCurrencyInquiry) {
          this.handleErrorCurrency({
            errorCode: 'DEFAULT_VALUE_REQUIRED',
            status: 400
          });
          return;
        }

        const currencySpecificConditionList = filteredRows.map(detail => {
          const conditionInquiry = {
            range:
              detail.currencyInquiry.find(inquiry =>
                inquiry.label.toLowerCase().includes('range')
              )?.value || false,
            minValue:
              detail.currencyInquiry.find(inquiry =>
                inquiry.label.toLowerCase().includes('minimum')
              )?.value || null,
            maxValue:
              detail.currencyInquiry.find(inquiry =>
                inquiry.label.toLowerCase().includes('maximum')
              )?.value || null,
            defaultValue:
              detail.currencyInquiry.find(inquiry =>
                inquiry.label.toLowerCase().includes('default')
              )?.value || null
          };

          return {
            conditionType: 'AmountCondition',
            currencyCode: detail.currencyISO4217Val || null,
            currencyName: detail.code,
            currencyIdfr: detail.identifier || null,
            value: conditionInquiry.defaultValue,
            minValue: conditionInquiry.minValue,
            maxValue: conditionInquiry.maxValue
          };
        });

        conditionDetail = {
          conditionType: formValues.conditionType,
          currencySpecificDetailsList: currencySpecificConditionList
        };
      }
    } else if (formValues.conditionType === 'CurrencyCondition') {
      const selectedCurrencies = this
        .selectedRowSingleSelect as CurrencyTableSingle[];

      if (!selectedCurrencies || selectedCurrencies.length === 0) {
        this.handleError1({
          errorCode: 'CURRENCY_SELECTION_REQUIRED',
          status: 400
        });
        return;
      }

      // Find the default currency from the entire data source
      const allCurrencies = this.currencyDataSingleSelect.datasource.data;
      const defaultCurrency = allCurrencies.find(c => c.default);

      if (!defaultCurrency) {
        this.handleError1({
          errorCode: 'DEFAULT_CURRENCY_REQUIRED',
          status: 400
        });
        return;
      }

      // Check if the default currency is among the selected rows
      const isDefaultInSelected = selectedCurrencies.some(
        c => c.identifier === defaultCurrency.identifier
      );

      if (!isDefaultInSelected) {
        this.handleError1({
          errorCode: 'DEFAULT_NOT_IN_SELECTED',
          status: 400
        });
        return;
      }

      const currencyValidValues = selectedCurrencies.map(c => c.identifier);

      conditionDetail = {
        conditionType: formValues.conditionType,
        value: defaultCurrency.identifier,
        currencyValidValues: currencyValidValues
      };
    } else if (formValues.conditionType === 'DurationCondition') {
      const durationClassification = formValues.durationclassification;
      const multivalueAllowed = !!formValues.multivalueallowed;
      let tableData: any[] = [];

      let durationSelectedValue: { durationUnitType: string; unit: number }[] =
        [];
      let durationValidValues: {
        durationUnitType: string;
        lowerLimit: number;
        upperLimit: number;
      }[] = [];

      // Helper for duplicate check
      function hasDuplicate(arr: any[], keyFn: (row: any) => string) {
        const seen = new Set();
        for (const row of arr) {
          const key = keyFn(row);
          if (seen.has(key)) return true;
          seen.add(key);
        }
        return false;
      }
      // Helper for group-by
      function groupBy(arr: any[], key: string) {
        return arr.reduce((acc, row) => {
          acc[row[key]] = acc[row[key]] || [];
          acc[row[key]].push(row);
          return acc;
        }, {});
      }

      if (durationClassification === 'fixed') {
        const tableData =
          this.simpleEditTableDurationFix?.getCurrentTableDuration?.() || [];
        // --- VALIDATIONS for fixed ---
        if (!tableData || tableData.length === 0) {
          this.handleError1({ errorCode: 'DURATION_TYPE_REQUIRED' });
          return;
        }
        // At least one default
        if (!tableData.some(row => row.default)) {
          this.handleError1({ errorCode: 'DEFAULT_DURATION_VALUE_REQUIRED' });
          return;
        }
        // Duplicate duration type + unitValue
        if (
          hasDuplicate(tableData, row => `${row.durationType}|${row.unitValue}`)
        ) {
          // Find all duplicate durationType|unitValue pairs
          const seen = new Set();
          const duplicates = new Set<string>();
          tableData.forEach(row => {
            const key = `${row.durationType}|${row.unitValue}`;
            if (seen.has(key)) {
              duplicates.add(row.durationType);
            } else {
              seen.add(key);
            }
          });
          this.handleError1({
            errorCode: 'DUPLICATE_DURATION_TYPE_UNIT',
            types: Array.from(duplicates)
          });
          return;
        }

        // If multiAllowed, only one default per durationType
        if (multivalueAllowed) {
          const grouped = groupBy(tableData, 'durationType');
          const multipleDefaultsTypes: string[] = [];
          for (const [type, rows] of Object.entries(grouped)) {
            const defaults = (rows as any[]).filter(r => r.default);
            if (defaults.length > 1) {
              multipleDefaultsTypes.push(type);
            }
          }
          if (multipleDefaultsTypes.length > 0) {
            this.handleError1({
              errorCode: 'MULTIPLE_DEFAULTS_PER_TYPE',
              types: multipleDefaultsTypes
            });
            return;
          }
        }
        durationSelectedValue = tableData
          .filter(row => row.default && row.unitValue !== null)
          .map(row => ({
            durationUnitType: row.durationType,
            unit: row.unitValue !== null ? row.unitValue : 0
          }));
        durationValidValues = tableData.map(row => ({
          durationUnitType: row.durationType,
          lowerLimit: row.unitValue ?? 0,
          upperLimit: row.unitValue
        }));
      }
      // Condition 3: range + N
      else if (
        durationClassification === 'range' &&
        multivalueAllowed === false
      ) {
        tableData =
          this.simpleEditTableRangeDuration?.getCurrentTableRangeDuration?.() ||
          [];
        if (!tableData || tableData.length === 0) {
          this.handleError1({ errorCode: 'DURATION_TYPE_REQUIRED' });
          return;
        }
        // --- VALIDATIONS for range + N ---
        // At least one default
        if (!tableData.some(row => row.default)) {
          this.handleError1({ errorCode: 'DEFAULT_VALUE_REQUIRED' });
          return;
        }
        // Duplicate duration type
        if (hasDuplicate(tableData, row => row.durationType)) {
          // Find all duplicate durationType values
          const seen = new Set();
          const duplicates = new Set<string>();
          tableData.forEach(row => {
            const key = row.durationType;
            if (seen.has(key)) {
              duplicates.add(row.durationType);
            } else {
              seen.add(key);
            }
          });
          this.handleError1({
            errorCode: 'DUPLICATE_DURATION_TYPE',
            types: Array.from(duplicates)
          });
          return;
        }
        // For each row: unitValue between min/max, unitValue required if default, max > min
        for (const row of tableData) {
          if (row.default) {
            if (row.unitValue == null) {
              this.handleError1({ errorCode: 'DEFAULT_UNIT_REQUIRED' });
              return;
            }
          }
          if (row.minimum != null && row.maximum != null) {
            if (row.maximum <= row.minimum) {
              this.handleError1({ errorCode: 'MAX_LESS_THAN_MIN' });
              return;
            }
            if (
              row.unitValue != null &&
              (row.unitValue < row.minimum || row.unitValue > row.maximum)
            ) {
              this.handleError1({ errorCode: 'UNIT_OUT_OF_RANGE' });
              return;
            }
          }
        }
        durationSelectedValue = tableData
          .filter(row => row.default)
          .map(row => ({
            durationUnitType: row.durationType,
            unit: row.unitValue
          }));
        durationValidValues = tableData.map(row => ({
          durationUnitType: row.durationType,
          lowerLimit: row.minimum !== null ? row.minimum : 0,
          upperLimit: row.maximum !== null ? row.maximum : 0
        }));
      }
      // Condition 4: range + Y
      else if (
        durationClassification === 'range' &&
        multivalueAllowed === true
      ) {
        tableData =
          this.simpleEditTableMultipleRangeDuration?.getCurrentTableMultipleRangeDuration?.() ||
          [];
        if (!tableData || tableData.length === 0) {
          this.handleError1({ errorCode: 'DURATION_TYPE_REQUIRED' });
          return;
        }
        // --- VALIDATIONS for range + Y ---
        // Duplicate duration type
        if (hasDuplicate(tableData, row => row.durationType)) {
          // Find all duplicate durationType values
          const seen = new Set();
          const duplicates = new Set<string>();
          tableData.forEach(row => {
            const key = row.durationType;
            if (seen.has(key)) {
              duplicates.add(row.durationType);
            } else {
              seen.add(key);
            }
          });
          this.handleError1({
            errorCode: 'DUPLICATE_DURATION_TYPE',
            types: Array.from(duplicates)
          });
          return;
        }
        // For each row: unitValue between min/max, max > min
        for (const row of tableData) {
          if (row.minimum != null && row.maximum != null) {
            if (row.maximum <= row.minimum) {
              this.handleError1({ errorCode: 'MAX_LESS_THAN_MIN' });
              return;
            }
            if (
              row.unitValue != null &&
              (row.unitValue < row.minimum || row.unitValue > row.maximum)
            ) {
              this.handleError1({ errorCode: 'UNIT_OUT_OF_RANGE' });
              return;
            }
          }
        }
        durationSelectedValue = tableData.map(row => ({
          durationUnitType: row.durationType,
          unit: row.unitValue
        }));
        durationValidValues = tableData.map(row => ({
          durationUnitType: row.durationType,
          lowerLimit: row.minimum ?? 0,
          upperLimit: row.maximum ?? 0
        }));
      }

      conditionDetail = {
        conditionType: formValues.conditionType,
        durationClassificationType: durationClassification,
        businessDayRule: formValues.processingdayForDuration,
        // primaryFrequencyType: 'DaysBetween', // <-- hardcoded  needs to be removed after service change
        // primaryUnits: 1,  // <-- hardcoded  needs to be removed after service change
        checkMultipleDurationValueAllowed: multivalueAllowed,
        durationSelectedValue,
        durationValidValues
      };
    } else if (formValues.conditionType === 'GroupCondition') {
      // Use childTableData for the child conditions

      const childTableData =
        this.simpleEditTableRefForChild.getCurrentTableData?.() || [];
      const childConditionList = (childTableData || []).map(row => ({
        conditionIdentifier: this.childConditions.find(
          cond => cond.label === row.cdarValue
        )?.value,
        cdarValue: row.cdarValue,
        conditionOptionalityType: row.optionality
      }));

      // --- Duplicate cdarValue check across all GroupConditions ---
      // Access parent conditionData via @Input()
      if (this.conditionData && Array.isArray(this.conditionData)) {
        for (const child of childConditionList) {
          for (const cond of this.conditionData) {
            if (
              cond.conditionType === 'GroupCondition' &&
              cond.conditionDetail?.childConditionList?.some(
                c => c.cdarValue === child.cdarValue
              )
            ) {
              // If editing, skip self
              if (this.isEdit && cond.identifier === this.retainedIdentifier) {
                continue;
              }
              // Throw error with the name of the mapped GroupCondition
              this.handleError1({
                errorCode: 'CHILD_CONDITION_ALREADY_MAPPED',
                status: 400,
                groupConditionName: cond.name || cond.cdarValue,
                childCdarValue: child.cdarValue
              });
              return;
            }
          }
        }
      }

      if (!childConditionList.length) {
        this.handleError1({
          errorCode: 'CHILD_CONDITION_REQUIRED',
          status: 400
        });
        return;
      }

      // --- Duplicate cdarValue check ---
      const cdarValues = childConditionList.map(c => c.cdarValue);
      const hasDuplicateCdarValue =
        new Set(cdarValues).size !== cdarValues.length;
      if (hasDuplicateCdarValue) {
        this.handleError1({
          errorCode: 'DUPLICATE_CHILD_CONDITION',
          status: 400
        });
        return;
      }

      // --- At least one Mandatory child condition check ---
      // ...existing code...
      // --- At least one Mandatory or Proposed child condition check ---
      const hasMandatoryOrProposed = childConditionList.some(
        c =>
          c.conditionOptionalityType === 'Mandatory' ||
          c.conditionOptionalityType === 'Proposed'
      );
      if (!hasMandatoryOrProposed) {
        this.handleError1({
          errorCode: 'MANDATORY_CHILD_CONDITION_REQUIRED',
          status: 400
        });
        return;
      }
      // ...existing code...

      conditionDetail = {
        conditionType: formValues.conditionType,
        childConditionList
      };
    } else {
      if (formValues.validValuesTypeNumber === 'none') {
        conditionDetail = {
          conditionType: formValues.conditionType,
          value: formValues.numberValue
        };
      } else if (formValues.validValuesTypeNumber === 'range') {
        const min = formValues.numberLow;
        const max = formValues.numberHigh;
        const def = formValues.numberdefaultValue;
        if (min > max) {
          this.handleErrorforMaxandMinAmt({
            errorCode: 'MAXVAL_LESS_THAN_MINVAL',
            status: 400
          });
          return;
        }

        if (def < min || def > max) {
          this.handleErrorforMaxandMinAmt({
            errorCode: 'DEFAULT_OUT_OF_RANGEPERCENT',
            status: 400
          });
          return;
        }
        conditionDetail = {
          conditionType: formValues.conditionType,
          value: formValues.numberdefaultValue,
          minValue: formValues.numberLow,
          maxValue: formValues.numberHigh
        };
      } else {
        // const numberData = this.numberData || [];
        const localeTableData2 =
          this.simpleEditTableRefNum.getCurrentTableNumData?.() || [];

        const hasValidValues = localeTableData2.some(
          row => row && row.validvalues
        );

        if (!hasValidValues) {
          this.handleError1({
            errorCode: 'VALID_VALUE_REQUIRED',
            status: 400
          });
          return;
        }

        if (localeTableData2.length > 0) {
          const aggregatedValidValues = localeTableData2.reduce((acc, row) => {
            if (row && row.validvalues) {
              acc.push(row.validvalues);
            }
            return acc;
          }, []);

          const defaultRow = localeTableData2.find(row => row && row.default);
          if (!defaultRow) {
            this.handleError1({
              errorCode: 'DEFAULT_VALUE_REQUIRED',
              status: 400
            });
            return;
          }
          // Check for duplicate numberValidValues
          const hasDuplicateNumberValidValues =
            new Set(aggregatedValidValues).size !==
            aggregatedValidValues.length;
          if (hasDuplicateNumberValidValues) {
            this.handleError1({
              errorCode: 'DUPLICATE_NUMBER_VALID_VALUE',
              status: 400
            });
            return;
          }

          conditionDetail = {
            conditionType: formValues.conditionType,
            value: defaultRow ? defaultRow.validvalues : null,
            numberValidValues: aggregatedValidValues
          };
        }
      }
    }

    const customizationLevel = formValues.customizable ? 'Yes' : 'No';

    const localeTableData =
      this.simpleEditTableRef.getCurrentTableData?.() || [];

    const applicableLawMap = {
      accountonly: 'ArrangementLaw',
      productonly: 'ProductLaw',
      'product&account': 'InternalLaw'
    };

    const conditionSubjects = localeTableData.map(
      data => data.conditionSubject
    );
    const hasDuplicateSubjects =
      new Set(conditionSubjects).size !== conditionSubjects.length;

    if (hasDuplicateSubjects) {
      this.handleErrorforMaxandMinAmt({
        errorCode: 'DUPLICATE_SUBJECT_CDAR_VALUE',
        status: 400
      });
      return;
    }

    let metadataDependencyRltnpList: any[] = [];
    if (formValues.conditionType === 'GroupCondition') {
      // Use the childConditionList from the conditionDetail you just built
      const parentIdentifier = formValues.conditionIdentifier;
      const childList = conditionDetail?.childConditionList || [];
      metadataDependencyRltnpList = childList.map(child => ({
        parentIdentifier: parentIdentifier,
        parentMetadataType: 'Condition',
        childIdentifier: child.conditionIdentifier,
        childMetadataType: 'Condition'
      }));
    }

    const productTypeIdentifiers = this.metadataService.getProductTypeValues();

    const conditionData = {
      metadataType: 'Condition',
      conditionList: [
        {
          conditionAttribute: {
            identifier: formValues.conditionIdentifier,
            cdarValue: formValues.code,
            name: formValues.name,
            applicableLevel: applicableLawMap[formValues.applicableTo],
            customizationLevel: customizationLevel,
            conditionType: formValues.conditionType,
            classificationType: formValues.classificationType,
            conditionOptionalityType: formValues.optionality
          },
          conditionDetail: conditionDetail,

          conditionsRltnp:
            localeTableData.length > 0
              ? localeTableData.map(data => ({
                  objectConditionIdentifier: formValues.conditionIdentifier,
                  objectCdarValue: formValues.code,
                  subjectConditionIdentifier: this.conditions.find(
                    cond => cond.label === data.conditionSubject
                  )?.value,
                  subjectCdarValue: data.conditionSubject,
                  conditionRltnpType: data.relationship
                }))
              : undefined,

          // feConditionRltnp: {
          //   conditionIdentifier: formValues.conditionIdentifier,
          //   cdarValue:formValues.code
          // }

          feConditionRltnp:
            formValues.classificationType === 'FECondition'
              ? {
                  conditionIdentifier: formValues.conditionIdentifier,
                  cdarValue: formValues.code
                }
              : undefined,

          productTypeConditionRltnpList:
            formValues.classificationType === 'ProductTemplate'
              ? productTypeIdentifiers.map(pdTypeIdentifier => ({
                  pdTypeIdentifier: pdTypeIdentifier,
                  conditionIdentifier: formValues.conditionIdentifier,
                  cdarValue: formValues.code,
                  conditionOptionalityType: formValues.optionality,
