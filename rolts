            ? freq.textValue === frequencyDef1.primaryFrequencyType
            : freq.numberValue === frequencyDef1?.primaryUnits
      });
    });
    this.retainedPrimaryFrequency = flatSetPrimaryFrequency;

    // --- Secondary Frequency Condition ---
    const flatSetSecondaryFrequency: secFreq[] = [];
