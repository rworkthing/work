        (response: string) => {
          if (field === 'conditionIdentifier') {
            this.addNewConditionFormGroup.controls[
              'conditionIdentifier'
            ].setValue(response);
          }
          resolve();
        },
        error => {
          console.error('Error:', error);
          reject(error);
        }
      );
    });
