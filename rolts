  public rowExpanded(element: ConditionList) {
    console.log(
      'Expanded conditionDetail:',
      JSON.stringify(element.conditionDetail, null, 2)
    );

    this.messages = []; // Directly map textValidValues to the validvalues column

    if (element.conditionDetail.conditionType === 'TextCondition') {
      this.TextConditionTable.datasource.data =
        element.conditionDetail.textValidValues?.map((value: string) => ({
          validvalues: value,
          default: value === element.conditionDetail.value ? 'Y' : 'N' // You can set the default value as needed
        })) ?? [];
    }

    if (element.conditionDetail.conditionType === 'TextSpecificCondition') {
      // Pass the full detail object so all fields are available in the table row
      let secondaryConditionType = '';
      if (
        Array.isArray(element.conditionDetail.textSpecificDetailList) &&
        element.conditionDetail.textSpecificDetailList.length > 0
      ) {
        secondaryConditionType =
          element.conditionDetail.textSpecificDetailList[0].conditionType || '';
      }

      // Update the title dynamically with the extracted value
      this.TextSpecificConditionTable.title = `Text Specific -  ${secondaryConditionType}`;

      // Ensure textSpecificDetailList is updated
      this.TextSpecificConditionTable.datasource.data = [];
      this.TextSpecificConditionTable.datasource.data =
        element.conditionDetail.textSpecificDetailList ?? [];

      console.log(
        'textSpecificDetailList before assigning freqRow:',
        element.conditionDetail.textSpecificDetailList
      );
    } else if (
      element.conditionDetail.conditionType === 'TextAndNumberCondition'
    ) {
      this.TextNumberConditionTable.datasource.data =
        element.conditionDetail.textAndNumberValidValues?.map(
          (value: { textValue: string; numberValue: number }) => ({
            validvalues: value.textValue,
            numbervalidvalues: value.numberValue,

            default:
              element.conditionDetail.textNumberValue &&
              value.textValue ===
                element.conditionDetail.textNumberValue.textValue &&
              value.numberValue ===
                element.conditionDetail.textNumberValue.numberValue
                ? 'Y'
                : 'N' // Set default value
          })
        ) ?? [];
    } else if (element.conditionDetail.conditionType === 'NumberCondition') {
      this.NumberConditionTable.datasource.data =
        element.conditionDetail.numberValidValues?.map((value: string) => ({
          validvalues: value,
          default: value === element.conditionDetail.value ? 'Y' : 'N'
        })) ?? [];
    } else if (element.conditionDetail.conditionType === 'GroupCondition') {
      // Map childConditionList to the ChildConditionTable
      this.ChildConditionTable.datasource.data =
        element.conditionDetail.childConditionList?.map((child: any) => {
          // Find the matching conditionData entry by cdarValue
          const match = this.conditionData.find(
            cond => cond.cdarValue === child.cdarValue
          );
          return {
            conditionIdentifier: child.conditionIdentifier,
            cdarValue: child.cdarValue,
            optionality: child.conditionOptionalityType,
            conditionType: match ? match.conditionType : '' // Map conditionType from conditionData
          };
        }) ?? [];
    } else if (element.conditionDetail.conditionType === 'FrequencyCondition') {
      this.primFrequencyConditionTable.datasource.data =
        element.conditionDetail.primaryFrequencyValidValues?.map(
          (value: { textValue: string; numberValue: number | null }) => {
            const frequencyDef = element.conditionDetail.frequencyDefinition;

            const isDefault =
              value.textValue === frequencyDef?.primaryFrequencyType &&
              (frequencyDef?.businessDayRule // Check if businessDayRule exists
                ? true // If it exists, we consider this the default
                : value.numberValue === frequencyDef?.primaryUnits); // Otherwise, fallback to numberValue check

            return {
              primaryfrequency: value.textValue,
              value: value.numberValue,
              default: isDefault ? 'Y' : 'N'
            };
          }
        );

      this.secFrequencyConditionTable.datasource.data =
        element.conditionDetail.secondaryFrequencyValidValues?.map(
          (value: { textValue: string; numberValue: number | null }) => {
            const frequencyDef = element.conditionDetail.frequencyDefinition;
            const isDefault =
              value.textValue === frequencyDef?.secondaryFrequencyType &&
              value.numberValue === frequencyDef?.secondaryUnits;
            return {
              secondaryfrequency: value.textValue,
              value: value.numberValue,
              default: isDefault ? 'Y' : 'N'
            };
          }
        ) ?? [];
    } else if (element.conditionDetail.conditionType === 'CurrencyCondition') {
      const validCurrencyIds =
        element.conditionDetail.currencyValidValues || [];
      const defaultCurrencyId = element.conditionDetail.value;

      // Only show selected currencies
      this.currencyConditionTable.datasource.data = this.currencyData1
        .filter(currency => validCurrencyIds.includes(currency.identifier))
        .map(currency => ({
          ...currency,
          default: currency.identifier === defaultCurrencyId
        }));

      // Deep copy for retained value (optional, if you need it)
      this.retainedCurrencyConditionTableData = JSON.parse(
        JSON.stringify(this.currencyConditionTable.datasource.data)
      );

      console.log(
        'Final currency table data:',
        this.currencyConditionTable.datasource.data
      );
    } else if (element.conditionDetail.conditionType === 'DurationCondition') {
      const detail = element.conditionDetail;
      const durationClassification = detail.durationClassificationType;
      const multiAllowed = detail.checkMultipleDurationValueAllowed === 'Y';
      const validValues = detail.durationValidValues || [];
      const selectedValues = detail.durationSelectedValue || [];

      // Helper to check if a row is default
      const isDefault = row => {
        return selectedValues.some(
          sel =>
            sel.durationUnitType === row.durationUnitType &&
            // For fixed: compare upperLimit and unit
            ((durationClassification === 'fixed' &&
              sel.unit === row.upperLimit) ||
              // For range: compare unit (unitValue) with selected unit
