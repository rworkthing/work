          return {
            id: index,
            cdarValue: child.cdarValue || '',
            optionality: child.conditionOptionalityType || '',
            conditiontype: match ? match.conditionType : '' // Retain conditiontype
          };
        })
      : [];

    // Mapping logic for applicableLevel
    let applicableToValue: string | null = null;
    switch (element.applicableLevel) {
      case 'ProductLaw':
        applicableToValue = 'productonly';
        break;
      case 'ArrangementLaw':
        applicableToValue = 'accountonly';
        break;
      case 'InternalLaw':
        applicableToValue = 'product&account';
        break;
      default:
        applicableToValue = null; // or handle unknown case
    }

    const customizable: boolean = element.customizationLevel === 'Yes';

    this.addNewConditionFormGroup.patchValue({
      code: element.cdarValue,
      conditionIdentifier: element.identifier,
      name: element.name,
      conditionType: element.conditionType,
      classificationType: element.classificationType,
      optionality: element.conditionOptionalityType,
      applicableTo: applicableToValue,
      customizable: customizable,
      conditionsRltnp: element.conditionsRltnp || [],
      conditionSubject: '',
      relationship: ''
    });

    const localeList: CondTable[] = (element.conditionsRltnp || []).map(
      (locale, i) => ({
        id: i,
        conditionSubject: locale.subjectCdarValue,
        relationship: locale.conditionRltnpType
      })
    );
    this.localeTableData = localeList;

    if (element.conditionType === 'GroupCondition') {
      const childList: ChildTable[] = (
        element.conditionDetail.childConditionList || []
      ).map((child, i) => {
        // Find the matching conditionData entry by cdarValue
        const match = this.conditionData?.find(
          cond => cond.cdarValue === child.cdarValue
        );
        return {
          id: i,
          cdarValue: child.cdarValue,
          optionality: child.conditionOptionalityType,
          conditiontype: match ? match.conditionType : '' // Patch conditionType from conditionData
        };
      });
      this.childTableData = childList;
    }

    if (element.conditionType === 'TextSpecificCondition') {
      const textSpecificList: textSpecificTable[] = (
        element.conditionDetail.textSpecificDetailList || []
      ).map((detail, i) => ({
        id: i,
        specifictext: detail.specificText,
        // Fix start property - only set for DateCondition, ensure it's string type
        start:
          detail.conditionType === 'DateCondition'
            ? String(detail.textSpecificDetailCondition?.value || '')
            : undefined,

        // Fix defaultflag property - only set for FlagCondition, ensure it's boolean type
        defaultflag:
          detail.conditionType === 'FlagCondition'
            ? Boolean(detail.textSpecificDetailCondition?.value)
            : undefined,

        currency: detail.textSpecificDetailCondition?.currencyIdfr,
        amountLow: detail.textSpecificDetailCondition?.minValue,
        amountHigh: detail.textSpecificDetailCondition?.maxValue,
        amountDefaultValue: detail.textSpecificDetailCondition?.value,
        percentageLow: detail.textSpecificDetailCondition?.minValue,
        percentageHigh: detail.textSpecificDetailCondition?.maxValue,
        percentageDefaultValue: detail.textSpecificDetailCondition?.value,
        textSpecificinquiry: detail.secondaryRange || [],
        primFreqTableData: (
          detail.textSpecificDetailCondition?.primaryFrequencyValidValues || []
        ).map((freq, index) => {
          const isDefault =
            freq.textValue ===
              detail.textSpecificDetailCondition?.frequencyDefinition
                ?.primaryFrequencyType &&
            (detail.textSpecificDetailCondition?.frequencyDefinition
              ?.businessDayRule
              ? true
              : freq.numberValue ===
                detail.textSpecificDetailCondition?.frequencyDefinition
                  ?.primaryUnits);

          return {
            id: index,
            primaryfrequency: freq.textValue,
            value: freq.numberValue ?? null,
            default: isDefault ? true : false // Set the default value
          };
        }),

        secFreqTableData: (
          detail.textSpecificDetailCondition?.secondaryFrequencyValidValues ||
          []
        ).map((freq, index) => ({
          id: index,
          secondaryfrequency: freq.textValue,
          value: freq.numberValue ?? null
        })),

        // Add TextCondition mapping here
        localeTableData3: (
          detail.textSpecificDetailCondition?.textValidValues || []
        ).map((value, index) => ({
          id: index,
          validvalues: value,
          default:
            String(value) === String(detail.textSpecificDetailCondition?.value)
              ? true
              : false
        })),

        //Add Number Condition
        // Add this after the TextCondition mapping and before the TextandNumberCondition section

        //Add Number Condition
        localeTableData2: (
          detail.textSpecificDetailCondition?.numberValidValues || []
        ).map((value, index) => ({
          id: index,
          validvalues: value,
          default:
            value === detail.textSpecificDetailCondition?.value ? true : false
        })),

        // Also add these properties to handle NumberCondition range type
        numberLow: detail.textSpecificDetailCondition?.minValue,
        numberHigh: detail.textSpecificDetailCondition?.maxValue,
        numberdefaultValue: detail.textSpecificDetailCondition?.value,
        validValuesTypeNumber: (() => {
          // Determine the type based on the presence of data
          if (
            detail.textSpecificDetailCondition?.numberValidValues &&
            detail.textSpecificDetailCondition.numberValidValues.length > 0
          ) {
            return 'set';
          } else if (
            detail.textSpecificDetailCondition?.minValue !== null &&
            detail.textSpecificDetailCondition?.maxValue !== null
          ) {
            return 'range';
          }
          return 'none';
        })(),

        //Add TextandNumberCondition
        localeTableData1: (
          detail.textSpecificDetailCondition?.textAndNumberValidValues || []
        ).map((value, index) => ({
          id: index,
          validvalues: value.textValue,
          numbervalidvalues: value.numberValue,
          default:
            detail.textSpecificDetailCondition?.textNumberValue &&
            value.textValue ===
              detail.textSpecificDetailCondition.textNumberValue.textValue &&
            value.numberValue ===
              detail.textSpecificDetailCondition.textNumberValue.numberValue
              ? true
              : false
        })),

        // Add DurationCondition mapping here
        durationclassification:
          detail.textSpecificDetailCondition?.durationClassificationType || '',
        processingdayForDuration:
          detail.textSpecificDetailCondition?.businessDayRule || '',
        multivalueallowed:
          detail.textSpecificDetailCondition
            ?.checkMultipleDurationValueAllowed === true ||
          detail.textSpecificDetailCondition
            ?.checkMultipleDurationValueAllowed === 'Y',

        // Duration table data based on classification type
        durationTableData: (() => {
          if (
            detail.textSpecificDetailCondition?.durationClassificationType ===
            'fixed'
          ) {
            const validValues =
              detail.textSpecificDetailCondition?.durationValidValues || [];
            const selectedValues =
              detail.textSpecificDetailCondition?.durationSelectedValue || [];

            return validValues.map((row, index) => ({
              id: index,
              durationType: row.durationUnitType,
              unitValue: row.upperLimit,
              default: selectedValues.some(
                sel =>
                  sel.durationUnitType === row.durationUnitType &&
                  sel.unit === row.upperLimit
              )
            }));
          }
          return [];
        })(),

        rangeDurationTableData: (() => {
          if (
            detail.textSpecificDetailCondition?.durationClassificationType ===
              'range' &&
            !detail.textSpecificDetailCondition
              ?.checkMultipleDurationValueAllowed
          ) {
            const validValues =
              detail.textSpecificDetailCondition?.durationValidValues || [];
            const selectedValues =
              detail.textSpecificDetailCondition?.durationSelectedValue || [];

            return validValues.map((row, index) => ({
              id: index,
              durationType: row.durationUnitType,
              minimum: row.lowerLimit,
              maximum: row.upperLimit,
              unitValue: (() => {
                const sel = selectedValues.find(
                  s => s.durationUnitType === row.durationUnitType
                );
                return sel ? sel.unit : null;
              })(),
              default: selectedValues.some(
                sel => sel.durationUnitType === row.durationUnitType
              )
            }));
          }
          return [];
        })(),

        multipleRangeDurationTableData: (() => {
          if (
            detail.textSpecificDetailCondition?.durationClassificationType ===
              'range' &&
            detail.textSpecificDetailCondition
              ?.checkMultipleDurationValueAllowed
          ) {
            const validValues =
              detail.textSpecificDetailCondition?.durationValidValues || [];
            const selectedValues =
              detail.textSpecificDetailCondition?.durationSelectedValue || [];

            return validValues.map((row, index) => ({
              id: index,
              durationType: row.durationUnitType,
              minimum: row.lowerLimit,
              maximum: row.upperLimit,
              unitValue: (() => {
                const sel = selectedValues.find(
                  s => s.durationUnitType === row.durationUnitType
                );
                return sel ? sel.unit : null;
              })()
              // No default column for multiple range duration
            }));
          }
          return [];
        })(),

        currencyData1: (() => {
          if (detail.conditionType === 'CurrencyCondition') {
            // Map all available currencies and mark selected ones
            const validCurrencyIds =
              detail.textSpecificDetailCondition?.currencyValidValues || [];
            const defaultCurrencyId = detail.textSpecificDetailCondition?.value;

            return this.currencyData1.map(currency => ({
              ...currency,
              default: currency.identifier === defaultCurrencyId
            }));
          }
          return [];
        })(),

        selectedRowSingleSelect: (() => {
          if (detail.conditionType === 'CurrencyCondition') {
            const validCurrencyIds =
              detail.textSpecificDetailCondition?.currencyValidValues || [];
            const defaultCurrencyId = detail.textSpecificDetailCondition?.value;

            // Filter currencies to only include selected ones
            return this.currencyData1
              .filter(currency =>
                validCurrencyIds.includes(currency.identifier)
              )
              .map(currency => ({
                ...currency,
                default: currency.identifier === defaultCurrencyId
              }));
          }
          return [];
        })(),

        // ...existing code...
        currencySpecificData: (() => {
          if (detail.conditionType === 'CurrencySpecificCondition') {
            const detailsList =
              detail.textSpecificDetailCondition?.currencySpecificDetailsList ||
              [];
            const secondaryRange = detail.secondaryRange || [];
            return this.currencySpecificData.datasource.data.map(currency => {
              const match = detailsList.find(
                d => d.currencyIdfr === currency.identifier
              );
              if (match) {
                const hasRange =
                  match.minValue != null && match.maxValue != null;
                return {
                  ...currency,
                  minimum: match.minValue ?? 0,
                  maximum: match.maxValue ?? 0,
                  defaultValue: match.value ?? 0,
                  range: hasRange,
                  currencyInquiry: [
                    {
                      id: 0,
                      label: 'Range',
                      value: hasRange ? 'Y' : 'N'
                    },
                    ...(hasRange
                      ? [
                          {
                            id: 1,
                            label: 'Minimum amount',
                            value: match.minValue
                          },
                          {
                            id: 2,
                            label: 'Maximum amount',
                            value: match.maxValue
                          },
                          {
                            id: 3,
                            label: 'Default amount',
                            value: match.value
                          }
                        ]
                      : [
                          {
                            id: 1,
                            label: 'Default amount',
                            value: match.value
                          }
                        ])
                  ]
                };
              }
              return { ...currency };
            });
          }
          return [];
        })(),

        selectedRow: (() => {
          if (detail.conditionType === 'CurrencySpecificCondition') {
            const selectedCurrencies = Array.isArray(
              detail.textSpecificDetailCondition?.currencySpecificDetailsList
            )
              ? detail.textSpecificDetailCondition.currencySpecificDetailsList
              : [];
            return this.currencySpecificData.datasource.data
              .filter(currency =>
                selectedCurrencies.some(
                  sel => sel.currencyIdfr === currency.identifier
                )
              )
              .map(currency => {
                const match = selectedCurrencies.find(
                  sel => sel.currencyIdfr === currency.identifier
                );
                if (match) {
                  const hasRange =
                    match.minValue != null && match.maxValue != null;
                  return {
                    ...currency,
                    currencyInquiry: [
                      {
                        id: 0,
                        label: 'Range',
                        value: hasRange ? 'Y' : 'N'
                      },
                      ...(hasRange
                        ? [
                            {
                              id: 1,
                              label: 'Minimum amount',
                              value: match.minValue
                            },
                            {
                              id: 2,
                              label: 'Maximum amount',
                              value: match.maxValue
                            },
                            {
                              id: 3,
                              label: 'Default amount',
                              value: match.value
                            }
                          ]
                        : [
                            {
                              id: 1,
                              label: 'Default amount',
                              value: match.value
                            }
                          ])
                    ]
                  };
                }
                return { ...currency };
              });
          }
          return [];
        })(),
        // ...existing code...

        secondoryconditiontypeforText:
          element.conditionDetail?.textSpecificDetailList?.[0]?.conditionType ||
          '',
        processingday:
          detail.textSpecificDetailCondition?.frequencyDefinition
            ?.businessDayRule || '', // Patch processingday
        subtract:
          detail.textSpecificDetailCondition?.frequencyDefinition
            ?.subtractSecondary ?? false, // Patch subtract
        secondaryfre:
          (
            detail.textSpecificDetailCondition?.secondaryFrequencyValidValues ||
            []
          ).length > 0
      }));

      this.textSpecificData = textSpecificList;
    }

    if (element.conditionType === 'TextSpecificCondition') {
      // If you want to patch the secondary condition type from the detail list, use the first item's conditionType
      const secondaryType =
        element.conditionDetail?.textSpecificDetailList?.[0]?.conditionType ||
        '';
      this.addNewConditionFormGroup.patchValue({
        secondoryconditiontypeforText: secondaryType
      });
    }

    if (element.conditionType === 'DateCondition') {
      this.addNewConditionFormGroup.patchValue({
        start: element.conditionDetail.value
      });
    } else if (element.conditionType === 'FlagCondition') {
      this.addNewConditionFormGroup.patchValue({
        defaultflag: element.conditionDetail.value
      });
    } else if (element.conditionType === 'FrequencyCondition') {
      this.addNewConditionFormGroup.patchValue({
        processingday:
          element.conditionDetail.frequencyDefinition?.businessDayRule || '',
        subtract:
          element.conditionDetail.frequencyDefinition?.subtractSecondary ??
          false
      });
      // Set the secondaryfre toggle ON if there are secondaryFrequencyValidValues
      const hasSecondary =
        Array.isArray(element.conditionDetail.secondaryFrequencyValidValues) &&
        element.conditionDetail.secondaryFrequencyValidValues.length > 0;
      this.secondaryfre = hasSecondary;
      // Instead of addControl, just patch the value:
      this.addNewConditionFormGroup.patchValue({
        secondaryfre: this.secondaryfre
      });
    } else if (element.conditionType === 'TextCondition') {
      if (
        element.conditionDetail.textValidValues &&
        element.conditionDetail.textValidValues.length > 0
      ) {
        this.addNewConditionFormGroup.patchValue({
          validvalue: true,
          conditionDetail: element.conditionDetail || [],
          validvalues: null,
          default: null
        });
      } else {
        this.addNewConditionFormGroup.patchValue({
          defaultValueText: element.conditionDetail.value
        });
      }
    } else if (element.conditionType === 'CurrencySpecificCondition') {
      this.curspecificvalue =
        element?.conditionDetail.currencySpecificDetailsList?.length > 0
          ? true
          : false;
      this.addNewConditionFormGroup.addControl(
        'curspecificvalue',
        this.fb.control(this.curspecificvalue)
      );
      this.isHidden = !this.curspecificvalue;

      const selectedCurrencies: CurrencyTable[] = [];

      element.conditionDetail.currencySpecificDetailsList?.forEach(detail => {
        const matchingCurrency = this.currencySpecificData.datasource.data.find(
          item => item.currencyISO4217Val === detail.currencyCode
        );

        if (matchingCurrency) {
          // Extract values from currencyRange array by label
          const minObj = detail.currencyRange?.find(cur =>
            cur.label?.toLowerCase().includes('minimum')
          );
          const maxObj = detail.currencyRange?.find(cur =>
            cur.label?.toLowerCase().includes('maximum')
          );
          const defObj = detail.currencyRange?.find(cur =>
            cur.label?.toLowerCase().includes('default')
          );

          const hasMin =
            minObj &&
            minObj.value !== undefined &&
            minObj.value !== null &&
            minObj.value !== '';
          const hasMax =
            maxObj &&
            maxObj.value !== undefined &&
            maxObj.value !== null &&
            maxObj.value !== '';

          const hasRange = hasMin && hasMax;

          // Always add the "Range" row
          const currencyInquiry = [
            {
              id: 0,
              label: 'Range',
              value: hasRange ? 'Y' : 'N'
            }
          ];

          if (hasRange) {
            currencyInquiry.push(
              {
                id: 1,
                label: 'Minimum amount',
                value: minObj ? minObj.value : null
              },
              {
                id: 2,
                label: 'Maximum amount',
                value: maxObj ? maxObj.value : null
              },
              {
                id: 3,
                label: 'Default amount',
                value: defObj ? defObj.value : null
              }
            );
          } else {
            currencyInquiry.push({
              id: 1,
              label: 'Default Amount',
              value: defObj ? defObj.value : null
            });
          }

          matchingCurrency.currencyInquiry = currencyInquiry;
          selectedCurrencies.push(matchingCurrency);
        }
      });

      this.currencySpecificData.datasource.data.forEach(row => {
        if (selectedCurrencies.includes(row)) {
          this.expandableTableRef.selection.select(row);
        }
      });

      this.selectedRow = selectedCurrencies;
    } else if (element.conditionType === 'CurrencyCondition') {
      // Retain current selection and default before updating
      this.retainCurrencyConditionSelection();

      // Retain current selection and default before updating
      this.retainCurrencyConditionSelection();

      const selectedCurrencyId = element.conditionDetail.value;
      const validCurrencyIds =
        element.conditionDetail.currencyValidValues || [];

      // Set up the selectedRowSingleSelect for the new data
      this.selectedRowSingleSelect = this.currencyData1
        .filter(c => validCurrencyIds.includes(c.identifier))
        .map(c => ({
          ...c,
          default: c.identifier === selectedCurrencyId
        }));

      // Update the datasource for the table
      this.currencyDataSingleSelect.datasource.data = this.currencyData1.map(
        c => ({
          ...c,
          default: c.identifier === selectedCurrencyId
        })
      );

      // Optionally, patch the form control if you have one for currency
      this.addNewConditionFormGroup.patchValue({
        currency: selectedCurrencyId
      });
    } else if (element.conditionType === 'DurationCondition') {
      // Normalize multiAllowed to boolean
      const rawMultiAllowed =
        element.conditionDetail.checkMultipleDurationValueAllowed;
      const multiAllowed =
        rawMultiAllowed === 'Y' || rawMultiAllowed === 'true';

      this.addNewConditionFormGroup.patchValue({
        durationclassification:
          element.conditionDetail.durationClassificationType,
        multivalueallowed: multiAllowed,
        processingdayForDuration: element.conditionDetail.businessDayRule
      });

      const detail = element.conditionDetail;
      const durationClassification = detail.durationClassificationType;
      const validValues = detail.durationValidValues || [];
      const selectedValues = detail.durationSelectedValue || [];

      // Helper for default toggle (fixed)
      const isDefaultFixed = row =>
        selectedValues.some(
          sel =>
            sel.durationUnitType === row.durationUnitType &&
            sel.unit === row.upperLimit
        );

      // Helper for default toggle (range, single)
      const isDefaultRange = row =>
        selectedValues.some(
          sel =>
            sel.durationUnitType === row.durationUnitType &&
            sel.unit === row.unitValue
        );

      if (durationClassification === 'fixed') {
        // Condition 1 & 2: Fixed, multiAllowed true/false
        this.durationTableData = validValues.map((row, index) => ({
          id: index,
          durationType: row.durationUnitType,
          unitValue: row.upperLimit,
          default: isDefaultFixed(row) // boolean: true for ON, false for OFF
        }));
        this.toggleValue = multiAllowed;
      } else if (durationClassification === 'range') {
        if (!multiAllowed) {
          // Condition 3: Range, multiAllowed false
          this.rangeDurationTableData = validValues.map((row, index) => ({
            id: index,
            durationType: row.durationUnitType,
            minimum: row.lowerLimit,
            maximum: row.upperLimit,
            unitValue: (() => {
              const sel = selectedValues.find(
                s => s.durationUnitType === row.durationUnitType
              );
              return sel ? sel.unit : null;
            })(),
            default:
              isDefaultRange({
                durationUnitType: row.durationUnitType,
                unitValue: (() => {
                  const sel = selectedValues.find(
                    s => s.durationUnitType === row.durationUnitType
                  );
                  return sel ? sel.unit : null;
                })()
              }) === true // boolean: true for ON, false for OFF
          }));
          // this.toggleValue = false;
        } else {
          // Condition 4: Range, multiAllowed true
          this.multipleRangeDurationTableData = validValues.map(
            (row, index) => ({
              id: index,
              durationType: row.durationUnitType,
              minimum: row.lowerLimit,
              maximum: row.upperLimit,
              unitValue: (() => {
                const sel = selectedValues.find(
                  s => s.durationUnitType === row.durationUnitType
                );
                return sel ? sel.unit : null;
              })()
              // No default column for multiAllowed true
            })
          );
          this.toggleValue = true;
        }
      }
    } else if (element.conditionType === 'TextAndNumberCondition') {
      if (
        element.conditionDetail.textAndNumberValidValues &&
        element.conditionDetail.textAndNumberValidValues.length > 0
      ) {
        this.addNewConditionFormGroup.patchValue({
          textnumbervalidvalue: true,
          conditionDetail: element.conditionDetail || [],
          validvalues: '',
          numbervalidvalues: null,
          default: null
        });
      } else if (element.conditionDetail.textNumberValue) {
        this.addNewConditionFormGroup.patchValue({
          defaultText: element.conditionDetail.textNumberValue.textValue,
          defaultNumber: element.conditionDetail.textNumberValue.numberValue
        });
      }
    } else if (element.conditionType === 'PercentCondition') {
      if (
        element.conditionDetail.minValue !== null &&
        element.conditionDetail.maxValue !== null
      ) {
        this.addNewConditionFormGroup.patchValue({
          validValuesTypePercentage: 'range',
          percentageDefaultValue: element.conditionDetail.value,
          percentageLow: element.conditionDetail.minValue,
          percentageHigh: element.conditionDetail.maxValue
        });
      } else {
        this.addNewConditionFormGroup.patchValue({
          validValuesTypePercentage: 'none',
          percentageValue: element.conditionDetail.value
        });
      }
    } else if (element.conditionType === 'AmountCondition') {
      if (
        element.conditionDetail.minValue !== null &&
        element.conditionDetail.maxValue !== null
      ) {
        this.addNewConditionFormGroup.patchValue({
          validValuesTypeAmount: 'range',
          currency: element.conditionDetail.currencyIdfr,
          amountDefaultValue: element.conditionDetail.value,
          amountLow: element.conditionDetail.minValue,
          amountHigh: element.conditionDetail.maxValue
        });
      } else {
        this.addNewConditionFormGroup.patchValue({
          validValuesTypeAmount: 'none',
          currency: element.conditionDetail.currencyIdfr,
          amountValue: element.conditionDetail.value
        });
      }
    } else if (element.conditionType === 'NumberCondition') {
      if (
        element.conditionDetail.minValue !== null &&
        element.conditionDetail.maxValue !== null
      ) {
        this.addNewConditionFormGroup.patchValue({
          validValuesTypeNumber: 'range',
          numberdefaultValue: element.conditionDetail.value,
          numberLow: element.conditionDetail.minValue,
          numberHigh: element.conditionDetail.maxValue
        });
      } else if (
        element.conditionDetail.numberValidValues &&
        element.conditionDetail.numberValidValues.length > 0
      ) {
        this.addNewConditionFormGroup.patchValue({
          validValuesTypeNumber: 'set',
          conditionDetail: element.conditionDetail || [],
          validvalues: null,
          default: null
        });
      } else {
        this.addNewConditionFormGroup.patchValue({
          validValuesTypeNumber: 'none',
          numberValue: element.conditionDetail.value
        });
      }
    }

    const localeList1: textNumCond[] = (
      element.conditionDetail.textAndNumberValidValues || []
    ).map((locale, i) => ({
      id: i,
      validvalues: locale.textValue,
      numbervalidvalues: locale.numberValue,

      default:
        element.conditionDetail.textNumberValue &&
        locale.textValue ===
          element.conditionDetail.textNumberValue.textValue &&
        locale.numberValue ===
          element.conditionDetail.textNumberValue.numberValue
          ? true
          : false
    }));
    this.localeTableData1 = localeList1;

    const localeList2: NumCond[] = (
      element.conditionDetail.numberValidValues || []
    ).map((value, i) => ({
      id: i,
      validvalues: Number(value),

      default:
        Number(value) === Number(element.conditionDetail.value) ? true : false
    }));

    this.localeTableData2 = localeList2;

    const localeList3: TextCond[] = (
      element.conditionDetail.textValidValues || []
    ).map((value, i) => ({
      id: i,
      validvalues: value,

      default: value === element.conditionDetail.value ? true : false
    }));

    this.localeTableData3 = localeList3;

    const frequencyDef = element.conditionDetail.frequencyDefinition;
    const primFreqList: primaFreq[] = (
      element.conditionDetail.primaryFrequencyValidValues || []
    ).map((freq, i) => ({
      id: i,
      primaryfrequency: freq.textValue,
      value: freq.numberValue ?? null,
      default:
        frequencyDef && frequencyDef.primaryFrequencyType
          ? freq.textValue === frequencyDef.primaryFrequencyType
          : freq.numberValue === frequencyDef?.primaryUnits
    }));

    this.primFreqTableData = primFreqList;

    const secFreqList: secFreq[] = (
      element.conditionDetail.secondaryFrequencyValidValues || []
    ).map((freq, i) => ({
      id: i,
      secondaryfrequency: freq.textValue,
      value: freq.numberValue ?? null
    }));

    this.secFreqTableData = secFreqList;

    this.isEdit = true;

    setTimeout(() => {
      this.suppressSelectionDirty = false;
      this.restoringSelection = false;

      this.addNewConditionFormGroup.markAsPristine();
      this.addNewConditionFormGroup.markAsUntouched();
    });
  }

  private retainCurrencyConditionSelection() {
    // Retain the currently selected rows and default currency before updating
    this.retainedCurrencyConditionTableData = JSON.parse(
      JSON.stringify(this.selectedRowSingleSelect)
    );
    const defaultRow = this.selectedRowSingleSelect.find(row => row.default);
    this.retainedDefaultCurrencyId = defaultRow
      ? defaultRow.identifier.toString()
      : null;
  }

