          <input
            matInput
            formControlName="start"
            [matDatepicker]="datePicker"
            [matDatepickerFilter]="dateRange.filter"
            placeholder="mm/dd/yyyy"
          />
          <mat-datepicker-toggle
            fisStyle
            matSuffix
            [for]="datePicker"
          ></mat-datepicker-toggle>
          <mat-datepicker #datePicker [xPosition]="'end'"></mat-datepicker>

          <mat-error>
            {{ getError('start', addNewConditionFormGroup) | translate }}
          </mat-error>
        </mat-form-field>
      </bod-control-group>
