  public message: NotificationMessage | undefined;
  TransactionTypeDelete(element: TransactionTypeList): void {
    if (element.identifier) {
      this.transactionTypeService
        .deleteTransactionType('TransactionType', element.identifier)
        .subscribe(response => {
          const successMsg = `${element.code} Deleted Successfully`;
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(
              msg => msg.text !== successMsg
            );
          }, 20000);

          this.getNewTransactionType();
          this.metadataService.retrieveAll().subscribe((response: any) => {
            const firstStatus =
              response?.data &&
              response.data.length > 0 &&
              response.data[0]?.MetadataStatus
                ? response.data[0].MetadataStatus
                : null;
            const statusToSet = firstStatus || 'NEW';
            this.statusControl.setValue(statusToSet);
            this.previousStatus = statusToSet;
            this.statusChanged.emit(statusToSet);
            this.transactionTypeService.updateCurrentStatus(statusToSet);
          });
        });
    } else {
      const stdIdentifier =
        element.productTypePostingSTDRltnpList?.[0]?.postingStdIdentifier;
      const stdCode =
        element.productTypePostingSTDRltnpList?.[0]?.postingStdCode;
      this.transactionTypeService
        .deleteTransactionType('TransactionType', stdIdentifier)
        .subscribe(response => {
          const successMsg = `${stdCode} Deleted Successfully`;
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(
              msg => msg.text !== successMsg
            );
          }, 20000);

          this.getNewTransactionType();
          this.metadataService.retrieveAll().subscribe((response: any) => {
            const firstStatus =
              response?.data &&
              response.data.length > 0 &&
              response.data[0]?.MetadataStatus
                ? response.data[0].MetadataStatus
                : null;
            const statusToSet = firstStatus || 'NEW';
            this.statusControl.setValue(statusToSet);
            this.previousStatus = statusToSet;
            this.statusChanged.emit(statusToSet);
            this.transactionTypeService.updateCurrentStatus(statusToSet);
          });
        });
    }
  }

  getCountersForChannel(channel: any, allCounters: any[]): any[] {
    if (!Array.isArray(allCounters)) {
      return [];
    }
    return allCounters.filter(
      c =>
        c.resourceItemIdentifier === channel.resourceItemIdentifier &&
        c.productTypeIdentifier === channel.productTypeIdentifier &&
        c.postingStdIdentifier === channel.postingStdIdentifier
    );
  }

  editTransactionType: TransactionTypeList | undefined;
  private editTransactionypes(element: TransactionTypeList) {
    this.editTransactionType = element;
    let selectedTemplate: TemplateRef<any>;
    let dialogTitle: string;
    if (element.name) {
      selectedTemplate = this.addNewTransactionTypeTemp;
      dialogTitle = 'Edit Transaction Type';
    } else {
      selectedTemplate = this.addExistingTransactionTypeTemp;
      dialogTitle = 'Edit Existing Transaction Type';
    }
    const dialogModel: BodCommonDialogModel = {
      formTemplate: selectedTemplate,
      title: dialogTitle
    };
    this.openDialog(dialogModel);
  }
}



























