  public getTaxTypeTableMetadata(
    identifier: number
  ): BodTableMetadata | undefined {
    const raw = this.taxTypeTableMap[identifier];
    if (!raw) return undefined;
    // Always return a new object and a new MatTableDataSource with a cloned array
    return {
      ...raw,
      columns: [...raw.columns],
      datasource: new MatTableDataSource(
        Array.isArray(raw.datasource.data) ? [...raw.datasource.data] : []
      ),
      title: raw.title,
      rowLeftAction: raw.rowLeftAction,
      noRecordsMessage: raw.noRecordsMessage
    };
  }

  public rowExpanded(element: TransactionTypeList) {
    this.postingTextTable.datasource.data = Array.isArray(
      element.postingRepeatedTextList
    )
      ? element.postingRepeatedTextList.map((item, index) => {
          const languageEntry = Array.isArray(
            element.postingTextLanguageRltnpList
          )
            ? element.postingTextLanguageRltnpList[index]
            : undefined;
          const eventCode = this.events.find(
            e => e.value === item.eventTypeIdentifier
          )?.label;
          const channelCode = this.channels.find(
            c => c.value === item.deliveryChannel
          )?.label;

          return {
            event: eventCode,
            channel: channelCode,
            language: languageEntry?.isoCode || 'N/A',
            text: languageEntry?.text || 'N/A'
          };
        })
      : [];

    // External Transaction Table
    this.externalTransactionTable.datasource.data = Array.isArray(
      element.externalTransactionTypePostingSTDRltnpDpList
    )
      ? element.externalTransactionTypePostingSTDRltnpDpList.map(item => ({
          code: item.code || '',
          description: item.description || '',
          type: item.type || '',
          subtype: item.subType || ''
        }))
      : [];

    // Role Type Table
    this.roleTypeTable.datasource.data = Array.isArray(
      element.productTypePostingSTDRoletypeRltnpList
    )
      ? element.productTypePostingSTDRoletypeRltnpList.map(
          (roleTypeRelationship: any) => ({
            ...roleTypeRelationship,
            type: this.convertRoleTypeIdfrToCode(
              roleTypeRelationship.roleTypeIdentifier
            )
          })
        )
      : [];
    //PSAM table
    const psamIdentifier =
      element.productTypePostingSTDPAMRltnpList?.[0]
        ?.postingApplicationMethodIdentifier;

    // Find the full PSAM object (assuming you have a full list with postingInstructionList)
    const psamObj = this.psamNames?.find(
      (psam: any) => psam.psam_identifier === psamIdentifier
    );

    // Map and store the postingInstructionList in the table
    this.psamTable.datasource.data = (
      psamObj?.postingInstructionList || []
    ).map(instr => ({
      order: instr.order,
      value: instr.value,
      balance_type_identifier: this.convertBalanceTypeIdfrToCode(
        instr.balance_type_identifier
