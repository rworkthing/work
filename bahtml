    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    MatDatepickerModule,
    BodCommonModule
  ],
  templateUrl: './transactiontype.component.html',
  styleUrl: './transactiontype.component.scss',
  schemas: [CUSTOM_ELEMENTS_SCHEMA]
})
export class TransactiontypeComponent implements OnInit {
  public editactions: BodTableAction[] = editDeleteActions;
  public transactionTypeList: any[] = [];
  public exstTransaction: any[] = [];
  public balanceTypes: any[] = [];
  public events: any[] = [];
  public psamNames: any[] = [];
  public channels: any[] = [];
  public internalProducts: any[] = [];
  public reverseConditions: any[] = [];
  public contraCode: any[] = [];
  public financialOperate: any[] = [];
  public postingCategory: any[] = [];
  public roletypes: any[] = [];
  public countersMasterList: any[] = [];
  public restrictionsMasterList: any[] = [];
  public communicationsMasterList: any[] = [];
  public conditionsMasterList: any[] = [];
  public taxTypeMasterList: any[] = [];
  public businessRuleMasterList: any[] = [];
  public taxTypeTable: any;
  public allTaxDefinitions: TaxDefinition[] = [];
  public taxDefinitionsTable: BodTableMetadata;
  @ViewChild('systemMessage', { static: true }) systemMessage: any;
  @Input() status = '';
  @ViewChild('addNewTransactionTemplate')
  public addNewTransactionTypeTemp: TemplateRef<any>;
  @ViewChild('addExistingTransactionTemplate')
  public addExistingTransactionTypeTemp: TemplateRef<any>;

  public taxTypeTableMap: { [id: number]: BodTableMetadata } = {};

  constructor(
    private bodConfirmAlertDialogsService: BodConfirmAlertDialogsService,
    private metadataService: MetadataService,

    private addEditTransactiontypeservice: AddEditransactiontypeService,
    private transactionTypeService: TransactionTypeService,
    public balanceTypeService: BalanceTypeService,
    private cdr: ChangeDetectorRef,
    private bodCommonDialogService: BodCommonDialogService
  ) {}

  public segments = [
    { label: 'Transaction Type', value: 'TransactionType' },
    { label: 'Transaction Category', value: 'TransactionCategory' },
    { label: 'Payment Type Details', value: 'PaymentTypeDetails' },
    { label: 'PSAM', value: 'PSAM' },
    { label: 'Delivery System', value: 'DeliverySystem'}
  ];
  public selectedSegment = 'TransactionType';

  public transactionTableActions: BodTableAction[] =
    TransactionTypeTableActions;
  public TransactionTypeMetaData: BodTableMetadata = {
    title: 'Transaction Type',
    columns: [...this.transactionTypeService.columns],
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<BodSampleTable>(),
    noRecordsMessage: 'No Transaction Type Data Defined',
    rowLeftAction: RowLeftAction.expandableRows,
    enableSorting: true,
    // filterOptions: {
    //   filterType: BodTableFilterType.SINGLE_SEGMENT_BASED,
    //   segments: [
    //     {
    //       columnName: 'status', // or any column you want to segment on
    //       label: 'Transaction Type',
    //       value: 'TransactionType',
    //       selected: true
    //     },
    //     {
    //       columnName: 'status',
    //       label: 'Transaction Category',
    //       value: 'TransactionCategory',
    //       selected: false
    //     },
    //     {
    //       columnName: 'status',
    //       label: 'Payment Type Details',
    //       value: 'PaymentTypeDetails',
    //       ignoreFilter: true
    //     },
    //     {
    //       columnName: 'status',
    //       label: 'PSAM',
    //       value: 'PSAM',
    //       ignoreFilter: true
    //     },
    //     {
    //       columnName: 'status',
    //       label: 'Delivery System',
    //       value: 'DeliverySystem',
    //       ignoreFilter: true
    //     }
    //   ]
    // }
  };

  public onSegmentFilterChange(event: any) {
    // You can filter your datasource here or call an API
    // Example: show a message or update the table data
    // this.messages = [{
    //   code: '',
    //   text: `Segment selected: ${event.label}`,
    //   type: NotificationMessageType.INFORMATIONAL_MESSAGE
    // }];
  }
  public onSegmentChanged(segmentValue: string) {
    this.selectedSegment = segmentValue;
    let filteredData;
    if (segmentValue === 'TransactionType') {
      // Show all data for TransactionType segment
      filteredData = this.transactionTypeData;
    } else if (segmentValue === 'ALL') {
      filteredData = this.transactionTypeData;
    } else {
      filteredData = this.transactionTypeData.filter(
        item => item.status === segmentValue
      );
    }
    this.TransactionTypeMetaData.datasource.data = filteredData;
    this.cdr.detectChanges();
  }

  ngOnInit() {
    this.loadDropdownData();
    this.transactionTypeService.retrieveAll().subscribe((response: any) => {
      const firstStatus = response?.data?.[0]?.MetadataStatus;
      const statusToSet = firstStatus || 'NEW';
      this.statusControl.setValue(statusToSet);
      this.previousStatus = statusToSet;
      // Update the transaction type service's current status
      this.transactionTypeService.updateCurrentStatus(statusToSet);
      console.log('TransactionType - Initial status set to:', statusToSet);
    });
    this.transactionTypeService.getTaxDefinition().subscribe((data: any[]) => {
      this.taxDefinitionsTable = {
        title: 'Tax Definitions',
        columns: this.transactionTypeService.taxDefinitionColumns,
        datasource: new MatTableDataSource(data),
        noRecordsMessage: 'No tax definitions available'
      };
    });
    this.transactionTypeService.getTaxType().subscribe((data: any[]) => {
      this.taxTypeMasterList = data;
    });
    this.transactionTypeService
      .getTransactionEvent()
      .subscribe((data: any[]) => {
        this.businessRuleMasterList = data;
      });
    this.transactionTypeService.getTaxDefinition().subscribe((data: any[]) => {
      this.allTaxDefinitions = data.map((item, index) => ({
        id: item.identifier || index + 1,
        identifier: item.identifier,
        code: item.code,
        taxTypeIdentifier: item.taxTypeIdentifier,
        region: item.region,
        partyClassification: item.partyClassification,
        rate: item.rate || 0,
        taxAmount: item.taxAmount || 0,
        thresholdTaxAmount: item.thresholdTaxAmount || 0,
        currencyIdentifier: item.currencyIdentifier || 0
      }));
    });
    this.getNewTransactionType();
  }

  loadDropdownData() {
    forkJoin({
      events: this.transactionTypeService.getTransactionEvent(),
      channels: this.transactionTypeService.getDeliveryChannel(),
      internalProducts: this.transactionTypeService.getInternalProdType(),
      reverseConditions: this.transactionTypeService.getConditions(),
      contraCode: this.transactionTypeService.getTransactionType(),
      financialOperate: this.transactionTypeService.getFinancialOperationType(),
      postingCategory: this.transactionTypeService.getpostingCategory(),
      roletypes: this.balanceTypeService.getRoletype(),
      psamNames: this.transactionTypeService.getPSAMDetails(),
      balanceTypes: this.balanceTypeService.getBalanceType(),
      transactionTypeList: this.transactionTypeService.getPsamPstgSTD(),
      exstTransaction: this.transactionTypeService.getExstTransactionType(),

      counters: this.transactionTypeService.getCounters(),
      restrictions: this.transactionTypeService.getRestrictions(),
      communications: this.transactionTypeService.getCommunicationService(),
      conditions: this.transactionTypeService.getConditions()
    }).subscribe(results => {
      this.events = results.events
        .map((item: any) => ({
          label: item.code,
          value: item.identifier
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      this.channels = results.channels
        .map((item: any) => ({
          label: item.code,
          value: item.identifier
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      this.internalProducts = results.internalProducts
        .map((item: any) => ({
          label: item.code,
          value: item.identifier
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      this.reverseConditions = results.reverseConditions
        .map((item: any) => ({
          label: item.cdarValue,
          value: item.identifier
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      this.contraCode = results.contraCode
        .map((item: any) => ({
          label: item.code,
          value: item.identifier,
          name: item.name,
          paymentTypeValue: item.paymentTypeValue
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      this.financialOperate = results.financialOperate
        .map((item: any) => ({
          label: item.code,
          value: item.identifier
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      this.postingCategory = results.postingCategory
        .map((item: any) => ({
          label: item.code,
          value: item.identifier
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      this.roletypes = results.roletypes
        .map((item: any) => ({
          label: item.code,
          value: item.identifier
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      this.psamNames = results.psamNames
        .map((item: any) => ({
          label: item.psam_code,
          value: item.psam_identifier,
          postingInstructionList: item.postingInstructionList,
          ...item
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      this.balanceTypes = results.balanceTypes
        .map((item: any) => ({
          label: item.code,
          value: item.identifier
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      this.transactionTypeList = results.transactionTypeList
        .map((item: any) => ({
          label: item.code,
          value: item.identifier
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      this.countersMasterList = results.counters;

      this.restrictionsMasterList = results.restrictions;

      this.communicationsMasterList = results.communications;

      this.conditionsMasterList = results.conditions;

      this.exstTransaction = results.exstTransaction
        .map((item: any) => ({
          label: item.code,
          value: item.identifier,
          paymentTypeValue: item.paymentTypeValue // add this line
        }))
        .sort((a, b) => a.label.localeCompare(b.label));

      // Now that all dropdowns are loaded, load the main data
      this.getNewTransactionType();
    });
  }

  public getTaxDefinitionsForTaxType(
    taxTypeIdentifier: number | string
  ): TaxDefinition[] {
    return this.allTaxDefinitions.filter(
      def => def.taxTypeIdentifier === taxTypeIdentifier
    );
  }

  isStatusEditable(): boolean {
    return this.status !== 'READY' && this.status !== 'GENERATED';
  }

  public commonDialogSize: string = 'Large';
  public closeOnCloseIconClick: boolean = false;
  private onCloseClick() {
    this.systemMessage.message = 'Custom Function called on close';
    this.systemMessage.show();
    this.dialogRef$.close();
  }
  private dialogRef$: MatDialogRef<CommonDialogComponent, any>;
  private openDialog(dialogModel: any) {
    let onClose = this.closeOnCloseIconClick
      ? this.onCloseClick.bind(this)
      : undefined;
    this.dialogRef$ = this.bodCommonDialogService.commonDialog(
      dialogModel,
      onClose,
      this.commonDialogSize
    );
  }

  isEdit = false;
  public messages: NotificationMessage[] = [];

  public onTableActionClicked1(event: BodTableAction) {
    this.isEdit = false;
    this.messages = [];
    if (event.id === 12) {
      this.addNewTransactionType();
    } else if (event.id === 13) {
      this.addExistingTransactionType();
    }
  }
  private addNewTransactionType() {
    this.editTransactionType = undefined; // Clear the editBalanceType to reset the form
    this.messages = [];
    let dialogModel: BodCommonDialogModel = {
      formTemplate: this.addNewTransactionTypeTemp,
      title: 'Add New Transaction Type'
    };
    this.openDialog(dialogModel);
  }

  private addExistingTransactionType() {
    this.editTransactionType = undefined; // Clear the editBalanceType to reset the form
    this.messages = [];
    let dialogModel: BodCommonDialogModel = {
      formTemplate: this.addExistingTransactionTypeTemp,
      title: 'Relate Existing Transaction Type'
    };
    this.openDialog(dialogModel);
  }

  public msg: NotificationMessage | undefined;
  statusControl = new FormControl(null);
  public previousStatus: string | undefined;
  @Output() statusChanged = new EventEmitter<string>();

  addTransactionTypeEvent(event: any) {
    if (event) {
      this.loadDropdownData();
      this.getNewTransactionType();
      const SuccessMsg = event.SuccessMsg;
      this.msg = {
        code: '',
        text: SuccessMsg,
        type: NotificationMessageType.SUCCESS
      };
      this.messages.push(this.msg);
      setTimeout(() => {
        this.messages = this.messages.filter(msg => msg.text !== SuccessMsg);
      }, 20000);
    }
    this.dialogRef$.close();

    this.metadataService.retrieveAll().subscribe((response: any) => {
      const firstStatus =
        response?.data &&
        response.data.length > 0 &&
        response.data[0]?.MetadataStatus
          ? response.data[0].MetadataStatus
          : null;
      const statusToSet = firstStatus || 'NEW';
      this.statusControl.setValue(statusToSet);
      this.previousStatus = statusToSet;
      this.statusChanged.emit(statusToSet);
      this.transactionTypeService.updateCurrentStatus(statusToSet);
      console.log('TransactionType - Status updated to:', statusToSet);
    });
  }
  //addExstTransactionTypeEvent
  addExstTransactionTypeEvent(event: any) {
    if (event) {
      this.getNewTransactionType();
      const SuccessMsg = event.SuccessMsg;
      this.msg = {
        code: '',
        text: SuccessMsg,
        type: NotificationMessageType.SUCCESS
      };
      this.messages.push(this.msg);
      setTimeout(() => {
        this.messages = this.messages.filter(msg => msg.text !== SuccessMsg);
      }, 20000);
    }
    this.dialogRef$.close();
    this.metadataService.retrieveAll().subscribe((response: any) => {
      const firstStatus =
        response?.data &&
        response.data.length > 0 &&
        response.data[0]?.MetadataStatus
          ? response.data[0].MetadataStatus
          : null;
      const statusToSet = firstStatus || 'NEW';
      this.statusControl.setValue(statusToSet);
      this.previousStatus = statusToSet;
      this.statusChanged.emit(statusToSet);
      this.transactionTypeService.updateCurrentStatus(statusToSet);
    });
  }

