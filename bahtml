  counterDelete(element: CounterList): void {
    this.counterService
      .deleteCounter('Counter', element.identifier)
      .subscribe({
        next: (response) => {
          const successMsg = `${element.code} Deleted Successfully`;
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
          setTimeout(() => {
