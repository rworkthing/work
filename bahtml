  private handleError1(error: any) {
    let errorMsg = '';
    switch (error.errorCode) {
      case 'DURATION_TYPE_REQUIRED':
        errorMsg = 'At least one duration type is required.';
        break;
      case 'DEFAULT_VALUE_REQUIRED':
        errorMsg =
          'At least one value must be set as default.';
        break;
      case 'DEFAULT_DURATION_VALUE_REQUIRED':
        errorMsg = 'At least one value must be set as default.';
        break;
      case 'CHILD_CONDITION_REQUIRED':
        errorMsg =
          'At least one child condition must be added for group condition.';
        break;

      case 'DUPLICATE_CHILD_CONDITION':
        errorMsg = 'Duplicate child condition found.';
        break;

      //

      case 'MANDATORY_CHILD_CONDITION_REQUIRED':
        errorMsg =
          'At least one child condition in a Group Condition must have optionality type as "Mandatory" or "Proposed"';
        break;

      case 'DUPLICATE_DURATION_TYPE_UNIT':
        if (error.types && error.types.length) {
          errorMsg = `Duplicate duration type and unit value found (${error.types.join(
            ', '
          )}).`;
        } else {
          errorMsg = 'Duplicate duration type and unit value found.';
        }
        break;
      case 'DUPLICATE_DURATION_TYPE':
        if (error.types && error.types.length) {
          errorMsg = `Duplicate duration type found (${error.types.join(
            ', '
          )}).`;
        } else {
          errorMsg = 'Duplicate duration type found.';
        }
        break;
      case 'MULTIPLE_DEFAULTS_PER_TYPE':
        if (error.types && error.types.length) {
          errorMsg = `Only one default allowed per duration type (${error.types.join(
            ', '
          )}).`;
        } else {
          errorMsg = 'Only one default allowed per duration type.';
        }
        break;
      case 'DEFAULT_UNIT_REQUIRED':
        errorMsg = 'Unit value must be provided when default is selected.';
        break;
      case 'UNIT_OUT_OF_RANGE':
        errorMsg = 'Unit value should be between minimum and maximum.';
        break;
      case 'MAX_LESS_THAN_MIN':
        errorMsg = 'Maximum should be greater than minimum.';
        break;
      case 'VALID_VALUE_REQUIRED':
        errorMsg = 'Valid value is required.';
        break;
      case 'MAX_LESS_THAN_MIN':
        errorMsg = 'Minimum Value cannot be Greater or Equal to Maximum Value.';
        break;
      case 'DEFAULT_OUT_OF_RANGE':
        errorMsg = 'Default Value must be between minimum and maximum values.';
        break;
      case 'CURRENCY_SELECTION_REQUIRED':
        errorMsg = 'Please select one currency.';
        break;
      case 'DEFAULT_CURRENCY_REQUIRED':
        errorMsg = 'Atleast one default currency must be selected';
        break;
      case 'DEFAULT_NOT_IN_SELECTED':
        errorMsg = 'Atleast one currency must be set as default.';
        break;
      case 'DUPLICATE_TEXT_VALID_VALUE':
        errorMsg = 'Duplicate text valid values found.';
        break;
      case 'DUPLICATE_NUMBER_VALID_VALUE':
        errorMsg = 'Duplicate number valid values found.';
        break;
      case 'DUPLICATE_FREQUENCY_VALID_VALUE':
        errorMsg = 'Selected frequency already exists.';
        break;
      case 'PRIMARY_FREQUENCY_REQUIRED':
        errorMsg = 'Primary frequency is required.';
        break;
      case 'SECONDARY_FREQUENCY_REQUIRED':
        errorMsg = 'Secondary frequency is required.';
        break;

      default:
        errorMsg = 'Unknown error occurred.';
    }
    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };
    this.errorMessages2.push(this.message);
    setTimeout(() => {
      this.errorMessages2 = this.errorMessages2.filter(
