  getNewTransactionType(): void {
    this.transactionTypeService
      .retrieveTransactionType()
      .subscribe(response => {
        // console.log('Raw transactionTypeService response:', JSON.stringify(response, null, 2));
        if (response.status === 'SUCCESS' && response.data) {
          this.transactionTypeData = response.data.map((item: any) => {
            const transactionType = item.TransactionType || {};
            const postingStd = transactionType.postingStd || {};
            const postingRepeatedTextList =
              transactionType.postingRepeatedTextList || {};
            const postingTextLanguageRltnpList =
              transactionType.postingTextLanguageRltnpList || {};
            const postingCategoryList =
              transactionType.postingCategoryList || [];
            const productTypePostingSTDRltnpList =
              transactionType.productTypePostingSTDRltnpList || [];
            const productTypePostingSTDDSRltnpList =
              transactionType.productTypePostingSTDDSRltnpList || [];
            const productTypePostingSTDCategoryRltnpList =
              transactionType.productTypePostingSTDCategoryRltnpList || [];
            const productTypePostingSTDPAMRltnpList =
              transactionType.productTypePostingSTDPAMRltnpList || {};
            const productTypePostingSTDRoletypeRltnpList =
              transactionType.productTypePostingSTDRoletypeRltnpList || [];
            const productTypeTransEventTypePostingSTDRltnpList =
              transactionType.productTypeTransEventTypePostingSTDRltnpList ||
              {};
            const externalTransactionTypePostingSTDRltnpDpList =
              transactionType.externalTransactionTypePostingSTDRltnpDpList ||
              {};
            const productTypePostingSTDDSCounterRltnp =
              transactionType.productTypePostingSTDDSCounterRltnp || [];
            const productTypePostingSTDDSRestrcitionRltnp =
              transactionType.productTypePostingSTDDSRestrcitionRltnp || [];
            const productTypePostingSTDDSCDRltnpList =
              transactionType.productTypePostingSTDDSCDRltnpList || [];
            const productTypePostingSTDDSComsRltnp =
              transactionType.productTypePostingSTDDSComsRltnp || [];
            const productTypePostingSTDTaxTypeRltnpList =
              transactionType.productTypePostingSTDTaxTypeRltnpList || [];
            const multiLingualCodeTranslationList =
              postingStd.multiLingualCodeTranslationList || [];
            const contraObj = this.contraCode.find(
              item => item.value === postingStd.contra
            );

            let paymentType = '';
            if (postingStd.code) {
              paymentType = postingStd.paymentType;
            } else if (
              productTypePostingSTDRltnpList.length > 0 &&
              productTypePostingSTDRltnpList[0].postingStdCode
