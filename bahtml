    //   classificationType: counter.classificationType || '',
    //   operatorType: counter.counterOperationType || ''
    // }));

    console.log(
      'Counters Table Data sent to Inquiry Layout:',
      JSON.stringify(this.countersTable.datasource.data, null, 2)
    );

    // Restrictions Table
    this.restrictionsTable.datasource.data = (
      element.productTypePostingSTDDSRestrcitionRltnp || []
    ).map(restriction => ({
      restrictionIdentifier: restriction.restrictionIdentifier,
      restrictionClassificationType:
        restriction.restrictionClassificationType || '',
      resourceItemIdentifier: restriction.resourceItemIdentifier,
      productTypeIdentifier: restriction.productTypeIdentifier,
      postingStdIdentifier: restriction.postingStdIdentifier
    }));

    this.conditionsTable.datasource.data = (
      element.productTypePostingSTDDSCDRltnpList || []
    ).map(condition => ({
      conditionIdentifier: condition.conditionIdentifier,
      cdarValue: condition.cdarValue || '',
      optionalityType: condition.optionalityType || '',
      resourceItemIdentifier: condition.resourceItemIdentifier,
      productTypeIdentifier: condition.productTypeIdentifier,
      postingStdIdentifier: condition.postingStdIdentifier
    }));

    this.communicationsTable.datasource.data = (
      element.productTypePostingSTDDSComsRltnp || []
    ).map(communication => {
      console.log('communication:', JSON.stringify(communication, null, 2));
      // Find the master entry for serviceElementCode
      const commMaster = this.communicationsMasterList?.find(
        c =>
          String(c.serviceElementIdentifier) ===
          String(communication.serviceElementIdentifier)
