    BodCurrencyControlModule,
    MatDatepickerModule,
    BodCommonModule
  ],
  templateUrl: './restriction-details.component.html',
  styleUrl: './restriction-details.component.scss',
  schemas: [CUSTOM_ELEMENTS_SCHEMA, NO_ERRORS_SCHEMA]
})
export class RestrictionDetailsComponent implements OnInit {
  public translationKey = TranslationKey;
  public editactions: BodTableAction[] = editDeleteActions;
  public addNewRestrictionFormGroup: UntypedFormGroup;
  private existingRestrictionsMap: {
    [code: string]: { name: string; classificationType: string; description: string  };
  } = {};

  @Input() status: string = '';

  @ViewChild('addNewRestrictionTemplate')
  public addNewRestrictionTemp: TemplateRef<any>;
  @ViewChild('relateExistingRestrictionTemplate')
  public relateExistingRestrictionTemp: TemplateRef<any>;
  private adminTableRef: BodTableComponent | undefined;
  @ViewChild('systemMessage', { static: true }) systemMessage: any;
  public messages: NotificationMessage[] = [];
  public message: NotificationMessage | undefined;
  public periodTypeColumns1 = [
    { name: 'childRestriction', title: 'Child Restriction' },
    { name: 'isExclude', title: 'Is Exclude' }
  ];

  public ConfirmData: BodConfirmDialogModel = {
    title: 'BOD.metadataconfig.title',
    message: 'BOD.metadataconfig.message',
    confirm: 'BOD.metadataconfig.delete',
    dismiss: 'BOD.metadataconfig.cancel'
  };

  constructor(
    private confirmDialogService: BodConfirmAlertDialogsService,
    private bodConfirmAlertDialogsService: BodConfirmAlertDialogsService,
    public restrictionService: RestrictionService,
    private fb: FormBuilder,
    public RestrictionService: RestrictionService,
    private bodCommonDialogService: BodCommonDialogService,
    private metadataService: MetadataService
  ) {}

  ngOnInit() {
    this.restrictionService.getRestrictions().subscribe((restrictions: any[]) => {
      this.existingRestrictionsMap = {};
      restrictions.forEach(restriction => {
        this.existingRestrictionsMap[restriction.code] = {
          name: restriction.name,
          classificationType: restriction.classificationType,
          description: restriction.description
        };
      });

      // Now fetch and map the main counters
      this.getNewRestriction();
      this.loadDropDownData();
    });
    this.restrictionService.retrieveAll().subscribe((response: any) => {
      const firstStatus = response?.data?.[0]?.MetadataStatus;
      const statusToSet = firstStatus || 'NEW';
      this.statusControl.setValue(statusToSet);
      this.previousStatus = statusToSet;
      this.restrictionService.updateCurrentStatus(statusToSet);
    });

    this.getNewRestriction();
  }
  public childRestriction: any[] = [];

  loadDropDownData(): void {
    this.RestrictionService.getRestrictions().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      this.childRestriction = mappedData;
    });
  }

  public restrictionTableActions: BodTableAction[] = RestrictionTableLevelActions;
  public restrictionTableMetaData: BodTableMetadata = {
    title: 'Restriction Details',
    columns: [...this.restrictionService.columns],
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<BodSampleTable>(),
    noRecordsMessage: 'No Restriction Data Defined',
    rowLeftAction: RowLeftAction.expandableRows,
    enableSorting: true
  };

  public periodTypesTableMetaData: BodTableMetadata = {
    title: 'Restriction Relationship',
    columns: this.periodTypeColumns1,
    enablePagination: false,
    datasource: new MatTableDataSource([]),
    noRecordsMessage: 'No Restriction Relationship Defined'
  };

  public rowExpanded(element: RestrictionList) {
    this.messages = [];
    // Example dropdown loaded from service
    // this.childRestrictionDropdown = [{ identifier: 110000000007, code: 'CR007' }, ...];

    const periodTypeRows = (element.exceptionTrigger || []).map(trigger => {
      // Find the dropdown item by identifier
      const dropdownItem = this.childRestriction?.find(
        item => item.value === trigger.exceptionChildIdentifier
      );
      return {
        childRestriction: dropdownItem
          ? dropdownItem.label
          : trigger.exceptionChildIdentifier,
        isExclude: trigger.exceptionTriggerExclude === 'Y' ? 'Yes' : 'No'
      };
    });
    this.periodTypesTableMetaData.datasource.data = periodTypeRows;
  }

  public msg: NotificationMessage | undefined;

  isStatusEditable(): boolean {
    return this.status !== 'READY' && this.status !== 'GENERATED';
  }
  statusControl = new FormControl(null);
  public previousStatus: string | undefined;

  @Output() statusChanged = new EventEmitter<string>();
  addRestrictionEvent(event: any) {
    if (event) {
      this.getNewRestriction();

      this.metadataService.retrieveAll().subscribe((response: any) => {
        const firstStatus = response?.data?.[0]?.MetadataStatus;
        const statusToSet = firstStatus || 'NEW';
        this.statusControl.setValue(statusToSet);
        this.previousStatus = statusToSet;
        this.statusChanged.emit(statusToSet);
        this.restrictionService.updateCurrentStatus(statusToSet);
      });
      const SuccessMsg = event.SuccessMsg;
      this.msg = {
        code: '',
        text: SuccessMsg,
        type: NotificationMessageType.SUCCESS
      };
      this.messages.push(this.msg);
      setTimeout(() => {
        this.messages = this.messages.filter(msg => msg.text !== SuccessMsg);
      }, 20000);
    }
    this.dialogRef$.close();
  }

  public commonDialogSize: string = 'Large';
  public closeOnCloseIconClick: boolean = false;
  private onCloseClick() {
    this.systemMessage.message = 'Custom Function called on close';
    this.systemMessage.show();
    this.dialogRef$.close();
  }
  private dialogRef$: MatDialogRef<CommonDialogComponent, any>;
  private openDialog(dialogModel: any) {
    let onClose = this.closeOnCloseIconClick
      ? this.onCloseClick.bind(this)
      : undefined;
    this.dialogRef$ = this.bodCommonDialogService.commonDialog(
      dialogModel,
      onClose,
      this.commonDialogSize
    );
  }

  private addNewRestriction() {
    this.editRestriction = undefined;
    this.messages = [];
    let dialogModel: BodCommonDialogModel = {
      formTemplate: this.addNewRestrictionTemp,
      title: 'Add New Restriction'
    };
    this.openDialog(dialogModel);
  }

  public onTableActionClicked1(event: BodTableAction) {
    this.isEdit = false;
    this.messages = [];
    if (event.id === 12) {
      this.addNewRestriction();
    } else if (event.id === 13) {
      this.relateExistingRestriction();
    }
  }

  private relateExistingRestriction() {
    this.editRestriction = undefined;
    this.messages = [];
    let dialogModel: BodCommonDialogModel = {
      formTemplate: this.relateExistingRestrictionTemp,
      title: 'Relate Existing Restriction'
    };
    this.openDialog(dialogModel);
  }

  // Add method to handle existing counter events
  relateExistingRestrictionEvent(event: any) {
    if (event) {
      this.getNewRestriction();

      this.metadataService.retrieveAll().subscribe((response: any) => {
        const firstStatus = response?.data?.[0]?.MetadataStatus;
        const statusToSet = firstStatus || 'NEW';
        this.statusControl.setValue(statusToSet);
        this.previousStatus = statusToSet;
        this.statusChanged.emit(statusToSet);
        this.restrictionService.updateCurrentStatus(statusToSet);
      });

      const SuccessMsg = event.SuccessMsg;
      this.msg = {
        code: '',
        text: SuccessMsg,
        type: NotificationMessageType.SUCCESS
      };
      this.messages.push(this.msg);
      setTimeout(() => {
        this.messages = this.messages.filter(msg => msg.text !== SuccessMsg);
      }, 20000);
    }
    this.dialogRef$.close();
  }

  restrictionData: RestrictionList[] = [];
  getNewRestriction(): void {
    this.restrictionService.retrieveRestriction().subscribe(response => {
      if (response.status === 'SUCCESS' && response.data) {
        this.restrictionData = response.data.map((item: any) => {
          const restriction = item.Restriction;
          const exceptionDef = restriction.exceptionDefinition || {};
          const rltnList = restriction.productElementExceptionRltnList || [];
          const code = exceptionDef?.code || rltnList[0]?.exceptionCode;
          const triggerList =
            restriction.productElementExceptionTriggerList || [];
 const identifier =
          (exceptionDef && exceptionDef.identifier) ||
          rltnList[0]?.exceptionIdentifier ||
          undefined;
        // Use name/classificationType from getExstCounters if available, else fallback to API response
const enrich: { name?: string; classificationType?: string; description?: string} = this.existingRestrictionsMap[code] || {};
const name = enrich.name || exceptionDef?.name || '';
const classificationType = enrich.classificationType || exceptionDef?.classificationType || '';
const description = enrich.description || exceptionDef?.description || '';
          // Build restrictionInquiry array
          const restrictionInquiry = [
            {
              id: 0,
              label: 'Name',
              value: name || ''
            },
            {
              id: 1,
              label: 'Classification Type',
              value: classificationType || ''
            },
            {
              id: 2,
              label: 'Description',
              value: description || ''
            },
            {
              id: 3,
              label: 'Restriction Mode',
              value: rltnList[0]?.processMode || ''
            },
            {
              id: 4,
              label: 'Activity Type',
              value: rltnList[0]?.activityType || ''
            }
          ];

          // Map exception relationship list
          const exceptionRltn = rltnList.map(rltn => ({
            productTypeIdentifier: rltn.productTypeIdentifier,
            exceptionIdentifier: rltn.exceptionIdentifier,
            exceptionCode: rltn.exceptionCode,
            exceptionValue: rltn.exceptionValue,
            processMode: rltn.processMode,
            activityType: rltn.activityType
          }));

          // Map trigger list
          const exceptionTrigger = triggerList.map(trigger => ({
            productTypeIdentifier: trigger.productTypeIdentifier,
            exceptionParentIdentifier: trigger.exceptionParentIdentifier,
            exceptionChildIdentifier: trigger.exceptionChildIdentifier,
            exceptionTriggerExclude: trigger.exceptionTriggerExclude
          }));

          // Build restriction data object
          return {
            identifier: identifier,
            code: code,
            name: name,
            description: description,
            classificationType: classificationType,
            restrictionInquiry,
            exceptionRltn,
            exceptionTrigger,
            metadataStatus: item.MetadataStatus
          };
        });

        // Example: assign to table datasource if needed
        this.restrictionTableMetaData.datasource.data = this.restrictionData;
      }
    });
  }

  isEdit = false;
  iconActionClicked(event: BodTableAction, element: RestrictionList) {
    this.isEdit = true;
    this.messages = [];
    if (event.id === BodTableActionType.EDIT) {
      this.editRestrictions(element);
    } else if (event.id === 1) {
      const confirmDataWithCode: BodConfirmDialogModel = {
        ...this.ConfirmData,
        message: `${'Are you sure you want to delete'} ${element.code}`
      };
      this.bodConfirmAlertDialogsService
        .confirm(confirmDataWithCode)
        .subscribe(val => {
          if (val) {
            this.restrictionDelete(element);
          }
        });
    }
  }

  editRestriction: RestrictionList | undefined;
  retainedCode: string = '';
  retainedIdentifier: number = 0;
  retainedName: string = '';
  retainedDescription: string = '';
  retainedSystemBalance: boolean = false;

  private editRestrictions(element: RestrictionList) {
    this.editRestriction = element;
    this.retainedCode = element.code || '';
    this.retainedIdentifier = element.identifier ?? 0;
    this.retainedName = element.name || '';
    this.retainedDescription = element.description || ''; 

    const dialogModel: BodCommonDialogModel = {
      formTemplate: this.addNewRestrictionTemp,
      title: 'Edit Restriction'
    };
    this.openDialog(dialogModel);
  }

  restrictionDelete(element: RestrictionList): void {
    this.restrictionService
      .deleteRestriction('Restriction', element.identifier)
      .subscribe({
        next: response => {
          const successMsg = `${element.code} Deleted Successfully`;
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(
              msg => msg.text !== successMsg
            );
          }, 20000);

          this.getNewRestriction();

          this.metadataService.retrieveAll().subscribe((response: any) => {
            const firstStatus =
              response?.data &&
              response.data.length > 0 &&
              response.data[0]?.MetadataStatus
                ? response.data[0].MetadataStatus
                : null;
            const statusToSet = firstStatus || 'NEW';
            this.statusControl.setValue(statusToSet);
            this.previousStatus = statusToSet;
            this.statusChanged.emit(statusToSet);
            this.restrictionService.updateCurrentStatus(statusToSet);
          });
        },
        error: error => {
          const errorMsg =
            error?.error?.errorDescription ||
            `Failed to delete ${element.code}. Please try again.`;
          this.message = {
            code: error?.error?.errorCode || 'ERROR',
            text: errorMsg,
            type: NotificationMessageType.ERROR
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(msg => msg.text !== errorMsg);
          }, 20000);
        }
      });
  }
}


























import { HttpClient, HttpHeaders } from '@angular/common/http';
import { Injectable } from '@angular/core';
import {
  Column,
  ColumnType,
  InquiryLayoutInput,
  UIContextService
} from '@bod/common';
import { BehaviorSubject, Observable, tap } from 'rxjs';
import { DataSharingService } from '../data-sharing-service.service';
import { RestrictionList } from './add-edit-restriction-details/add-edit-restriction.model';

@Injectable({
  providedIn: 'root'
})
export class RestrictionService {
  private saveUrl = '';
  private retrieveUrl = '';
  private deleteUrl = '';
  private updateUrl = '';
  private baseUrl = '';
  private retrieveAllUrl = '';
  private counterexstUrl = '';
  private apiURL = '';

  private currentStatus: string = 'NEW';

  businessProductLine: any[] = [];
  private reqDfnId = '';
  private clientCode = '';
  private countryCode = '';
  private productLines: any[] = [];
  private productTypes: any[] = [];

  constructor(
    private http: HttpClient,
    private uiContextService: UIContextService,
    private readonly dataSharingService: DataSharingService
  ) {
    let url =
      this.uiContextService.getModuleDataById('fis.nextgen.sdkit').valueMap
        .sdkServiceUrl.value;

    this.dataSharingService.data$.subscribe(data => {
      if (data) {
        this.reqDfnId = data.reqDfnId;
        this.businessProductLine = data.reqDfnResponseDTO.businessProductLine;
        this.countryCode = data.countryCode;
        this.clientCode = data.countryCode;
        this.productLines = [
          ...new Set(this.businessProductLine.map(obj => obj.value))
        ];
        this.productTypes = [
          ...new Set(this.businessProductLine.map(obj => obj.type))
        ];

        this.baseUrl = url ?? '';
        this.saveUrl = url + '/metadata/create/' + this.reqDfnId;
        this.updateUrl = url + '/metadata/update/' + this.reqDfnId;

        this.retrieveUrl =
          url +
          '/metadata/retrieve/' + this.reqDfnId + '?metadata-config-type=Restriction';

        this.counterexstUrl =
          url + '/basedata/counter';
        this.deleteUrl = url + '/metadata/delete/' + this.reqDfnId;
        this.retrieveAllUrl =
          url +
          '/metadata/retrieve/' +
          this.reqDfnId;
        this.apiURL = url + '/basedata/restriction';
      }
    });
  }

  retrieveAll(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<any[]>(this.retrieveAllUrl, { headers }).pipe(
      tap((response: any) => {
        const firstStatus = response?.data && response.data.length > 0 && response.data[0]?.MetadataStatus
          ? response.data[0].MetadataStatus
          : 'NEW';
        this.currentStatus = firstStatus;
      })
    );
  }

  updateCurrentStatus(status: string): void {
    this.currentStatus = status;
  }

  createHeaders(): HttpHeaders {
    return new HttpHeaders({
      'country-code': this.countryCode,
      'client-code': this.clientCode,
      'product-line': this.productLines,
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID(),
      'requirement-id': this.reqDfnId
    });
  }

  private getCreateUrlWithStatus(status: string): string {
    return `${this.baseUrl}/metadata/create/${this.reqDfnId}?status=${status}`;
  }

  saveRestriction(request: any, status?: string): Observable<any> {
    const headers = this.createHeaders();
    const statusToUse = status || this.currentStatus;
    const url = this.getCreateUrlWithStatus(statusToUse);
    return this.http.post(url, request, { headers });
  }

  retrieveRestriction(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<RestrictionList[]>(this.retrieveUrl, { headers });
  }

  getExstCounters(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get(`${this.counterexstUrl}`, { headers });
  }

  deleteRestriction(
    metadataConfigType: string,
    metadataConfigIdfr: number
  ): Observable<any> {
    const headers = this.createHeaders();
    const params = {
      'metadata-config-type': metadataConfigType,
      'metadata-config-idfr': metadataConfigIdfr
    };

