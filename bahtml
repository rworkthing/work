      sub_balance_type: instr.sub_balance_type,
      posting_identifier: this.convertPostingIdentifierToCode(
        instr.posting_identifier
      ),
      customization_type_value: instr.customization_type_value
    }));

    // Channels Table
    const uniqueChannels = (
      element.productTypePostingSTDDSRltnpList || []
    ).filter(
      (channel, index, self) =>
        index ===
        self.findIndex(
          c =>
            c.resourceItemIdentifier === channel.resourceItemIdentifier &&
            c.productTypeIdentifier === channel.productTypeIdentifier &&
            c.postingStdIdentifier === channel.postingStdIdentifier
        )
    );

    const mappedChannels = uniqueChannels.map(channel => {
      const countersForChannel = (
        element.productTypePostingSTDDSCounterRltnp || []
      )
        .filter(
          counter =>
            counter.resourceItemIdentifier === channel.resourceItemIdentifier &&
            counter.productTypeIdentifier === channel.productTypeIdentifier &&
            counter.postingStdIdentifier === channel.postingStdIdentifier
        )
        .map(counter => ({
          code: counter.counterIdentifier,
          classificationType: counter.classificationType || '',
          operatorType: counter.counterOperationType || ''
        }));

      const restrictionsForChannel = (
        element.productTypePostingSTDDSRestrcitionRltnp || []
      )
        .filter(
          restriction =>
            restriction.resourceItemIdentifier ===
              channel.resourceItemIdentifier &&
            restriction.productTypeIdentifier ===
              channel.productTypeIdentifier &&
            restriction.postingStdIdentifier === channel.postingStdIdentifier
        )
        .map(restriction => ({
          restrictionIdentifier: restriction.restrictionIdentifier,
          restrictionClassificationType:
            restriction.restrictionClassificationType || ''
        }));

      const conditionsForChannel = (
        element.productTypePostingSTDDSCDRltnpList || []
      )
        .filter(
          condition =>
            condition.resourceItemIdentifier ===
              channel.resourceItemIdentifier &&
            condition.productTypeIdentifier === channel.productTypeIdentifier &&
            condition.postingStdIdentifier === channel.postingStdIdentifier
        )
        .map(condition => ({
          conditionIdentifier: condition.conditionIdentifier,
          cdarValue: condition.cdarValue || '',
          optionalityType: condition.optionalityType || ''
        }));

      const communicationsForChannel = (
        element.productTypePostingSTDDSComsRltnp || []
      )
        .filter(
          communication =>
            communication.resourceItemIdentifier ===
              channel.resourceItemIdentifier &&
            communication.productTypeIdentifier ===
              channel.productTypeIdentifier &&
            communication.postingStdIdentifier === channel.postingStdIdentifier
        )
        .map(communication => {
          console.log(
            'communication:1',
            JSON.stringify(communication, null, 2)
          );
          // Find the master entry for serviceElementCode
          const commMaster = this.communicationsMasterList?.find(
            c =>
              String(c.serviceElementIdentifier) ===
