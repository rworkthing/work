        postingStdIdentifier: communication.postingStdIdentifier,
        serviceElementCode: communication.serviceElementIdentifier
      };
      console.log('result:', JSON.stringify(result, null, 2));
      return result;
    });

    const taxTypeRows = (
      element.productTypePostingSTDTaxTypeRltnpList || []
