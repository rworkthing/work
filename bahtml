          console.log('communication:result', JSON.stringify(result, null, 2));
          return result;
        });

      let channelLabel =
        this.channels.find(c => c.value === channel.resourceItemIdentifier)
          ?.label ?? channel.resourceItemIdentifier;

      if (channelLabel === 0 || channelLabel === '0') {
        channelLabel = 'All';
      }

      return {
        channel: channelLabel,
        option: channel.optionalityType,
        counters: countersForChannel,
        restrictions: restrictionsForChannel,
        conditions: conditionsForChannel,
        communications: communicationsForChannel
      };
    });

    // Deduplicate by channel label
