<bod-message-container rufId [messages]="messages"></bod-message-container>
{{ messages }}

<bod-table
  #customTable
  [customColumnTemplates]="[
    {
      columnName: 'actions',
      templateName: editActionTemplate
    }
  ]"
  [data]="counterTableMetaData"
  [tableActions]="isStatusEditable() ? counterTableActions : []"
  (onTableActionClick)="isStatusEditable() && onTableActionClicked1($event)"
  [expandedRowTemplate]="expandedRowTemplate"
  (onRowExpand)="rowExpanded($event)"
>
  <ng-template
    #editActionTemplate
    let-element="element"
    let-column="column"
    let-index="index"
  >
    <bod-table-actions
      sectionActions
      [actions]="isStatusEditable() ? editactions: []"
      (onActionClick)="isStatusEditable() && iconActionClicked($event, element)"
    >
    </bod-table-actions>
  </ng-template>
  <ng-template #expandedRowTemplate let-context="context">
    <div fullwidth>
      @if(context.element.name){

      <h1>Counter</h1>
      <bod-inquiry-layout
        [columns]="2"
        [groups]="counterService.getCounterData(context.element)"
        [softSeparator]="false"
        [direction]="direction"
        [information]="[]"
        (linkClick)="commonDataService.inquiryLayoutClick($event)"
      >
      </bod-inquiry-layout>
      <h2 *ngIf="context.element.periodTypeList?.length">Period Types</h2>
       <bod-table
        *ngIf="context.element.periodTypeList?.length"
        [data]="periodTypesTableMetaData"
        [alignContent]="'top'"
      [customColumnTemplates]="[
    { columnName: 'isCalculated', templateName: isCalculatedDisplayTemplate }
  ]"
>
  <ng-template #isCalculatedDisplayTemplate let-element="element">
    {{ element.isCalculated ? 'Yes' : 'No' }}
  </ng-template>
      </bod-table>
      }
    </div>
  </ng-template>
</bod-table>

<ng-template #addNewCounterTemplate>
  <bod-add-edit-counter
    (apiResponse)="addCounterEvent($event)"
    [editCounterRow]="editCounter"
    [retainedCode]="retainedCode"
    [retainedIdentifier]="retainedIdentifier"
    [retainedName]="retainedName"
    [retainedSystemBalance]="retainedSystemBalance"
  >
  </bod-add-edit-counter>
</ng-template>

<ng-template #relateExistingCounterTemplate>
  <bod-existing-counters
    (apiResponse)="relateExistingCounterEvent($event)"
    [preselectCode]="preselectCode"
    [counterTableData]="counterTableMetaData.datasource.data"
    [isAdd]="!isEdit"
  >
  </bod-existing-counters>
</ng-template>













