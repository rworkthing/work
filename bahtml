<div
  class="segment-filter"
  style="
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 16px 0;
  "
>
  <mat-button-toggle-group
    [value]="selectedSegment"
    (change)="onSegmentChanged($event.value)"
    appearance="legacy"
    name="segmentFilter"
    aria-label="Segment Filter"
    fisStyle
  >
    <mat-button-toggle *ngFor="let segment of segments" [value]="segment.value">
      {{ segment.label }}
    </mat-button-toggle>
  </mat-button-toggle-group>
</div>
<bod-message-container rufId [messages]="messages"></bod-message-container>
<bod-table
  *ngIf="selectedSegment === 'TransactionType'"
  #customTable
  [customColumnTemplates]="[
    {
      columnName: 'actions',
      templateName: editActionTemplate
    }
  ]"
  [data]="TransactionTypeMetaData"
  [tableActions]="isStatusEditable() ? transactionTableActions : []"
  (onTableActionClick)="isStatusEditable() && onTableActionClicked1($event)"
  [expandedRowTemplate]="expandedRowTemplate"
  (onRowExpand)="rowExpanded($event)"
  (segmentFilterChangeEvent)="onSegmentFilterChange($event)"
>
  <ng-template
    #editActionTemplate
    let-element="element"
    let-column="column"
    let-index="index"
  >
    <bod-table-actions
      sectionActions
      [actions]="isStatusEditable() ? editactions : []"
      (onActionClick)="isStatusEditable() && iconActionClicked($event, element)"
    >
    </bod-table-actions>
  </ng-template>
  <ng-template #expandedRowTemplate 
  let-context="context">
    <div fullwidth>
      @if(context.element.name){
      <bod-inquiry-layout
        [columns]="2"
        [groups]="
          transactionTypeService.getTransactionTypeData(context.element)
        "
        [softSeparator]="false"
        [direction]="direction"
        [information]="[]"
        (linkClick)="commonDataService.inquiryLayoutClick($event)"
      >
      </bod-inquiry-layout>

      <ng-container
        *ngIf="
          (context.element.contraTemplateIdentifier === null ||
            context.element.contraTemplateIdentifier === 0) &&
          context.element.contra
        "
      >
        <h1>Contra Posting Details</h1>
        <bod-inquiry-layout
          [columns]="2"
          [groups]="transactionTypeService.getPostingDetails(context.element)"
          [softSeparator]="false"
          [direction]="direction"
          [information]="[]"
          (linkClick)="commonDataService.inquiryLayoutClick($event)"
        >
        </bod-inquiry-layout>
      </ng-container>
      <h1>Additional Details</h1>
      <bod-inquiry-layout
        [columns]="2"
        [groups]="transactionTypeService.additionDetails(context.element)"
        [softSeparator]="false"
        [direction]="direction"
        [information]="[]"
        (linkClick)="commonDataService.inquiryLayoutClick($event)"
      >
      </bod-inquiry-layout>
      <bod-table
        [data]="postingTextTable"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      >
      </bod-table>
      <bod-table
        *ngIf="
          context.element?.externalTransactionTypePostingSTDRltnpDpList
            ?.length > 0
        "
        [data]="externalTransactionTable"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      >
      </bod-table>
      }
      <h1>Product Type Relationships</h1>
      <bod-inquiry-layout
        [columns]="2"
        [groups]="
          transactionTypeService.prdtTypeRelationshipInquiry(context.element)
        "
        [softSeparator]="false"
        [direction]="direction"
        [information]="[]"
        (linkClick)="commonDataService.inquiryLayoutClick($event)"
      >
      </bod-inquiry-layout>

      <h1>Relationship Details</h1>
      <bod-inquiry-layout
        [columns]="2"
        [groups]="transactionTypeService.relationshipInquiry(context.element)"
        [softSeparator]="false"
        [direction]="direction"
        [information]="[]"
        (linkClick)="commonDataService.inquiryLayoutClick($event)"
      >
      </bod-inquiry-layout>
      <bod-table
        *ngIf="
          context.element?.productTypePostingSTDRoletypeRltnpList?.length > 0
        "
        [data]="roleTypeTable"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      >
      </bod-table>
      <h1>Posting Standard Application Method</h1>
      <bod-inquiry-layout
        [columns]="2"
        [groups]="transactionTypeService.getPSAM(context.element)"
        [softSeparator]="false"
        [direction]="direction"
        [information]="[]"
        (linkClick)="commonDataService.inquiryLayoutClick($event)"
      >
      </bod-inquiry-layout>
      <bod-table
        [data]="psamTable"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      >
      </bod-table>

      <ng-container
        *ngIf="
          !!context.element?.productTypePostingSTDDSRltnpList &&
          (context.element.productTypePostingSTDDSRltnpList.length > 1 ||
            (context.element.productTypePostingSTDDSRltnpList.length === 1 &&
              (context.element?.productTypePostingSTDDSCounterRltnp?.length >
                0 ||
                context.element?.productTypePostingSTDDSRestrcitionRltnp
                  ?.length > 0 ||
                context.element.productTypePostingSTDDSCDRltnpList?.length >
                  0 ||
                context.element.productTypePostingSTDDSComsRltnp?.length > 0)))
        "
      >
        <bod-table
          [data]="channelsTable"
          [alignContent]="'top'"
          [expandedRowTemplate]="expandedChannelRowTemplate"
          [innerTableContext]="context"
        >
        </bod-table>
      </ng-container>

      <bod-table
        *ngIf="
          taxTypeTableMap[context.element.identifier]?.datasource?.data?.length
        "
        [data]="taxTypeTableMap[context.element.identifier]"
        [alignContent]="'top'"
        [expandedRowTemplate]="expandedTaxTypeRowTemplate"
      >
      </bod-table>
    </div>
  </ng-template>
  <ng-template #expandedChannelRowTemplate
    let-channel="element"
    let-context="context"
  >
    <div style="margin-left: 32px">
      <bod-table
        *ngIf="context.element?.counters?.length"
        [data]="getCountersTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
      <bod-table
        *ngIf="context.element?.restrictions?.length"
        [data]="getRestrictionsTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
      <bod-table
        *ngIf="context.element?.conditions?.length"
        [data]="getConditionsTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
      <bod-table
        *ngIf="context.element?.communications?.length"
        [data]="getCommunicationsTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
    </div>
  </ng-template>

  <ng-template #expandedTaxTypeRowTemplate
    let-element="element"
    let-context="context"
  >
    <div style="margin-left: 32px">
      <bod-table
        [data]="
          getFilteredTaxDefinitionsTable(context.element.taxTypeIdentifier)
        "
        [alignContent]="'top'"
      ></bod-table>
    </div>
  </ng-template>
</bod-table>

<bod-transaction-category
  *ngIf="selectedSegment === 'TransactionCategory'"
  [status]="status"
  (statusChanged)="statusChanged.emit($event)"
></bod-transaction-category>

<bod-delivery-system
  *ngIf="selectedSegment === 'DeliverySystem'"
  [status]="status"
  (statusChanged)="statusChanged.emit($event)"
></bod-delivery-system>


<ng-template #addNewTransactionTemplate>
  <bod-add-edit-transactiontype
    (apiResponse)="addTransactionTypeEvent($event)"
    [editTransactionTypeRow]="editTransactionType"
  ></bod-add-edit-transactiontype>
</ng-template>

<ng-template #addExistingTransactionTemplate>
  <bod-existing-transactiontype
    (apiResponse)="addExstTransactionTypeEvent($event)"
    [editTransactionTypeRow]="editTransactionType"
  >
  </bod-existing-transactiontype>
</ng-template>


















