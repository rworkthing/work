        const counterData: CounterList = {
          code: code,
          counterInquiry: [
            {
              id: 0,
              label: 'Name',
              value: name
            },
            {
              id: 1,
              label: 'Classification Type',
              value: classificationType
            },
            {
              id: 2,
              label: 'Rule Check',
              value: rltnpList[0]?.ruleCheck === 'Y' ? 'Yes' : 'No'
            }
          ],
          identifier: identifier,
          name: name,
          classificationType: classificationType,
          ruleCheck: rltnpList[0]?.ruleCheck,
          periodTypeList: item.Counter.productElementCounterTypePeriodList?.map(pt => ({
            periodType: pt.periodType,
            isCalculated: pt.isCalculate === 'Y'
          })) || [],
          sourceType // <-- Add this property
        };

        return counterData;
      });

      this.counterTableMetaData.datasource.data = this.counterData;
      this.availableCounters = this.counterData;
      console.log('Table Data:', JSON.stringify(this.counterTableMetaData.datasource.data, null, 2));
    }
  });
}

