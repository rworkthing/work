  onReset(isAdd: boolean): void {
    const isEditMode = this.isEdit;
    const currentCode = this.addNewAttributeFormGroup?.get('code')?.value;
    this.inputRangeLocaleLayoutFormLocale.reset();
    this.inputRangeLocaleLayoutFormDisplayName.reset();
    this.inputRangeLocaleLayoutFormDesc.reset();
    this.dataWithSimpleEdit = [];
    this.inputLayoutForm.reset();
    this.dataWithValidvalues = [];
    this.dataWithExsistingValidvalues = [];
    this.tableWithSimpleEdit.datasource.data = [];

    if (this.ValidvalueArray && this.ValidvalueArray.datasource) {
      this.ValidvalueArray.datasource.data = [...this.dataWithValidvalues];
    }
    if (this.ExistingValidvalueArray && this.ExistingValidvalueArray.datasource) {
      this.ExistingValidvalueArray.datasource.data = [...this.dataWithExsistingValidvalues];
    }
    if (this.tableWithSimpleEdit && this.tableWithSimpleEdit.datasource) {
      this.tableWithSimpleEdit.datasource.data = [...this.dataWithSimpleEdit];
    }

    if (isEditMode) {
      // Restore 'code' value and keep it disabled
      this.addNewAttributeFormGroup.get('code')?.setValue(currentCode);
      this.addNewAttributeFormGroup.get('code')?.disable();
    } else {
      this.addNewAttributeFormGroup.get('code')?.enable();
    }
    this.changeDetectorRef.detectChanges();
  }
