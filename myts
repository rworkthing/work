  nonNegativeValidator(): ValidatorFn {
    return (control: AbstractControl): { [key: string]: any } | null => {
      const value = control.value;
      return value < 0 ? { negativeValue: { value: value } } : null;
    };
  }

  requiredValidator(): ValidatorFn {
    return (control: AbstractControl): { [key: string]: any } | null => {
      const value = control.value;
      return value === null || value === undefined || value === '' ? { required: true } : null;
    };
  }

  maxValueValidator(maxValue: number): ValidatorFn {
    return (control: AbstractControl): { [key: string]: any } | null => {
      const value = control.value;
      return value > maxValue ? { maxValueExceeded: { value: value } } : null;
    };
  }

  exceedLimitValidator(maxDigits: number): ValidatorFn {
    return (control: AbstractControl): ValidationErrors | null => {
      const value = control.value;
      if (!value) return null;

      // Check if it's a valid number and not in exponential format
      if (!/^\d+$/.test(value)) {
        return { exceedLimit: 'Invalid format or contains non-digit characters' };
      }

      // Check digit length
      if (value.length > maxDigits) {
        return { exceedLimit: 'Value exceeds allowed digit limit' };
      }

      return null;
    };
  }




  nonZeroValidator(): ValidatorFn {
    return (control: AbstractControl): ValidationErrors | null => {
      const value = control.value;

      // Allow null, undefined, or empty string (for optional fields)
      if (value === null || value === undefined || value === '') {
        return null;
      }

      // Reject zero
      return Number(value) === 0 ? { zeroValue: true } : null;
    };
  }

  maxLengthValidator(maxLength: number): ValidatorFn {
    return (control: AbstractControl): ValidationErrors | null => {
      const value = control.value;

      if (value === null || value === undefined || value === '') {
        return null;
      }

      const stringValue = value.toString();

      // Reject scientific notation
      // if (/[eE]/.test(stringValue)) {
      //   return { maxLength: 'Scientific notation not allowed' };
      // }

      return stringValue.length > maxLength
        ? { maxLength: 'Value exceeds allowed digit limit' }
        : null;
    };
  }

  integerValidator(): ValidatorFn {
    return (control: AbstractControl): ValidationErrors | null => {
      const value = control.value;
      if (value === null) {
        return null;
      }
      return Number.isInteger(value) ? null : { notInteger: true };
    };
  }
  private getInvalidRequiredFields(formGroup: FormGroup): string[] {
    const invalidFields: string[] = [];

    Object.keys(formGroup.controls).forEach(key => {
      const control = formGroup.get(key);
      if (control && control.errors?.['required']) {
        invalidFields.push(key);
      }
    });

    return invalidFields;
  }


