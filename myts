import { TranslationKey } from '../../../metadat-config/codegen-config.constant';
import { Conditions, ConditionTable } from '../../transaction-type.model';

@Component({
  selector: 'bod-conditions-multiselect-dialog',
  standalone: true,
  imports: [
    ConditionsMultiselectTableComponent,
    ReactiveFormsModule,
    BodFormModule,
    FormsModule,
    BodAutoCompleteModule,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    BodCommonModule
  ],
  templateUrl: './conditions-multiselect-dialog.component.html',
  styleUrls: ['./conditions-multiselect-dialog.component.scss']
})
export class ConditionsMultiselectDialogComponent {
  public translationKey = TranslationKey;

  formType: BodFormTypes = BodFormTypes.FORM;
  @ViewChild('conditionsTable', { static: false }) conditionsTable: ConditionsMultiselectTableComponent;
  @Output() rowSelected = new EventEmitter<ConditionTable[]>();

  public initialSelectedRows: Conditions[] = [];
  selectedRows: Conditions[] = [];
  public addConditionsFormGroup: UntypedFormGroup;
  isDirty = false;

  constructor(
    public dialogRef: MatDialogRef<ConditionsMultiselectDialogComponent>,
    @Inject(MAT_DIALOG_DATA) public data: any,
    private fb: UntypedFormBuilder
  ) {
    this.initForm();
    this.initialSelectedRows = [...(data.selectedRowSingleSelect || [])];
    this.selectedRows = [...this.initialSelectedRows];
  }

  private initForm(): void {
    const controls: { [key: string]: any } = {};
    // Always get the latest data
    const allRows = this.data?.conditionsDataSingleSelect?.datasource?.data || [];
    allRows.forEach((row: any, idx: number) => {
     
      controls['relationshipType_' + row.id] = [row.relationshipType || null];
    });
    this.addConditionsFormGroup = this.fb.group(controls);
    console.log('Dialog initForm - Form controls:', Object.keys(controls));
  }

  ngOnChanges(changes: SimpleChanges) {
    if (changes['data'] || changes['conditionData']) {
      this.initForm();
    }
  }

  onTableDirtyChange(dirty: boolean) {
    this.isDirty = dirty;
    if (dirty) {
      this.addConditionsFormGroup.markAsDirty();
    }
  }

  public isTableDirty = false;

  public onTableDirty(): void {
    this.isTableDirty = true;
    this.addConditionsFormGroup.markAsDirty();
  }

  onRowSelected(selectedRows: Conditions[]) {
    console.log('onRowSelected called with:', selectedRows);
    this.selectedRows = selectedRows;
    this.isDirty = true;
    this.addConditionsFormGroup.markAsDirty();
    // this.initForm();
  }

  onSubmit() {
    if (this.addConditionsFormGroup.invalid) {
      this.addConditionsFormGroup.markAllAsTouched();
      return; // Prevent closing the dialog
    }
    // Pass the selectedRows object when closing the dialog
    this.dialogRef.close({ selectedConditions: this.selectedRows });
  }

 onReset() {
  this.isDirty = false;

  this.selectedRows = [...this.initialSelectedRows];

  // Use identifier for matching
  Object.keys(this.addConditionsFormGroup.controls).forEach(key => {
    const rowId = Number(key.replace('relationshipType_', ''));
    // Find the table row by id
    const tableRow = this.data.conditionsDataSingleSelect?.datasource?.data.find(row => row.id === rowId);
    // Find the initial row by identifier
    const initialRow = this.initialSelectedRows.find(row => row.identifier === tableRow?.identifier);
    this.addConditionsFormGroup.get(key)?.setValue(initialRow ? initialRow.relationshipType : null);
  });

  if (this.conditionsTable) {
    this.conditionsTable.resetSelection();
    setTimeout(() => {
      this.conditionsTable.selectedRowSingleSelect = [...this.initialSelectedRows];
      this.conditionsTable.selectConditionsRows?.();
    }, 0);
  }
}
}
