<bod-message-container [messages]="errorMessages"></bod-message-container>
<bod-form
  [formGroup]="addNewBalanceTypeFormGroup"
  rufId
  [type]="formType"
  (onSubmit)="onAddNewBalanceType(isAdd)"
  (onReset)="onReset(isAdd)"
  fisStyle
>
  <bod-input-layout col="2">
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.code'"
      [forTextOnly]="true"
      [required]="true"
    >
    <div *ngIf="isEdit">
      {{ addNewBalanceTypeFormGroup.get('balanceTypeCode')?.value }}
    </div>
      <mat-form-field appearance="outline" fisStyle *ngIf="!isEdit">
        <input
          type="text"
          matInput
          fisStyle
          formControlName="balanceTypeCode"
          name="balanceTypeCode"
        />
        
        <mat-error>
         {{ getError('balanceTypeCode', addNewBalanceTypeFormGroup) | translate }}
        </mat-error> 
        <mat-error *ngIf="addNewBalanceTypeFormGroup.get('balanceTypeCode').hasError('noSpecialCharacters')">
        </mat-error>
      </mat-form-field>
    </bod-control-group>
   
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.name'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <input
          type="text"
          matInput
          fisStyle
          formControlName="balanceTypeName"
          name="balanceTypeName"
        />
        <mat-error>
          {{ getError('balanceTypeName', addNewBalanceTypeFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.systembalance'"
      [forTextOnly]="true"
      [required]="false"
    >
      <mat-slide-toggle
        fisStyle
        color="primary"
        formControlName="systembalance"
        name="systembalance"
      >
      </mat-slide-toggle>
    </bod-control-group>
  </bod-input-layout>
  <bod-input-layout col="2">
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.balancesubtype'"
      [forTextOnly]="true"
      [required]="false"
      
    >
      <mat-slide-toggle
        fisStyle
        color="primary"
        formControlName="balancesubtype"
        name="balancesubtype"
      
      >
      </mat-slide-toggle>
    </bod-control-group>
  </bod-input-layout>
  <div *ngIf="addNewBalanceTypeFormGroup.get('balancesubtype').value" >
    <bod-input-layout col="1">
      <bod-table
        #balanceSubTypetable
        [data]="balanceSubTypeData"
        [tableActions]="balanceSubTypeTableActions"
        (onTableActionClick)="onValidTableActionClicked($event)"
        [inlineModal]="{
          addNewInlineRowTitle: 'New Balance Sub Type' | translate,
          formGroup: balanceSubtypeForm,
          formTemplateName: balanceSubtypeTemplate
        }"
        (onInlineFormAddSubmit)="onAddBalSubType(balanceSubtypeForm.value)"
        (onInlineFormEditSubmit)="onAddBalSubType(balanceSubtypeForm.value)"
        (onInlineEditRowActionClick)="inlineEditRowActionClick($event, 0)"
        (onInlineAddRowActionClick)="inlineAddRowActionClick()"
        [customColumnTemplates]="[
          {
            columnName: 'actions',
            templateName: deleteBalSubTypeTemplate
          }
        ]"
        [alignContent]="'top'"
      >
        <ng-template
          #deleteBalSubTypeTemplate
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <bod-table-actions
            [actions]="rowLevelActionsForBasicEdit"
            (onActionClick)="handleRowLevelActionsforBalSubType($event.icon, index)"
          >
          </bod-table-actions>
        </ng-template>
      </bod-table>
      <form [formGroup]="balanceSubtypeForm">
        <ng-template #balanceSubtypeTemplate>
          <bod-input-layout col="2">
            <bod-control-group
              [truncate]="false"
              [label]="translationKey + 'metadataconfig.code'"
              [forTextOnly]="true"
              [required]="true"
            >
              <mat-form-field appearance="outline" fisStyle>
                <input
                  type="text"
                  matInput
                  fisStyle
                  formControlName="balancesubtypecode"
                  name="balancesubtypecode"
                />
              </mat-form-field>
            </bod-control-group>
          
            <bod-control-group
              [truncate]="false"
              [label]="translationKey + 'metadataconfig.name'"
              [forTextOnly]="true"
              [required]="true"
            >
              <mat-form-field appearance="outline" fisStyle>
                <input
                  type="text"
                  matInput
                  fisStyle
                  formControlName="balancesubtypename"
                  name="balancesubtypename"
                />
              </mat-form-field>
            </bod-control-group>
          </bod-input-layout>
        </ng-template>
      </form>
    </bod-input-layout>
  </div>


