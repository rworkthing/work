  loadDropdownData(): void {


    this.metadataService.getTypes().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: this.codeTranslationMap[item.code] || item.code,
        value: item.identifier
      }));
      mappedData.sort((a, b) => a.label.localeCompare(b.label));
      this.types = mappedData;
    });



    this.metadataService.getDataTypes().subscribe(
      (data: any[]) => {
        const mappedData = data.map(item => ({
          label: item.code,
          value: item.identifier
        }));
        mappedData.sort((a, b) => a.label.localeCompare(b.label));
        this.datatypes = mappedData;
      },
      error => {
        console.error('Error fetching data types', error);
      }
    );

    this.metadataService.getProductCodes().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      mappedData.sort((a, b) => a.label.localeCompare(b.label));
      this.productCodes = mappedData;

    });


    this.metadataService.getLocaleCodes().subscribe(
      (data: any[]) => {
        const mappedData = data.map(item => ({
          label: item,
          value: item
        }));
        mappedData.sort((a, b) => a.label.localeCompare(b.label));
        this.localeCodes = mappedData;
      },
      error => {
        console.error('Error fetching data types', error);
      }
    );
    this.metadataService
      .getStatus()
      .subscribe(data => (this.statuses = data));

    this.metadataService
      .getClassificationTypes()
      .subscribe(data => (this.classificationtypes = data));

    this.metadataService
      .getValidvalueTypes()
      .subscribe(data => (this.validvaluestypes = data));
  }

