  onAddNewRoleType() {
    const formValue = this.addNewRoleTypeFormGroup.getRawValue();
    this.addNewRoleTypeFormGroup.controls['roleTypeIdentifier'].enable();
    const SelectedCategory = formValue.category;
    const SelectedClassification = formValue.classification;
    const categoryIdentifier =
      parseInt(
        this.categorys.find(item => item.label === SelectedCategory)?.value,
        10
      ) || parseInt(SelectedCategory, 10);
    const classificationIdentifier =
      parseInt(
        this.classifications.find(item => item.label === SelectedClassification)?.value,
        10
      ) || parseInt(SelectedClassification, 10);

    const roleType = {
      identifier: formValue.roleTypeIdentifier,
      code: formValue.roleTypeCode,
      name: formValue.roleTypeName,
      shortName: formValue.roleTypeShortName,
      category: categoryIdentifier,
      classification: classificationIdentifier,
      systemDefined: formValue.systemDefined ? 'Y' : 'N',
      calculated: formValue.calculated ? 'Y' : 'N'
    };
    const roleCategoryList = [
      {
        identifier: formValue.roleTypeIdentifier,
        code: formValue.roleTypeCode,
        name: formValue.roleTypeName,
        shortName: formValue.roleTypeShortName
      }
    ];
    const productTypeRoleTypeRelationshipList =
      this.dataWithRoleRelationshipvalues.length > 0
        ? this.dataWithRoleRelationshipvalues.map(item => {

          const primary = item.roleTypes.find(
            roleType => roleType.label === 'Primary'
          )?.value;
          const percentageAllowed = item.roleTypes.find(
            roleType => roleType.label === 'Percentage Allowed'
          )?.value;
          const applicableOrder = item.roleTypes.find(
            roleType => roleType.label === 'Applicable Order'
          )?.value;
          const signatureRequired = item.roleTypes.find(
            roleType => roleType.label === 'Signature Required'
          )?.value;
          const ownerCategory = item.roleTypes.find(
            roleType => roleType.label === 'Owner Category'
          )?.value;
          const ownerSubCategory = item.roleTypes.find(
            roleType => roleType.label === 'Owner Sub Category'
          )?.value;
          const additionalDetails = item.roleTypes.find(
            roleType => roleType.label === 'Additional Details'
          )?.value;
          // const roleTypeIdentifier = this.roleTypes.find(
          //   rt => rt.label === item.roleType
          // )?.value;

          return {
            identifier: 1110101,
            roleTypeIdentifier: formValue.roleTypeIdentifier,
            roleTypeCode: formValue.roleTypeCode,
            customerType: item.customerType || null,
            percentageAllowed: percentageAllowed ? 'Y' : 'N',
            isPrimary: primary ? 'Y' : 'N',
            minimumRequired: item.minimum,
            maximumAllowed: item.maximum,
            applicableOrder: applicableOrder ? 'Y' : 'N',
            maximumAccountAllowed: item.maximumAccountAllowed,
            signatureRequired: signatureRequired ? 'Y' : 'N',
            ownerCategory: ownerCategory,
            onwerSubCategory: ownerSubCategory,
            additionalDetails: additionalDetails
          }
        })
        : [];


    // const productTypeRoleTypeCatRelationshipList = [
    //   {
    //     productTypeIdentifier: 1110101,
    //     roleTypeIdentifier: formValue.roleTypeIdentifier,
    //     categoryIdentifier: formValue.roleCategoryValue
    //   }
    // ];

    const productTypeRoleTypeCatRelationshipList = Object.keys(
      this.roleCategoryValueForm.controls
    ).map((key, index) => {
      return {
        productTypeIdentifier: 1110101,
        roleTypeIdentifier: formValue.roleTypeIdentifier,
        categoryIdentifier: parseInt(this.roleCategoryValueForm.get(
          this.roleCategoryFormCtrlKeysValue[index]
        )?.value, 10)
      };
    });

    const roleTypeData = {
      metadataType: 'RoleType',
      roleRelationshipTypeList: [
        {
          roleType,
          roleCategoryList,
          productTypeRoleTypeRelationshipList,
          productTypeRoleTypeCatRelationshipList,
        }
      ],
      productTypeList: ['Checking']
    };
    this.getNewRoleType();
    console.log('Role Type Data:', JSON.stringify(roleTypeData, null, 2));


    const serviceCall = this.roleTypeService.saveRoleType(roleTypeData)
    serviceCall.subscribe(
      response => this.handleSuccess(response),
      error => {
        console.error('Error creating role type:', error);
        // this.handleError(error);
      }
    );
    this.addNewRoleTypeFormGroup.controls['roleTypeIdentifier'].disable();

  }
  handleSuccess(response?: any) {
    this.dialogRef$.close();

    console.log('Balance Type saved successfully:', response);
    const successMsg = 'Balance Type Added Successfully';

    this.message = {
      code: '204',
      text: successMsg,
      type: NotificationMessageType.SUCCESS
    };

    this.messages.push(this.message);
    this.getNewRoleType();
  }
  roleTypeData: RoleTypeList[] = [];

  getNewRoleType(): void {
    this.roleTypeService.retrieveRoleType().subscribe(response => {
      if (response.status === 'SUCCESS' && response.data) {
        console.log('Response Data:', response.data);
        console.log('Response Data:', JSON.stringify(response.data, null, 2));
        this.roleTypeData = response.data.map((item: any) => {
          if (!item.RoleType || !item.RoleType.roleType) {
            console.error("RoleType or roleType is missing in item:", item);
            return null; // Skip this item
          }
        
          const roleType = item.RoleType.roleType;
          const roleCategoryList = item.RoleType.roleCategoryList || [];
          const productTypeRoleTypeRelationshipList = item.RoleType.productTypeRoleTypeRelationshipList || [];
          const productTypeRoleTypeCatRelationshipList = item.RoleType.productTypeRoleTypeCatRelationshipList || [];
        
          let roleCategoryListMapped = roleCategoryList.map((category: any) => ({
            identifier: category.identifier,
            code: category.code,
            name: category.name,
            shortName: category.shortName
          }));
        
          let productTypeRoleTypeRelationshipListMapped = productTypeRoleTypeRelationshipList.map((relationship: any) => ({
            identifier: relationship.identifier,
            roleTypeIdentifier: relationship.roleTypeIdentifier,
            roleTypeCode: relationship.roleTypeCode,
            customerType: relationship.customerType,
            percentageAllowed: relationship.percentageAllowed,
            isPrimary: relationship.isPrimary,
            minimumRequired: relationship.minimumRequired,
            maximumAllowed: relationship.maximumAllowed,
            applicableOrder: relationship.applicableOrder,
            maximumAccountAllowed: relationship.maximumAccountAllowed,
            signatureRequired: relationship.signatureRequired,
            ownerCategory: relationship.ownerCategory,
            onwerSubCategory: relationship.onwerSubCategory,
            additionalDetails: relationship.additionalDetails
          }));
        
          let productTypeRoleTypeCatRelationshipListMapped = productTypeRoleTypeCatRelationshipList.map((roleCatRelationship: any) => ({
            productTypeIdentifier: roleCatRelationship.productTypeIdentifier,
            roleTypeIdentifier: roleCatRelationship.roleTypeIdentifier,
            categoryIdentifier: roleCatRelationship.categoryIdentifier
          }));
        
          const roleTypeData: RoleTypeList = {
            code: roleType.code,
            roleTypeInquiry: [
              { id: 0, label: "Name", value: roleType.name },
              { id: 1, label: "Identifier", value: roleType.identifier },
              { id: 2, label: "Short Name", value: roleType.shortName },
              { id: 3, label: "Category", value: roleType.category },
              { id: 4, label: "Classification", value: roleType.classification },
              { id: 5, label: "System Defined", value: roleType.systemDefined },
              { id: 6, label: "Calculated", value: roleType.calculated }
            ],
            identifier: roleType.identifier,
            name: roleType.name,
            shortName: roleType.shortName,
            category: roleType.category,
            classification: roleType.classification,
            systemDefined: roleType.systemDefined,
            calculated: roleType.calculated,
            roleCategoryList: roleCategoryListMapped,
            productTypeRoleTypeRelationshipList: productTypeRoleTypeRelationshipListMapped,
            productTypeRoleTypeCatRelationshipList: productTypeRoleTypeCatRelationshipListMapped
          };
        
          return roleTypeData;
        }).filter(Boolean); // Remove null values
        
        console.log('Element Data:', JSON.stringify(this.roleTypeData, null, 2));
        this.roleTypeDataEvent.emit(this.roleTypeData);
      }
    });
  }

