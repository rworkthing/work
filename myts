  private updateAdditionalDataValueType(datatype: string) {
    const additionalDataValueControl = this.addNewAttributeFormGroup.get('additionaldatavalue');
    if (additionalDataValueControl) {
      if (datatype === 'Integer' || datatype === 'BigInteger') {
        additionalDataValueControl.setValidators([
          this.exceedLimitValidator(32),
          Validators.required,
          Validators.pattern('^[0-9]*$')
        ]);
      } else {
        additionalDataValueControl.setValidators([Validators.required]);
      }
      additionalDataValueControl.updateValueAndValidity();
    }
  }
  onSelectionChangeForStatus(event: MatSelectChange) {
    const selectedValue = event.value;

    this.bodConfirmAlertDialogsService.confirm(this.ConfirmData1).subscribe(val => {
      if (val) {
        this.handleStatusChange(selectedValue);
        this.previousStatus = selectedValue; // Update only after confirmation
      } else {
        this.statusControl.setValue(this.previousStatus);
      }
    });
  }

  getStatusLabel(): string {
    const selectedValue = this.statusControl.value;
    if (selectedValue === 'NEW' || selectedValue === null) {
      return 'New';
    }
    const match = this.statuses.find(status => status.value === selectedValue);
    return match ? match.label : 'New';
  }


  handleStatusChange(newStatus: any) {
    console.log('Status changed to:', newStatus);

    const requestPayload = {
      status: newStatus,
      // Add other necessary fields here
    };

    this.metadataService.updateMetadataStatus(newStatus, requestPayload).subscribe({
      next: (response) => {
        console.log('Status update successful:', response);
        this.getAttribute();
      },
      error: (error) => {
        console.error('Error updating status:', error);
      }
    });

  }
  isStatusEditable(): boolean {
    const value = this.statusControl.value;
    return value !== 'READY' && value !== 'GENERATED';
  }



  onSelectionChange(event: MatSelectChange) {
    const selectedValue = event.value;
    const selectedLabel = this.datatypes.find(option => option.value === selectedValue)?.label;

    switch (selectedLabel) {
      case 'Count':
      case 'Integer':
      case 'BigInteger':
      case 'Percentage':
      case 'Rate':
      case 'Money':
        this.inputType = 'number';
        this.isDisabled = false;
        break;
      case 'Time':
        this.inputType = 'time';
        this.isDisabled = false;
        break;
      case 'Date':
        this.inputType = 'date';
        this.isDisabled = false;
        break;
      case 'Code':
      case 'Text':
      case 'ObjectReference':
      case 'DPKeyAttributeList':
        this.inputType = 'text';
        this.isDisabled = false;
        break;
      case 'DAT':
        this.inputType = 'datetime-local';
        this.isDisabled = false;
        break;
      case 'YesNo':
      case 'Flag':
        this.inputType = 'disable';
        this.isDisabled = true;
        break;
      default:
        this.inputType = 'text';
        this.isDisabled = false;
        break;
    }
    console.log('Selected value:', selectedValue);
    console.log('Selected label:', selectedLabel);
    console.log('Input type:', this.inputType);
    console.log('Is disabled:', this.isDisabled);
  }
