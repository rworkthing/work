import { Component, OnInit, ViewChild } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormBuilder, FormsModule, ReactiveFormsModule, UntypedFormControl, UntypedFormGroup, Validators } from '@angular/forms';
import { MatButtonModule } from '@angular/material/button';
import { MatButtonToggleModule } from '@angular/material/button-toggle';
import { MatDatepickerModule } from '@angular/material/datepicker';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatIconModule } from '@angular/material/icon';
import { MatInputModule } from '@angular/material/input';
import { MatSelectModule } from '@angular/material/select';
import { MatSlideToggleModule } from '@angular/material/slide-toggle';
import { MatTabsModule } from '@angular/material/tabs';
import { InquiryLayoutModule, SearchFieldModule, DirectivesModule, BodPageContainerModule, BodTableModule, BodTableActionsModule, InputLayoutModule, BodFormModule, ControlGroupModule, BodDynamicFormModule, SectionContainerModule, MessageContainerModule, BodCurrencyControlModule, BodCommonModule, BodFormTypes, BodCommonDialogService, BodTableMetadata, RowLeftAction, BodTableAction, InlineEditOutput, ColumnType, ModeOptions, BodTableActionType, EditTableAction, BodTableComponent } from '@bod/common';
import { TranslateModule } from '@ngx-translate/core';
import { RufIconModule } from '@ruf/shell/icon';
import { RoleTypeComponent } from '../role-type/role-type.component';
import { TranslationKey } from '../metadat-config/codegen-config.constant';
import { MetadataService } from '../metadat-config/metada-config.service';
import { RoleTypeService } from '../role-type/role-type-service';
import { RoleRelationshipSampleTable } from './roletypeForExisting.model';
import { MatTableDataSource } from '@angular/material/table';
import { roletypeaction, roletypeactionDelete } from '../role-type/role-type-constants';
import { BodRoleCategoryTable } from '../bod-table-demo.model';
import { roleCategoryTableActions } from '../codegen-config/codegen-config.constant';
import { FormUtilityService } from '../metadat-config/form-utility.service';

@Component({
  selector: 'bod-existing-role-type',
  standalone: true,
  imports: [
    RoleTypeComponent,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,

    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    MatDatepickerModule,
    BodCommonModule
  ],
  templateUrl: './existing-role-type.component.html',
  styleUrl: './existing-role-type.component.scss'
})
export class ExistingRoleTypeComponent implements OnInit {
  public translationKey = TranslationKey;
  public addExistingRoleTypeFormGroup: UntypedFormGroup | undefined;
  public roleRelationshipForExistingForm: UntypedFormGroup;
  public exstRoleCategoryTableData: BodTableMetadata;
  public customerTypes: any[] = [];

  formType: BodFormTypes = BodFormTypes.SUBMIT;

  public existingRoleCodes: any[] = [];
  public modeOptions: ModeOptions = { input: false, reset: false };


  public exstRoleCategoryTableActions: BodTableAction[] = roleCategoryTableActions;
  public roleRelationshipTableActions: BodTableAction[] = roletypeaction;
  public rowLevelActionsForBasicEdit: BodTableAction[] = roletypeactionDelete;

  public dataWithExstRoleCategory: BodRoleCategoryTable[] = [];
  private lastModifiedIndex: number = 0;
  roleCategoryIdForm: UntypedFormGroup = new UntypedFormGroup({});
  roleCategoryValueForm: UntypedFormGroup = new UntypedFormGroup({});
  roleCategoryFormCtrlKeysId: string[] = [];
  roleCategoryFormCtrlKeysValue: string[] = [];
  
  @ViewChild('exstRoleCategoryTable',  { static: false })
    public exstRoleCategoryTable: BodTableComponent;

  public onValidTableActionClicked(event: BodTableAction): void { }
  public inlineAddRowActionClick() { }
  public inlineEditRowActionClick(_event: InlineEditOutput) { }

  public onRoleCategoryTableActionClicked(event: BodTableAction) {
    if (event.id === BodTableActionType.ADD) {
      this.addExstRoleCategory('', '');
    }
    //  else if (event.id === BodTableActionType.EDIT) {
    //   console.log('edit')
    // }
  }

  constructor(
    public roleTypeService: RoleTypeService,
    private fb: FormBuilder,
    private bodCommonDialogService: BodCommonDialogService,
    private metadataService: MetadataService //roleTypetabledata

  ) {

    this.exstRoleCategoryTableData = {
      columns: [
        {
          name: 'roleCategoryId',
          title: 'Id',
          truncate: true,
          noOverflow: true,
          width: 12,
          widthUnit: 'rem',
          inputModeOptions: {
            type: ColumnType.select
          }
        },
        {
          name: 'roleCategoryValue',
          title: 'Value',
          truncate: true,
          noOverflow: true,
          width: 6,
          widthUnit: 'rem',
          inputModeOptions: {
            type: ColumnType.select
          }
        },
        { name: 'actionBtns', title: ' ', hasAction: true }
      ],
      datasource: new MatTableDataSource<BodRoleCategoryTable>(this.dataWithExstRoleCategory),
      noRecordsMessage: 'No Data Defined'
    };
  }
  ngOnInit(): void {
    this.initForm();
    this.loadDropdownData();
  }

  loadDropdownData(): void {

    this.roleTypeService.getRoletype().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      this.existingRoleCodes = mappedData;
    });

  }
  private initForm(): void {
    this.addExistingRoleTypeFormGroup = this.fb.group({
      existingRolecode: new UntypedFormControl('', [Validators.required]),
    });
    this.roleRelationshipForExistingForm = this.fb.group({
      customerType: new UntypedFormControl('', [Validators.required]),
      maximumAccountAllowed: new UntypedFormControl(''),
      minimum: new UntypedFormControl(''),
      maximum: new UntypedFormControl(''),
      primary: new UntypedFormControl(''),
      percentageAllowed: new UntypedFormControl(''),
      applicableOrder: new UntypedFormControl(''),
      signatureRequired: new UntypedFormControl(''),
      ownerCategory: new UntypedFormControl(''),
      ownerSubCategory: new UntypedFormControl(''),
      additionalDetails: new UntypedFormControl('')
    });
  }

  private addExstRoleCategory(roleCategoryId: string, roleCategoryValue: string) {
    let updatedData = {
      id: this.lastModifiedIndex,
      roleCategoryId: '',
      action: EditTableAction.ADD,
      roleCategoryValue: ''
    };
    this.exstRoleCategoryTable.addRow(updatedData);
    console.log(this.exstRoleCategoryTable)
    this.roleCategoryFormCtrlKeysId = FormUtilityService.addFormControl(
      this.roleCategoryIdForm,
      'roleCategoryId',
      this.lastModifiedIndex,
      true,
      roleCategoryId
    );
    this.roleCategoryFormCtrlKeysValue = FormUtilityService.addFormControl(
      this.roleCategoryValueForm,
      'roleCategoryValue',
      this.lastModifiedIndex,
      true,
      roleCategoryValue
    );

    ++this.lastModifiedIndex;
    // this.addNewAttributeFormGroup.markAsDirty();
  }

  handleRowLevelActionsforRoleRelationshipForExisting(action: string, index: number) {
    if (action === 'trash') {
      this.deleteRoleRelationshipRow(index);
    }
  }
  deleteRoleRelationshipRow(index: number): void {
    this.dataWithRoleRelationshipvaluesForExisting.splice(index, 1);
    if (this.roleRelationshipTabledataForExisting && this.roleRelationshipTabledataForExisting.datasource) {
      this.roleRelationshipTabledataForExisting.datasource.data = [
        ...this.dataWithRoleRelationshipvaluesForExisting
      ];
    }
  }

  onExistingRoleType() { }

  public dataWithRoleRelationshipvaluesForExisting: RoleRelationshipSampleTable[] = [];
  onAddForExistingRoleRelationship(formValues: any) {
    //convert from idfr to code

    console.log("form value:", formValues);
    console.log("before push:", this.dataWithRoleRelationshipvaluesForExisting);

    const selectedCustomerType = this.customerTypes.find(
      item => item.value === formValues.customerType
    );
    const custTypeName = selectedCustomerType ? selectedCustomerType.label : '';
    const newValidValue: RoleRelationshipSampleTable = {
      customerType: custTypeName || '',
      maximumAccountAllowed: formValues.maximumAccountAllowed || '',
      minimum: formValues.minimum || '',
      maximum: formValues.maximum || '',
      roleType: [
        {
          id: 0,
          label: 'Primary',
          value: formValues.primary
        },
        {
          id: 1,
          label: 'Percentage Allowed',
          value: formValues.percentageAllowed
        },
        {
          id: 2,
          label: 'Applicable Order',
          value: formValues.applicableOrder
        },
        {
          id: 3,
          label: 'Signature Required',
          value: formValues.signatureRequired
        },
        {
          id: 4,
          label: 'Owner Category',
          value: formValues.ownerCategory
        },
        {
          id: 5,
          label: 'Owner Sub Category',
          value: formValues.ownerSubCategory
        },
        {
          id: 6,
          label: 'Additional Details',
          value: formValues.additionalDetails
        }
      ]
    };
    this.dataWithRoleRelationshipvaluesForExisting.push(newValidValue);
    console.log("after push:", this.dataWithRoleRelationshipvaluesForExisting);
    if (this.roleRelationshipTabledataForExisting && this.roleRelationshipTabledataForExisting.datasource) {
      this.roleRelationshipTabledataForExisting.datasource.data = [
        ...this.dataWithRoleRelationshipvaluesForExisting
      ];
      console.log("uodated table data:", this.roleRelationshipTabledataForExisting);
    }
    if (this.roleRelationshipForExistingForm) {
      this.roleRelationshipForExistingForm.reset();
    }
  }

  public roleRelationshipTabledataForExisting: BodTableMetadata = {
    title: 'Role Relationship Details',
    columns: [...this.roleTypeService.roleTypecolumn],
    rowLeftAction: RowLeftAction.expandableRows,
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      // pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<RoleRelationshipSampleTable>(
      this.dataWithRoleRelationshipvaluesForExisting
    ),
    noRecordsMessage: 'No data Defined'
  };

}
