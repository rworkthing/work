          .get('productTypeCode')
          ?.setValue(value);
      });

    this.addEditBalanceHoldFormGroup
      .get('relatetoproducttype')
      ?.valueChanges.subscribe(value => {
        this.isRelateToProductTemplate = value;
        if (!value) {
          this.isValidValueTypes = false;
          this.addEditBalanceHoldFormGroup
            .get('validtype')
            ?.setValue(false, { emitEvent: false });
        }
      });

    this.addEditBalanceHoldFormGroup
      .get('validtype')
      ?.valueChanges.subscribe(value => {
        if (this.isRelateToProductTemplate) {
          this.isValidValueTypes = value;
        } else {
          this.isValidValueTypes = false;
        }
      });
  }

