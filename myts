  loadDropdownData(): void {
    this.roleTypeService.getRoleCat().subscribe(data => {
      
      this.inputForpreconversionSelect1 = {
        options: data.map((item: any) => ({
          label: item.code,
          value: item.identifier
        })),
        isMultiSelect: true
      };
      this.roleCategoryMultidata = this.inputForpreconversionSelect1;
    });
    this.roleTypeService.getRoleCat().subscribe(data => {
      this.cattypes = data.map((item: any) => ({
