  roleTypeData: RoleTypeList[] = [];
  getNewRoleType(): void {
    this.roleTypeService.retrieveRoleType().subscribe(response => {
      if (response.status === 'SUCCESS' && response.data) {
        console.log('Response Data:', response.data);
        console.log('Response Data:', JSON.stringify(response.data, null, 2));
        this.roleTypeData = response.data.map((item: any) => {
          if (!item.RoleType) {
            console.error("RoleType is missing in item:", item);
            return null;
          }

          const roleType = item.RoleType.roleType || {};
          const productTypeRoleTypeRelationshipList = item.RoleType.productTypeRoleTypeRelationshipList || [];

          const roleTypeCode = roleType.code || (productTypeRoleTypeRelationshipList.length > 0 ? productTypeRoleTypeRelationshipList[0].roleTypeCode : null);

          if (!roleTypeCode) {
            console.error("RoleType code is missing in item:", item);
            return null;
          }



          const roleCategoryList = item.RoleType.roleCategoryList || [];
          const productTypeRoleTypeCatRelationshipList = item.RoleType.productTypeRoleTypeCatRelationshipList || [];

          // const categoryValues = productTypeRoleTypeCatRelationshipList
          //   .map((categoryValRelationship: { categoryIdentifier: any; }) => categoryValRelationship.categoryIdentifier)
          //   .join(', ');

          // // Create a single entry in roleCategory with the combined category values
          // const roleCategoryMapped = categoryValues
          //   ? [{ id: 0, label: "Category", value: categoryValues }]
          //   : [];

          const categoryLabels = productTypeRoleTypeCatRelationshipList
            .map((categoryValRelationship: { categoryIdentifier: any; }) => {
              const category = this.cattypes.find(cat => cat.value === categoryValRelationship.categoryIdentifier);
              return category ? category.label : categoryValRelationship.categoryIdentifier; // Fallback to identifier if not found
            })
            .join(', ');

          // Create a single entry in roleCategory with the combined category labels
          const roleCategoryMapped = categoryLabels
            ? [{ id: 0, label: "Category", value: categoryLabels }]
            : [];

          const categoryLabel = this.cattypes.find(cat => cat.value === roleType.category)?.label || roleType.category;
          const classificationLabel = this.classifications.find(cls => cls.value === roleType.classification)?.label || roleType.classification;


          let roleCategoryListMapped = roleCategoryList.map((category: any) => ({
            identifier: category.identifier,
            code: category.code,
            name: category.name,
            shortName: category.shortName
          }));

          // let productTypeRoleTypeRelationshipListMapped = productTypeRoleTypeRelationshipList.map((relationship: any) => ({
          //   identifier: relationship.identifier,
          //   roleTypeIdentifier: relationship.roleTypeIdentifier,
          //   roleTypeCode: relationship.roleTypeCode,
          //   customerType: relationship.customerType,
          //   percentageAllowed: relationship.percentageAllowed,
          //   isPrimary: relationship.isPrimary,
          //   minimum: relationship.minimumRequired,
          //   maximum: relationship.maximumAllowed,
          //   applicableOrder: relationship.applicableOrder,
          //   maximumAccountAllowed: relationship.maximumAccountAllowed,
          //   signatureRequired: relationship.signatureRequired,
          //   ownerCategory: relationship.ownerCategory,
          //   onwerSubCategory: relationship.onwerSubCategory,
          //   additionalDetails: relationship.additionalDetails
          // }));

          let productTypeRoleTypeRelationshipListMapped = productTypeRoleTypeRelationshipList.map((relationship: any) => {
            const productTypeRole = [

              { id: 0, label: "Percentage Allowed", value: relationship.percentageAllowed },
              { id: 1, label: "Is Primary", value: relationship.isPrimary },
              { id: 2, label: "Applicable Order", value: relationship.applicableOrder },
              { id: 3, label: "Signature Required", value: relationship.signatureRequired },
              { id: 4, label: "Owner Category", value: relationship.ownerCategory },
              { id: 5, label: "Owner SubCategory", value: relationship.onwerSubCategory },
              { id: 6, label: "Additional Details", value: relationship.additionalDetails }
            ];

            return {
              identifier: relationship.identifier,
              roleTypeIdentifier: relationship.roleTypeIdentifier,
              roleTypeCode: relationship.roleTypeCode,
              customerType: relationship.customerType,
              percentageAllowed: relationship.percentageAllowed,
              isPrimary: relationship.isPrimary,
              minimum: relationship.minimumRequired,
              maximum: relationship.maximumAllowed,
              applicableOrder: relationship.applicableOrder,
              maximumAccountAllowed: relationship.maximumAccountAllowed,
              signatureRequired: relationship.signatureRequired,
              ownerCategory: relationship.ownerCategory,
              onwerSubCategory: relationship.onwerSubCategory,
              additionalDetails: relationship.additionalDetails,
              productTypeRole: productTypeRole // Add this line
            };
          });

          // let productTypeRoleTypeCatRelationshipListMapped = productTypeRoleTypeCatRelationshipList.map((roleCatRelationship: any) => ({
          //   productTypeIdentifier: roleCatRelationship.productTypeIdentifier,
          //   roleTypeIdentifier: roleCatRelationship.roleTypeIdentifier,
          //   categoryIdentifier: roleCatRelationship.categoryIdentifier
          // }));

          let productTypeRoleTypeCatRelationshipListMapped = null;
          if (productTypeRoleTypeCatRelationshipList.length > 0) {
            productTypeRoleTypeCatRelationshipListMapped =
              productTypeRoleTypeCatRelationshipList.map(
                (categoryValRelationship: any) => ({
                  productTypeIdentifier:
                    categoryValRelationship.productTypeIdentifier,
                  roleTypeIdentifier:
                    categoryValRelationship.roleTypeIdentifier,
                  categoryIdentifier:
                    categoryValRelationship.categoryIdentifier
                })
              );
          }

          const roleTypeData: RoleTypeList = {
            code: roleType.code
              ? roleType.code
              : productTypeRoleTypeRelationshipList[0].roleTypeCode,
            roleTypeInquiry: [
              { id: 0, label: "Name", value: roleType.name },
              { id: 1, label: "Identifier", value: roleType.identifier },
              { id: 2, label: "Short Name", value: roleType.shortName },
              { id: 3, label: "Category", value: categoryLabel },
              { id: 4, label: "Classification", value: classificationLabel },
              { id: 5, label: "System Defined", value: roleType.systemDefined },
              { id: 6, label: "Calculated", value: roleType.calculated }
            ],
            identifier: roleType.identifier,
            name: roleType.name,
            shortName: roleType.shortName,
            category: categoryLabel,
            classification: classificationLabel,
            systemDefined: roleType.systemDefined,
            calculated: roleType.calculated,
            roleCategoryList: roleCategoryListMapped,
            productTypeRoleTypeRelationshipList: productTypeRoleTypeRelationshipListMapped,
            productTypeRoleTypeCatRelationshipList: productTypeRoleTypeCatRelationshipListMapped,
            productTypeRole: [],
            roleCategory: roleCategoryMapped
          };

          return roleTypeData;
        });
        this.roleTypeTableMetaData.datasource.data = this.roleTypeData;

        console.log('Element Data:', JSON.stringify(this.roleTypeData, null, 2));
        console.log("emmiting data fromchild", this.roleTypeData);
      }
    });
  }

  iconActionClicked(event: BodTableAction, element: RoleTypeList) {
    // this.isEdit = true;
    this.messages = [];
    console.log(element);
    if (event.id === BodTableActionType.EDIT) {
      // this.editAttributes(element);
      // this.editBalanceTypes(element);
    } else if (event.id === 1) {
      this.bodConfirmAlertDialogsService
        .confirm(this.ConfirmData)
        .subscribe(val => {
          if (val) {
            this.roleTypeDelete(element);
          }
        });
    }
  }


  roleTypeDelete(element: RoleTypeList): void {
    if (
      element.code ===
      element.productTypeRoleTypeRelationshipList[0].roleTypeCode
    ) {
      this.roleTypeService
        .deleteRoleType(
          'RoleType',
          element.productTypeRoleTypeRelationshipList[0]
            .roleTypeIdentifier
        )
        .subscribe(response => {
          const successMsg = 'Role Type Deleted Successfully';
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);

          this.getNewRoleType();
        });
    } else {
      this.roleTypeService
        .deleteRoleType('RoleType', element.identifier)
        .subscribe(response => {
          const successMsg = 'Role Type Deleted Successfully';
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
        });
    }
