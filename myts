  getError(formControl: string, formValidatorKey?: string, customkey?: string) {
    const fc: AbstractControl = this.addNewAttributeFormGroup.get(
      `${formControl}`
    );
    if (fc.errors && fc.errors !== null) {
      let error: string = '';
      Object.keys(fc.errors).forEach(
        key =>
        (error = key
          ? key == formValidatorKey
            ? `BOD.error.${customkey}`
            : key !== null
              ? `BOD.error.${key}`
              : ''
          : ``)
      );
      return error;
    }
  }
