inlineFormAddSubmit(formGroupValid: boolean, index) {
  if (formGroupValid) {
    const newRow: BodInlineSampleTable = {
      index: this.getTableData(index).paginationOptions.length,
      id: this.getTableInput(index).id,
      name: this.getTableInput(index).name,
      productLine: this.getTableFormGroup(index).value.productLine,
      aware: this.getTableFormGroup(index).value.owner,
      relationship: this.getTableFormGroup(index).value.relationship,
      lastDebit:
        this.getTableFormGroup(index).value.lastDebit === null
          ? 0
          : this.getTableFormGroup(index).value.lastDebit,
      start: this.getTableFormGroup(index).controls['start'].value
    };
    if (index === 1 || index === 2) {
      newRow.description = [
        {
          id: 0,
          label: 'mbpBod.demo.microsite.label.title',
          value: this.getTableFormGroup(index).value.title
        },
        {
          id: 1,
          label: 'mbpBod.demo.microsite.label.firstName',
          value: this.getTableFormGroup(index).value.firstName
        },
        {
          id: 2,
          label: 'mbpBod.demo.microsite.label.lastName',
          value: this.getTableFormGroup(index).value.lastName
        }
      ];
    }
    const tempData = this.getTableRef(index).data.datasource.data;
    tempData.push(newRow);
    this.getTableRef(index).updateDatasource(
      new MatTableDataSource<BodInlineSampleTable>([...tempData])
    );
    this.getTableData(index).paginationOptions.length =
      this.getTableData(index).paginationOptions.length + 1;
  } else {
    this.displayInlineFormErrorMessage(index);
  }
}

