onExistingAdd(formValues: any) {
    if (this.inputExistingLayoutForm.invalid) {
      alert('Please fill all the required fields.');
      return;
    }
    const newValidValue: BodSampleTableExisting = {
      additionaldatavalue: formValues.additionaldatavalue ?? false,
      defaultindicator: formValues.defaultindicator ?? false,
      primaryindicator: formValues.primaryindicator ?? false,
      overrideindicator: formValues.overrideindicator ?? false,
      percentagevalue: formValues.percentagevalue ?? false,
      sequencenumber: formValues.sequencenumber ?? false
    };

    this.dataWithExsistingValidvalues.push(newValidValue);
    this.ExistingValidvalueArray.datasource.data =
      this.dataWithExsistingValidvalues;
    this.inputExistingLayoutForm.reset();
    alert('Valid values added successfully!');
  }
