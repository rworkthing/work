  public getError(control: string, formGroup: UntypedFormGroup): string {
    if (formGroup) {
      const fc: AbstractControl = formGroup.get(control);
      if (fc && fc.errors && fc.touched) {
        return FormUtilityService.getCommonFCErrorMsg(fc);
      }
    }
  }
  private roleTypeForm(element: RoleTypeList): void {
    this.isAdd = false;
   
    if (!this.categorys.length || !this.classifications.length) {
      this.roleTypeService.getRoleCat().subscribe(data => {
        this.categorys = data.map((item: any) => ({
          label: item.code,
          value: item.identifier
        }));
        this.setDropdownValues(element); // ✅ Set values after dropdown data loads
      });

      this.roleTypeService.getAccountClassification().subscribe(data => {
        this.classifications = data.map((item: any) => ({
          label: item.code,
          value: item.identifier
        }));
        this.setDropdownValues(element);
      });
    } else {
      this.setDropdownValues(element); // ✅ If data already exists, set values immediately
    }
    this.loadRoleRelationshipData(element);
    this.isEdit = true;
  }

  // ✅ Helper method to correctly set dropdown and category1 values
  private setDropdownValues(element: RoleTypeList) {
    
    // ✅ Match category and classification values correctly
    const selectedCategory = this.categorys.find(
      cat => cat.label === element.category
    );
    const selectedClassification = this.classifications.find(
      cls => cls.label === element.classification
    );

  
    // ✅ Convert category1 identifiers to corresponding labels
    const categoryLabels = element.productTypeRoleTypeCatRelationshipList.map(
      rel => {
        const matchedCategory = this.categorys.find(
          cat => cat.value === rel.categoryIdentifier
        );
        return matchedCategory
          ? matchedCategory.label
          : rel.categoryIdentifier.toString(); // Fallback to identifier if not found
      }
    );
    this.addNewRoleTypeFormGroup.patchValue({
      roleTypeCode: element.code,
      roleTypeIdentifier: element.identifier,
      roleTypeName: element.name,
      roleTypeShortName: element.shortName,
      category: selectedCategory.value, // ✅ Fix: Ensure category dropdown value is set correctly
      classification: selectedClassification.value,
      systemDefined: element.systemDefined,
      isCalculated: element.calculated,
      category1: categoryLabels
    });

    
  }
  private loadRoleRelationshipData(element: RoleTypeList): void {
    this.roleRelationshipTabledata.datasource.data = []; // Clear existing data
    this.dataWithRoleRelationshipvalues = []; // Clear existing data

    element.productTypeRoleTypeRelationshipList?.forEach(relationship => {
      let obj = {} as RoleRelationshipSampleTable;
      obj.customerType = String(relationship.customerType);
      obj.maximumAccountAllowed = relationship.maximumAccountAllowed;
      obj.minimumRequired = relationship.minimumRequired;
      obj.maximumAllowed = relationship.maximumAllowed;
      obj.roleTypes = relationship.productTypeRole.map(role => ({
        id: role.id,
        label: role.label,
        value: role.value
      }));

      // ✅ Add the data to the table and list
      this.roleRelationshipTabledata.datasource.data.push(obj);
      this.dataWithRoleRelationshipvalues.push(obj);
    });

    // ✅ Ensure Angular detects changes
    this.roleRelationshipTabledata.datasource.data = [
      ...this.roleRelationshipTabledata.datasource.data
    ];
   
  }
