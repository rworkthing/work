}

  
public setSearchFieldsData(isReset: boolean) {
  const searchFieldFormCtrlObj = this.createSearchFieldControls(isReset);
  this.searchFieldColumnForm = this.formBuilder.group(searchFieldFormCtrlObj);
  this.searchFieldFormCtrlKeys = Object.keys(this.searchFieldColumnForm.controls);
}

private createSearchFieldControls(isReset: boolean): { [key: string]: UntypedFormControl } {
  const searchFieldFormCtrlObj = {};
  this.searchFieldObjArr = [];
  const data = isReset ? this.dataForReset : this.tableWithSimpleEdit.datasource.data;

  data.forEach((row, ind) => {
    if (this.shouldCreateControl(ind)) {
      searchFieldFormCtrlObj['locale' + ind] = new UntypedFormControl(row.locale, Validators.required);
      this.searchFieldObjArr[ind] = this.createSearchFieldObject();
    }
  });

  return searchFieldFormCtrlObj;
}

private shouldCreateControl(index: number): boolean {
  return (
    this.modeOptionsSimple?.input ||
    (this.singleRowEdit?.modeOptions?.input && this.singleRowEdit?.index === index)
  );
}

private createSearchFieldObject(): SearchFieldInputData {
  return {
    searchFieldData: {
      label: '',
      fieldName: 'locale',
      descFieldName: 'displayName',
      required: true,
      hideLabel: true,
      hideFilterCriteria: true,
      disableInput: true,
      disableSearch: false,
      hideDescription: false
    },
    searchTableData: {
      title: '', // Default title
      columns: [], // Default columns
      datasource: new MatTableDataSource<any>([]), // Default data source
      noRecordsMessage: '' // Default message for no records
    }
  };
}

  public updateCustomColumnFormFields() {
    let lastSearchFieldCtrl;
    let index;
    this.searchFieldObjArr.push({
      searchFieldData: {
        label: '',
        fieldName: 'locale',
        descFieldName: 'displayName',
        required: true,
        hideLabel: true,
        hideFilterCriteria: true,
        disableInput: true,
        hideDescription: false
      },
      searchTableData: {
        columns: this.commonDataService.columnsForDemoService,
        enablePagination: true,
        paginationOptions: {
          pageSize: 5,
          length: 12
        },
        datasource: new BodTableDataSource<SampleEC>(
          new DemoTableDataService(this.http)
        ),
        noRecordsMessage: 'mbpBod.demo.microsite.table.noRecordsMsg'
      }
      });
    
    if (this.tableWithSimpleEdit.datasource.data.length > 1) {
      lastSearchFieldCtrl =
        this.searchFieldFormCtrlKeys[
          this.searchFieldFormCtrlKeys.length - 1
        ];
      index =
        parseInt(lastSearchFieldCtrl[lastSearchFieldCtrl.length - 1]) + 1;
    } else {
      index = 0;
    }
    
    this.searchFieldFormCtrlKeys = this.addFormControl(
      this.searchFieldColumnForm,
      'locale',
      index,
      true,
      ''
    );
    this.displayNameFormCtrlKeys = this.addFormControl(
      this.displayNameColumnForm,
      'displayName',
      index,
      false,
      ''
    );
    this.descriptionFormCtrlKeys = this.addFormControl(
      this.descriptionColumnForm,
      'description',
      index,
      false,
      ''
    );
}
public addFormControl(form, columnName, index, isRequired, defaultValue) {
  isRequired
    ? form.addControl(
        columnName + index,
        new UntypedFormControl(defaultValue, Validators.required)
      )
    : form.addControl(
        columnName + index,
        new UntypedFormControl(defaultValue)
      );
  return Object.keys(form.controls);
}

