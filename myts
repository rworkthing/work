  private updateRelateToProductTypeValidator(classificationType: string): void {
    const relateToProductTypeControl = this.addEditBalanceHoldFormGroup.get(
      'relatetoproducttype'
    );
    if (classificationType === 'systemDefined') {
      relateToProductTypeControl?.setValidators([Validators.required]);
    } else {
      relateToProductTypeControl?.clearValidators();
    }
    relateToProductTypeControl?.updateValueAndValidity();
  }


