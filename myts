<form [formGroup]="formGroup">
    <bod-table
      #conditionsMultiselectTable
      [data]="conditionsDataSingleSelect"
      (onRowSelect)="rowSelection($event)"
      [rowSelectionStrategy]="rowSelectionStrategy"
      [allowSelectAll]="allowRowSelection"
      [alignContent]="'top'"
      [customColumnTemplates]="[
        { columnName: 'relationshipType', templateName: relationshipTypeTemplate }
      ]"
      [modeOptions]="{selection: true }"
    >
    
      <ng-template
        #relationshipTypeTemplate
        let-element="element"
        let-column="column"
        let-index="index"
      >
      <mat-form-field appearance="outline" fisStyle style="width: 120px;">
        <mat-select
          [formControlName]="'relationshipType_' + (element.id ?? index)"
          (selectionChange)="onRelationshipTypeChange(element, $event.value)"
          panelClass="fis-style"
          name="relationshipType"
          (click)="$event.stopPropagation()"
        >
            <mat-option *ngFor="let option of relationshipTypeOptions" [value]="option.value">
              {{ option.label }}
            </mat-option>
          </mat-select>
          <mat-error *ngIf="formGroup.get('relationshipType_' + (element.id ?? index))?.hasError('required') && formGroup.get('relationshipType_' + (element.id ?? index))?.touched">
            Required field
          </mat-error>
        </mat-form-field>
      </ng-template>
    </bod-table>
</form>
















