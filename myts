 submitForm(isAdd: boolean) {
    this.messages1 = [];
    this.messages2 = [];
    this.addNewAttributeFormGroup.get('classificationtype')?.setValue('System Defined');
    const updatedData = this.addNewAttributeFormGroup.getRawValue();
    this.addNewAttributeFormGroup.controls['identifier'].enable();
    const formValue = this.addNewAttributeFormGroup.getRawValue();
    const validvalue = this.inputLayoutForm.value;
    delete formValue.validtype;
    const selectedType = formValue.type;
    const selectedFormatType = formValue.datatype;
    if (formValue.max !== undefined && formValue.max !== null && formValue.max < formValue.min) {
      this.handleError({ errorCode: 'MAX_LESS_THAN_MIN', status: 800 }, true);
      return;
    }


    formValue.name = formValue.name === "" ? null : formValue.name;
    formValue.shortname = formValue.shortname === "" ? null : formValue.shortname;



    const objectTypeIdentifier =
      this.types.find(item => item.label === selectedType)?.value ||
      selectedType;
    const formatTypeIdentifier =
      parseInt(
        this.datatypes.find(item => item.label === selectedFormatType)?.value,
        10
      ) || parseInt(selectedFormatType, 10);

    const localeTableData = this.simpleEditTableRef.getCurrentTableData?.() || [];

    const multiLingualTextInfoList: MultiLingualTextInfo[] = localeTableData.map(item => ({
      localeCode: item.locale,
      localeText: item.description ? item.description : '',
      translationText: item.displayName ? item.displayName : '',
      identifier: formValue.identifier,
      objectType: formValue.type,
      attributeType: formValue.datatype
    }));


    const locales = new Set();
    let hasDuplicateLocale = false;
    let duplicateLocale = null;

    for (const item of multiLingualTextInfoList) {
      if (locales.has(item.localeCode)) {
        hasDuplicateLocale = true;
        duplicateLocale = item.localeCode;
        break;
      }
      locales.add(item.localeCode);
    }

    if (hasDuplicateLocale) {
      this.handleError({ errorCode: 'DUPLICATE_LOCALE', status: 800, duplicateLocale }, true);
      return;
    }





    const multiLingualTextInfoRangeList = Object.keys(
      this.inputRangeLocaleLayoutFormLocale.controls
    ).map((key, index) => {
      return {
        localeCode: this.inputRangeLocaleLayoutFormLocale.get(key)?.value,
        localeText: this.inputRangeLocaleLayoutFormDisplayName.get(
          this.useExistingFormCtrlKeysRangeDisplayName[index]
        )?.value,
        identifier: formValue.identifier,
        objectType: formValue.type,
        attributeType: formValue.datatype,
        translationText: this.inputRangeLocaleLayoutFormDesc.get(
          this.useExistingFormCtrlKeysRangeDesc[index]
        )?.value
      };
    });
    const multiLingualTextInfoSetList = Object.keys(
      this.inputSetLocaleLayoutFormLocale.controls
    ).map((key, index) => {
      return {
        localeCode: this.inputSetLocaleLayoutFormLocale.get(key)?.value,
        localeText: this.inputSetLocaleLayoutFormDisplayName.get(
          this.useExistingFormCtrlKeysSetDisplayName[index]
        )?.value,
        identifier: formValue.identifier,
        objectType: formValue.type,
        attributeType: formValue.datatype,
        translationText: this.inputSetLocaleLayoutFormDesc.get(
          this.useExistingFormCtrlKeysSetDesc[index]
        )?.value
      };
    });

    const attribute: any = {
      additionalDataType: {
        identifier: formValue.identifier,
        code: formValue.code,
        name: formValue.name,
        shortName: formValue.shortname,
        objectTypeIdentifier: objectTypeIdentifier,
        formatTypeIdentifier: formatTypeIdentifier,
        calculated: formValue.calculate ? 'Y' : 'N',
        searchable: formValue.searchable ? 'Y' : 'Y',
        multiValueAllowed: formValue.multivalueallowed ? 'Y' : 'N',
        percentageAllowed: formValue.percentageallowed ? 'Y' : 'N',
        classificationType: formValue.classificationtype,
        multiLingualTextInfoList: multiLingualTextInfoList
      }


    };

    if (formValue.validvaluestype === 'rangevalues') {
      attribute.additionalDataValidValuesRange = {
        identifier: 0,
        attributeIdentifier: formValue.identifier,
        name: formValue.rangename,
        description: formValue.rangedescriptions,
        lowValue: formValue.low,
        highValue: formValue.high,
        multiLingualTextInfoList: multiLingualTextInfoRangeList

      };
    }
    if (formValue.validvaluestype === 'setvalues') {
      attribute.additionalDataValidValueSetList = [
        {
          identifier: 0,
          attributeIdentifier: formValue.identifier,
          name: formValue.setname,
          description: formValue.setdescription,
          value: formValue.attributevalue,
          isdefault: formValue.isdefault ? 'Y' : 'N',
          isPrimary: formValue.isprimary ? 'Y' : 'N',
          percentage: formValue.percentagevalue,
          sequenceNumber: formValue.sequencenumbers,
          overrideDefault: formValue.isvalueoverridden ? 'Y' : 'N',
          multiLingualTextInfoList: multiLingualTextInfoSetList

        }
      ];
    }

    
//  const productTypeIdentifiers = this.metadataService.getProductTypeIdentifiers();

    console.log("forml values data", formValue);
    // Commenting the below if condition as we are not depending on the toggle to give the value for now  
    // if (formValue.relatetoproducttype) {
      const productTypeIdentifiers = this.metadataService.getProductTypeValues();

      attribute.productTypeAdditionalDataTypeRltnpList = productTypeIdentifiers.map(id => ({
        identifier: id,
        attributeIdentifier: formValue.identifier,
        attributeCode: formValue.code,
        minimumRequired: formValue.min,
        maximumAllowed: formValue.max,
        glCategarization: formValue.GLcategorizationAllowed ? 'Y' : 'N'
      }));
      
    // }
    if (this.dataWithValidvalues.length > 0) {
      console.log(this.dataWithValidvalues);
      const productTypeAdditionalDataList = this.dataWithValidvalues.map(
        (item, index) => ({
          identifier: index,
          attributeIdentifier: formValue.identifier,
          attributeCode: formValue.code,
          attributeValue: item.additionaldatavalue,
          attributeValueSource: '',
          isDefault: item.defaultindicator === 'Y' ? 'Y' : 'N',
          isPrimary: item.primaryindicator === 'Y' ? 'Y' : 'N',
          percentage: item.percentagevalue,
          sequenceNumber: item.sequencenumber,
          overrideDefault: item.overrideindicator === 'Y' ? 'Y' : 'N'
        })
      );
      attribute.productTypeAdditionalDataList = productTypeAdditionalDataList;
    }

    this.addNewAttributeFormGroup.markAllAsTouched();
    this.addNewAttributeFormGroup.updateValueAndValidity();


    const request = {
      metadataType: 'Attribute',
      attributeList: [attribute],

      productTypeList: [
        {
          identifier: 1110101,
          code: 'Checking'
        }
      ]
    };

    console.log('request SEND:', JSON.stringify(request, null, 2));

    if (multiLingualTextInfoList.length === 0) {
      this.handleError(
        {
          errorCode: 'LOCALE_EMPTY',
          status: 409
        },
        isAdd
      );
      return;
    }
    if (this.addNewAttributeFormGroup.invalid) {
      this.addNewAttributeFormGroup.markAllAsTouched();

      const missingFields = this.getInvalidRequiredFields(this.addNewAttributeFormGroup);
      console.warn('Missing required fields:', missingFields);

      this.handleError(
        {
          errorCode: 'FORM_INVALID',
          status: 400,
          missingFields
        },
        isAdd
      );
      return;
    }


    console.log("invalidform::", this.addNewAttributeFormGroup);
    this.addNewAttributeFormGroup;
    console.log('API REQUEST', request);
    // console.log('request SEND:', JSON.stringify(request, null, 2));
    const serviceCall = isAdd
      ? this.metadataService.saveAttribute(request)
      : this.metadataService.updateAttribute(request);

    serviceCall.subscribe(
      response => {
        console.log('API Response from PUT:', response);

        if (!response) {
          console.warn(
            'PUT response is null. Fetching updated data using GET...'
          );

          this.metadataService.retrieveAttribute().subscribe(getResponse => {
            console.log(
              'Full GET Response:',
              JSON.stringify(getResponse, null, 2)
            );

            if (
              getResponse &&
              getResponse.data &&
              getResponse.data.length > 0
            ) {
              const updatedData = getResponse.data.flatMap(attributeObj => {
                const additionalDataType =
                  attributeObj.Attribute?.additionalDataType;

                if (
                  !additionalDataType ||
                  !additionalDataType.multiLingualTextInfoList
                ) {
                  console.warn(
                    'Skipping attribute: No multiLingualTextInfoList found for',
                    attributeObj
                  );
                  return [];
                }

                return additionalDataType.multiLingualTextInfoList.map(
                  item => ({
                    locale: item.localeCode,
                    displayName: item.translationText,
                    description: item.localeText
                  })
                );
              });
              console.log('DATAAAAA', this.tableWithSimpleEdit);

              // this.tableWithSimpleEdit.datasource = new MatTableDataSource(updatedData);
              this.tableWithSimpleEdit.datasource.data = updatedData;

              setTimeout(() => {
                this.changeDetectorRef.detectChanges();
              }, 100);

              console.log('Updated Table Data (After GET):', updatedData);
            } else {
              console.warn(
                'GET response contains empty data. No data to display.'
              );
            }
          });
        } else {
          const updatedData =
            response.attributeList[0].multiLingualTextInfoList.map(item => ({
              locale: item.localeCode,
              displayName: item.translationText,
              description: item.localeText
            }));

          this.tableWithSimpleEdit.datasource = new MatTableDataSource(
            updatedData
          );

          setTimeout(() => {
            this.changeDetectorRef.detectChanges();
          }, 100);

          console.log('Updated Table Data:', updatedData);
        }

        this.handleSuccess(isAdd, request);
      },
      error => {
        console.error('API Call Failed:', error);


        this.handleError(error, isAdd);
      }
    );

    this.dataWithValidvalues = [];
    this.addNewAttributeFormGroup.controls['identifier'].disable();
  }
