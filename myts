          this.lastModifiedIndex,
          true,
          column.inputModeOptions.type === ColumnType.select ? '' : null
        );
      } else if (column.name === 'displayName') {
        this.useExistingFormCtrlKeysDisplayName = FormUtilityService.addFormControl(
          this.inputLocaleLayoutFormDisplayName,
          column.name,
          this.lastModifiedIndex,
          true,
          column.inputModeOptions.type === ColumnType.input ? '' : null
        );
      } else if (column.name === 'description') {
        this.useExistingFormCtrlKeysDesc = FormUtilityService.addFormControl(
          this.inputLocaleLayoutFormDesc,
          column.name,
          this.lastModifiedIndex,
          true,
          column.inputModeOptions.type === ColumnType.input ? '' : null
        );
      }
    });

    ++this.lastModifiedIndex;
    this.addNewAttributeFormGroup.markAsDirty();
  }

