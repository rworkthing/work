    if (request?.attributeList?.[0]?.additionalDataType?.code) {
      attributeCode = request.attributeList[0].additionalDataType.code;
    } else if (request?.attributeList[0].productTypeAdditionalDataTypeRltnpList?.[0]?.attributeCode) {
      attributeCode = request.attributeList[0].productTypeAdditionalDataTypeRltnpList[0].attributeCode;
    }
    const successMsg = isAdd
      ? `${attributeCode} Added successfully`
      : `${attributeCode} Updated successfully`;

    this.message = {
      code: '204',
      text: successMsg,
      type: NotificationMessageType.SUCCESS
    };

    this.messages.push(this.message);
    this.getAttribute();
    this.resetForms();
  }

  private handleError(error: any, isAdd: boolean) {
    let errorMsg = ' ';

    if (error.errorCode === 'MAX_LESS_THAN_MIN') {
      errorMsg = 'Error: Minimum Value cannot be Greater or Equal to Maximum Value.';
    } else if (error.error.errorCode === "MBP_SDK_BUS_ERR_005") {
      errorMsg = 'Code already exists.';
    } else if (error.status === 400) {
      errorMsg = 'Please fill the required fields.';
    } else {
      errorMsg = 'Unknown error occurred.';
    }

    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };

    if (isAdd) {
      this.messages1.push(this.message);
    }
    setTimeout(() => {
      this.messages1 = this.messages1.filter(
        msg => msg.text !== errorMsg
      );
    }, 12000);
  }

  private handleError1(error: any) {
    let errorMsg = '';
    switch (error.errorCode) {
      case 'MAX_LESS_THAN_MIN':
        errorMsg =
          'Error: Minimum Value cannot be Greater or Equal to Maximum Value.';
        break;
      default:
        errorMsg = 'Unknown error occurred.';
    }
    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };
  }

