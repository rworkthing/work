      this.addNewAttributeFormGroup.get('productTypeCode')?.setValue(value);
    });

    this.addNewAttributeFormGroup
      .get('relatetoproducttype')
      ?.valueChanges.subscribe(value => {
        this.isRelateToProductTemplate = value;
        if (!value) {
          this.isValidValueTypes = false;
          this.addNewAttributeFormGroup
            .get('validtype')
            ?.setValue(false, { emitEvent: false });
        }
      });

    this.addNewAttributeFormGroup
      .get('validtype')
      ?.valueChanges.subscribe(value => {
        if (this.isRelateToProductTemplate) {
          this.isValidValueTypes = value;
        } else {
          this.isValidValueTypes = false;
        }
      });
  }

  getError(formControl: string, formValidatorKey?: string, customkey?: string) {
    const fc: AbstractControl = this.addNewAttributeFormGroup.get(`${formControl}`);
    if (fc.errors && fc.errors !== null) {
      let error: string = '';
      Object.keys(fc.errors).forEach(
        key =>
        (error = key
          ? key == formValidatorKey
            ? `BOD.error.${customkey}`
            : key !== null
              ? `BOD.error.${key}`
              : ''
          : ``)
      );
      return error;
    }
  }

  /** On click of Add Button*/
  inlineAddRowActionClick(index) {
    this.getTableInput(index).productLine = '';
    this.getTableInput(index).owner = '';
    this.getTableInput(index).relationship = '';
    this.getTableInput(index).lastDebit = 0;
    this.getTableInput(index).id =
      'RT_00' + this.getTableData(index).paginationOptions.length;
    this.getTableInput(index).name =
      'Newly added row Name:' + this.inputBasic.id;
    if (index === 1 || index === 2) {
      this.getTableInput(index).title = '';
      this.getTableInput(index).firstName = '';
      this.getTableInput(index).lastName = '';
    }
    this.getTableFormGroup(index).controls['start'].setValue(
      new Date(new Date(Date.now()))
    );
  }

