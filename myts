          lastSearchFieldCtrl =
            this.searchFieldFormCtrlKeys[
              this.searchFieldFormCtrlKeys.length - 1
            ];
          index =
            parseInt(lastSearchFieldCtrl[lastSearchFieldCtrl.length - 1]) + 1;
        } else {
