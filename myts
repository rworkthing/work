      isExpire: event.editRowElement['isExpire'],
      effective: this.effectiveDate,
      expirationDate: combinedDateTime
    });

    this.addEditBalanceHoldFormGroup.controls['effective'].clearValidators();
    this.addEditBalanceHoldFormGroup.controls[
      'effective'
    ].updateValueAndValidity();
  }

  private combineDateAndTime(date: string, time: string): Date {
    const [hours, minutes, seconds] = time.split(':').map(Number);
    const dateObj = new Date(date);
    dateObj.setHours(hours, minutes, seconds);
    return dateObj;
  }
}
