  public inlineEditRowActionClick(event: InlineEditOutput): void {
    this.updateMessages([]);
    this.currentMode = EditTableAction.EDIT;
    this.selectedHoldId = event.editRowElement['referenceId'];
    this.changeDetectorRef.detectChanges();
    const combinedDateTime = this.combineDateAndTime(
      event.editRowElement['expirationDate'],
      event.editRowElement['expirationTime']
    );
    // const holdAmount = CurrencyService.getAmountFromCurrencyCodeDescAndValue(
    //   event.editRowElement['amount'].amount,
    //   event.editRowElement['amount'].currency?.symbol
    // );
    // this.amountFieldValue = this.bodAmountPipe.transform(holdAmount);
    this.addEditBalanceHoldFormGroup.removeControl('referenceId');
    this.addEditBalanceHoldFormGroup.removeControl('referenceType');
    this.holdAllValue = event.editRowElement['isHoldAll'];
    this.isExpireValue = event.editRowElement['isExpire'];
    this.amountIsRequired = event.editRowElement['isHoldAll'] ? false : true;
    // this.checkExpirationFieldVisibility();
    // this.effectiveDate = DateUtilityService.updateDateFormat(
    //   new Date(this.bookingDate),
    //   'MM/dd/YYYY'
    // );
    this.addEditBalanceHoldFormGroup.setValue({
      // amount: holdAmount,
      reason: event.editRowElement['reasonDescription'],
      description: event?.editRowElement['description']
        ? event?.editRowElement['description']
        : '',
      isHoldAll: event.editRowElement['isHoldAll'],
      isExpire: event.editRowElement['isExpire'],
      effective: this.effectiveDate,
      expirationDate: combinedDateTime
    });

    this.addEditBalanceHoldFormGroup.controls['effective'].clearValidators();
    this.addEditBalanceHoldFormGroup.controls[
      'effective'
    ].updateValueAndValidity();
  }

  private combineDateAndTime(date: string, time: string): Date {
    const [hours, minutes, seconds] = time.split(':').map(Number);
    const dateObj = new Date(date);
    dateObj.setHours(hours, minutes, seconds);
    return dateObj;
  }
