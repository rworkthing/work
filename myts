  onAddNewRoleType(isAdd: boolean) {
    if (isAdd) {
      this.identifierSearch('roleTypeIdentifier').then(() => {
        this.submitForm(isAdd);
      });
    } else {
      this.submitForm(isAdd);
    }
  }

  submitForm(isAdd: boolean) {
    // this.isAdd = true;
    const formValue = this.addNewRoleTypeFormGroup.getRawValue();
    this.addNewRoleTypeFormGroup.controls['roleTypeIdentifier'].enable();
    const SelectedCategory = formValue.category;
    const SelectedClassification = formValue.classification;
    const categoryIdentifier =
      parseInt(
        this.categorys.find(item => item.label === SelectedCategory)?.value,
        10
      ) || parseInt(SelectedCategory, 10);
    const classificationIdentifier =
      parseInt(
        this.classifications.find(item => item.label === SelectedClassification)
          ?.value,
        10
      ) || parseInt(SelectedClassification, 10);

    const roleType = {
      identifier: formValue.roleTypeIdentifier,
      code: formValue.roleTypeCode,
      name: formValue.roleTypeName,
      shortName: formValue.roleTypeShortName,
      category: categoryIdentifier,
      classification: classificationIdentifier,
      systemDefined: formValue.systemDefined ? 'Y' : 'N',
      calculated: formValue.calculated ? 'Y' : 'N'
    };
    const roleCategoryList = [
      {
        identifier: formValue.roleTypeIdentifier,
        code: formValue.roleTypeCode,
        name: formValue.roleTypeName,
        shortName: formValue.roleTypeShortName
      }
    ];
    const productTypeRoleTypeRelationshipList =
      this.dataWithRoleRelationshipvalues.length > 0
        ? this.dataWithRoleRelationshipvalues.map(item => {
            const primary = item.roleTypes.find(
              roleType => roleType.label === 'Primary'
            )?.value;
            const percentageAllowed = item.roleTypes.find(
              roleType => roleType.label === 'Percentage Allowed'
            )?.value;
            const applicableOrder = item.roleTypes.find(
              roleType => roleType.label === 'Applicable Order'
            )?.value;
            const signatureRequired = item.roleTypes.find(
              roleType => roleType.label === 'Signature Required'
            )?.value;
            const ownerCategory = item.roleTypes.find(
              roleType => roleType.label === 'Owner Category'
            )?.value;
            const ownerSubCategory = item.roleTypes.find(
              roleType => roleType.label === 'Owner SubCategory'
            )?.value;
            const additionalDetails = item.roleTypes.find(
              roleType => roleType.label === 'Additional Details'
            )?.value;

            return {
              identifier: 1110101,
              roleTypeIdentifier: formValue.roleTypeIdentifier,
              roleTypeCode: formValue.roleTypeCode,
              customerType: item.customerType || null,
              percentageAllowed: percentageAllowed ? 'Y' : 'N',
              isPrimary: primary ? 'Y' : 'N',
              minimumRequired: item.minimumRequired,
              maximumAllowed: item.maximumAllowed,
              applicableOrder: applicableOrder ? 'Y' : 'N',
              maximumAccountAllowed: item.maximumAccountAllowed,
              signatureRequired: signatureRequired ? 'Y' : 'N',
              ownerCategory: ownerCategory,
              onwerSubCategory: ownerSubCategory,
              additionalDetails: additionalDetails
            };
          })
        : [];

    const productTypeRoleTypeCatRelationshipList = formValue.category1.map(
      subtype => {
        const selectedCategoryType = this.cattypes.find(
          item => item.label === subtype
        );

        return {
          productTypeIdentifier: 1110101,
          roleTypeIdentifier: formValue.roleTypeIdentifier,
          categoryIdentifier: selectedCategoryType.value
        };
      }
    );

    const roleTypeData = {
      metadataType: 'RoleType',
      roleRelationshipTypeList: [
        {
          roleType,
          roleCategoryList,
          productTypeRoleTypeRelationshipList,
          productTypeRoleTypeCatRelationshipList
        }
      ],
      productTypeList: ['Checking']
    };


    const serviceCall = isAdd
      ? this.roleTypeService.saveRoleType(roleTypeData)
      : this.roleTypeService.updateRoleType(roleTypeData);
    serviceCall.subscribe({
      next: resp => this.successResponse(resp, roleTypeData, isAdd),
      error: (err: NotificationMessage[]) => this.errorResponse(err, isAdd)
    });
    this.addNewRoleTypeFormGroup.controls['roleTypeIdentifier'].disable();
  }

  private successResponse(resp, _roleTypeData, isAdd) {
    const roleTypeCode =
      _roleTypeData.roleRelationshipTypeList[0].productTypeRoleTypeRelationshipList[0]
        .roleTypeCode;
    const SuccessMsg = isAdd
      ? `${roleTypeCode} Added successfully`
      : `${roleTypeCode} Updated successfully`;
    this.apiResponse.emit(..._roleTypeData, SuccessMsg);
  }
  
  private errorResponse(error: any, isAdd: boolean) {
    // const errorMessages1 = 'Please fill the Role Type fields.';
    let errorMsg = 'Role Type Code already exists.';
    if (error.errorCode === 'MBP_SDK_BUS_ERR_005') {
      errorMsg = 'Code already exists.';
    } else if (error.status === 400) {
      errorMsg = 'Please fill the Role Type fields.';
    }
    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };
    this.errorMessages.push(this.message);
  }
  

