  AttributeDelete(element: Attribute): void {
    if (
      element.code ===
      element.productTypeAdditionalDataTypeRltnpList[0].attributeCode
    ) {
      this.metadataService
        .deleteAttribute(
          'Attribute',
          element.productTypeAdditionalDataTypeRltnpList[0].attributeIdentifier
        )
        .subscribe(response => {
          const successMsg = 'Attribute Deleted Successfully';
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);

          this.getAttribute();
          console.log('State after getAttribute:', this.attributeData); // Log state
          this.changeDetectorRef.detectChanges();
        });
    } else {
      this.metadataService
        .deleteAttribute('Attribute', element.identifier)
        .subscribe(response => {
          const successMsg = 'Attribute Deleted Successfully';
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
          this.getAttribute();
          this.changeDetectorRef.detectChanges();
        });
    }
  }

