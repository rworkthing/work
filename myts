      // console.log('fetching data from API' + this.types);
    });

    this.metadataService.getDataTypes().subscribe(
      (data: any[]) => {
        this.datatypes = data.map(item => ({
          label: item.code,
          value: item.identifier
        }));
      },
      error => {
        console.error('Error fetching data types', error);
      }
    );

    this.metadataService.getProductCodes().subscribe(data => {
      this.productCodes = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));

      // console.log('fetching data from API' + this.types);
