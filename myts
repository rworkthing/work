  getError(formControl: string, formValidatorKey?: string, customkey?: string) {
    const fc: AbstractControl = this.addNewRoleTypeFormGroup.get(
      `${formControl}`
    );
    if (fc.errors && fc.errors !== null) {
      let error = '';
      Object.keys(fc.errors).forEach(
        key =>
        (error = key
          ? key == formValidatorKey
            ? `BOD.error.${customkey}`
            : key !== null
              ? `BOD.error.${key}`
              : ''
          : ``)
      );
      return error;
    }
  }
  private roleTypeForm(element: RoleTypeList): void {
    this.isAdd = false;
    // this.addNewRoleTypeFormGroup.reset()
    // console.log("FOR NEW EDIT in add edit",element);
    const roleCategorySubTypes =
      element.productTypeRoleTypeCatRelationshipList
        ?.filter(item => item.roleTypeIdentifier === element.identifier)
        .map(item => {
          const matchedItem = this.cattypes.find(cat => cat.value === item.categoryIdentifier);
          return matchedItem ? matchedItem.label : item.categoryIdentifier;
        }) || [];

