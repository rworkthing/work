getNewRoleType(): void {
    this.roleTypeService.retrieveRoleType().subscribe(response => {
      if (response.status === 'SUCCESS' && response.data) {
        console.log('Response Data:', response.data);
        this.roleTypeData = response.data.map((item: any) => {
          const roleType = item.RoleTypeList || [];
          const roleCategoryList = roleType.roleCategoryList || [];
          const productTypeRoleTypeRelationshipList = roleType.productTypeRoleTypeRelationshipList || [];
          const productTypeRoleTypeCatRelationshipList = roleType.productTypeRoleTypeCatRelationshipList || [];

          let roleCategoryListMapped = null;
          if (roleCategoryList.length > 0) {
            roleCategoryListMapped = roleCategoryList.map(
              (category: any) => ({
                identifier: category.identifier,
                code: category.code,
                name: category.name,
                shortName: category.shortName
              })
            );
          }

          let productTypeRoleTypeRelationshipListMapped = null;
          if (productTypeRoleTypeRelationshipList.length > 0) {
            productTypeRoleTypeRelationshipListMapped =
              productTypeRoleTypeRelationshipList.map((relationship: any) => ({
                identifier: relationship.identifier,
                roleTypeIdentifier: relationship.roleTypeIdentifier,
                roleTypeCode: relationship.roleTypeCode,
                customerType: relationship.customerType,
                percentageAllowed: relationship.percentageAllowed,
                isPrimary: relationship.isPrimary,
                minimumRequired: relationship.minimumRequired,
                maximumAllowed: relationship.maximumAllowed,
                applicableOrder: relationship.applicableOrder,
                maximumAccountAllowed: relationship.maximumAccountAllowed,
                signatureRequired: relationship.signatureRequired,
                ownerCategory: relationship.ownerCategory,
                onwerSubCategory: relationship.onwerSubCategory,
                additionalDetails: relationship.additionalDetails

              }));
          }
          let productTypeRoleTypeCatRelationshipListMapped = null;
          if (productTypeRoleTypeCatRelationshipList.length > 0) {
            productTypeRoleTypeCatRelationshipListMapped =
              productTypeRoleTypeCatRelationshipList.map(
                (roleCatRelationship: any) => ({
                  productTypeIdentifier:
                    roleCatRelationship.productTypeIdentifier,
                  roleTypeIdentifier:
                    roleCatRelationship.roleTypeIdentifier,
                  categoryIdentifier:
                    roleCatRelationship.categoryIdentifier
                })
              );
          }

          const roleTypeData: RoleTypeList = {
            code: roleType.code,
            roleTypeInquiry: [
              {
                id: 0,
                label: 'Name',
                value: roleType.name
              },
              {
                id: 1,
                label: 'Identifier',
                value: roleType.identifier
              },
              {
                id: 2,
                label: 'Short Name',
                value: roleType.shortName
              },
              {
                id: 3,
                label: 'Category',
                value: roleType.category
              },
              {
                id: 4,
                label: 'Classification',
                value: roleType.classification
              },
              {
                id: 5,
                label: 'System Defined',
                value: roleType.systemDefined
              },
              {
                id: 6,
                label: 'Calculated',
                value: roleType.calculated
              }
            ],
            identifier: roleType.identifier,
            name: roleType.name,
            shortName: roleType.shortName,
            category: roleType.category,
            classification: roleType.classification,
            systemDefined: roleType.systemDefined,
            calculated: roleType.calculated,
            roleCategoryList: roleCategoryListMapped,
            productTypeRoleTypeRelationshipList: productTypeRoleTypeRelationshipListMapped,
            productTypeRoleTypeCatRelationshipList: productTypeRoleTypeCatRelationshipListMapped
          };
          return roleTypeData;

        });
        console.log('Element Data:', JSON.stringify(this.roleTypeData, null, 2));
        this.roleTypeDataEvent.emit(this.roleTypeData);
      }
    });
  }
