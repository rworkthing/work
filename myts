 private editAttributes(element: Attribute) {
    console.log("Element Data:", JSON.stringify(element, null, 2)); // Log the full element data
    this.isAdd = false;
    this.addNewAttributeFormGroup.reset();
    this.addExistingAttributeFormGroup.reset();
    this.addNewAttributeFormGroup.removeControl('validtype');
    this.addExistingAttributeFormGroup.removeControl('validtype');
    this.tableWithSimpleEdit.datasource.data = [];
    console.log(this.addNewAttributeFormGroup);
    //this.addNewAttributeFormGroup.addControl("validtype",true)
    let selectedTemplate: TemplateRef<any>;
    let dialogTitle: string;
    this.validtype = element?.productTypeAdditionalDataList?.length > 0 ? true : false;
    if (element.shortName) {
      selectedTemplate = this.addAttributeTemp;
      dialogTitle = "Edit Attribute";

      this.addNewAttributeFormGroup.setValue({
        code: element.code,
        identifier: element.identifier,
        name: element.name,
        shortname: element.shortName,
        type: element.objectTypeIdentifier,
        datatype: element.formatTypeIdentifier,
        calculate: element.calculated === "Y",
        searchable: element.searchable === "Y",
        multivalueallowed: element.multiValueAllowed === "Y",
        percentageallowed: element.percentageAllowed === "Y",
        classificationtype: element.classificationType,
        relatetoproducttype: element.productTypeAdditionalDataTypeRelationshipList || [],
        descriptions: element.descriptions.find(desc => desc.label === "Description")?.value || '',
        validvaluestype: element.additionalDataValidValuesRange ? "rangevalues" :
          element.additionalDataValidValueSetList ? "setvalues" : '',
        productTypeCode: element.productTypeAdditionalDataTypeRelationshipList?.[0]?.attributeIdentifier || '',
        min: element.productTypeAdditionalDataTypeRelationshipList?.[0]?.minimumRequired || '',
        max: element.productTypeAdditionalDataTypeRelationshipList?.[0]?.maximumAllowed || '',
        GLcategorizationAllowed: element.productTypeAdditionalDataTypeRelationshipList?.[0]?.glCategarization === "Y",
        attributevalue: element.productTypeAdditionalDataList?.[0]?.attributeValue || '',
        isdefault: element.productTypeAdditionalDataList?.[0]?.isDefault === "Y",
        isvalueoverridden: element.productTypeAdditionalDataList?.[0]?.overrideDefault === "Y",
        isprimary: element.productTypeAdditionalDataList?.[0]?.isPrimary === "Y",
        sequencenumbers: element.productTypeAdditionalDataList?.[0]?.sequenceNumber || '',
        percentages: element.productTypeAdditionalDataList?.[0]?.percentage || '',
        valuesearch: element.productTypeAdditionalDataList?.[0]?.attributeValueSource || '',
        localeCode: element.multiLingualTextInfoList?.[0]?.localeCode || '',
        description: element.multiLingualTextInfoList?.[0]?.localeText || '',
        displayName: element.multiLingualTextInfoList?.[0]?.translationText || '',
        // low: element.additionalDataValidValuesRange?.low || '',
        // high: element.additionalDataValidValuesRange?.high || '',
        rangename: element.additionalDataValidValuesRange?.name || '',
        rangedescriptions: element.additionalDataValidValuesRange?.description || '',
        // setname: element.additionalDataValidValueSetList?.[0]?.name || '',
        // setdescriptions: element.additionalDataValidValueSetList?.[0]?.description || ''

      });
    } else {
      selectedTemplate = this.addExistingAttributeTemp;
      dialogTitle = "Edit Existing Attribute";

      const firstRelation = element.productTypeAdditionalDataTypeRelationshipList?.[0];

      this.addExistingAttributeFormGroup.setValue({
        productCode: firstRelation?.attributeIdentifier || '',
        min: firstRelation?.minimumRequired || '',
        max: firstRelation?.maximumAllowed || '',
        GLcategorizationAllowed: firstRelation?.glCategarization === "Y"
      });
    }
    this.addNewAttributeFormGroup.addControl(
      'validtype',
      this.fb.control(this.validtype)
    );
    this.addExistingAttributeFormGroup.addControl(
      'validtype',
      this.fb.control(this.validtype)
    );

    console.log(this.addNewAttributeFormGroup)
    this.ValidvalueArray.datasource.data = [];
    this.ExistingValidvalueArray.datasource.data = [];
    this.dataWithValidvalues = [];

    element.productTypeAdditionalDataList?.forEach(element => {
      let obj = {} as BodSampleTable1;
      obj.additionaldatavalue = element.attributeValue;
      obj.defaultindicator = element.isDefault;
      obj.overrideindicator = element.overrideDefault;
      obj.percentagevalue = element.percentage;
      obj.sequencenumber = element.sequenceNumber;
      this.ValidvalueArray.datasource.data.push(obj);
      this.ExistingValidvalueArray.datasource.data.push(obj);
      this.dataWithValidvalues.push(obj);
      this.dataWithExsistingValidvalues.push(obj);

    })
    console.log("loaded vaild", this.dataWithValidvalues);
    // console.log(this.inputLayoutForm);
    // console.log(this.ValidvalueArray);
    // element.productTypeAdditionalDataList?.forEach(element => {
    //   let obj = {} as BodSampleTable1;
    //   obj.additionaldatavalue = element.attributeValue;
    //   obj.defaultindicator = element.isDefault;
    //   obj.overrideindicator = element.overrideDefault;
    //   obj.percentagevalue = element.percentage;
    //   obj.sequencenumber = element.sequenceNumber;
    //   this.ValidvalueArray.datasource.data.push(obj);
    // })


    // element.multiLingualTextInfoList?.forEach(element => {

    //   this.editLocale(element.localeCode, element.translationText, element.localeText)
    //   console.log("processinglocale", element.localeCode)
    //   let obj = {} as BodLocaleTable;
    //   obj.locale = element.localeCode;
    //   // this.inputLocaleLayoutFormLocale.get('localeCode')?.setValue(element.localeCode)
    //   obj.displayName = element.translationText;
    //   obj.description = element.localeText;
    //   const existingRow = this.tableWithSimpleEdit.datasource.data.find(
    //     row => row.locale === obj.locale
    //   );
    //   if (!existingRow) {
    //     this.tableWithSimpleEdit.datasource.data.push(obj);
    //   }

    // })
    // console.log(this.inputLayoutForm);
    if (element.multiLingualTextInfoList && element.multiLingualTextInfoList.length > 0) {
      console.log("Processing multiLingualTextInfoList:", element.multiLingualTextInfoList);
  
      element.multiLingualTextInfoList.forEach(item => {
          this.editLocale(item.localeCode, item.translationText, item.localeText);
  
          let obj = {
              locale: item.localeCode,
              displayName: item.translationText,
              description: item.localeText
          };
  
          const existingRow = this.tableWithSimpleEdit.datasource.data.find(
              row => row.locale === obj.locale
          );
          if (!existingRow) {
              this.tableWithSimpleEdit.datasource.data.push(obj);
          }
      });
  
      console.log("Updated multiLingualTextInfoList in table:", this.tableWithSimpleEdit.datasource.data);
  }
    console.log(this.inputLocaleLayoutFormLocale);


    if (!this.dialogRef$ || this.dialogRef$.getState() === MatDialogState.CLOSED) {
      let dialogModel: BodCommonDialogModel = {
        formTemplate: selectedTemplate,
        title: dialogTitle
      };
      this.openDialog(dialogModel);
    }

    this.isEdit = true;
  }
