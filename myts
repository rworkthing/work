  loadDropdownData(): void {

    this.roleTypeService
      .getCustomerType()
      .subscribe(data => (this.customerTypes = data));

    this.roleTypeService.getRoleCat().subscribe(data => {
      const mappedData = data.map((item: any) => ({
        label: item.code,
        value: item.identifier
      }));
      this.roleCategoryValues = mappedData;
      this.categorys = mappedData;
    });
    this.roleTypeService
      .getRoleCategoryId()
      .subscribe(data => (this.roleCategoryIds = data));

