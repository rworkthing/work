  public reset() {
    this.setSearchFieldsData(true);
    this.setOverrideDefaultFieldsData(true);
    this.setRequiredFieldsData(true);

    this.modeOptionsSimple = { input: true, reset: true };

    this.updateMsgArr(this.resetMsg);
  }

