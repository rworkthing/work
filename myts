  private editLocale(locale, name, desc) {
    console.log("editlocale called with ", locale, name, desc)
    let updatedData = {
      id: this.lastModifiedIndex,
      locale: '',
      action: EditTableAction.ADD,
      displayName: '',
      description: ''
    };
    // this.addLocaleTemp.addRow(updatedData);
    this.useExistingFormCtrlKeysLocale = FormUtilityService.addFormControl(
      this.inputLocaleLayoutFormLocale,
      'locale',
      this.lastModifiedIndex,
      true,
      locale
    );
    this.useExistingFormCtrlKeysDisplayName = FormUtilityService.addFormControl(
      this.inputLocaleLayoutFormDisplayName,
      'displayName',
      this.lastModifiedIndex,
      true,
      name
    );
    this.useExistingFormCtrlKeysDesc = FormUtilityService.addFormControl(
      this.inputLocaleLayoutFormDesc,
      'description',
      this.lastModifiedIndex,
      true,
      desc
    );
    const existingRow = this.tableWithSimpleEdit.datasource.data.find(
      row => row.locale === locale
    );

    if (!existingRow) {
      this.useExistingFormCtrlKeysLocale = FormUtilityService.addFormControl(
        this.inputLocaleLayoutFormLocale,
        'locale',
        this.lastModifiedIndex,
        true,
        locale
      );
      this.useExistingFormCtrlKeysDisplayName = FormUtilityService.addFormControl(
        this.inputLocaleLayoutFormDisplayName,
        'displayName',
        this.lastModifiedIndex,
        true,
        name
      );
      this.useExistingFormCtrlKeysDesc = FormUtilityService.addFormControl(
        this.inputLocaleLayoutFormDesc,
        'description',
        this.lastModifiedIndex,
        true,
        desc
      );
      ++this.lastModifiedIndex;
    } else {
      console.log("editLocale: Row already exists, skipping...");
    }


  }
