  inlineFormEditSubmit(formGroupValid: boolean, index) {
    if (formGroupValid) {
      const editedData: BodInlineSampleTable[] = [];
      const formGroup = this.getTableFormGroup(index);
      this.getTableRef(index).data.datasource.data.forEach(d => {
        if (d.index === this.editRowElement.index) {
          const editedRow: BodInlineSampleTable = {
            index: d.index,
            id: d.id,
            name: d.name,
            productLine: formGroup.value.productLine,
            aware: formGroup.value.owner,
            relationship: formGroup.value.relationship,
            lastDebit:
              formGroup.value.lastDebit === null
                ? 0
                : formGroup.value.lastDebit,
            start: formGroup.controls['start'].value
          };
          if (index === 1 || index === 2) {
            editedRow.description = [
              {
                id: d.description[0].id,
                label: d.description[0].label,
                value: formGroup.value.title
              },
              {
                id: d.description[1].id,
                label: d.description[1].label,
                value: formGroup.value.firstName
              },
              {
                id: d.description[2].id,
                label: d.description[2].label,
                value: formGroup.value.lastName
              }
            ];
          }
          editedData.push(editedRow);
        } else {
          editedData.push(d);
        }
      });
      this.getTableRef(index).updateDatasource(
        new MatTableDataSource<BodInlineSampleTable>([...editedData])
      );
    } else {
      this.displayInlineFormErrorMessage(index);
    }
  }
