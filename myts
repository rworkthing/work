              </mat-option>
            </mat-select>
        
          </mat-form-field>
        </bod-control-group>

        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.accountclassification'"
          [forTextOnly]="true"
          [required]="false"
        >
