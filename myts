import { CommonModule } from '@angular/common';
import { Component, NO_ERRORS_SCHEMA, ViewChild } from '@angular/core';
import { TranslateModule, TranslateService } from '@ngx-translate/core';
import {
  Amount,
  BodAutoCompleteMetadata,
  BodFormModule,
  BodKeyValuePairMetadata,
  BodPageContainerModule,
  BodTableAction,
  BodTableActionType,
  BodTableActionsModule,
  BodTableComponent,
  BodTableDataSource,
  BodTableFilterCriteria,
  BodTableMetadata,
  BodTableModule,
  Column,
  ControlGroupModule,
  Currency,
  EditTableAction,
  InlineEditOutput,
  InputLayoutModule,
  ListType,
  MessageContainerModule,
  ModeOptions,
  NotificationMessage,
  NotificationMessageType,
  PageAction,
  PageMode,
  SearchFieldModule,
  SingleRowEdit
} from '@bod/common';
import { MatTableDataSource } from '@angular/material/table';
import { MatPaginator } from '@angular/material/paginator';
import {
  FormsModule,
  ReactiveFormsModule,
  UntypedFormGroup,
  FormBuilder,
  FormArray,
  FormControl,
  FormGroup
} from '@angular/forms';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatSelectModule } from '@angular/material/select';
import { MatDatepickerModule } from '@angular/material/datepicker';
import { MatInputModule } from '@angular/material/input';
import {
  BodEditableSampleTable,
  BodLocaleTable,
  SearchFieldInputData
} from '../bod-table-demo.model';
import { take } from 'rxjs/operators';
import { Subscription } from 'rxjs';
import moment from 'moment';
import { BodTableDemoCommonDataService } from '../bod-table-demo-common-data.service';
import { HttpClient } from '@angular/common/http';
import { DemoTableDataService, SampleEC } from '../bod-table-demo.service';

@Component({
  selector: 'bod-template-settings',
  standalone: true,
  imports: [
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    BodTableModule,
    BodPageContainerModule,
    TranslateModule,
    BodFormModule,
    BodTableActionsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    MatInputModule,
    TranslateModule,
    FormsModule,
    SearchFieldModule,
    MessageContainerModule
  ],
  templateUrl: './template-settings.component.html',
  styleUrl: './template-settings.component.scss',
  schemas: [NO_ERRORS_SCHEMA]
})
export class TemplateSettingsComponent {
  private dataForReset: BodLocaleTable[] = [];
  public messages: NotificationMessage[] = [];
  @ViewChild('simpleEditTableRef', { static: false })
  simpleEditTableRef: BodTableComponent;
  public tableWithSimpleEdit: BodTableMetadata;
  public requiredColumnForm: UntypedFormGroup | undefined;
  public searchFieldObjArr: SearchFieldInputData[] = [];
  public pageMode = PageMode.INQUIRY;
  public pageModeSimple = this.pageMode;
  public lastModifiedIndex: number;
  public requiredColFormCtrKeys: string[] = [];
  public searchFieldFormCtrlKeys: string[] = [];
  selectedTabIndex = 0;
  showEdit = true;
  public formStatus = false;
  private subscriptions: Subscription = new Subscription();
  public modeOptions: ModeOptions = { input: false, reset: false };
  public singleRowEdit: SingleRowEdit = {
    modeOptions: { input: false, reset: false },
    index: 0
  };
  public modeOptionsSimple = this.modeOptions;
  // Form Array to manage dynamic rows
  public tableForm: UntypedFormGroup;

  constructor(
    private translate: TranslateService,
    public commonDataService: BodTableDemoCommonDataService,
    private http: HttpClient,
    private fb: FormBuilder,
    
  ) {
    this.tableForm = this.fb.group({
      rows: this.fb.array([]) // Initialize a FormArray for rows
    });
    

    this.tableWithSimpleEdit = {
      columns: [
        {
          name: 'locale',
          title: 'Locale',
          truncate: true,
          noOverflow: true,
          width: 12,
          widthUnit: 'rem'
        },
        {
          name: 'displayName',
          title: 'Display Name',
          truncate: true,
          noOverflow: true,
          width: 6,
          widthUnit: 'rem'
        },
        {
          name: 'description',
          title: 'Description',
          truncate: true,
          noOverflow: true,
          width: 12,
          widthUnit: 'rem'
        }
      ],
      datasource: new MatTableDataSource<BodLocaleTable>(),
      noRecordsMessage: 'mbpBod.demo.microsite.table.noRecordsMsg'
    };
  }

  ngOnInit(): void {
    // Initialize form controls for existing rows
    this.tableWithSimpleEdit.datasource.data.forEach((row) => this.addRow(row));
  }

  // Getter for the rows FormArray
  get rows(): FormArray {
    return this.tableForm.get('rows') as FormArray;
  }

  // Add a new row to the FormArray
  public addRow(row: any) {
    const rowGroup = this.fb.group({
      id: [row?.id || ''],
      locale: [row?.locale || ''],
      displayName: [row?.displayName || ''],
      description: [row?.description || []]
    });
  
    this.rows.push(rowGroup);
  }

  // Add a new row to the table and form
  public addTableData() {
    const newRow: BodLocaleTable = {
      locale: '',
      displayName: '',
      description: ''
    };
  
    // Clone existing data and add new row
    const updatedData = [...this.tableWithSimpleEdit.datasource.data, newRow];
  
    // Update the table data source
    this.tableWithSimpleEdit.datasource = new MatTableDataSource(updatedData);
  
    // Add new row to the form
    this.addRow(newRow);
  
    // Enable edit mode
    this.modeOptionsSimple = { input: true, reset: false };
    this.pageModeSimple = PageMode.INPUT;
  
    // Set edit mode for the new row
    this.singleRowEdit = {
      modeOptions: { input: true, reset: false },
      index: updatedData.length - 1
    };
  }

  // Get the FormGroup for a specific row
  getFormGroup(index: number): FormGroup {
    return this.rows.at(index) as FormGroup;
  }

  // Update column data
  public updateColumnData(columnName: string, value: any, index: number) {
    const updatedData = this.tableWithSimpleEdit.datasource.data;
    updatedData[index][columnName] = value;

    // Update the MatTableDataSource to reflect the changes
    (this.tableWithSimpleEdit.datasource as MatTableDataSource<BodLocaleTable>).data =
      [...updatedData]; // Reassign to trigger change detection

    // Update the corresponding form control
    this.getFormGroup(index).get(columnName)?.setValue(value);

    // Mark the form as dirty
    this.getFormGroup(index).markAsDirty();
  }

  // Save table data
  public saveTableData() {
    // Map form values to the table data
    const updatedData = this.rows.controls.map((control, index) => ({
      id: control.get('id')?.value,
      locale: control.get('locale')?.value,
      displayName: control.get('displayName')?.value,
      description: control.get('description')?.value || []
    }));
  
    // Reassign MatTableDataSource (important for Angular change detection)
    this.tableWithSimpleEdit.datasource = new MatTableDataSource(updatedData);
  
    // Log saved data
    console.log('Table data saved:', updatedData);
  
    // Mark the form as pristine after saving
    this.rows.controls.forEach((control) => control.markAsPristine());
  
    // Exit edit mode
    this.singleRowEdit = { modeOptions: { input: false, reset: false }, index: -1 };
  }
  

  public isFormDirty(): boolean {
    return this.rows.controls.some((control) => control.dirty);
  }

  // Reset form data
  public reset() {
    this.tableForm.reset();
  }

  // Handle row-level actions
  public handleRowLevelActions(action: string, index: number) {
    if (action === 'save') {
      // Get the form group for the current row
      const rowFormGroup = this.getFormGroup(index);

      // Check if the form is valid before saving
      if (rowFormGroup.valid) {
        // Save the row data
        const rowData = this.tableWithSimpleEdit.datasource.data[index];
        console.log('Row saved:', rowData);

        // Exit edit mode for this row
        this.singleRowEdit = {
          modeOptions: { input: false, reset: false },
          index: -1
        };
      } else {
        console.error('Form is invalid. Please fill all required fields.');
      }
    } else if (action === 'reset') {
      // Reset the form for the current row
      this.getFormGroup(index).reset(this.tableWithSimpleEdit.datasource.data[index]);

      // Exit edit mode for this row
      this.singleRowEdit = {
        modeOptions: { input: false, reset: false },
        index: -1
      };
    }
  }

  // Other methods
  public onEditTableAction() {}
  public checkStatus(status: boolean) {
    this.formStatus = status;
  }

  public actionsForSimple: BodTableAction[] = [
    {
      id: 1,
      icon: 'add',
      label: 'mbpBod.demo.microsite.tableActions.labels.add',
      mostCommon: false
    }
  ];

  public onTableAction(event: BodTableAction) {
    if (event.id === 1) {
      this.addTableData(); // Add a new row when the add action is clicked
    }
  }

  public onPageAction(event: PageAction) {
    if (event === PageAction.ADD) {
      this.addTableData(); // Add a new row when the Add button is clicked
    } else if (event === PageAction.EDIT) {
      this.modeOptionsSimple = { input: true, reset: false };
      this.pageModeSimple = PageMode.INPUT;
    } else {
      this.modeOptionsSimple = { input: false, reset: true };
      this.pageModeSimple = PageMode.INQUIRY;
    }
  }
}
