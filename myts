            <mat-select
              panelClass="fis-style"
              formControlName="roleaccountclassification"
              name="roleaccountclassification"
            >
              <mat-option
                *ngFor="
                  let roleaccountclassification of roleaccountclassifications
                "
                [value]="roleaccountclassification.value"
              >
                {{ roleaccountclassification.label }}
              </mat-option>
            </mat-select>
       
          </mat-form-field>
        </bod-control-group>

        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.obligator'"
          [required]="false"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="obligator"
            name="obligator"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.beneficiary'"
          [required]="false"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="beneficiary"
            name="beneficiary"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.isvisible'"
