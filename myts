  submitForm(isAdd: boolean) {
    if (this.addNewBalanceTypeFormGroup.invalid) {
      return;
    }
    // this.isAdd = true;
    const formValue = this.addNewBalanceTypeFormGroup.getRawValue();
    this.addNewBalanceTypeFormGroup.controls['balTypeIdentifier'].enable();
    const formValue1 = this.balanceSubtypeForm.getRawValue();

    const balanceType = {
      identifier: formValue.balTypeIdentifier,
      code: formValue.balanceTypeCode,
      name: formValue.balanceTypeName,
      systemBalance: formValue.systembalance ? 'Y' : 'N'
    };
    const balanceSubTypeList =
      this.dataWithBalSubTypevalues.length > 0
        ? this.dataWithBalSubTypevalues.map(item => ({
          identifier: formValue1.balsubtypeIdentifier,
          code: item.code,
          name: item.name
        }))
        : [];

    const productTypeIdentifiers = this.metadataService.getProductTypeValues();

    // 1. balanceAggregationInsertionList
    const balanceAggregationInsertionList =
      this.dataWithAggregatevalues.length > 0
        ? this.dataWithAggregatevalues.map((item, index) => {
          const productType = this.producttypes.find(
            pt =>
              pt.label ===
              item.aggregates.find(aggregate => aggregate.label === 'Product Type')?.value
          )?.value;
          const debitTransactionType = this.debittransactiontypes.find(
            dt =>
              dt.label ===
              item.aggregates.find(aggregate => aggregate.label === 'Debit Transaction Type')?.value
          )?.value;
          const creditTransactionType = this.credittransactiontypes.find(
            ct =>
              ct.label ===
              item.aggregates.find(aggregate => aggregate.label === 'Credit Transaction Type')?.value
          )?.value;
          const otherCurrency = item.aggregates.find(aggregate => aggregate.label === 'Other Currency')?.value;
          const reverse = item.aggregates.find(aggregate => aggregate.label === 'Reverse')?.value;
          const balanceTypeIdentifier = this.balancetypes.find(bt => bt.label === item.balancetype)?.value;

          return {
            balanceTypeIdentifier: balanceTypeIdentifier || null,
            productTypeIdentifier: productTypeIdentifiers[index] ?? null,
            name: item.aggregationname,
            productTypeAggrIdfr: productType || null,
            aggrBalanceTypeIdentifier: balanceTypeIdentifier || null,
            relationshipType: this.relationshiptypes.find(rt => rt.label === item.relationshiptype)?.value || null,
            relationshipTypeCode: item.relationshiptype,
            aggregationLevel: item.aggregationLevel ?? null,
            balanceTypeCode: item.balancetype,
            otherCurrencyAggregation: otherCurrency === 'Y' ? 'Y' : 'N',
            reverseAggregation: reverse === 'Y' ? 'Y' : 'N',
            postingStandardIdentifierForDebit: debitTransactionType || null,
            postingStandardIdentifierForCredit: creditTransactionType || null
          };
        })
        : [];

    // 2. productTypeBalanceTypeRelationshipList
    const productTypeBalanceTypeRelationshipList = productTypeIdentifiers.map((id, index) => ({
      identifier: id,
      balanceTypeIdentifier: formValue.balTypeIdentifier,
      balanceTypeCode: formValue.balanceTypeCode,
      persisted: formValue.persisted ? 'Y' : 'N',
      calculated: formValue.calculated ? 'Y' : 'N',
      autoCreated: formValue.autocreation ? 'Y' : 'N',
      statementProcess: formValue.statementdisplay ? 'Y' : 'N',
      accountingClassification: formValue.accountclassification,
      snapshotRequired: formValue.dailysnapshot ? 'Y' : 'N',
      payerIdentifier: formValue.payer,
      payeeIdentifier: formValue.payee,
      chargeCalculation: formValue.chargebase ? 'Y' : 'N',
      logAudit: formValue.loghistory ? 'Y' : 'N',
      financialResultRequired: formValue.generatefinancialresults ? 'Y' : 'N',
      glRequired: formValue.glmapping ? 'Y' : 'N',
      dateValue: formValue.datevalue,
      enquiryRequired: formValue.inquiryrequired ? 'Y' : 'N',
      summaryRequired: formValue.summaryrequired ? 'Y' : 'N'
    }));

    // 3. productTypeBalanceSubTypeRelationshipList


    const productTypeBalanceSubTypeRelationshipList: ProductTypeBalanceSubTypeRelationship[] = [];

    formValue.balsubtype.forEach((subtype: string) => {
      const selectedBalanceType = this.subBalancetypes.find(item => item.label === subtype);

      productTypeIdentifiers.forEach((productTypeIdentifier: any) => {
        productTypeBalanceSubTypeRelationshipList.push({
          productTypeIdentifier: productTypeIdentifier ?? null,
          balanceTypeIdentifier: formValue.balTypeIdentifier,
          balanceSubTypeIdentifier: selectedBalanceType?.value ?? null,
          balanceSubTypeCode: selectedBalanceType?.label ?? null
        });
      });
    });

    // 4. productTypeBalanceTypePeriodList

    let productTypeBalanceTypePeriodList: ProductTypeBalanceTypePeriod[] = [];

    if (formValue.balperiodtype && formValue.balperiodtype.length > 0) {
      productTypeBalanceTypePeriodList = [];
      formValue.balperiodtype.forEach((periodType: string) => {
        productTypeIdentifiers.forEach((productTypeIdentifier: any) => {
          productTypeBalanceTypePeriodList.push({
            productTypeIdentifier: productTypeIdentifier ?? null,
            balanceTypeIdentifier: formValue.balTypeIdentifier,
            periodType: periodType
          });
        });
      });
    }


    // 5. productTypeBalanceTypeRoletypeRelationshipList
    const productTypeBalanceTypeRoletypeRelationshipList =
      this.dataWithRoleTypevalues.length > 0
        ? this.dataWithRoleTypevalues.map((roleType, index) => ({
          productTypeIdentifier: productTypeIdentifiers[index] ?? null,
          balanceTypeIdentifier: formValue.balTypeIdentifier,
          roleType: this.roletypes.find(rt => rt.label === roleType.type)?.value,
          accountingClassification: this.accountclassifications.find(
            ac => ac.label === roleType.accountingClassification
          )?.value,
          roleTypeCode: roleType.type,
          accountingClassificationCode: roleType.accountingClassification,
          visible: roleType.visibility === 'Y' ? 'Y' : 'N',
          payee: roleType.beneficiary === 'Y' ? 'Y' : 'N',
          payer: roleType.obligator === 'Y' ? 'Y' : 'N'
        }))
        : [];    // 6. MetadataRequestRltnpList
    const metadataRequestRltnpList: any[] = [];    // Map BalanceSubType relationships
    if (this.dataWithBalSubTypevalues.length > 0) {
      this.dataWithBalSubTypevalues.forEach(() => {
        metadataRequestRltnpList.push({
          parentIdentifier: formValue.balTypeIdentifier,
          parentRequirementId: this.metadataService.getReqDfnId(),
          parentMetadataType: "BalanceType",
          childIdentifier: formValue1.balsubtypeIdentifier,
          childMetadataType: "BalanceSubType"
        });
      });
    }    // Map selected BalanceSubType from dropdown relationships
    if (formValue.balsubtype && formValue.balsubtype.length > 0) {
      formValue.balsubtype.forEach((subtype: string) => {
        const selectedBalanceType = this.subBalancetypes.find(item => item.label === subtype);
        if (selectedBalanceType) {
          metadataRequestRltnpList.push({
            parentIdentifier: formValue.balTypeIdentifier,
            parentRequirementId: this.metadataService.getReqDfnId(),
            parentMetadataType: "BalanceType",
            childIdentifier: selectedBalanceType.value,
            childMetadataType: "BalanceSubType"
          });
        }
      });
    }    // Map RoleType relationships
    if (this.dataWithRoleTypevalues.length > 0) {
      this.dataWithRoleTypevalues.forEach((roleType) => {
        const selectedRoleType = this.roletypes.find(rt => rt.label === roleType.type);
        if (selectedRoleType) {
          metadataRequestRltnpList.push({
            parentIdentifier: formValue.balTypeIdentifier,
            parentRequirementId: this.metadataService.getReqDfnId(),
            parentMetadataType: "BalanceType",
            childIdentifier: selectedRoleType.value,
            childMetadataType: "RoleType"
          });
        }
      });
    }

    // 7. Final balanceTypeData
    const productTypeKeys = this.metadataService.getProductTypeKeys();
    const productTypeValues = this.metadataService.getProductTypeValues();
    const balanceTypeData = {
      metadataType: 'BalanceType',
      balanceTypeList: [
        {
          balanceType,
          balanceSubTypeList,
          balanceAggregationInsertionList,
          productTypeBalanceTypeRelationshipList,
          productTypeBalanceSubTypeRelationshipList,
          productTypeBalanceTypePeriodList,
          productTypeBalanceTypeRoletypeRelationshipList
        }
      ],
      productTypeList: productTypeKeys.map((code, index) => ({
        identifier: productTypeValues[index],
        code: code
      })),
      metadataDependencyRltnpList: metadataRequestRltnpList
    };


    if (productTypeBalanceTypeRoletypeRelationshipList.length === 0) {
      this.handleError(
        {
          errorCode: 'ROLE_TABLE_EMPTY',
          status: 409
        },
        isAdd
      );
      return;
    }

    if (this.addNewBalanceTypeFormGroup.invalid) {
      this.addNewBalanceTypeFormGroup.markAllAsTouched();

      const missingFields = this.getInvalidRequiredFields(this.addNewBalanceTypeFormGroup);
      console.warn('Missing required fields:', missingFields);

      this.handleError(
        {
          errorCode: 'FORM_INVALID',
          status: 400,
          missingFields
        },
        isAdd
      );
      return;
    }

    const serviceCall = isAdd
      ? this.balanceTypeService.saveBalanceType(balanceTypeData)
      : this.balanceTypeService.updateBalanceType(balanceTypeData);

    serviceCall.subscribe({
      next: resp => this.successResponse(resp, balanceTypeData, isAdd),
      error: (err: NotificationMessage[]) => this.handleError(err, isAdd)
    });
    this.addNewBalanceTypeFormGroup.controls['balTypeIdentifier'].disable();
  }
  private getInvalidRequiredFields(formGroup: FormGroup): string[] {
    const invalidFields: string[] = [];

    Object.keys(formGroup.controls).forEach(key => {
      const control = formGroup.get(key);
      if (control && control.errors?.['required']) {
        invalidFields.push(key);
      }
    });

    return invalidFields;
  }

  private successResponse(resp, _balanceTypeData, isAdd) {
    const balanceTypeCode =
      _balanceTypeData.balanceTypeList[0]
        .productTypeBalanceTypeRelationshipList[0].balanceTypeCode;
    const SuccessMsg = isAdd
      ? `${balanceTypeCode} Added successfully`
      : `${balanceTypeCode} Updated successfully`;
    this.apiResponse.emit({ ..._balanceTypeData, SuccessMsg });
  }
  private handleError(error: any, isAdd: boolean) {
    let errorMsg = ' ';

    if (error.errorCode === 'FORM_INVALID' || error.status === 400) {
      if (error.missingFields?.length) {
        errorMsg = `Please fill the required fields.`;
      } else {
        errorMsg = 'Please fill the required fields.';
      }
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_005") {
      errorMsg = 'Code already exists.';
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_004") {
      errorMsg = error.error?.errorDescription || 'Code already exists.';
    } else if (error.status === 400) {
      errorMsg = 'Please fill the Role Type fields.';
    } else if (error.errorCode === 'ROLE_TABLE_EMPTY') {
      errorMsg = 'AtLeast One Role Type is required.';
    } else {
      errorMsg = 'Unknown error occurred.';
    }
    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };
    this.errorMessages.push(this.message);

    // if (isAdd) {
    //   this.errorMessages.push(this.message);
    // }
    // setTimeout(() => {
    //   this.errorMessages = this.errorMessages.filter(
    //     msg => msg.text !== errorMsg
    //   );
    // }, 20000);
  }

