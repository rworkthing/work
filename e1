    BodCommonModule
  ],
  templateUrl: './channels-multiselect-dialog.component.html',
  styleUrls: ['./channels-multiselect-dialog.component.scss']
})
export class ChannelsMultiselectDialogComponent implements OnInit {
  public translationKey = TranslationKey;

  formType: BodFormTypes = BodFormTypes.FORM;
  @ViewChild('channelsTable', { static: false }) channelsTable: ChannelsMultiselectTableComponent;
  @Output() rowSelected = new EventEmitter<ChannelTable[]>();
  @Output() tableDirty = new EventEmitter<void>();

  public initialSelectedRows: Channels[] = [];
  selectedRows: Channels[] = [];
  public selectedRowSingleSelect: Channels[] = [];
  public addChannelsFormGroup: UntypedFormGroup;
  isDirty = false;

  constructor(
    public dialogRef: MatDialogRef<ChannelsMultiselectDialogComponent>,
    @Inject(MAT_DIALOG_DATA) public data: any,
    private fb: UntypedFormBuilder
  ) {
    this.initForm();
  this.selectedRowSingleSelect = [...(data.selectedRowSingleSelect || [])];
  this.initialSelectedRows = [...this.selectedRowSingleSelect];

  }
  private initForm(): void {
    const controls: { [key: string]: any } = {};
    const allRows = this.data?.channelsDataSingleSelect?.datasource?.data || [];
    allRows.forEach((row: any, idx: number) => {
      controls['option_' + row.id] = [row.option || null, Validators.required];
    });
    this.addChannelsFormGroup = this.fb.group(controls);
    // console.log('Dialog initForm - Form controls:', Object.keys(controls));

  }
  ngOnChanges(changes: SimpleChanges) {
    if (changes['data'] || changes['channelData']) {
      this.initForm();
    }
  }

  ngOnInit() {
    // Mark selected rows as disabled if in edit mode
    if (this.data?.editMode && this.selectedRowSingleSelect?.length) {
      const selectedIds = this.selectedRowSingleSelect.map(r => r.id);
      const allRows = this.data.channelsDataSingleSelect?.datasource?.data || [];
      allRows.forEach(row => {
        if (selectedIds.includes(row.id)) {
          row.disabled = true;
        } else {
          row.disabled = false;
        }
      });
    }
  }

  onTableDirtyChange(dirty: boolean) {
    this.isDirty = dirty;
    if (dirty) {
      this.addChannelsFormGroup.markAsDirty();
    }
  } public isTableDirty = false;

  public onTableDirty(): void {
    this.isTableDirty = true;
    this.addChannelsFormGroup.markAsDirty();

  }


  onRowSelected(selectedRows: Channels[]) {
    console.log('onRowSelected called with:', selectedRows);
    this.selectedRows = selectedRows;
    this.selectedRowSingleSelect = [...selectedRows];
    this.isDirty = true;
    this.addChannelsFormGroup.markAsDirty(); // <-- Mark the form as dirty
    this.tableDirty.emit();

    // this.initForm();
  }
  

  onSubmit() {
    if (this.addChannelsFormGroup.invalid) {
      this.addChannelsFormGroup.markAllAsTouched();
      return; // Prevent closing the dialog
    }
    // Pass the selectedRows object when closing the dialog
    this.dialogRef.close({ selectedChannels: this.selectedRows });
  }
  onReset() {
    this.isDirty = false;
    // Restore to initial selection instead of clearing all
    this.selectedRows = [...this.initialSelectedRows];
    this.selectedRowSingleSelect = [...this.initialSelectedRows];

    // Reset form controls to initial values
    Object.keys(this.addChannelsFormGroup.controls).forEach(key => {
      // Find the corresponding row in initialSelectedRows
      const rowId = Number(key.replace('option_', ''));
      const initialRow = this.initialSelectedRows.find(row => row.id === rowId);
      this.addChannelsFormGroup.get(key)?.setValue(initialRow ? initialRow.option : null);
    });

    // Also clear selection in the child table and re-select initial rows
    if (this.channelsTable) {
      this.channelsTable.resetSelection();
      setTimeout(() => {
        this.channelsTable.selectedRowSingleSelect = [...this.initialSelectedRows];
        this.channelsTable.selectChannelsRows?.();
      }, 0);
    }
  }
}













