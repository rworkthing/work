<bod-page-container
title="Channel Configuration"
  [pageMode]="pageModeSimple"
  (pageAction)="onPageAction($event)"
  [messages]="messages"
  *ngIf="showEdit"
>
  <bod-table
    [data]="tableWithSimpleEdit"
    [tableActions]="showActionsForSimple ? actionsForSimple : []" 
    [modeOptions]="modeOptionsSimple"
    [singleRowEdit]="singleRowEdit"
    [customColumnTemplates]="[
      { columnName: 'channel', templateName: channelTemplate1 },
      { columnName: 'option', templateName: optionTemplate1 },
      { columnName: 'actions', templateName: editActionsTemplate1 }
    ]"
    (inputValidationStatus)="checkStatus($event)"
    (editTableEvent)="onEditTableAction($event)"
    (onTableActionClick)="onSimpleTableAction($event)"
    [primaryColumnName]="'id'"
    (onInlineEditRowActionClick)="inlineEditRowActionClick($event, 0)"
    (onInlineFormEditSubmit)="onSaveChannelRow($event)"
    (onInlineFormCancel)="onCancelChannelRow($event)"
    #simpleEditTableRef
    [expandedRowTemplate]="expandedRowTemplate1"
    [inlineModal]="{
      formGroup: addNewChannelForm,
      formTemplateName: addNewChannelTemplate
    }"
  >
    <ng-template #channelTemplate1 let-element="element" let-column="column">
      <span>{{ element.channel }}</span>
    </ng-template>
    <ng-template
  #optionTemplate1
  let-element="element"
  let-column="column"
  let-index="index"
>
  <ng-container *ngIf="element.code !== 'All'">
    <mat-form-field appearance="outline" fisStyle style="min-width: 120px">
      <mat-select
        panelClass="fis-style"
        [(ngModel)]="element.option"
        #optionModel="ngModel"
        [ngModelOptions]="{ updateOn: 'change' }"
        (ngModelChange)="onValueChange()"
        required
        (click)="$event.stopPropagation()"
      >
        <mat-option
          *ngFor="let opt of column.inputModeOptions.model"
          [value]="opt.value"
        >
          {{ opt.label }}
        </mat-option>
      </mat-select>
    </mat-form-field>
  </ng-container>
</ng-template>

    <ng-template
  #editActionsTemplate1
  let-element="element"
  let-column="column"
  let-index="index"
>
  <ng-container *ngIf="index !== 0">
    <bod-table-actions
      [actions]="rowLevelActionsForBasicEdit"
      (onActionClick)="handleRowLevelActions($event.icon, index)"
    >
    </bod-table-actions>
  </ng-container>
</ng-template>

    <ng-template #expandedRowTemplate1 let-context="context">
      <div style="margin-left: 32px">
        <bod-table
          *ngIf="context.element?.counters?.length"
          [data]="getCountersTableForChannel(context.element)"
          [alignContent]="'top'"
        ></bod-table>
        <bod-table
          *ngIf="context.element?.restrictions?.length"
          [data]="getRestrictionsTableForChannel(context.element)"
          [alignContent]="'top'"
        ></bod-table>

        <bod-table
          *ngIf="context.element?.conditions?.length"
          [data]="getConditionsTableForChannel(context.element)"
          [alignContent]="'top'"
        ></bod-table>
        <bod-table
          *ngIf="context.element?.communications?.length"
          [data]="getCommunicationsTableForChannel(context.element)"
          [alignContent]="'top'"
        ></bod-table>
      </div>
    </ng-template>
  </bod-table>
  <form [formGroup]="addNewChannelForm">
    <ng-template #addNewChannelTemplate>
      <bod-input-layout col="2">
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.attributeForChannel'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <mat-select
              panelClass="fis-style"
              formControlName="attributeForChannel"
              name="attributeForChannel"
              required
              (selectionChange)="onAttributeForChannelChange($event)"
            >
              <mat-option
                *ngFor="let attributeForChannel of attributeForChannels"
                [value]="attributeForChannel.value"
              >
                {{ attributeForChannel.label }}
              </mat-option>
            </mat-select>
          </mat-form-field>
        </bod-control-group>
      </bod-input-layout>

      <!-- Counters Table -->
       <!-- <pre>{{ tableWithSimpleCounter.datasource.data | json }}</pre> -->
      <bod-table
        *ngIf="
          addNewChannelForm.get('attributeForChannel')?.value === 'Counters'
        "
        #counterTable
        [data]="tableWithSimpleCounter"
        [tableActions]="actionsForChannels"
        (onTableActionClick)="addCounterTableData()"
        [modeOptions]="modeOptionsSimple"
        [alignContent]="'top'"
        [customColumnTemplates]="[
          { columnName: 'counters', templateName: countersTemplate },
          {
            columnName: 'classificationType',
            templateName: classificationTypeTemplate
          },
          { columnName: 'operatorType', templateName: operatorTypeTemplate },
          { columnName: 'actions', templateName: editActionsTemplate1 }
        ]"
      >
        <!-- Counters column template -->
        <ng-template
          #countersTemplate
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <span>{{ element.code }}</span>
        </ng-template>

        <!-- Classification Type column template -->
        <ng-template
          #classificationTypeTemplate
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <span>{{ element.classificationType }}</span>
        </ng-template>

        <!-- Operator Type column template -->
        <ng-template
          #operatorTypeTemplate
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <span>{{ element.operatorType }}</span>
        </ng-template>
        <ng-template
          #editActionsTemplate1
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <bod-table-actions
            [actions]="rowLevelActionsForBasicEdit"
            (onActionClick)="handleCounterRowLevelActions($event.icon, index)"
          >
          </bod-table-actions>
        </ng-template>
      </bod-table>
      <!-- End counters table -->

      <!-- Conditions Table -->
      <bod-table
        *ngIf="
          addNewChannelForm.get('attributeForChannel')?.value === 'Conditions'
        "
        #conditionTable
        [data]="tableWithSimpleCondition"
        [tableActions]="actionsForChannels"
        (onTableActionClick)="addConditionTableData()"
        [modeOptions]="modeOptionsSimple"
        [alignContent]="'top'"
        [customColumnTemplates]="[
          { columnName: 'conditions', templateName: conditionsTemplate },
          {
            columnName: 'relationshipType',
            templateName: relationshipTypeTemplate
          },
          { columnName: 'actions', templateName: editActionsTemplate1 }
        ]"
      >
        <!-- Conditions column template -->
        <ng-template
          #conditionsTemplate
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <span>{{ element.code }}</span>
        </ng-template>

        <!-- Relationship Type column template -->
        <ng-template
          #relationshipTypeTemplate
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <span>{{ element.relationshipType }}</span>
        </ng-template>

        <ng-template
          #editActionsTemplate1
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <bod-table-actions
            [actions]="rowLevelActionsForBasicEdit"
            (onActionClick)="handleConditionRowLevelActions($event.icon, index)"
          >
          </bod-table-actions>
        </ng-template>
      </bod-table>
      <!-- End conditions table -->

      <!-- Restrictions Table -->
      <bod-table
        *ngIf="
          addNewChannelForm.get('attributeForChannel')?.value === 'Restrictions'
        "
        #restrictionTable
        [data]="tableWithSimpleRestriction"
        [tableActions]="actionsForChannels"
        (onTableActionClick)="addRestrictionTableData()"
        [modeOptions]="modeOptionsSimple"
        [alignContent]="'top'"
        [customColumnTemplates]="[
          { columnName: 'restrictions', templateName: restrictionsTemplate },
          {
            columnName: 'type',
            templateName: restrictionTypeTemplate
          },
          { columnName: 'actions', templateName: editActionsTemplate1 }
        ]"
      >
        <!-- Restrictions column template -->
        <ng-template
          #restrictionsTemplate
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <span>{{ element.code }}</span>
        </ng-template>

        <!-- Type column template -->
        <ng-template
          #restrictionTypeTemplate
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <span>{{ element.type }}</span>
        </ng-template>

        <ng-template
          #editActionsTemplate1
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <bod-table-actions
            [actions]="rowLevelActionsForBasicEdit"
            (onActionClick)="
              handleRestrictionRowLevelActions($event.icon, index)
            "
          >
          </bod-table-actions>
        </ng-template>
      </bod-table>
      <!-- End restrictions table -->

      <!-- Communications Table -->
      <bod-table
        *ngIf="
          addNewChannelForm.get('attributeForChannel')?.value ===
          'CommunicationServices'
        "
        #communicationTable
        [data]="tableWithSimpleCommunication"
        [tableActions]="actionsForChannels"
        (onTableActionClick)="addCommunicationTableData()"
        [modeOptions]="modeOptionsSimple"
        [alignContent]="'top'"
        [customColumnTemplates]="[
          {
            columnName: 'serviceElement',
            templateName: serviceElementTemplate
          },
          {
            columnName: 'communicationServices',
            templateName: communicationServicesTemplate
          },
          { columnName: 'actions', templateName: editActionsTemplate1 }
        ]"
      >
        <!-- Service Element column template -->
        <ng-template
          #serviceElementTemplate
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <span>{{ element.serviceElement || 'Blank Alert' }}</span>
        </ng-template>

        <!-- Communication Services column template -->
        <ng-template
          #communicationServicesTemplate
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <span>{{ element.communicationServices }}</span>
        </ng-template>

        <ng-template
          #editActionsTemplate1
          let-element="element"
          let-column="column"
          let-index="index"
        >
          <bod-table-actions
            [actions]="rowLevelActionsForBasicEdit"
            (onActionClick)="
              handleCommunicationRowLevelActions($event.icon, index)
            "
          >
          </bod-table-actions>
        </ng-template>
      </bod-table>
      <!-- End communications table -->
    </ng-template>
  </form>
</bod-page-container>














