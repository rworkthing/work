  private setAttributeForChannelByPriority(element: any): void {
    // Priority: Counters > Restrictions > CommunicationServices > Conditions
    let value = ' ';
    if (Array.isArray(element?.counters) && element.counters.length > 0) {
      value = 'Counters';
    } else if (Array.isArray(element?.restrictions) && element.restrictions.length > 0) {
      value = 'Restrictions';
    } else if (Array.isArray(element?.communications) && element.communications.length > 0) {
      value = 'CommunicationServices';
    } else if (Array.isArray(element?.conditions) && element.conditions.length > 0) {
      value = 'Conditions';
    }
    if (value) {
      const control = this.addNewChannelForm.get('attributeForChannel');
      if (control) {
        control.setValue(value, { emitEvent: false });
      }
      this.onAttributeForChannelChange({ value });
    }
  }

