# Multiple Range Duration Condition Component Integration

## Overview
The `MultipleRangeDurationConditionComponent` is a new child component based on the existing `RangeDurationConditionComponent`, but without the default column functionality. This component allows multiple range duration entries without requiring a default selection.

## Key Differences from Original Component

1. **Removed Default Column**: No default toggle column in the table
2. **Simplified Interface**: `MultipleRangeDuration` interface without `default` property
3. **No Multivalue Logic**: Removed `multivalueallowed` input since it's not needed
4. **Cleaner Data Model**: Focuses purely on range duration data without default handling

## Integration Steps

### 1. Import the Component in Parent Component

Add to your parent component imports:

```typescript
import { MultipleRangeDurationConditionComponent } from '../multiple-range-duration-condition/multiple-range-duration-condition.component';

@Component({
  // ... other properties
  imports: [
    // ... other imports
    MultipleRangeDurationConditionComponent,
    // ... other imports
  ],
})
```

### 2. Add to Parent Component Template

Add this to your parent component HTML where you want the multiple range duration condition:

```html
<div *ngIf="addNewConditionFormGroup.get('conditionType').value === 'MultipleDurationCondition'">
  <bod-input-layout col="2">
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.classification'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="classification"
          name="classification"
        >
          <mat-option
            *ngFor="let classification of classifications"
            [value]="classification.value"
          >
            {{ classification.label }}
          </mat-option>
        </mat-select>
        <mat-error>
          {{ getError('classification', addNewConditionFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.processingday'"
      [forTextOnly]="true"
      [required]="false"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="processingday"
          name="processingday"
        >
          <mat-option
            *ngFor="let processingday of processingDays"
            [value]="processingday.value"
          >
            {{ processingday.label }}
          </mat-option>
        </mat-select>
        <mat-error>
          {{ getError('processingday', addNewConditionFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
  </bod-input-layout>

  <bod-multiple-range-duration-condition
    #simpleEditTableMultipleRangeDuration
    (completeDeltaChangeMultipleRangeDuration)="handleCompleteDeltaChangeMultipleRangeDuration($event)"
    [multipleRangeDurationData]="multipleRangeDurationTableData"
    (tableDirty)="onTableDirty()"
  >
  </bod-multiple-range-duration-condition>
</div>
```

### 3. Add to Parent Component TypeScript

Add these properties and methods to your parent component:

```typescript
export class AddEditConditionsComponent implements OnInit, AfterViewInit {
  // ... existing properties

  @ViewChild('simpleEditTableMultipleRangeDuration')
  simpleEditTableMultipleRangeDuration: MultipleRangeDurationConditionComponent;

  public multipleRangeDurationTableData: MultipleRangeDuration[] = [];

  // ... existing methods

  completeDeltaMultipleRangeDurationData: any;
  handleCompleteDeltaChangeMultipleRangeDuration(data: any) {
    this.completeDeltaMultipleRangeDurationData = data;
    console.log('Received CompleteDelta from multiple range duration child:', this.completeDeltaMultipleRangeDurationData);
  }

  // Add to your condition types array
  conditionTypes = [
    // ... existing condition types
    {
      value: 'MultipleDurationCondition',
      label: 'Multiple Duration Condition'
    }
    // ... other condition types
  ];

  // In your submitForm method, add handling for MultipleDurationCondition
  submitForm(isAdd: boolean) {
    // ... existing code

    if (formValues.conditionType === 'MultipleDurationCondition') {
      const multipleRangeDurationTableData =
        this.simpleEditTableMultipleRangeDuration.getCurrentTableMultipleRangeDuration?.() || [];

      if (multipleRangeDurationTableData.length === 0) {
        this.handleError1({
          errorCode: 'MULTIPLE_RANGE_DURATION_REQUIRED',
          status: 400
        });
        return;
      }

      const durationValidValues = multipleRangeDurationTableData.reduce((acc, row) => {
        if (row && row.durationType && row.unitValue !== undefined) {
          acc.push({
            durationType: row.durationType,
            unitValue: row.unitValue,
            minimum: row.minimum,
            maximum: row.maximum
          });
        }
        return acc;
      }, []);

      conditionDetail = {
        conditionType: 'MultipleDurationCondition',
        durationDefinition: {
          businessDayRule: formValues.processingday || ''
        },
        multipleDurationValidValues: durationValidValues
      };
    }

    // ... rest of existing submitForm logic
  }

  // In your resetFormControls method, add reset logic
  resetFormControls(conditionType: string) {
    // ... existing reset logic

    if (conditionType !== 'MultipleDurationCondition') {
      this.addNewConditionFormGroup.get('classification')?.reset('');
      this.addNewConditionFormGroup.get('processingday')?.reset('');
    }
  }
}
```

### 4. Interface Definition

Make sure you have the interface defined (already included in the component file):

```typescript
export interface MultipleRangeDuration {
  id: number;
  durationType: string;
  unitValue: number | null;
  minimum: number | null;
  maximum: number | null;
}
```

## Component Features

### Input Properties
- `multipleRangeDurationData`: Array of `MultipleRangeDuration` objects to populate the table

### Output Events
- `tableDirty`: Emitted when table data changes
- `completeDeltaChangeMultipleRangeDuration`: Emitted with complete table data when changes occur

### Public Methods
- `getCurrentTableMultipleRangeDuration()`: Returns current table data
- `markTouched()`: Marks the table form as touched for validation
- `reset()`: Resets the table to initial state

## Validation

The component includes:
- Min/max value validation (minimum cannot be greater than maximum)
- Required field validation for duration type, unit value, minimum, and maximum
- Automatic clearing of values when disabled duration types are selected

## Usage Notes

1. The component automatically disables minimum/maximum/unit value fields when 'Permanent' or 'UntilFurtherNotice' duration types are selected
2. The table supports inline editing with save/cancel functionality
3. Row-level delete actions are available with confirmation dialogs
4. The component integrates with the BOD framework's form validation and dirty state tracking

This component provides a clean, simplified interface for managing multiple range duration conditions without the complexity of default value selection.
