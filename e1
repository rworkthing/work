      case 'select': {
        this.updateMessage('Row Selected', JSON.stringify(event));
        break;
      }
      case 'selectInput': {
        this.updateMessage('Row Selected in Input Mode', JSON.stringify(event));
        break;
      }
      default:
        break;
    }
  }

