  public addTableData() {
    const dialogChannels = this.channelsDataSingleSelect.datasource.data;

    // Sync option values from current table to dialog data
    (this.dataWithSimpleEdit || []).forEach(row => {
      const dialogRow = dialogChannels.find(
        (c: any) =>
          String(c.identifier) === String(row.identifier) ||
          c.code === row.code
      );
      if (dialogRow) {
        dialogRow.option = row.option;
      }
    });

    // Prepare selectedRows for the dialog
    const selectedRows = (this.dataWithSimpleEdit || []).map(row => {
      const dialogRow = dialogChannels.find(
        (c: any) =>
          String(c.identifier) === String(row.identifier) ||
          c.code === row.code
      );
      return dialogRow
        ? { ...dialogRow, option: row.option }
        : { ...row };
    });

    const dialogRef = this.dialog.open(ChannelsMultiselectDialogComponent, {
      width: '900px',
      height: '600px',
      data: {
        channelsDataSingleSelect: this.channelsDataSingleSelect,
        selectedRowSingleSelect: selectedRows,
        editMode: true
      }
    });

    dialogRef.componentInstance.tableDirty.subscribe(() => {
      this.addNewChannelForm.markAsDirty();
    });

    dialogRef.afterClosed().subscribe(result => {
      if (result?.selectedChannels) {
        const currentAttr = this.addNewChannelForm.get('attributeForChannel')?.value || '';
        this.selectedRowSingleSelect = result.selectedChannels;

        // --- Merge new selection with previous data ---
        // Use 'code' as the unique key for merging
        const existingMap = new Map(this.dataWithSimpleEdit.map(row => [row.code, row]));
        const selectedCodes = new Set(result.selectedChannels.map(row => row.code));

        // Build new data: for selected channels, merge with previous data if exists
        const mapped = result.selectedChannels.map(row => {
          const existing = existingMap.get(row.code);
          return {
            id: existing?.id ?? row.id, // preserve existing id if present
            option: row.option,
            channel: row.code,
            code: row.code,
            identifier: row.identifier,
            attributeForChannel: currentAttr,
            counters: existing?.counters ?? [],
            conditions: existing?.conditions ?? [],
            restrictions: existing?.restrictions ?? [],
            communications: existing?.communications ?? []
          };
        });

        // Add any previous channels not in the new selection (preserve them)
        const preserved = this.dataWithSimpleEdit.filter(
          row => !selectedCodes.has(row.code) && row.code !== 'All'
        );

        // --- Ensure "All" row is always present at the top ---
        const allRow = this.dataWithSimpleEdit.find(row => row.code === 'All');
        let newData: any[] = [];
        if (allRow) {
          newData = [allRow, ...mapped, ...preserved];
        } else {
          newData = [{
            id: -1,
            code: 'All',
            channel: 'All',
            option: '',
            identifier: '0',
            attributeForChannel: currentAttr
          }, ...mapped, ...preserved];
        }

        // Remove duplicates by id (keep the first occurrence, which is always the merged one)
        newData = newData.filter((row, idx, arr) =>
          arr.findIndex(r => r.id === row.id) === idx
        );

        this.dataWithSimpleEdit = newData;
        this.tableWithSimpleEdit.datasource.data = [...newData];
        this.channelData = [...newData];
        this.emitCompleteDelta();
      }
    });
  }

