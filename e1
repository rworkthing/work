def imageBuilder = buildxImageBuilder()
def buildImages = { parameters = [:] ->
  def shouldPublish = parameters.containsKey('publish') ? parameters.publish : true
  def appVersion = resolveAppVersion()
  def imageVersion = versionNumber
  def imageBaseName = 'epo-docker-snapshot-local.docker.fis.dev/mbp/cape/cape'

  def modules = [
	'service-app': ['oracle','postgres'],
	'batch-app': ['oracle'],
	'release-db-loader': ['oracle', 'postgres'],
	'eventlistener-app': ['oracle'],
	'cdc-engine-app': ['']
  ]
  
  parallel(modules.collectEntries { name, classifiers  ->
    [
      "${name}": {
		 classifiers.each { classifier ->
            if ("${name}" == 'cdc-engine-app') {
	              dockerfile = 'Dockerfile'
		    	  tag = "${imageVersion}"
		     } else {
	             tag = "${imageVersion}-${classifier}"
				  dockerfile = ''
   	         }
			imageBuilder(
				name: "${imageBaseName}-${name}",
				tag: "${imageVersion}-${classifier}",
				contextDir: "../dev-ops/${name}",
				publish: shouldPublish,
				dockerfile: "${dockerfile}" ? "${dockerfile}"  : "Dockerfile.${classifier.replaceAll('-', '.')}"
			)
          if (shouldPublish == true) {
           container('skopeo') {
			if ("${name}" == 'cdc-engine-app') {
				tag = "${imageVersion}"
			} else {
				tag = "${imageVersion}-${classifier}"
			}
            sh "skopeo copy --format v2s2 docker://${imageBaseName}-${name}:${imageVersion}-${classifier} docker://${imageBaseName}-${name}:${imageVersion}-${classifier}"
          }
        }
		 }
      }
    ]
  })
}

