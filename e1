              <bod-input-layout col="1">
                <bod-table
                  [data]="tableWithSimpleEdit"
                  [tableActions]="actionsForSimple"
                  [modeOptions]="modeOptionsSimple"
                  [singleRowEdit]="singleRowEdit"
                  [customColumnTemplates]="[
                    { columnName: 'locale', templateName: localeTemplate },
                    {
                      columnName: 'displayName',
                      templateName: displayNameTemplate
                    },
                    {
                      columnName: 'description',
                      templateName: descriptionTemplate
                    }
                  ]"
                  (inputValidationStatus)="checkStatus($event)"
                  (editTableEvent)="onEditTableAction($event)"
                  (onTableActionClick)="addTableData()"
                  [primaryColumnName]="'locale'"
                  #simpleEditTableRef
                >
                  <!-- Template for the 'Locale' column -->
                  <ng-template
                    #localeTemplate
                    let-element="element"
                    let-column="column"
                    let-index="index"
                  >
                    <ng-container>
                      <div>{{ element[column.name] }}</div>
                    </ng-container>
                  </ng-template>

                  <!-- Template for the 'Display Name' column -->
                  <ng-template
                    #displayNameTemplate
                    let-element="element"
                    let-column="column"
                    let-index="index"
                  >
                    <ng-container
                      *ngIf="
                        !singleRowEdit?.modeOptions?.input ||
                        (singleRowEdit?.modeOptions?.input &&
                          singleRowEdit?.index !== index)
                      "
                    >
                      <div>{{ element[column.name] }}</div>
                    </ng-container>
                    <ng-container
                      *ngIf="
                        modeOptionsSimple.input ||
                        (singleRowEdit?.modeOptions?.input &&
                          singleRowEdit?.index === index)
                      "
                    >
                      <form [formGroup]="displayNameColumnForm">
                        <mat-form-field appearance="outline" fisStyle>
                          <input
                            matInput
                            [formControl]="
                              displayNameColumnForm.controls[
                                column.name + index
                              ]
                            "
                          />
                        </mat-form-field>
                      </form>
                    </ng-container>
                  </ng-template>

                  <!-- Template for the 'Description' column -->
                  <ng-template
                    #descriptionTemplate
                    let-element="element"
                    let-column="column"
                    let-index="index"
                  >
                    <ng-container
                      *ngIf="
                        !singleRowEdit?.modeOptions?.input ||
                        (singleRowEdit?.modeOptions?.input &&
                          singleRowEdit?.index !== index)
                      "
                    >
                      <div>{{ element[column.name] }}</div>
                    </ng-container>
                    <ng-container
                      *ngIf="
                        modeOptionsSimple.input ||
                        (singleRowEdit?.modeOptions?.input &&
                          singleRowEdit?.index === index)
                      "
                    >
                      <form [formGroup]="descriptionColumnForm">
                        <mat-form-field appearance="outline" fisStyle>
                          <input
                            matInput
                            [formControl]="
                              descriptionColumnForm.controls[
                                column.name + index
                              ]
                            "
                          />
                        </mat-form-field>
                      </form>
                    </ng-container>
                  </ng-template>
                </bod-table>

                <!-- Save and Reset buttons for the table in edit mode -->
                <div *ngIf="modeOptionsSimple.input" class="editPageOptions">
                  <button
                    mat-raised-button
                    fisStyle
                    type="button"
                    color="primary"
                    (click)="saveTableData()"
                    [disabled]="!simpleEditTableRef.tableFormGroup.dirty"
                  >
                    {{ 'mbpBod.demo.microsite.buttons.save' | translate }}
