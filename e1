<![CDATA[
                	SELECT  
					 	LDBID, 
					 	GLS_IDFR,
					 	GLS_NAME,
						GLA_NMBR ,
						GLA_NAME ,
						ARF_IDFR ,
						ARID_ITEM ,
						IP_IDFR_LGL_ORG_UNIT ,
						IP_ID_ITEM_LGL_ORG_UNIT ,
						IP_IDFR_ORG_UNIT ,
						IP_ID_ITEM_ORG_UNIT ,
						GLAC_VALUE ,
						GLT_COST_CNTR_CODE ,
						ACM_IDFR,
						ACM_CODE,
						PD_IDFR ,
						APD_CODE ,
						PDEL_IDFR ,
						PDELP_VALUE ,
						CRNCY_IDFR ,
						CRNCY_ISO4217_VAL ,
						GLT_DR_AMT ,
						GLT_CR_AMT ,
						GLT_BKNG_DATE ,
						GLT_EFCTV_DATE ,
						BALTT_IDFR ,
						BALTT_CODE ,
						GLAT_IDFR ,
						GLAT_CODE 					
					FROM GNRL_LDGR_TRANS X
							WHERE X.LDBID         = ?
								AND X.ARF_IDFR        >= ?
								AND X.ARF_IDFR        <= ?
								AND (X.GLT_BKNG_DATE = ?
									AND ((X.GLT_HOST_TS >= ?  AND X.GLT_HOST_TS <= ?) 
	   									  OR
	   									(X.GLT_HOST_TS >= ?))) 
								ORDER BY X.LDBID,X.ARF_IDFR,X.GLT_HOST_TS
                ]]>
