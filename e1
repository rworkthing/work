import { Injectable } from '@angular/core';
import { HttpClient, HttpHeaders } from '@angular/common/http';
import { Observable, of } from 'rxjs';
import { BodTableAction, UIContextService } from '@bod/common';
import { Attribute } from './attribute.model';
import { DataSharingService } from '../data-sharing-service.service';

@Injectable({
  providedIn: 'root'
})
export class MetadataService {
  private apiURL = '';
  private dataTypesUrl = '';
  private additionalDataTypesUrl = '';
  private ExistingUrl = '';
  private localeUrl = '';
  private idfrUrl = '';
  private saveUrl = '';
  private retrieveUrl = '';
  private UpdateUrl = '';
  private deleteUrl = '';
  private updateStatusUrl = '';
  private baseUrl = '';
  private retrieveAllUrl = '';



  businessProductLine: any[] = [];
  private reqDfnId = '';
  private clientCode = '';
  private countryCode = '';
  private productLines: any[] = [];
  private productTypes: any[] = [];
  private productTypesIdfr: any[] = [];
  private productTypeKeyValueMap: { [key: string]: number } = {};
  private productTypeKeys: string[] = [];
  private productTypeValues: number[] = [];


  constructor(
    private http: HttpClient,
    private uiContextService: UIContextService,
    public readonly dataSharingService: DataSharingService
  ) {
    let url =
      this.uiContextService.getModuleDataById('fis.nextgen.sdkit').valueMap
        .sdkServiceUrl.value;
    this.dataSharingService.data$.subscribe(data => {
      if (data) {
        this.reqDfnId = data.reqDfnId;
        this.businessProductLine = data.reqDfnResponseDTO.businessProductLine;
        this.countryCode = data.countryCode;
        this.clientCode = data.countryCode;
        this.productLines = [
          ...new Set(this.businessProductLine.map(obj => obj.value))
        ];
        this.productTypes = [
          ...new Set(this.businessProductLine.map(obj => obj.type))
        ];
        this.productTypesIdfr = [
          ...new Set(this.businessProductLine.map(obj => obj.identifier))
        ];
        if (data.identifier) {
          try {
            const parsedIdentifiers: { key: string; value: number }[] = JSON.parse(data.identifier);

            this.productTypeKeyValueMap = parsedIdentifiers.reduce(
              (acc: { [key: string]: number }, curr: { key: string; value: number }) => {
                acc[curr.key] = curr.value;
                return acc;
              },
              {}
            );

            this.productTypeKeys = parsedIdentifiers.map((item: { key: string; value: number }) => item.key);
            this.productTypeValues = parsedIdentifiers.map((item: { key: string; value: number }) => item.value);
          } catch (e) {
            console.error('Failed to parse identifier JSON:', e);
          }
        }




        this.apiURL = url + '/basedata/attrobjtype';
        this.dataTypesUrl = url + '/basedata/attrfrmttype';
        this.additionalDataTypesUrl = url + '/basedata/attributetype';
        this.ExistingUrl = url + '/metadata/create/' + this.reqDfnId;
        this.localeUrl = url + '/basedata/multilingualinfo';
        this.idfrUrl =
          url +
          '/metadata/getIdentifier/' +
          this.reqDfnId +
          '?product-type=CASA';
        this.saveUrl = url + '/metadata/create/' + this.reqDfnId;
        this.retrieveUrl =
          url +
          '/metadata/retrieve/' +
          this.reqDfnId +
          '?metadata-config-type=Attribute';
        this.UpdateUrl = url + '/metadata/update/' + this.reqDfnId;
        this.deleteUrl = url + '/metadata/delete/' + this.reqDfnId;
        this.updateStatusUrl = url + '/metadata/updateStatus/' + this.reqDfnId + '?status=READY';
        this.baseUrl = url ?? '';
        this.retrieveAllUrl =
          url +
          '/metadata/retrieve/' +
          this.reqDfnId;

      }
    });
  }


  idfrSearch(): Observable<string> {
    const headers = new HttpHeaders({
      'product-type': this.productTypes,
      'country-code': this.countryCode,
      'client-code': this.clientCode,
      'product-line': this.productLines,
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.get<string>(`${this.idfrUrl}`, { headers });
  }
  createHeaders(): HttpHeaders {
    return new HttpHeaders({
      'country-code': this.countryCode,
      'client-code': this.clientCode,
      'product-line': this.productLines,
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID(),
      'requirement-id': this.reqDfnId
    });
  }
  getTypes(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get(`${this.apiURL}`, { headers });
  }
  generateUUID(): string {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(
      /[xy]/g,
      function (c) {
        const r = (Math.random() * 16) | 0,
          v = c === 'x' ? r : (r & 0x3) | 0x8;
        return v.toString(16);
      }
    );
  }



  getDataTypes(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get(`${this.dataTypesUrl}`, { headers });
  }
  getProductCodes(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get(`${this.additionalDataTypesUrl}`, { headers });
  }
  getLocaleCodes(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get(`${this.localeUrl}`, { headers });
  }

  saveExistingAttribute(request: any): Observable<any> {
    const headers = this.createHeaders();
    return this.http.post(this.ExistingUrl, request, { headers });
  }

  getClassificationTypes(): Observable<any> {
    const classificationtypes = [
      { label: '', value: '' },
      { label: 'System Defined', value: 'systemDefined' },
      { label: 'User Defined', value: 'userDefined' }
    ];
    return of(classificationtypes);
  }

  getStatus(): Observable<any> {
    const statuses = [
      { label: 'Ready', value: 'READY' },
      { label: 'In Progress', value: 'INPROGRESS' },
      { label: 'Generated', value: 'GENERATED' }
    ];
    return of(statuses);
  }
  getValidvalueTypes(): Observable<any> {
    const validvaluestypes = [
      { label: '', value: 'empty' },
      { label: 'Set Values', value: 'setvalues' },
      { label: 'Range Values', value: 'rangevalues' }
    ];
    return of(validvaluestypes);
  }

  saveAttribute(request: any): Observable<any> {
    const headers = this.createHeaders();
    return this.http.post(this.saveUrl, request, { headers });
  }
  retrieveAttribute(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<Attribute[]>(this.retrieveUrl, { headers });
  }
  retrieveAll(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<Attribute[]>(this.retrieveAllUrl, { headers });
  }
  updateAttribute(request: any): Observable<any> {
    const headers = this.createHeaders();
    return this.http.put(this.UpdateUrl, request, { headers });
  }
  deleteAttribute(
    metadataConfigType: string,
    metadataConfigIdfr: number
  ): Observable<any> {
    const headers = this.createHeaders();
    const params = {
      'metadata-config-type': metadataConfigType,
      'metadata-config-idfr': metadataConfigIdfr
    };

    return this.http.delete(this.deleteUrl, { headers, params });
  }


  private getUpdateStatusUrl(status: string): string {
    return `${this.baseUrl}/metadata/updateStatus/${this.reqDfnId}?status=${status}`;
  }

  updateMetadataStatus(status: string, request: any): Observable<any> {
    const headers = this.createHeaders();
    const url = this.getUpdateStatusUrl(status);
    return this.http.put(url, request, { headers });
  }

  getProductTypeIdentifiers(): number[] {
    return this.productTypeValues;
  }

  public getProductTypeValues(): number[] {
    return this.productTypeValues;
  }
  





