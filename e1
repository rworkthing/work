SELECT * FROM
(SELECT A.ARF_IDFR,
A.CDN_IDFR,
A.CDAR_VALUE,
A.APACR_CDN_SRC,
A.OBJ_STATUS,
A.APACR_EFCTV_DATE,
A.CRUD_VALUE,
A.APACR_USER_ID,
A.APACR_WS_ID,
A.APACR_LOCAL_TS,
A.APACR_ACPT_TS,
A.APACR_ACPT_TS_UTC_OFST,
A.UUID,
A.APACR_HOST_TS,
A.RULE_SYSTEM_ID,
A.LDBID,
A.APACR_CDN_DATA,
MAX(A.APACR_HOST_TS) over (partition by a.ldbid, a.arf_idfr, a.cdar_value, a.apacr_efctv_date, a.obj_status) as max_host
FROM APD_AR_CD_RLTNP A
WHERE A.LDBID = 3010
AND A.ARF_IDFR = 553000758229604 
AND A.CRUD_VALUE <> 'D'
AND A.APACR_EFCTV_DATE <= '23-NOV-27'
AND A.OBJ_STATUS = 'Approved'
)
WHERE APACR_HOST_TS = max_host
ORDER BY APACR_HOST_TS DESC;







SELECT A.ARF_IDFR,
A.CDN_IDFR,
A.CDAR_VALUE,
A.APACR_CDN_SRC,
A.OBJ_STATUS,
A.APACR_EFCTV_DATE,
A.CRUD_VALUE,
A.APACR_USER_ID,
A.APACR_WS_ID,
A.APACR_LOCAL_TS,
A.APACR_ACPT_TS,
A.APACR_ACPT_TS_UTC_OFST,
A.UUID,
A.APACR_HOST_TS,
A.RULE_SYSTEM_ID,
A.LDBID,
A.APACR_CDN_DATA
FROM APD_AR_CD_RLTNP A 
WHERE A.LDBID =  3010  
AND A.ARF_IDFR =  553000758229604
AND A.OBJ_STATUS =  'Approved'  
AND A.APACR_EFCTV_DATE <=  '23-NOV-27'  
AND A.CRUD_VALUE <> 'D' 
AND A.APACR_HOST_TS = 
(
SELECT MAX (Y.APACR_HOST_TS) 
FROM APD_AR_CD_RLTNP Y
WHERE Y.LDBID =  3010 AND
Y.ARF_IDFR = A.ARF_IDFR AND
Y.CDAR_VALUE = A.CDAR_VALUE AND
Y.OBJ_STATUS =  'Approved'  AND
Y.APACR_EFCTV_DATE <=  '23-NOV-27'
)
ORDER BY A.APACR_HOST_TS DESC;
