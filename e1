def helminstall = { parameters ->
    def release = parameters.release
	def chart = release.split("/")[1]
    def version = parameters.version
	def valueEntries = parameters.valueEntries
    def setValuesFlags = valueEntries.collect { key, value -> "--set ${key}=${value}" }.join(' ')
  container('helm') {
      def deployNamespace = getNameSpace(branchName)
      def envName = getEnvName(branchName)
	  def valuesPath = "dev-ops/deploy/" + envName + "_values.yaml"

      sh """
	    helm uninstall $chart --namespace $deployNamespace --kube-context $kubeContext|| echo 'Chart already uninstalled!!!'
        helm repo update
        helm upgrade $chart $release --namespace $deployNamespace --kube-context $kubeContext \
		  --values dev-ops/deploy/dashboard-values.yaml \
		  --values dev-ops/deploy/commonConfig_values.yaml \
          --values $valuesPath \
          --version ${version} \
          --install ${setValuesFlags}      
      """
  }
}
