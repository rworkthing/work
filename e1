  ngOnChanges(changes: SimpleChanges) {
    if (changes['channelData']) {
      // Update your table data source
      this.dataWithSimpleEdit = this.channelData || [];
      this.tableWithSimpleEdit.datasource.data = [...(this.channelData || [])];

      // Counters
      this.counterMap = {};
      // Conditions
      this.conditionMap = {};
      // Restrictions
      this.restrictionMap = {};
      // Communications
      this.communicationMap = {};

      (this.channelData || []).forEach(row => {
        if (row.id !== undefined && Array.isArray(row.counters)) {
          this.counterMap[row.id] = [...row.counters];
        }
        if (row.id !== undefined && Array.isArray(row.conditions)) {
          this.conditionMap[row.id] = [...row.conditions];
        }
        if (row.id !== undefined && Array.isArray(row.restrictions)) {
          this.restrictionMap[row.id] = [...row.restrictions];
        }
        if (row.id !== undefined && Array.isArray(row.communications)) {
          this.communicationMap[row.id] = [...row.communications];
        }
      });
    }
  }
