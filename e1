  getCommunicationsTableForChannel(channel: any): BodTableMetadata {
    console.log('channel.communications:', JSON.stringify(channel.communications, null, 2));
    // Map communications with correct serviceElementCode and communicationServices
    const mappedCommunications = (channel.communications || []).map(comm => {
      // Find the master entry by serviceElementIdentifier
      const master = this.communicationsMasterList?.find(
        (m: any) => String(m.serviceElementIdentifier) === String(comm.serviceElementCode)
      );
      return {
        ...comm,
        serviceElement: master?.serviceElementCode || comm.serviceElement || '',
        serviceElementCode: comm.serviceElementCode,
        communicationServices: master?.code || comm.communicationServices || '',
      };
    });

    // Log the data being sent to the table
    console.log('mappedCommunications for Inquiry Table:', JSON.stringify(mappedCommunications, null, 2));

