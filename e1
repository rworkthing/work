private List<CustomerPOCDetails> getCustomerPOCDetailbByService(
      final ThreadContext threadContext, final String customerExternalId)
      throws TechnicalFailureException, BusinessException
   {
      LogUtility.entering(LOG, CLASS, "getCustomerPOCDetailbByService", threadContext, COMPONENT);

      List<CustomerPOCDetails> result = null;
      final CustomerConnector customerConnectorImpl = ConnectorService
         .getImplementation(threadContext, CustomerConnector.class);

      List<CustomerPOCDetails> detailList = customerConnectorImpl
         .getCustomerPOCDetails(threadContext, customerExternalId);

      if (Utility.isNotEmptyList(detailList))
      {
         result = new ArrayList<>();
         // record the detail into DB
         for (CustomerPOCDetails poc : detailList)
         {
            result = CustomerPOCDetailsPersistenceManager.getInstance()
               .createCustomerPOCDetail(threadContext, detailList);
         }
      }
      LogUtility.entering(LOG, CLASS, "getCustomerPOCDetailbByService", threadContext, COMPONENT);
      return result;
   }
