                  {{ element[column.name] }}
                </div>
              </ng-container>
            </ng-template>
            <ng-template
              #useExistingGroupIdTemplate6
              let-element="element"
              let-column="column"
              let-index="index"
              ><ng-container *ngIf="!modeOptionsExpandMulti.input">
                <div>
                  {{ element[column.name] }}
                </div>
              </ng-container>
              <ng-container *ngIf="modeOptionsExpandMulti.input">
                <form [formGroup]="useExistingColForm">
                  <mat-form-field class="editDiv" appearance="outline" fisStyle>
                    <mat-select
                      panelClass="fis-style"
                      (selectionChange)="
                        this.updateColumnData(
                          'useExisting',
                          $event.value,
                          index
                        );
                        this.searchFieldObjArr[
                          index
                        ].searchFieldData.disableSearch =
                          $event.value === 'Yes' ? true : false
                      "
                      [formControl]="
                        useExistingColForm.controls[
                          useExistingFormCtrlKeys[index]
                        ]
                      "
                      [(value)]="element[column.name]"
                    >
                      <mat-option
                        *ngFor="let val of useExistingArr"
                        value="{{ val }}"
                      >
                        {{ val }}
                      </mat-option>
                    </mat-select>
                  </mat-form-field>
                </form>
              </ng-container>
            </ng-template>
            <ng-template
              #overrideDefaultTemplate6
              let-element="element"
              let-column="column"
              let-index="index"
              ><ng-container *ngIf="!modeOptionsExpandMulti.input">
                <div>
                  {{
                    element[column.name] == true
                      ? inputForSlideToggleValue.options[0].label
                      : inputForSlideToggleValue.options[1].label
                  }}
                </div>
              </ng-container>

              <ng-container *ngIf="modeOptionsExpandMulti.input">
                <form [formGroup]="overrideDefaultColumnForm">
                  <mat-slide-toggle
                    fisStyle
                    color="primary"
                    [checked]="element[column.name]"
                    (change)="
                      this.dependentColChange($event, index);
                      this.updateColumnData(column.name, $event.checked, index)
                    "
                    [formControl]="
                      overrideDefaultColumnForm.controls[
                        overrideDefaultColFormCtrKeys[index]
                      ]
                    "
                  ></mat-slide-toggle>
                </form>
              </ng-container>
            </ng-template>
            <ng-template
              #requiredTemplate6
              let-element="element"
              let-column="column"
              let-index="index"
              ><ng-container *ngIf="!modeOptionsExpandMulti.input">
                <div>
                  {{
                    element[column.name] === true
                      ? inputForAuthorizeCheckboxValue.options[0].label
                      : inputForAuthorizeCheckboxValue.options[1].label
                  }}
                </div>
              </ng-container>
              <ng-container *ngIf="modeOptionsExpandMulti.input">
                <form [formGroup]="requiredColumnForm">
                  <mat-checkbox
                    fisStyle
                    color="primary"
                    #checkboxRef6
                    [formControl]="
                      requiredColumnForm.controls[requiredColFormCtrKeys[index]]
                    "
                    [checked]="element[column.name]"
                    [value]="
                      element[column.name] === true
                        ? inputForAuthorizeCheckboxValue.options[0].value
                        : inputForAuthorizeCheckboxValue.options[1].value
                    "
                    (click)="
                      this.updateColumnData(
                        column.name,
                        requiredColumnForm.controls[
                          requiredColFormCtrKeys[index]
                        ].value,
                        index,
                        checkboxRef6,
                        'expandableMultiSelectEditTable'
                      )
                    "
                  ></mat-checkbox>
                </form>
              </ng-container>
            </ng-template>
            <ng-template
              #idTemplate6
              let-element="element"
              let-column="column"
              let-index="index"
              ><ng-container>
                <div>
                  {{ element[column.name] }}
                  <span *ngIf="element.required">*</span>
                </div>
              </ng-container>
            </ng-template>
            <ng-template
              #expandedRowTemplate
              let-context="context"
              let-element="element"
              let-column="column"
            >
              <div fullwidth>
                <bod-inquiry-layout
                  [columns]="2"
                  [groups]="commonDataService.getExpandedData(context.element)"
                  [softSeparator]="false"
                  [information]="[]"
                  (linkClick)="commonDataService.inquiryLayoutClick($event)"
                  [truncation]="{
                    truncate: true,
                    noOverflow: false,
                    truncateAfterLine: 1
                  }"
                >
                </bod-inquiry-layout>
              </div>
              <bod-section-container [expanded]="true" [softSeparator]="false">
                <bod-inquiry-layout
                  [columns]="2"
                  [groups]="$groups.asObservable()"
                  [softSeparator]="false"
                  [information]="[]"
                >
                </bod-inquiry-layout>
              </bod-section-container>
            </ng-template>
          </bod-table>
          <div *ngIf="modeOptionsExpandMulti.input" class="editPageOptions">
            <button
              mat-raised-button
              fisStyle
              type="button"
              color="primary"
              (click)="saveTableData()"
              [disabled]="!expandMultiSelectEditTableRef.tableFormGroup.dirty"
            >
              {{ 'mbpBod.demo.microsite.buttons.save' | translate }}
            </button>
            <button mat-stroked-button fisStyle type="button" (click)="reset()">
              {{ 'mbpBod.demo.microsite.buttons.reset' | translate }}
            </button>
          </div>
        </bod-page-container>
      </mat-tab>
    </mat-tab-group>
  </section>
</demo-container>
