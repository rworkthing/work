public rowExpanded(element: RoleTypeList) {
    console.log("Expanded Element Data:", element);

    // Update Inquiry Layout Data (for bod-inquiry-layout)
    this.roleTypeService.getRoleTypeData(element).subscribe((data) => {
        console.log("Setting Inquiry Layout Data:", data);
        this.roleTypeTableMetaData.datasource.data = data; 
    });

    // Update Role Relationship Table Data (for inner bod-table)
    this.roleRelationshipTable.datasource.data = 
        element.productTypeRoleTypeRelationshipList || [];
}
