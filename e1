// In your submitForm method, add handling for RangeDurationCondition:
else if (formValues.conditionType === 'RangeDurationCondition') {
  const rangeDurationData =
    this.simpleEditTableRangeDuration.getCurrentTableRangeDuration?.() || [];

  const defaultRow = rangeDurationData.find(row => row && row.default);

  if (!this.multivalueallowed && !defaultRow) {
    this.handleError1({
      errorCode: 'DEFAULT_VALUE_REQUIRED',
      status: 400
    });
    return;
  }

  const rangeDurationValidValues = rangeDurationData.reduce((acc, row) => {
    if (row && row.durationType) {
      acc.push({
        durationType: row.durationType,
        unitValue: row.unitValue,
        minimum: row.minimum,
        maximum: row.maximum
      });
    }
    return acc;
  }, []);

  conditionDetail = {
    conditionType: 'RangeDurationCondition',
    rangeDurationDefinition: {
      durationType: defaultRow?.durationType || rangeDurationData[0]?.durationType,
      unitValue: defaultRow?.unitValue || rangeDurationData[0]?.unitValue,
      minimum: defaultRow?.minimum || rangeDurationData[0]?.minimum,
      maximum: defaultRow?.maximum || rangeDurationData[0]?.maximum,
      businessDayRule: formValues.processingday || '',
      multivalueAllowed: formValues.multivalueallowed || false
    },
    rangeDurationValidValues: rangeDurationValidValues
  };
}

