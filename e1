import { HttpClient, HttpHeaders } from '@angular/common/http';
import { Injectable } from '@angular/core';
import { Column, InquiryLayoutInput, UIContextService } from '@bod/common';
import { BehaviorSubject, Observable, of } from 'rxjs';
import { RoleRelationshipSampleTable } from '../add-edit-roletype/roletype.model';
import { RoleTypeList } from '../add-edit-roletype/add-edit-roletype.mode';

@Injectable({
  providedIn: 'root'
})
export class RoleTypeService {
  
  private roleTypeUrl = '';
  private roleCategoryUrl = '';
  private accountClassificationUrl = '';
  private saveUrl = '';
  private retrieveUrl = '';
  private deleteUrl = '';

  constructor(
    private http: HttpClient,
    private uiContextService: UIContextService
  ) {
    let url =
      this.uiContextService.getModuleDataById('fis.nextgen.sdkit').valueMap
        .sdkServiceUrl.value;
        this.roleTypeUrl = url + '/basedata/roletype';
        this.roleCategoryUrl = url + '/basedata/rolecat';
        this.accountClassificationUrl = url + '/basedata/accountclassification';
        this.saveUrl = url + '/metadata/create/requirement512';
        this.retrieveUrl =
      url +
      '/metadata/retrieve/requirement512?metadata-config-type=RoleType';
      this.deleteUrl = url + '/metadata/delete/requirement512';
  }

  getRoletype(): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.get(`${this.roleTypeUrl}`, { headers });
  }

  getRoleCat(): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.get(`${this.roleCategoryUrl}`, { headers });
  }

  getAccountClassification(): Observable<any> {
    const headers = new HttpHeaders({
      'country-code': 'CNTRY01',
      'client-code': 'CLNT01',
      'product-line': 'retaildeposits',
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID()
    });

    return this.http.get(`${this.accountClassificationUrl}`, { headers });
  }

  getCustomerType(): Observable<any> {
    const customerTypes = [
      { label: '', value: 'empty' },
      { label: 'Individual', value: 'individual' },
      { label: 'Organization', value: 'organization' }
      
    ];
    return of(customerTypes);
  }

  getRoleCategoryId(): Observable<any> {
      const roleCategoryIds = [
        { label: '', value: 'empty' },
        { label: 'Category', value: 'category' },
        
      ];
      return of(roleCategoryIds);
    }


    saveRoleType(request: any): Observable<any> {
      const headers = new HttpHeaders({
        'country-code': 'CNTRY01',
        'client-code': 'CLNT01',
        'product-line': 'retaildeposits',
        fe_id: this.uiContextService.getTenantId(),
        'user-id': this.uiContextService.getUserProfile().userId?.toString(),
        uuid: this.generateUUID()
      });
  
      return this.http.post(this.saveUrl, request, { headers });
    }

    retrieveRoleType(): Observable<any> {
      const headers = new HttpHeaders({
        'country-code': 'CNTRY01',
        'client-code': 'CLNT01',
        'product-line': 'retaildeposits',
        fe_id: this.uiContextService.getTenantId(),
        'user-id': this.uiContextService.getUserProfile().userId?.toString(),
        uuid: this.generateUUID()
      });
  
      return this.http.get<RoleTypeList[]>(this.retrieveUrl, { headers });
    }

    deleteRoleType(
      metadataConfigType: string,
      metadataConfigIdfr: number
    ): Observable<any> {
      const headers = new HttpHeaders({
        'country-code': 'CNTRY01',
        'client-code': 'CLNT01',
        'product-line': 'retaildeposits',
        fe_id: this.uiContextService.getTenantId(),
        'user-id': this.uiContextService.getUserProfile().userId?.toString(),
        uuid: this.generateUUID()
      });
  
      const params = {
        'metadata-config-type': metadataConfigType,
        'metadata-config-idfr': metadataConfigIdfr
      };
  
      return this.http.delete(this.deleteUrl, { headers, params });
    }
    generateUUID(): string {
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(
        /[xy]/g,
        function (c) {
          const r = (Math.random() * 16) | 0,
            v = c === 'x' ? r : (r & 0x3) | 0x8;
          return v.toString(16);
        }
      );
    }

  public getExpandedRelationshipData(
    element: RoleRelationshipSampleTable
  ): Observable<InquiryLayoutInput[]> {
    const groups: InquiryLayoutInput[] = [];
    let setIsLink = false;
    for (let i = 0; i < element.roleTypes.length; i++) {
      //setIsLink = !setIsLink;
      groups.push({
        id: element.roleTypes[i].id,
        label: element.roleTypes[i].label,
        value: element.roleTypes[i].value,
        isLink: setIsLink
      });
    }

    const $groups = new BehaviorSubject<InquiryLayoutInput[]>(groups);

    return $groups;
  }

