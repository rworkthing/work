public getAddtnlReltns(
    element: RoleTypeList
  ): Observable<InquiryLayoutInput[]> {
    // console.log("recieved element", element);
    // console.log("returningdata", element.productTypeRoleTypeCatRelationshipList);
    const groups: InquiryLayoutInput[] = [];
    let setIsLink = false;
    for (let i = 0; i < element.roleCategory.length; i++) {
      //setIsLink = !setIsLink;
      groups.push({
        id: element.roleCategory[i].id,
        label: element.roleCategory[i].label,
        value: element.roleCategory[i].value,
        isLink: setIsLink
      });
    }

    const $groups = new BehaviorSubject<InquiryLayoutInput[]>(groups);

    return $groups;
    
  }
