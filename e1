// existing-service-element.component.ts

import {
  ChangeDetectorRef,
  Component,
  EventEmitter,
  Output,
  ViewChild,
  OnInit
} from '@angular/core';
import { CommonModule } from '@angular/common';
import {
  AbstractControl,
  FormBuilder,
  FormControl,
  FormGroup,
  FormsModule,
  ReactiveFormsModule,
  UntypedFormControl,
  UntypedFormGroup,
  ValidationErrors,
  ValidatorFn,
  Validators
} from '@angular/forms';
import {
  BodCommonDialogService,
  BodCommonModule,
  BodCurrencyControlModule,
  BodDynamicFormModule,
  BodFormModule,
  BodFormStateService,
  BodFormTypes,
  BodPageContainerModule,
  BodTableAction,
  BodTableActionsModule,
  BodTableActionType,
  BodTableComponent,
  BodTableMetadata,
  BodTableModule,
  CommonDialogComponent,
  ControlGroupModule,
  DirectivesModule,
  EditTableAction,
  EditTableEventData,
  InlineEditOutput,
  InputLayoutModule,
  InquiryLayoutModule,
  MessageContainerModule,
  ModeOptions,
  NotificationMessage,
  NotificationMessageType,
  RowLeftAction,
  SearchFieldModule,
  SectionContainerModule
} from '@bod/common';
import { TranslationKey } from '../../metadat-config/codegen-config.constant';
import { ServiceElementService } from '../service-element.service';

import { MatIconModule } from '@angular/material/icon';
import { RufIconModule } from '@ruf/shell/icon';
import { MatButtonModule } from '@angular/material/button';
import { MatSlideToggleModule } from '@angular/material/slide-toggle';
import { MatTabsModule } from '@angular/material/tabs';
import { TranslateModule } from '@ngx-translate/core';
import { MatDatepickerModule } from '@angular/material/datepicker';
import { MatInputModule } from '@angular/material/input';
import { MatSelectModule } from '@angular/material/select';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatButtonToggleModule } from '@angular/material/button-toggle';
import { MatTableDataSource } from '@angular/material/table';
import { FormUtilityService } from '../../metadat-config/form-utility.service';
import { MatDialogRef } from '@angular/material/dialog';
import { MetadataService } from '../../metadat-config/metada-config.service';
import { ExistingServiceElement } from '../add-edit-service-element-details/add-edit-service-element.model';

@Component({
  selector: 'bod-existing-service-element',
  standalone: true,
  imports: [
    CommonModule,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    MatDatepickerModule,
    BodCommonModule
  ],
  templateUrl: './existing-service-element.component.html',
  styleUrl: './existing-service-element.component.scss'
})
export class ExistingServiceElementComponent implements OnInit {
  public translationKey = TranslationKey;
  public existingServiceElementFormGroup: UntypedFormGroup;
  public errorMessages: NotificationMessage[] = [];
  public availableServiceElements: ExistingServiceElement[] = [];
  public selectedServiceElementDetails: ExistingServiceElement | null = null;
  public formType = 'edit';

  @Output() apiResponse: EventEmitter<any> = new EventEmitter<any>();

  public messages: NotificationMessage[] = [];
  public message: NotificationMessage | undefined;

  constructor(
    private fb: FormBuilder,
    private serviceElementService: ServiceElementService,
    private changeDetectorRef: ChangeDetectorRef,
    private metadataService: MetadataService
  ) {}

  ngOnInit() {
    this.initForm();
    this.loadAvailableServiceElements();
  }

  private initForm(): void {
    this.existingServiceElementFormGroup = this.fb.group({
      serviceElement: ['', Validators.required],
      serviceElementName: [''],
      optionality: ['', Validators.required]
    });
  }

  private getInvalidRequiredFields(formGroup: FormGroup): string[] {
    const invalidFields: string[] = [];

    Object.keys(formGroup.controls).forEach(key => {
      const control = formGroup.get(key);
      if (control && control.errors?.['required']) {
        invalidFields.push(key);
      }
    });

    return invalidFields;
  }

  private successResponse(resp, serviceElementData) {
    const serviceElementCode = this.selectedServiceElementDetails?.code;
    const SuccessMsg = `${serviceElementCode} related successfully`;
    this.apiResponse.emit({ ...serviceElementData, SuccessMsg });
  }
  
  private handleError(error: any) {
    let errorMsg = '';

    if (error.errorCode === 'FORM_INVALID' || error.status === 400) {
      if (error.missingFields?.length) {
        errorMsg = `Please fill the required fields.`;
      } else {
        errorMsg = 'Please fill the required fields.';
      }
    } else if (error.errorCode === 'NO_SERVICE_ELEMENT_SELECTED') {
      errorMsg = 'Please select a service element from the dropdown.';
    } else if (error.errorCode === 'SERVICE_ELEMENT_ALREADY_EXISTS') {
      errorMsg = 'Service element relationship already exists.';
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_005") {
      errorMsg = 'Service element relationship already exists.';
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_004") {
      errorMsg = error.error?.errorDescription || 'Service element relationship already exists.';
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_048") {
      errorMsg = error.error?.errorDescription || 'This Metadata cannot be created.';
    } else {
      errorMsg = 'Unknown error occurred.';
    }

    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };
    this.errorMessages.push(this.message);

    // Auto-remove error messages after 10 seconds
    setTimeout(() => {
      this.errorMessages = this.errorMessages.filter(msg => msg.text !== errorMsg);
    }, 10000);
  }

  private loadAvailableServiceElements(): void {
    this.serviceElementService.getServiceElements().subscribe({
      next: (serviceElements) => {
        this.availableServiceElements = serviceElements.map((s: any) => ({
          identifier: s.identifier,
          code: s.code,
          name: s.name,
          optionality: s.optionality
        }));
      },
      error: () => {
        // Fallback to mock data
        this.availableServiceElements = [
          { identifier: 1, code: 'SE001', name: 'Service Element 1', optionality: 'Mandatory' },
          { identifier: 2, code: 'SE002', name: 'Service Element 2', optionality: 'Optional' }
        ];
      }
    });
  }

  onServiceElementChange(event: any): void {
    const selectedId = event.value;
    this.selectedServiceElementDetails = this.availableServiceElements.find(s => s.identifier === selectedId) || null;
    this.existingServiceElementFormGroup.patchValue({
      serviceElementName: this.selectedServiceElementDetails?.name || '',
      optionality: this.selectedServiceElementDetails?.optionality || ''
    });
  }

  getError(control: string, formGroup: FormGroup): string {
    const fc: AbstractControl = formGroup.get(control);
    if (fc && fc.errors && fc.touched) {
      return 'Please fill the required fields.'; // Replace with your error logic
    }
    return '';
  }

  onRelateExistingServiceElement($event?: any) {
    this.submitForm();
  }

  submitForm() {
    this.errorMessages = [];

    if (this.existingServiceElementFormGroup.invalid) {
      this.existingServiceElementFormGroup.markAllAsTouched();
      const missingFields = this.getInvalidRequiredFields(this.existingServiceElementFormGroup);
      this.handleError({
        errorCode: 'FORM_INVALID',
        status: 400,
        missingFields
      });
      return;
    }

    if (!this.selectedServiceElementDetails) {
      this.handleError({
        errorCode: 'NO_SERVICE_ELEMENT_SELECTED',
        status: 400
      });
      return;
    }

    // Get product type data from metadata service
    const productTypeKeys = this.metadataService.getProductTypeKeys();
    const productTypeValues = this.metadataService.getProductTypeValues();

    // Build serviceElementList
    const serviceElementList = [{
      serviceElement: {
        identifier: this.selectedServiceElementDetails.identifier,
        code: this.selectedServiceElementDetails.code,
        name: this.selectedServiceElementDetails.name,
        optionality: this.selectedServiceElementDetails.optionality
      }
    }];

    // Build productTypeList
    const productTypeListOut = productTypeKeys.map((code, index) => ({
      identifier: productTypeValues[index],
      code: code
    }));

    // Final request object
    const serviceElementData = {
      metadataType: 'ServiceElement',
      serviceElementList,
      productTypeList: productTypeListOut
    };

    this.serviceElementService.saveServiceElement(serviceElementData).subscribe({
      next: resp => this.successResponse(resp, serviceElementData),
      error: (err: NotificationMessage[]) => this.handleError(err)
    });
  }

  onReset($event?: any): void {
    this.errorMessages = [];
    this.existingServiceElementFormGroup.reset();
    this.selectedServiceElementDetails = null;
    this.changeDetectorRef.detectChanges();
  }
}




























<!-- existing-service-element.component.html -->
<bod-message-container [messages]="errorMessages"></bod-message-container>
<bod-form
  [formGroup]="existingServiceElementFormGroup"
  rufId
  [type]="formType"
  (onSubmit)="onRelateExistingServiceElement()"
  (onReset)="onReset()"
  fisStyle
>
  <bod-input-layout col="2">
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.code'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="serviceElement"
          name="serviceElement"
          (selectionChange)="onServiceElementChange($event)"
        >
          <mat-option
            *ngFor="let serviceElement of availableServiceElements"
            [value]="serviceElement.identifier"
          >
            {{ serviceElement.code }}
          </mat-option>
        </mat-select>
        <mat-error>
         {{ getError('serviceElement', existingServiceElementFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
   
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.name'"
      [forTextOnly]="true"
      [required]="true"
    >
      <div *ngIf="selectedServiceElementDetails">
        {{ selectedServiceElementDetails.name }}
      </div>
      <mat-form-field appearance="outline" fisStyle *ngIf="!selectedServiceElementDetails">
        <input
          type="text"
          matInput
          fisStyle
          formControlName="serviceElementName"
          name="serviceElementName"
          readonly
        />
      </mat-form-field>
    </bod-control-group>
  </bod-input-layout>
  
  <bod-input-layout col="2">
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.optionality'"
      [forTextOnly]="true"
      [required]="true"
    >
      <div *ngIf="selectedServiceElementDetails">
        {{ selectedServiceElementDetails.optionality }}
      </div>
      <mat-form-field appearance="outline" fisStyle *ngIf="!selectedServiceElementDetails">
        <input
          type="text"
          matInput
          fisStyle
          formControlName="optionality"
          name="optionality"
          readonly
        />
      </mat-form-field>
    </bod-control-group>
  </bod-input-layout>
</bod-form>
























