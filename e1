  constructor(
    private http: HttpClient,
    private uiContextService: UIContextService,
    private readonly dataSharingService: DataSharingService
  ) {
    let url =
      this.uiContextService.getModuleDataById('fis.nextgen.sdkit').valueMap
        .sdkServiceUrl.value;

    this.dataSharingService.data$.subscribe(data => {
      if (data) {
        this.reqDfnId = data.reqDfnId;
        this.businessProductLine = data.reqDfnResponseDTO.businessProductLine;
        this.countryCode = data.countryCode;
        this.clientCode = data.countryCode;
        this.productLines = [
          ...new Set(this.businessProductLine.map(obj => obj.value))
        ];
        this.productTypes = [
          ...new Set(this.businessProductLine.map(obj => obj.type))
        ];
        this.deleteUrl = url + '/metadata/delete/' + this.reqDfnId;
        this.apiURL = url + '/basedata/condition';
        this.saveUrl = url + '/metadata/create/' + this.reqDfnId;
        this.updateUrl = url + '/metadata/update/' + this.reqDfnId;
        this.currencyUrl = url + '/basedata/currency';
        this.retrieveUrl =
          url +
          '/metadata/retrieve/' +
          this.reqDfnId +
          '?metadata-config-type=Condition';
      }
    });
  }
  createHeaders(): HttpHeaders {
    return new HttpHeaders({
      'country-code': this.countryCode,
      'client-code': this.clientCode,
      'product-line': this.productLines,
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID(),
      'requirement-id':this.reqDfnId
    });
  }
  generateUUID(): string {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(
      /[xy]/g,
      function (c) {
        const r = (Math.random() * 16) | 0,
          v = c === 'x' ? r : (r & 0x3) | 0x8;
        return v.toString(16);
      }
    );
  }
  getConditions(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get(`${this.apiURL}`, { headers });
  }
  getCurrency(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get(`${this.currencyUrl}`, { headers });
  }
  saveCondition(request: any): Observable<any> {
    const headers = this.createHeaders();
    return this.http.post(this.saveUrl, request, { headers });
  }

  updateCondition(request: any): Observable<any> {
    const headers = this.createHeaders();
    return this.http.put(this.updateUrl, request, { headers });
  }
  retrieveCondition(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<ConditionList[]>(this.retrieveUrl, { headers });
  }
  deleteCondition(
    metadataConfigType: string,
    metadataConfigIdfr: number
  ): Observable<any> {
    const headers = this.createHeaders();
    const params = {
      'metadata-config-type': metadataConfigType,
      'metadata-config-idfr': metadataConfigIdfr
    };

    return this.http.delete(this.deleteUrl, { headers, params });
  }

  public getCondition(
    element: ConditionList
  ): Observable<InquiryLayoutInput[]> {
    const groups: InquiryLayoutInput[] = [];
    let setIsLink = false;
    for (let i = 0; i < element.conditionInquiry.length; i++) {
      //setIsLink = !setIsLink;
      groups.push({
        id: element.conditionInquiry[i].id,
        label: element.conditionInquiry[i].label,
        value: element.conditionInquiry[i].value,
        isLink: setIsLink
      });
    }

    const $groups = new BehaviorSubject<InquiryLayoutInput[]>(groups);

    return $groups;
  }
