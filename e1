// channel-table.model.ts

/**
 * Interface for Channel Table data
 */
export interface ChannelTable {
  id: number;
  channel: string;
  option: string;
}

/**
 * Interface for Channel Configuration in API payload
 */
export interface ChannelConfiguration {
  channelIdentifier: string;
  channelCode: string;
  optionType: string;
  transactionTypeIdentifier: number;
}

/**
 * Interface for Channel Dropdown Options
 */
export interface ChannelOption {
  label: string;
  value: string;
}

/**
 * Enum for Channel Option Types
 */
export enum ChannelOptionType {
  REQUIRED = 'Required',
  OPTIONAL = 'Optional',
  NOT_APPLICABLE = 'NotApplicable'
}

/**
 * Interface for extending TransactionTypeList to include channel configuration
 */
export interface TransactionTypeWithChannels {
  channelConfigurationList?: ChannelConfiguration[];
}

/**
 * Type for Channel Table Actions
 */
export type ChannelTableAction = 'add' | 'edit' | 'delete' | 'save' | 'cancel';






