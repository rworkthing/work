<bod-page-container title="Metadata Configurations"></bod-page-container>
<section demo fullWidth>
  <mat-tab-group fisStyle mat-stretch-tabs="false" tableDemoTabGroug>
    <mat-tab label="{{ 'BOD.metadataconfig.attributes' | translate }}">
      <bod-page-container rufId [title]="'Attributes Details' | translate">
        <bod-table
          rufId
          #balanceHoldsTabRef
          [data]="balanceHoldsTableMetaData"
          [tableActions]="balanceHoldsTableActions"
          [alignContent]="'top'"
          [selectedFilters]="selectedFilters"
          (updateFilters)="onUpdateFilterClick($event)"
          (onTableActionClick)="onTableActionClicked($event)"
          [expandedRowTemplate]="expandedRowTemplate"
          [inlineModal]="{
            addNewInlineRowTitle: 'New Attribute' | translate,
            addFormTitle: 'Add Attribute' | translate,
            editFormTitle:
              translationKey + '.table.labels.balanceHoldEditFormTitle'
              | translate,
            formGroup: addEditBalanceHoldFormGroup,
            formTemplateName: addEditBalanceHoldTemplate
          }"
          (onInlineFormAddSubmit)="onSubmit($event)"
          (onInlineAddRowActionClick)="inlineAddRowActionClick()"
          (onInlineFormEditSubmit)="onSubmit($event)"
          (onInlineEditRowActionClick)="inlineEditRowActionClick($event)"
        >
          <ng-template
            #expandedRowTemplate
            let-element="element"
            let-context="context"
          >
          </ng-template>
        </bod-table>
