<input
  type="text"
  matInput
  fisStyle
  formControlName="displayName"
  name="displayName"
  (blur)="autoSaveInlineEntry(inputLocaleLayoutForm.value)"
  (input)="autoSaveInlineEntry(inputLocaleLayoutForm.value)"
/>


<mat-select
  panelClass="fis-style"
  formControlName="localeCode"
  name="localeCode"
  (selectionChange)="autoSaveInlineEntry(inputLocaleLayoutForm.value)"
>
  <mat-option *ngFor="let localeCode of localeCodes" [value]="localeCode.value">
    {{ localeCode.label }}
  </mat-option>
</mat-select>
