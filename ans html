@Input() set localeData(data: BodLocaleTable[]) {
  this.dataWithSimpleEdit = data || [];
  this.tableWithSimpleEdit.datasource.data = this.dataWithSimpleEdit;

  // Rebuild forms based on new data
  this.buildLocaleForms();
}


buildLocaleForms() {
  this.inputLocaleLayoutFormDisplayName = new UntypedFormGroup({});
  this.inputLocaleLayoutFormLocale = new UntypedFormGroup({});
  this.inputLocaleLayoutFormDesc = new UntypedFormGroup({});

  this.useExistingFormCtrlKeysDisplayName = [];
  this.useExistingFormCtrlKeysLocale = [];
  this.useExistingFormCtrlKeysDesc = [];

  this.dataWithSimpleEdit.forEach((row, index) => {
    this.inputLocaleLayoutFormLocale.addControl(
      `locale${index}`,
      new UntypedFormControl(row.locale, Validators.required)
    );
    this.inputLocaleLayoutFormDisplayName.addControl(
      `displayName${index}`,
      new UntypedFormControl(row.displayName)
    );
    this.inputLocaleLayoutFormDesc.addControl(
      `description${index}`,
      new UntypedFormControl(row.description)
    );

    this.useExistingFormCtrlKeysLocale.push(`locale${index}`);
    this.useExistingFormCtrlKeysDisplayName.push(`displayName${index}`);
    this.useExistingFormCtrlKeysDesc.push(`description${index}`);
  });
}
