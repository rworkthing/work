    if (this.channelForm.invalid) return;

    const selectedChannel = this.channels.find(c => c.value === formValues.channel);
    if (!selectedChannel) return;

    // Check for duplicates
    const isDuplicate = this.tableWithSimpleEdit.datasource.data.some(
      (channel: ChannelTable) => channel.identifier === selectedChannel.value.toString()
    );

    if (isDuplicate) {
      this.showError('Channel already exists');
      return;
