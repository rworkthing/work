})
export class RestrictionsMultiselectDialogComponent {
  public translationKey = TranslationKey;

  formType: BodFormTypes = BodFormTypes.FORM;
  @ViewChild('restrictionsTable', { static: false }) restrictionsTable: RestrictionsMultiselectTableComponent;
  @Output() rowSelected = new EventEmitter<RestrictionTable[]>();

  selectedRows: Restrictions[] = [];
  public addRestrictionsFormGroup: UntypedFormGroup;
  isDirty = false;

  constructor(
    public dialogRef: MatDialogRef<RestrictionsMultiselectDialogComponent>,
    @Inject(MAT_DIALOG_DATA) public data: any,
    private fb: UntypedFormBuilder
  ) {
    this.initForm();
  }

  private initForm(): void {
    const controls: { [key: string]: any } = {};
    // Always get the latest data
    const allRows = this.data?.restrictionsDataSingleSelect?.datasource?.data || [];
    allRows.forEach((row: any, idx: number) => {
     
      controls['type_' + row.id] = [row.type || 'ERROR'];
    });
    this.addRestrictionsFormGroup = this.fb.group(controls);
    console.log('Dialog initForm - Form controls:', Object.keys(controls));
  }

  ngOnChanges(changes: SimpleChanges) {
    if (changes['data'] || changes['restrictionData']) {
      this.initForm();
    }
  }

  onTableDirtyChange(dirty: boolean) {
    this.isDirty = dirty;
    if (dirty) {
      this.addRestrictionsFormGroup.markAsDirty();
    }
  }

  public isTableDirty = false;

  public onTableDirty(): void {
    this.isTableDirty = true;
    this.addRestrictionsFormGroup.markAsDirty();
  }

  onRowSelected(selectedRows: Restrictions[]) {
    console.log('onRowSelected called with:', selectedRows);
    this.selectedRows = selectedRows;
    this.isDirty = true;
    this.initForm();
  }

  onSubmit() {
    // Pass the selectedRows object when closing the dialog
    this.dialogRef.close({ selectedRestrictions: this.selectedRows });
  }

  onReset() {
    this.isDirty = false;
  }
}













