// add-edit-service-element.component.ts

import {
  ChangeDetectorRef,
  Component,
  EventEmitter,
  Input,
  OnInit,
  Output,
  ViewChild
} from '@angular/core';
import { CommonModule } from '@angular/common';
import {
  AbstractControl,
  FormBuilder,
  FormControl,
  FormGroup,
  FormsModule,
  ReactiveFormsModule,
  UntypedFormControl,
  UntypedFormGroup,
  ValidationErrors,
  ValidatorFn,
  Validators
} from '@angular/forms';
import { TranslationKey } from '../../metadat-config/codegen-config.constant';
import { ServiceElementService } from '../service-element.service';
import { MetadataService } from '../../metadat-config/metada-config.service';
import {
  BodCommonDialogService,
  BodCommonModule,
  BodCurrencyControlModule,
  BodDynamicFormModule,
  BodFormModule,
  BodFormStateService,
  BodFormTypes,
  BodPageContainerModule,
  BodTableAction,
  BodTableActionsModule,
  BodTableActionType,
  BodTableComponent,
  BodTableMetadata,
  BodTableModule,
  CommonDialogComponent,
  ControlGroupModule,
  DirectivesModule,
  EditTableAction,
  EditTableEventData,
  InlineEditOutput,
  InputLayoutModule,
  InquiryLayoutModule,
  MessageContainerModule,
  ModeOptions,
  NotificationMessage,
  NotificationMessageType,
  RowLeftAction,
  SearchFieldModule,
  SectionContainerModule
} from '@bod/common';
import { ServiceElementDetailsComponent } from '../service-element-details.component';
import { MatIconModule } from '@angular/material/icon';
import { RufIconModule } from '@ruf/shell/icon';
import { MatButtonModule } from '@angular/material/button';
import { MatSlideToggleModule } from '@angular/material/slide-toggle';
import { MatTabsModule } from '@angular/material/tabs';
import { TranslateModule } from '@ngx-translate/core';
import { MatDatepickerModule } from '@angular/material/datepicker';
import { MatInputModule } from '@angular/material/input';
import { MatSelectModule } from '@angular/material/select';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatButtonToggleModule } from '@angular/material/button-toggle';
import { MatTableDataSource } from '@angular/material/table';
import { FormUtilityService } from '../../metadat-config/form-utility.service';
import { MatDialogRef } from '@angular/material/dialog';
import { ServiceElementList } from './add-edit-service-element.model';

@Component({
  selector: 'bod-add-edit-service-element',
  standalone: true,
  imports: [
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    MatDatepickerModule,
    BodCommonModule
  ],
  templateUrl: './add-edit-service-element.component.html',
  styleUrl: './add-edit-service-element.component.scss'
})
export class AddEditServiceElementComponent implements OnInit {
  public translationKey = TranslationKey;
  public addNewServiceElementFormGroup: UntypedFormGroup;
  formType: BodFormTypes = BodFormTypes.SUBMIT;

  @Input() retainedCode: string = '';
  @Input() retainedIdentifier: number = 0;
  @Input() retainedName: string = '';
  @Input() retainedOptionality: string = '';
  
  @Input() editServiceElementRow: ServiceElementList;

  @Output() apiResponse: EventEmitter<NotificationMessage[]> = new EventEmitter<
    NotificationMessage[]
  >();

  public errorMessages: NotificationMessage[] = [];
  public modeOptions: ModeOptions = { input: false, reset: false };

  @ViewChild('systemMessage', { static: true }) systemMessage: any;

  public messages: NotificationMessage[] = [];
  public message: NotificationMessage | undefined;
  private dialogRef$: MatDialogRef<CommonDialogComponent, any>;

  // Optionality dropdown options
  optionalityOptions = [
    { label: 'Locked', value: 'Locked' },
    { label: 'Mandatory', value: 'Mandatory' },
    { label: 'Optional', value: 'Optional' },
    { label: 'Proposed', value: 'Proposed' }
  ];

  statusControl = new FormControl(null);
  public previousStatus: string | undefined;
  isAdd = true;
  isEdit = false;

  constructor(
    private changeDetectorRef: ChangeDetectorRef,
    private bodFormStateService: BodFormStateService,
    public ServiceElementService: ServiceElementService,
    private fb: FormBuilder,
    private bodCommonDialogService: BodCommonDialogService,
    private metadataService: MetadataService
  ) { }

  ngOnInit() {
    this.initForm();
    if (this.editServiceElementRow) {
      this.serviceElementForm(this.editServiceElementRow);
    }
    this.metadataService.retrieveAll().subscribe((response: any) => {
      const firstStatus = response?.data?.[0]?.MetadataStatus;
      const statusToSet = firstStatus || 'NEW';
      this.statusControl.setValue(statusToSet);
      this.previousStatus = statusToSet;
    });
  }

  private initForm(): void {
    this.addNewServiceElementFormGroup = this.fb.group({
      serviceElementCode: new UntypedFormControl('', [
        Validators.required,
        this.noSpecialCharactersValidator(),
        this.maxLengthValidator(32)
      ]),
      serviceElementIdentifier: [{ value: '', disabled: true }],
      serviceElementName: new UntypedFormControl('', [
        Validators.required,
        this.maxLengthValidator(120)
      ]),
      optionality: new UntypedFormControl('', [Validators.required])
    });
  }

  noSpecialCharactersValidator(): ValidatorFn {
    return (control: AbstractControl): { [key: string]: any } | null => {
      const forbidden = /[^a-zA-Z0-9]/.test(control.value);
      return forbidden
        ? { noSpecialCharacters: { value: control.value } }
        : null;
    };
  }

  maxLengthValidator(maxLength: number): ValidatorFn {
    return (control: AbstractControl): ValidationErrors | null => {
      const value = control.value;

      if (value === null || value === undefined || value === '') {
        return null;
      }

      const stringValue = value.toString();

      return stringValue.length > maxLength
        ? { maxLength: 'Value exceeds allowed digit limit' }
        : null;
    };
  }

  identifierSearch(field: string): Promise<void> {
    return new Promise((resolve, reject) => {
      this.metadataService.idfrSearch().subscribe(
        (response: string) => {
          if (field === 'serviceElementIdentifier') {
            this.addNewServiceElementFormGroup.controls['serviceElementIdentifier'].setValue(response);
          }
          this.addNewServiceElementFormGroup.markAsDirty();
          resolve();
        },
        error => {
          console.error('Error:', error);
          reject(error);
        }
      );
    });
  }

  public getError(control: string, formGroup: UntypedFormGroup): string {
    if (formGroup) {
      const fc: AbstractControl = formGroup.get(control);
      if (fc && fc.errors && fc.touched) {
        return FormUtilityService.getCommonFCErrorMsg(fc);
      }
    }
  }

  onAddNewServiceElement(isAdd: boolean) {
    const promises = [];

    if (isAdd) {
      promises.push(this.identifierSearch('serviceElementIdentifier'));
    }

    Promise.all(promises)
      .then(() => {
        this.submitForm(isAdd);
      })
      .catch(error => {
        console.error('Error during identifier search:', error);
      });
  }

  submitForm(isAdd: boolean) {
    this.errorMessages = [];

    if (this.addNewServiceElementFormGroup.invalid) {
      this.addNewServiceElementFormGroup.markAllAsTouched();
      const missingFields = this.getInvalidRequiredFields(this.addNewServiceElementFormGroup);
      this.handleError(
        {
          errorCode: 'FORM_INVALID',
          status: 400,
          missingFields
        },
        isAdd
      );
      return;
    }

    const formValue = this.addNewServiceElementFormGroup.getRawValue();
    this.addNewServiceElementFormGroup.controls['serviceElementIdentifier'].enable();

    // Get product type data from metadata service
    const productTypeKeys = this.metadataService.getProductTypeKeys();
    const productTypeValues = this.metadataService.getProductTypeValues();

    // Build serviceElementList
    const serviceElementList = [{
      serviceElement: {
        identifier: formValue.serviceElementIdentifier,
        code: formValue.serviceElementCode,
        name: formValue.serviceElementName,
        optionality: formValue.optionality
      }
    }];

    // Build productTypeList
    const productTypeList = productTypeKeys.map((code, index) => ({
      identifier: productTypeValues[index],
      code: code
    }));

    // Final request object
    const serviceElementData = {
      metadataType: 'ServiceElement',
      serviceElementList,
      productTypeList
    };

    const serviceCall = isAdd
      ? this.ServiceElementService.saveServiceElement(serviceElementData)
      : this.ServiceElementService.updateServiceElement(serviceElementData);

    serviceCall.subscribe({
      next: resp => this.successResponse(resp, serviceElementData, isAdd),
      error: (err: NotificationMessage[]) => this.handleError(err, isAdd)
    });

    this.addNewServiceElementFormGroup.controls['serviceElementIdentifier'].disable();
  }

  private getInvalidRequiredFields(formGroup: FormGroup): string[] {
    const invalidFields: string[] = [];

    Object.keys(formGroup.controls).forEach(key => {
      const control = formGroup.get(key);
      if (control && control.errors?.['required']) {
        invalidFields.push(key);
      }
    });

    return invalidFields;
  }

  private successResponse(resp, serviceElementData, isAdd) {
    const serviceElementCode = serviceElementData.serviceElementList[0].serviceElement.code;
    const SuccessMsg = isAdd
      ? `${serviceElementCode} Added successfully`
      : `${serviceElementCode} Updated successfully`;
    this.apiResponse.emit({ ...serviceElementData, SuccessMsg });
  }

  private handleError(error: any, isAdd: boolean) {
    let errorMsg = '';

    if (error.errorCode === 'FORM_INVALID' || error.status === 400) {
      if (error.missingFields?.length) {
        errorMsg = `Please fill the required fields.`;
      } else {
        errorMsg = 'Please fill the required fields.';
      }
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_005") {
      errorMsg = 'Code already exists.';
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_004") {
      errorMsg = error.error?.errorDescription || 'Code already exists.';
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_048") {
      errorMsg = error.error?.errorDescription || 'This Metadata cannot be created.';
    } else {
      errorMsg = 'Unknown error occurred.';
    }

    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };
    this.errorMessages.push(this.message);

    // Auto-remove error messages after 10 seconds
    setTimeout(() => {
      this.errorMessages = this.errorMessages.filter(msg => msg.text !== errorMsg);
    }, 10000);
  }

  onReset(isAdd: boolean): void {
    const isEditMode = this.isEdit;

    // Reset error messages
    this.errorMessages = [];

    // Reset the form
    this.addNewServiceElementFormGroup.reset();
    this.addNewServiceElementFormGroup.markAsPristine();
    this.addNewServiceElementFormGroup.markAsUntouched();

    if (isEditMode) {
      // Restore retained values for edit mode
      this.addNewServiceElementFormGroup.get('serviceElementCode')?.setValue(this.retainedCode);
      this.addNewServiceElementFormGroup.get('serviceElementCode')?.disable();
      this.addNewServiceElementFormGroup.get('serviceElementIdentifier')?.setValue(this.retainedIdentifier);
      this.addNewServiceElementFormGroup.get('serviceElementIdentifier')?.disable();
      this.addNewServiceElementFormGroup.get('serviceElementName')?.setValue(this.retainedName);
      this.addNewServiceElementFormGroup.get('optionality')?.setValue(this.retainedOptionality);
    } else {
      this.addNewServiceElementFormGroup.get('serviceElementCode')?.enable();
      this.addNewServiceElementFormGroup.get('serviceElementIdentifier')?.enable();
    }

    this.changeDetectorRef.detectChanges();
  }

  private serviceElementForm(element: ServiceElementList): void {
    this.isAdd = false;
    this.isEdit = true;

    // Store retained values
    this.retainedCode = element.code || '';
    this.retainedIdentifier = element.identifier || 0;
    this.retainedName = element.name || '';
    this.retainedOptionality = element.optionality || '';

    this.addNewServiceElementFormGroup.patchValue({
      serviceElementIdentifier: element.identifier,
      serviceElementCode: element.code,
      serviceElementName: element.name,
      optionality: element.optionality
    });

    // Disable code field in edit mode
    this.addNewServiceElementFormGroup.get('serviceElementCode')?.disable();
  }
}


























<!-- add-edit-service-element.component.html -->
<bod-message-container [messages]="errorMessages"></bod-message-container>
<bod-form
  [formGroup]="addNewServiceElementFormGroup"
  rufId
  [type]="formType"
  (onSubmit)="onAddNewServiceElement(isAdd)"
  (onReset)="onReset(isAdd)"
  fisStyle
>
  <bod-input-layout col="2">
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.code'"
      [forTextOnly]="true"
      [required]="true"
    >
    <div *ngIf="isEdit">
      {{ addNewServiceElementFormGroup.get('serviceElementCode')?.value }}
    </div>
      <mat-form-field appearance="outline" fisStyle *ngIf="!isEdit">
        <input
          type="text"
          matInput
          fisStyle
          formControlName="serviceElementCode"
          name="serviceElementCode"
        />
        
        <mat-error>
         {{ getError('serviceElementCode', addNewServiceElementFormGroup) | translate }}
        </mat-error> 
        <mat-error *ngIf="addNewServiceElementFormGroup.get('serviceElementCode').hasError('noSpecialCharacters')">
        </mat-error>
      </mat-form-field>
    </bod-control-group>
   
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.name'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <input
          type="text"
          matInput
          fisStyle
          formControlName="serviceElementName"
          name="serviceElementName"
        />
        <mat-error>
          {{ getError('serviceElementName', addNewServiceElementFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>

    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.optionality'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="optionality"
          name="optionality"
        >
          <mat-option
            *ngFor="let optionality of optionalityOptions"
            [value]="optionality.value"
          >
            {{ optionality.label }}
          </mat-option>
        </mat-select>
        <mat-error>
          {{ getError('optionality', addNewServiceElementFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
  </bod-input-layout>
</bod-form>
