<ng-container *ngIf="!['Flag', 'YesNo'].includes(addNewAttributeFormGroup.get('datatype')?.value)">
  <bod-control-group 
    [truncate]="false"
    [label]="translationKey + 'metadataconfig.validtype'"
    [forTextOnly]="true"
    [required]="false"
  >
    <mat-slide-toggle formControlName="validtype" name="validtype">
    </mat-slide-toggle>
  </bod-control-group>
</ng-container>



this.addNewAttributeFormGroup.get('datatype')?.valueChanges.subscribe(() => {
  this.changeDetectorRef.detectChanges();
});
