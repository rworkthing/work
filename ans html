    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    BodCommonModule
  ],
  templateUrl: './edit-paymenttype.component.html',
  styleUrl: './edit-paymenttype.component.scss'
})
export class EditPaymentTypeComponent implements OnInit {
  @Input() editPaymentTypeRow: PaymentTypeList;

  public translationKey = TranslationKey;
  public editPaymentTypeFormGroup: UntypedFormGroup;

  public channelData: ChannelTable[] = [];
  public isChannelTableDirty = false;

  public counterData: CounterTable[] = [];
  public restrictionData: RestrictionTable[] = [];
  public conditionData: ConditionTable[] = [];
  public communicationData: CommunicationTable[] = [];

  public channels: any[] = [];
  public counters: any[] = [];
  public restrictions: any[] = [];
  public conditions: any[] = [];
  public communications: any[] = [];
  public communicationsMasterList: any[] = [];

  @ViewChild('channelsMainTable')
  channelsMainTable: PaymentTypeChannelsMainTableComponent;

  // Retained values for edit mode
  @Input() retainedCode = '';
  @Input() retainedPaymentTypeIdentifier = 0;
  @Input() retainedName = '';
  @Input() retainedChannels: any[] = [];
  @Input() retainedCounters: any[] = [];
  @Input() retainedRestrictions: any[] = [];
  @Input() retainedConditions: any[] = [];
  @Input() retainedCommunicationServices: any[] = [];

  formType: BodFormTypes = BodFormTypes.SUBMIT;
  isEdit = true; // Always in edit mode

  constructor(
    private metadataService: MetadataService,
    private cdr: ChangeDetectorRef,
    private fb: UntypedFormBuilder,
    private http: HttpClient,
    private bodCommonDialogService: BodCommonDialogService,
    private paymentTypeService: PaymentTypeService,
    private transactionTypeService: TransactionTypeService
  ) {}

  ngOnInit() {
    this.initForm();

    // Load all dropdowns first, then call paymentTypeForm
    const dropdownsLoaded$ = [
      this.transactionTypeService.getDeliveryChannel(),
      this.transactionTypeService.getCounters(),
      this.transactionTypeService.getRestrictions(),
      this.transactionTypeService.getConditions(),
      this.transactionTypeService.getCommunicationService()
    ];

    // Use forkJoin to wait for all dropdowns
    import('rxjs').then(rxjs => {
      rxjs.forkJoin(dropdownsLoaded$).subscribe(
        ([channels, counters, restrictions, conditions, communications]) => {
          this.channels = channels.map((item: any) => ({
            label: item.code,
            value: item.identifier
          }));
          this.counters = counters.map((item: any) => ({
            identifier: item.identifier,
            code: item.code,
            classificationType: item.classificationType
          }));
          this.restrictions = restrictions;
          this.conditions = conditions;
          this.communications = communications;
          this.communicationsMasterList = communications;

          // Now safe to call paymentTypeForm
          if (this.editPaymentTypeRow) {
            this.paymentTypeForm(this.editPaymentTypeRow);
          }
        }
      );
    });
  }

  private initForm(): void {
    this.editPaymentTypeFormGroup = this.fb.group({
      code: new UntypedFormControl({ value: '', disabled: true }),
      name: new UntypedFormControl({ value: '', disabled: true }),
      paymentTypeIdentifier: [{ value: '', disabled: true }]
    });
  }

  /**
   * Handle channel table dirty state
   */
  public onChannelTableDirty(): void {
    this.isChannelTableDirty = true;
    this.editPaymentTypeFormGroup.markAsDirty();
  }

  /**
   * Handle channel data changes
   */
  public handleChannelDataChange(data: any) {
    this.channelData = data.channels;
    this.counterData = data.counters;
    this.restrictionData = data.restrictions;
    this.conditionData = data.conditions;
    this.communicationData = data.communications;

    console.log(
      'Received All Counters with Channel Identifier (JSON):\n',
      JSON.stringify(this.counterData, null, 2)
    );
    console.log(
      'Received All Restrictions with Channel Identifier (JSON):\n',
      JSON.stringify(this.restrictionData, null, 2)
    );
    console.log(
      'Received All Conditions with Channel Identifier (JSON):\n',
      JSON.stringify(this.conditionData, null, 2)
    );
    console.log(
      'Received All Communications with Channel Identifier (JSON):\n',
      JSON.stringify(this.communicationData, null, 2)
    );
  }

  /**
   * Get current channel table data
   */
  public getCurrentChannelData(): ChannelTable[] {
    return this.channelsMainTable?.getCurrentTableData() || [];
  }

  onReset(): void {
    console.log('retainedCounters:', JSON.stringify(this.retainedCounters, null, 2));
    console.log('retainedRestrictions:', JSON.stringify(this.retainedRestrictions, null, 2));
    console.log('retainedConditions:', JSON.stringify(this.retainedConditions, null, 2));
    console.log('retainedCommunicationServices:', JSON.stringify(this.retainedCommunicationServices, null, 2));

    this.editPaymentTypeFormGroup.reset();
    this.channelData = [];
    this.counterData = [];
    this.restrictionData = [];
    this.conditionData = [];
    this.communicationData = [];
    this.isChannelTableDirty = false;

    if (this.channelsMainTable) {
      this.channelsMainTable.resetTableForm();
    }

    // Restore retained form values
    this.editPaymentTypeFormGroup.patchValue({
      code: this.retainedCode,
      paymentTypeIdentifier: this.retainedPaymentTypeIdentifier,
      name: this.retainedName
    });

    // Restore channel data
    this.restoreChannelDataFromRetained();

    this.editPaymentTypeFormGroup.markAsPristine();
    this.editPaymentTypeFormGroup.markAsUntouched();
  }

  private restoreChannelDataFromRetained() {
    function dedupeBy<T>(arr: T[], key: (item: T) => string): T[] {
      const seen = new Set<string>();
      return arr.filter(item => {
        const k = key(item);
        if (seen.has(k)) return false;
        seen.add(k);
        return true;
      });
    }

    // Enrich and dedupe retainedCounters
    const enrichedRetainedCounters = dedupeBy(
      (this.retainedCounters || []).map(counter => {
        const counterObj = this.counters?.find(
          c => String(c.identifier) === String(counter.counterIdentifier)
        );
        return {
          id: counter.counterIdentifier,
          code: counterObj ? counterObj.code : String(counter.counterIdentifier),
          identifier: counter.counterIdentifier,
          classificationType: counterObj ? counterObj.classificationType : '',
          operatorType: counter.counterOperationType || '',
          channelidentifier: counter.resourceItemIdentifier
        };
      }),
      c => `${c.channelidentifier}_${c.identifier}`
    );

    // Similar for restrictions, conditions, communications
    const enrichedRetainedRestrictions = dedupeBy(
      (this.retainedRestrictions || []).map(restriction => {
        const restrictionObj = this.restrictions?.find(
          r => String(r.identifier) === String(restriction.restrictionIdentifier)
        );
        return {
          id: restriction.restrictionIdentifier,
          code: restrictionObj ? restrictionObj.code : String(restriction.restrictionIdentifier),
          identifier: restriction.restrictionIdentifier,
          type: restriction.restrictionClassificationType || '',
          channelidentifier: restriction.resourceItemIdentifier
        };
      }),
      r => `${r.channelidentifier}_${r.identifier}`
    );

    const enrichedRetainedConditions = dedupeBy(
      (this.retainedConditions || []).map(condition => {
        const conditionObj = this.conditions?.find(
          c => String(c.identifier) === String(condition.conditionIdentifier)
        );
        return {
          id: condition.conditionIdentifier,
          code: conditionObj ? conditionObj.cdarValue : String(condition.conditionIdentifier),
          identifier: condition.conditionIdentifier,
          relationshipType: condition.optionalityType || '',
          channelidentifier: condition.resourceItemIdentifier
        };
      }),
      c => `${c.channelidentifier}_${c.identifier}`
    );

    const enrichedRetainedCommunicationServices = dedupeBy(
      (this.retainedCommunicationServices || []).map(comm => {
        const commObj = this.communications?.find(
          c => String(c.identifier) === String(comm.commServiceIdentifier)
        );
        const commMaster = this.communicationsMasterList?.find(
          m => String(m.serviceElementIdentifier) === String(comm.serviceElementIdentifier)
        );
        return {
          id: comm.commServiceIdentifier,
          identifier: comm.commServiceIdentifier,
          serviceElement: commMaster ? commMaster.serviceElementCode : '',
          serviceElementCode: comm.serviceElementIdentifier,
          communicationServices: commObj ? commObj.code : String(comm.commServiceIdentifier),
          channelidentifier: comm.resourceItemIdentifier
        };
      }),
      c => `${c.channelidentifier}_${c.identifier}`
    );

    // Rebuild channelData
    let channelIds = (this.retainedChannels || []).map(c => c.resourceItemIdentifier);
    if (!channelIds.includes(0)) {
      channelIds.unshift(0);
    }

    this.channelData = channelIds.map(channelId => {
      const channelObj = this.channels?.find(
        c => String(c.value) === String(channelId)
      );
      const isAllChannel = String(channelId) === '0';
      return {
        id: channelId,
        identifier: String(channelId),
        code: isAllChannel
          ? 'All'
          : channelObj
          ? channelObj.label
          : String(channelId),
        channel: isAllChannel
          ? 'All'
          : channelObj
          ? channelObj.label
          : String(channelId),
        option: '',
        attributeForChannel: '',
        counters: enrichedRetainedCounters.filter(
          c => String(c.channelidentifier) === String(channelId)
        ),
        restrictions: enrichedRetainedRestrictions.filter(
          r => String(r.channelidentifier) === String(channelId)
        ),
        conditions: enrichedRetainedConditions.filter(
          c => String(c.channelidentifier) === String(channelId)
        ),
        communications: enrichedRetainedCommunicationServices.filter(
          c => String(c.channelidentifier) === String(channelId)
        )
      };
    });

    // Restore flat arrays
    this.counterData = [];
    this.restrictionData = [];
    this.conditionData = [];
    this.communicationData = [];
    this.channelData.forEach(channel => {
      if (channel.counters) this.counterData.push(...channel.counters);
      if (channel.restrictions) this.restrictionData.push(...channel.restrictions);
      if (channel.conditions) this.conditionData.push(...channel.conditions);
      if (channel.communications) this.communicationData.push(...channel.communications);
    });

    // Update child tables
    if (this.channelsMainTable && this.channelsMainTable.tableWithSimpleEdit) {
      this.channelsMainTable.tableWithSimpleEdit.datasource.data = [...this.channelData];
    }
  }

  onEditPaymentType() {
    // Force the child to emit the latest data
    this.channelsMainTable?.emitCompleteDelta();

    this.errorMessages = [];

    // Validate that non-All channels have at least one relationship
    const emptyNonAllChannels = (this.channelData || []).filter(channel =>
      (String(channel.id) !== '0' && String(channel.identifier) !== '0') && // Exclude "All"
      (!channel.counters || channel.counters.length === 0) &&
      (!channel.conditions || channel.conditions.length === 0) &&
      (!channel.restrictions || channel.restrictions.length === 0) &&
      (!channel.communications || channel.communications.length === 0)
    );

    if (emptyNonAllChannels.length > 0) {
      this.errorMessages.push({
        code: 'CHANNEL_RELATIONSHIP_REQUIRED',
        text: 'Each channel (other than All) must have at least one Counter, Condition, Restriction, or Communication.',
        type: NotificationMessageType.ERROR
      });
      return;
    }

    const formValue = this.editPaymentTypeFormGroup.getRawValue();
    
    // Get all relationship data
    const productTypeIdentifiers = this.metadataService.getProductTypeValues();

    // Build relationship lists
    const buildList = (arr: any[], keyMap: Record<string, any> = {}) =>
      productTypeIdentifiers
        .map(productTypeIdentifier =>
          (arr || []).map(item => ({
            productTypeIdentifier: productTypeIdentifier ?? null,
            paymentTypeIdentifier: formValue.paymentTypeIdentifier || this.editPaymentTypeRow.identifier,
            ...item,
            resourceItemIdentifier:
              item.resourceItemIdentifier !== undefined
                ? Number(item.resourceItemIdentifier)
                : undefined
          }))
        )
        .reduce((acc, val) => acc.concat(val), []);

    const counterList = buildList(
      this.counterData.map(counter => ({
        resourceItemIdentifier: counter.channelidentifier,
        counterIdentifier: counter.identifier,
        counterOperationType: counter.operatorType
      }))
    );

    const restrictionList = buildList(
      this.restrictionData.map(restriction => ({
        resourceItemIdentifier: restriction.channelidentifier,
        restrictionIdentifier: restriction.identifier,
        restrictionClassificationType: restriction.type
      }))
    );

    const conditionList = buildList(
      this.conditionData.map(condition => ({
        resourceItemIdentifier: condition.channelidentifier,
        conditionIdentifier: condition.identifier,
        cdarValue: condition.code,
        optionalityType: condition.relationshipType
      }))
    );

    const communicationList = buildList(
      this.communicationData.map(communication => {
        const master = this.communicationsMasterList.find(
          m => m.code === communication.communicationServices
        );
        return {
          resourceItemIdentifier: communication.channelidentifier,
          serviceElementIdentifier: master?.serviceElementIdentifier ?? null,
          commServiceIdentifier: communication.identifier
        };
      })
    );

    // Build the payload
    const paymentTypeData = {
      metadataType: 'PaymentType',
      paymentTypeDetailList: [
        {
          paymentType: {
            identifier: formValue.paymentTypeIdentifier || this.editPaymentTypeRow.identifier,
            code: formValue.code || this.editPaymentTypeRow.code,
            name: formValue.name || this.editPaymentTypeRow.name,
            isExisting: "true"
          },
          productTypePaymentTypeDSCDRltnpList: conditionList,
          productTypePaymentTypeDSComsRltnpList: communicationList,
          productTypePaymentTypeDSCounterRltnpList: counterList,
          productTypePaymentTypeDSRestrcitionRltnpList: restrictionList
        }
      ]
    };

    console.log(
      'paymentTypeData(JSON):\n',
      JSON.stringify(paymentTypeData, null, 2)
    );

    // Always use update for edit mode
    this.paymentTypeService.updatePaymentType(paymentTypeData).subscribe({
      next: resp => this.successResponse(resp, paymentTypeData),
      error: (err: NotificationMessage[]) => this.handleError(err)
    });
  }

  @Output() apiResponse: EventEmitter<NotificationMessage[]> = new EventEmitter<
    NotificationMessage[]
  >();

  private successResponse(resp, paymentTypeData) {
    const paymentTypeCode =
      paymentTypeData.paymentTypeDetailList[0].paymentType.code;
    const SuccessMsg = `${paymentTypeCode} Updated successfully`;
    this.apiResponse.emit({ ...paymentTypeData, SuccessMsg });
  }

  public errorMessages: NotificationMessage[] = [];
  public message: NotificationMessage | undefined;

  private handleError(error: any) {
    const errorMsg =
      error?.error?.errorDescription || 'An unexpected error occurred.';
    this.message = {
      code: error?.error?.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };

    if (errorMsg) {
      this.errorMessages.push(this.message);
    }

    setTimeout(() => {
      this.errorMessages = this.errorMessages.filter(
        msg => msg.text !== errorMsg
      );
    }, 20000);
  }

  paymentTypeForm(element: PaymentTypeList) {
    console.log(
      'paymentTypeForm element:',
      JSON.stringify(element, null, 2)
    );

    // Retain basic fields
    this.retainedPaymentTypeIdentifier = element.identifier ?? 0;
    this.retainedCode = element.code || '';
    this.retainedName = element.name || '';

    // Retain relationship lists
    const allResourceItems = [
      ...(element.productTypePaymentTypeDSCounterRltnp || []),
      ...(element.productTypePaymentTypeDSRestrcitionRltnp || []),
      ...(element.productTypePaymentTypeDSCDRltnpList || []),
      ...(element.productTypePaymentTypeDSComsRltnp || [])
    ].map(rel => rel.resourceItemIdentifier);

    this.retainedChannels = Array.from(new Set(allResourceItems)).map(id => ({ resourceItemIdentifier: id }));

    // Always keep resourceItemIdentifier: 0 at the top
    this.retainedChannels.sort((a, b) => {
      if (a.resourceItemIdentifier === 0) return -1;
      if (b.resourceItemIdentifier === 0) return 1;
      return 0;
    });

    this.retainedCounters = element.productTypePaymentTypeDSCounterRltnp || [];
    this.retainedRestrictions = element.productTypePaymentTypeDSRestrcitionRltnp || [];
    this.retainedConditions = element.productTypePaymentTypeDSCDRltnpList || [];
    this.retainedCommunicationServices = element.productTypePaymentTypeDSComsRltnp || [];

    console.log('retainedChannels:', JSON.stringify(this.retainedChannels, null, 2));
    console.log('retainedCounters:', JSON.stringify(this.retainedCounters, null, 2));
    console.log('retainedRestrictions:', JSON.stringify(this.retainedRestrictions, null, 2));
    console.log('retainedConditions:', JSON.stringify(this.retainedConditions, null, 2));
    console.log('retainedCommunicationServices:', JSON.stringify(this.retainedCommunicationServices, null, 2));

    // Patch form values
    this.editPaymentTypeFormGroup.patchValue({
      code: element.code,
      paymentTypeIdentifier: element.identifier,
      name: element.name
    });

    // Build channelData with nested relationships
    const channelIds = new Set<string | number>();
    [
      ...(element.productTypePaymentTypeDSCounterRltnp || []),
      ...(element.productTypePaymentTypeDSRestrcitionRltnp || []),
      ...(element.productTypePaymentTypeDSCDRltnpList || []),
      ...(element.productTypePaymentTypeDSComsRltnp || [])
    ].forEach(rel => {
      if (rel.resourceItemIdentifier !== undefined && rel.resourceItemIdentifier !== null) {
        channelIds.add(rel.resourceItemIdentifier);
      }
    });
    
    // Always ensure "All" channel (id 0) is present
    channelIds.add(0);

    function dedupeBy<T>(arr: T[], key: (item: T) => string | number): T[] {
      const seen = new Set<string | number>();
      return arr.filter(item => {
        const k = key(item);
        if (seen.has(k)) return false;
        seen.add(k);
        return true;
      });
    }

    this.channelData = Array.from(channelIds).map(channelIdRaw => {
      const channelId = typeof channelIdRaw === 'string' ? Number(channelIdRaw) : channelIdRaw;
      let channelLabel =
        this.channels.find(c => String(c.value) === String(channelId))?.label ?? channelId;
      if (channelId === 0) channelLabel = 'All';

      // Map counters (deduplicate by counterIdentifier)
      const countersForChannel = dedupeBy(
        (element.productTypePaymentTypeDSCounterRltnp || [])
          .filter(c => Number(c.resourceItemIdentifier) === channelId)
          .map(counter => {
            const counterObj = this.counters?.find(
              c => String(c.identifier) === String(counter.counterIdentifier)
            );
            return {
              id: Number(counter.counterIdentifier),
              code: counterObj ? counterObj.code : String(counter.counterIdentifier),
              identifier: counter.counterIdentifier,
              classificationType: counterObj ? counterObj.classificationType : '',
              operatorType: counter.counterOperationType || '',
              channelidentifier: counter.resourceItemIdentifier
            };
          }),
        c => c.identifier
      );

      // Map restrictions (deduplicate by restrictionIdentifier)
      const restrictionsForChannel = dedupeBy(
        (element.productTypePaymentTypeDSRestrcitionRltnp || [])
          .filter(r => Number(r.resourceItemIdentifier) === channelId)
          .map(restriction => {
            const restrictionObj = this.restrictions?.find(
              r => String(r.identifier) === String(restriction.restrictionIdentifier)
            );
            return {
              id: Number(restriction.restrictionIdentifier),
              code: restrictionObj ? restrictionObj.code : String(restriction.restrictionIdentifier),
              identifier: restriction.restrictionIdentifier,
              type: restriction.restrictionClassificationType || '',
              channelidentifier: restriction.resourceItemIdentifier
            };
          }),
        r => r.identifier
      );

      // Map conditions (deduplicate by conditionIdentifier)
      const conditionsForChannel = dedupeBy(
        (element.productTypePaymentTypeDSCDRltnpList || [])
          .filter(cond => Number(cond.resourceItemIdentifier) === channelId)
          .map(condition => {
            const conditionObj = this.conditions?.find(
              c => String(c.identifier) === String(condition.conditionIdentifier)
            );
            return {
              id: Number(condition.conditionIdentifier),
              code: conditionObj ? conditionObj.cdarValue : String(condition.conditionIdentifier),
              identifier: condition.conditionIdentifier,
              relationshipType: condition.optionalityType || '',
              channelidentifier: condition.resourceItemIdentifier
            };
          }),
        c => c.identifier
      );

      // Map communications (deduplicate by commServiceIdentifier)
      const communicationsForChannel = dedupeBy(
        (element.productTypePaymentTypeDSComsRltnp || [])
          .filter(comm => Number(comm.resourceItemIdentifier) === channelId)
          .map(comm => {
            const commObj = this.communications?.find(
              c => String(c.identifier) === String(comm.commServiceIdentifier)
            );
            const commMaster = this.communicationsMasterList?.find(
              c => String(c.serviceElementIdentifier) === String(comm.serviceElementIdentifier)
            );
            return {
              id: Number(comm.commServiceIdentifier),
              identifier: comm.commServiceIdentifier,
              serviceElement: commMaster ? commMaster.serviceElementCode : '',
              serviceElementCode: comm.serviceElementIdentifier,
              communicationServices: commObj ? commObj.code : String(comm.commServiceIdentifier),
              channelidentifier: comm.resourceItemIdentifier
            };
          }),
        c => c.identifier
      );

      return {
        id: channelId,
        identifier: String(channelId),
        code: channelLabel,
        channel: channelLabel,
        option: '',
        attributeForChannel:
          restrictionsForChannel.length > 0
            ? 'Restrictions'
            : countersForChannel.length > 0
            ? 'Counters'
            : conditionsForChannel.length > 0
            ? 'Conditions'
            : communicationsForChannel.length > 0
            ? 'CommunicationServices'
            : '',
        counters: countersForChannel,
        restrictions: restrictionsForChannel,
        conditions: conditionsForChannel,
        communications: communicationsForChannel
      } as ChannelTable;
    })
    // Sort so "All" channel is always first
    .sort((a, b) => {
      if (String(a.id) === '0') return -1;
      if (String(b.id) === '0') return 1;
      return 0;
    });

    // Populate flat arrays for child tables
    this.counterData = [];
    this.restrictionData = [];
    this.conditionData = [];
    this.communicationData = [];
    this.channelData.forEach(channel => {
      if (channel.counters) this.counterData.push(...channel.counters);
      if (channel.restrictions) this.restrictionData.push(...channel.restrictions);
      if (channel.conditions) this.conditionData.push(...channel.conditions);
      if (channel.communications) this.communicationData.push(...channel.communications);
    });

    // Update child tables/maps if needed
    if (this.channelsMainTable) {
      if (this.channelsMainTable.tableWithSimpleEdit) {
        this.channelsMainTable.tableWithSimpleEdit.datasource.data = [...this.channelData];
      }
      // Set up maps for nested tables
      this.channelsMainTable.counterMap = {};
      this.channelsMainTable.conditionMap = {};
      this.channelsMainTable.restrictionMap = {};
      this.channelsMainTable.communicationMap = {};
      (this.channelData || []).forEach(row => {
        if (row.id !== undefined && Array.isArray(row.counters)) {
          this.channelsMainTable.counterMap[row.id] = [...row.counters];
        }
        if (row.id !== undefined && Array.isArray(row.conditions)) {
          this.channelsMainTable.conditionMap[row.id] = [...row.conditions];
        }
        if (row.id !== undefined && Array.isArray(row.restrictions)) {
          this.channelsMainTable.restrictionMap[row.id] = [...row.restrictions];
        }
        if (row.id !== undefined && Array.isArray(row.communications)) {
          this.channelsMainTable.communicationMap[row.id] = [...row.communications];
        }
      });
    }

    // Log for debugging
    console.log('Updated channelData:', JSON.stringify(this.channelData, null, 2));
    console.log('Updated counterData:', JSON.stringify(this.counterData, null, 2));
    console.log('Updated restrictionData:', JSON.stringify(this.restrictionData, null, 2));
    console.log('Updated conditionData:', JSON.stringify(this.conditionData, null, 2));
    console.log('Updated communicationData:', JSON.stringify(this.communicationData, null, 2));
  }

  public getError(control: string, formGroup: UntypedFormGroup): string {
    if (formGroup) {
      const fc: AbstractControl = formGroup.get(control);
      if (fc && fc.errors && fc.touched) {
        return FormUtilityService.getCommonFCErrorMsg(fc);
      }
    }
  }
}

























