<bod-page-container [title]="'Editable Table'" [pageMode]="pageModeSimple" (pageAction)="onPageAction($event)" [messages]="messages" *ngIf="showEdit">
  <bod-table [data]="tableWithSimpleEdit" [tableActions]="actionsForSimple" [modeOptions]="modeOptionsSimple" [singleRowEdit]="singleRowEdit" [customColumnTemplates]="customColumnTemplates" (inputValidationStatus)="checkStatus($event)" (editTableEvent)="onEditTableAction($event)" (onTableActionClick)="addTableData()" [primaryColumnName]="'id'" #simpleEditTableRef>
    <ng-template #editActionsTemplate let-element="element" let-column="column" let-index="index">
      <div *ngIf="!singleRowEdit.modeOptions?.input || (singleRowEdit?.modeOptions?.input && singleRowEdit?.index !== index)">
        <bod-table-actions [actions]="rowLevelActionsForBasicEdit" (onActionClick)="handleRowLevelActions($event.icon, index)"></bod-table-actions>
      </div>
      <div *ngIf="singleRowEdit?.modeOptions?.input && singleRowEdit?.index === index">
        <button matTooltip="Save" [matTooltipPosition]="'below'" mat-mini-fab color="primary" (click)="handleRowLevelActions('save', index)">
          <mat-icon>check</mat-icon>
        </button>
        <button mat-icon-button matTooltip="Cancel" [matTooltipPosition]="'below'" class="ruf-ghost-button" (click)="handleRowLevelActions('reset', index)">
          <mat-icon>close</mat-icon>
        </button>
      </div>
    </ng-template>
    <ng-template #inputTemplate let-element="element" let-column="column" let-index="index">
      <ng-container *ngIf="modeOptionsSimple.input || (singleRowEdit?.modeOptions?.input && singleRowEdit?.index === index)">
        <input [(ngModel)]="element[column.name]" [placeholder]="column.title">
      </ng-container>
      <ng-container *ngIf="!modeOptionsSimple.input && (!singleRowEdit?.modeOptions?.input || (singleRowEdit?.modeOptions?.input && singleRowEdit?.index !== index))">
        <div>{{ element[column.name] }}</div>
      </ng-container>
    </ng-template>
  </bod-table>
  <div *ngIf="modeOptionsSimple.input" class="editPageOptions">
    <button mat-raised-button type="button" color="primary" (click)="saveTableData()" [disabled]="!simpleEditTableRef.tableFormGroup.dirty">Save</button>
    <button mat-stroked-button type="button" (click)="reset()">Reset</button>
  </div>
</bod-page-container>
