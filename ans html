import { Injectable } from '@angular/core';
import { HttpClient, HttpHeaders } from '@angular/common/http';
import { Column, InquiryLayoutInput, UIContextService } from '@bod/common';
import { BehaviorSubject, Observable, tap } from 'rxjs';
import { PaymentTypeList } from './payment-type.model';
import { DataSharingService } from '../../data-sharing-service.service';

@Injectable({
  providedIn: 'root'
})
export class PaymentTypeService {
  public columns: Column[] = [
    {
      name: 'code',
      title: 'Payment Type Code',
      truncate: true,
      noOverflow: true,
      width: 20,
      widthUnit: 'rem'
    },
    {
      name: 'name',
      title: 'Name',
      truncate: true,
      noOverflow: true,
      width: 15,
      widthUnit: 'rem'
    },
    {
      name: 'actions',
      title: ' ',
      hasAction: true
    }
  ];

  private baseUrl = '';
  private saveUrl = '';
  private updateUrl = '';
  private retrieveUrl = '';
  private deleteUrl = '';
  private retrieveAllUrl = '';
  private currentStatus: string = 'NEW';
  
  private reqDfnId = '';
  private clientCode = '';
  private countryCode = '';
  private productLines: any[] = [];
  private productTypes: any[] = [];
  private productTypeValues: number[] = [];
  private businessProductLine: any[] = [];

  constructor(
    private http: HttpClient,
    private uiContextService: UIContextService,
    private readonly dataSharingService: DataSharingService
  ) {
    let url = this.uiContextService.getModuleDataById('fis.nextgen.sdkit').valueMap.sdkServiceUrl.value;

    this.dataSharingService.data$.subscribe(data => {
      if (data) {
        this.reqDfnId = data.reqDfnId;
        this.businessProductLine = data.reqDfnResponseDTO.businessProductLine;
        this.countryCode = data.countryCode;
        this.clientCode = data.countryCode;
        this.productLines = [...new Set(this.businessProductLine.map(obj => obj.value))];
        this.productTypes = [...new Set(this.businessProductLine.map(obj => obj.type))];
        
        if (data.identifier) {
          try {
            const parsedIdentifiers: { key: string; value: number }[] = JSON.parse(data.identifier);
            this.productTypeValues = parsedIdentifiers.map((item: { key: string; value: number }) => item.value);
          } catch (e) {
            console.error('Failed to parse identifier JSON:', e);
          }
        }

        this.saveUrl = url + '/metadata/create/' + this.reqDfnId;
        this.updateUrl = url + '/metadata/update/' + this.reqDfnId;
        this.retrieveUrl = url + '/metadata/retrieve/' + this.reqDfnId + '?metadata-config-type=PaymentType';
        this.deleteUrl = url + '/metadata/delete/' + this.reqDfnId;
        this.baseUrl = url ?? '';
        this.retrieveAllUrl = url + '/metadata/retrieve/' + this.reqDfnId;
      }
    });
  }

  retrieveAll(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<any[]>(this.retrieveAllUrl, { headers }).pipe(
      tap((response: any) => {
        const firstStatus = response?.data && response.data.length > 0 && response.data[0]?.MetadataStatus
          ? response.data[0].MetadataStatus
          : 'NEW';
        this.currentStatus = firstStatus;
      })
    );
  }

  updateCurrentStatus(status: string): void {
    this.currentStatus = status;
  }

  private getCreateUrlWithStatus(status: string): string {
    return `${this.baseUrl}/metadata/create/${this.reqDfnId}?status=${status}`;
  }

  savePaymentType(request: any, status?: string): Observable<any> {
    const headers = this.createHeaders();
    const statusToUse = status || this.currentStatus;
    const url = this.getCreateUrlWithStatus(statusToUse);
    return this.http.post(url, request, { headers });
  }

  updatePaymentType(request: any): Observable<any> {
    const headers = this.createHeaders();
    return this.http.put(this.updateUrl, request, { headers });
  }

  deletePaymentType(metadataConfigType: string, metadataConfigIdfr: number): Observable<any> {
    const headers = this.createHeaders();
    const params = {
      'metadata-config-type': metadataConfigType,
      'metadata-config-idfr': metadataConfigIdfr
    };
    return this.http.delete(this.deleteUrl, { headers, params });
  }

  retrievePaymentType(): Observable<any> {
    const headers = this.createHeaders();
    return this.http.get<PaymentTypeList[]>(this.retrieveUrl, { headers });
  }

  createHeaders(): HttpHeaders {
    return new HttpHeaders({
      'country-code': this.countryCode,
      'client-code': this.clientCode,
      'product-line': this.productLines,
      fe_id: this.uiContextService.getTenantId(),
      'user-id': this.uiContextService.getUserProfile().userId?.toString(),
      uuid: this.generateUUID(),
      'requirement-id': this.reqDfnId
    });
  }

  generateUUID(): string {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
      const r = (Math.random() * 16) | 0,
        v = c === 'x' ? r : (r & 0x3) | 0x8;
      return v.toString(16);
    });
  }

  public getProductTypeValues(): number[] {
    return this.productTypeValues;
  }

  public getPaymentTypeData(element: PaymentTypeList): Observable<InquiryLayoutInput[]> {
    const groups: InquiryLayoutInput[] = [];
    let setIsLink = false;
    for (let i = 0; i < element.paymentTypeInquiry.length; i++) {
      groups.push({
        id: element.paymentTypeInquiry[i].id,
        label: element.paymentTypeInquiry[i].label,
        value: element.paymentTypeInquiry[i].value,
        isLink: setIsLink
      });
    }
    const $groups = new BehaviorSubject<InquiryLayoutInput[]>(groups);
    return $groups;
  }

  // Initialize default payment types
  public getDefaultPaymentTypes(): PaymentTypeList[] {
    return [
      {
        identifier: 1,
        code: 'Credit',
        name: 'Credit Payment Type',
        paymentTypeInquiry: [
          { id: 0, label: 'Code', value: 'Credit' },
          { id: 1, label: 'Name', value: 'Credit Payment Type' }
        ],
        productTypePaymentTypeDSCounterRltnp: [],
        productTypePaymentTypeDSRestrcitionRltnp: [],
        productTypePaymentTypeDSCDRltnpList: [],
        productTypePaymentTypeDSComsRltnp: []
      },
      {
        identifier: 2,
        code: 'Debit',
        name: 'Debit Payment Type',
        paymentTypeInquiry: [
          { id: 0, label: 'Code', value: 'Debit' },
          { id: 1, label: 'Name', value: 'Debit Payment Type' }
        ],
        productTypePaymentTypeDSCounterRltnp: [],
        productTypePaymentTypeDSRestrcitionRltnp: [],
        productTypePaymentTypeDSCDRltnpList: [],
        productTypePaymentTypeDSComsRltnp: []
      }
    ];
  }
}

















<bod-message-container rufId [messages]="messages"></bod-message-container>

<bod-table
  #customTable
  [customColumnTemplates]="[
    {
      columnName: 'actions',
      templateName: editActionTemplate
    }
  ]"
  [data]="PaymentTypeMetaData"
  [tableActions]="isStatusEditable() ? paymentTypeTableActions : []"
  [expandedRowTemplate]="expandedRowTemplate"
  (onRowExpand)="rowExpanded($event)"
>
  <ng-template
    #editActionTemplate
    let-element="element"
    let-column="column"
    let-index="index"
  >
    <bod-table-actions
      sectionActions
      [actions]="isStatusEditable() ? editactions : []"
      (onActionClick)="isStatusEditable() && iconActionClicked($event, element)"
    >
    </bod-table-actions>
  </ng-template>
  
  <ng-template #expandedRowTemplate let-context="context">
    <div fullwidth>
      
        <bod-inquiry-layout
          [columns]="2"
          [groups]="paymentTypeService.getPaymentTypeData(context.element)"
          [softSeparator]="false"
          [direction]="direction"
          [information]="[]"
          (linkClick)="commonDataService.inquiryLayoutClick($event)"
        >
        </bod-inquiry-layout>

        <h1>Channel Configuration</h1>
        <!-- Display channel data similar to transaction category -->
        <ng-container>
          <bod-table
            [data]="getChannelsTableForPaymentType(context.element)"
            [alignContent]="'top'"
            [innerTableContext]="context"
            [expandedRowTemplate]="expandedChannelRowTemplate"
          >
          </bod-table>
        </ng-container>
      
    </div>
  </ng-template>
   <ng-template #expandedChannelRowTemplate
    let-channel="element"
    let-context="context"
  >
    <div style="margin-left: 32px">
      <bod-table
        *ngIf="context.element?.counters?.length"
        [data]="getCountersTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
      <bod-table
        *ngIf="context.element?.restrictions?.length"
        [data]="getRestrictionsTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
      <bod-table
        *ngIf="context.element?.conditions?.length"
        [data]="getConditionsTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
      <bod-table
        *ngIf="context.element?.communications?.length"
        [data]="getCommunicationsTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
    </div>
  </ng-template>
</bod-table>

<ng-template #editPaymentTypeTemplate>
  <bod-edit-paymenttype
    (apiResponse)="editPaymentTypeEvent($event)"
    [editPaymentTypeRow]="editPaymentType"
  ></bod-edit-paymenttype>
</ng-template>

















import {
  Component,
