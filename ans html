<div *ngFor="let control of inputArray.controls; let i = index">
  <mat-form-field>
    <input matInput [formControl]="control" placeholder="Enter value">
    <button mat-icon-button color="warn" (click)="removeInputField(i)">
      <mat-icon>delete</mat-icon>
    </button>
  </mat-form-field>
</div>
