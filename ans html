    this.counterMap = {};
    this.restrictionMap = {};
    this.conditionMap = {};
    this.communicationMap = {};
    
    this.currentExpandedChannelId = null;
  }

  private updateChannelTable() {
    this.tableWithSimpleEdit.datasource.data = [...this.channelData];
  }
