public addTableData() {
  // Add a new row with empty/default values
  const newRow = {
    locale: '',
    displayName: '',
    description: ''
  };

  // Add the row to the table
  this.simpleEditTableRef.addRow(newRow);

  // Set up edit mode for the newly added row
  const newIndex = this.tableWithSimpleEdit.datasource.data.length - 1;
  this.singleRowEdit = {
    modeOptions: { input: true, reset: false },
    index: newIndex
  };
  this.pageModeSimple = PageMode.NONE;
}
