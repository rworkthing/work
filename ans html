  private deleteChannel(index: number) {
    const currentData = [...this.tableWithSimpleEdit.datasource.data];
    const channelToDelete = currentData[index];
    
    if (channelToDelete) {
      // Remove from maps
      delete this.counterMap[channelToDelete.id];
      delete this.restrictionMap[channelToDelete.id];
      delete this.conditionMap[channelToDelete.id];
      delete this.communicationMap[channelToDelete.id];
      
      currentData.splice(index, 1);
      this.tableWithSimpleEdit.datasource.data = currentData;
      
      this.emitCompleteDelta();
      this.tableDirty.emit();
    }
  }

