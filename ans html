else if ($event === 'save') {
  this.singleRowEdit = {
    modeOptions: { input: false, reset: false },
    index: 0
  };
  this.pageModeSimple = PageMode.INQUIRY;
  this.rowLevelActionsForBasicEdit[0].disabled = false;

  // 💡 Type cast and check values
  const updatedRow = this.translationObject as BodLocaleTable;
  const allRows = this.tableWithSimpleEdit.datasource.data as BodLocaleTable[];

  console.log('%c📝 DEBUG: translationObject:', 'color: cyan', updatedRow);
  console.log('%c📋 DEBUG: All Rows Before Update:', 'color: orange', [...allRows]);

  // 🛠 Match and update row
  const existingIndex = allRows.findIndex(row => row.id === updatedRow.id);

  if (existingIndex !== -1) {
    console.log(`🔄 Updating row at index ${existingIndex}`);
    allRows[existingIndex] = { ...updatedRow };
  } else {
    console.warn('⚠️ Row not found, pushing new one:', updatedRow);
    allRows.push(updatedRow);
  }

  this.translationObjectsArray = [...allRows];

  console.log('%c✅ DEBUG: Final translationObjectsArray to emit:', 'color: green', this.translationObjectsArray);

