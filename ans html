@Component({
  selector: 'bod-edit-paymenttype',
  standalone: true,
  imports: [
    PaymentTypeChannelsMainTableComponent,
    MatRadioModule,
    CommonModule,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
