  public getError(control: string, formGroup: UntypedFormGroup): string {
    if (formGroup) {
      const fc: AbstractControl = formGroup.get(control);
      if (fc && fc.errors && fc.touched) {
        return FormUtilityService.getCommonFCErrorMsg(fc);
      }
    }
    return '';
  }

  private showError(message: string) {
    this.errorMessages = [{
      code: 'VALIDATION_ERROR',
      text: message,
      type: NotificationMessageType.ERROR
    }];
    
    setTimeout(() => {
      this.errorMessages = [];
    }, 5000);
  }

  public getCurrentTableData(): ChannelTable[] {
    return this.tableWithSimpleEdit.datasource.data as ChannelTable[];
  }

  public emitCompleteDelta() {
    const channels = this.getCurrentTableData();
    const allCounters: CounterTable[] = [];
    const allRestrictions: RestrictionTable[] = [];
    const allConditions: ConditionTable[] = [];
    const allCommunications: CommunicationTable[] = [];

    // Collect all data from maps
    Object.keys(this.counterMap).forEach(channelId => {
      allCounters.push(...this.counterMap[channelId]);
    });

    Object.keys(this.restrictionMap).forEach(channelId => {
      allRestrictions.push(...this.restrictionMap[channelId]);
    });

    Object.keys(this.conditionMap).forEach(channelId => {
      allConditions.push(...this.conditionMap[channelId]);
    });

    Object.keys(this.communicationMap).forEach(channelId => {
      allCommunications.push(...this.communicationMap[channelId]);
    });

    const deltaData = {
      channels,
      counters: allCounters,
      restrictions: allRestrictions,
      conditions: allConditions,
      communications: allCommunications
    };

    this.completeDeltaChange.emit(deltaData);
    this.channelDetails.emit(deltaData);
  }

  public resetTableForm() {
