// Extract all categoryIdentifiers and join them as a comma-separated string
const categoryValues = productTypeRoleTypeCatRelationshipList
    .map(categoryValRelationship => categoryValRelationship.categoryIdentifier)
    .join(', ');

// Create a single entry in roleCategory with the combined category values
const roleCategoryMapped = categoryValues
    ? [{ id: 0, label: "Category", value: categoryValues }]
    : [];
