              <bod-table
                #localetable
                [data]="tableWithSimpleEdit"
                [modeOptions]="modeOptions"
                [tableActions]="balanceHoldsTableActions1"
                (onTableActionClick)="onLocaleTableActionClicked($event)"
                [primaryColumnName]="'id'"
                [truncateAfterLine]="1"
                (onInlineFormAddSubmit)="inlineFormAddSubmit($event, 0)"
                (onInlineFormEditSubmit)="inlineFormEditSubmit($event, 0)"
                (onInlineEditRowActionClick)="inlineEditRowActionClick($event)"
                (onInlineAddRowActionClick)="inlineAddRowActionClick(0)"
                [customColumnTemplates]="[
                  {
                    columnName: 'locale',
                    templateName: localeTemplate1
                  },
                  {
                    columnName: 'displayName',
                    templateName: displayName1
                  },
                  {
                    columnName: 'description',
                    templateName: descriptionTemplate1
                  },
                  {
                    columnName: 'actionBtns',
                    templateName: actionBtnsTemplate
                  }
                ]"
              >
                <ng-template
                  #localeTemplate1
                  let-element="element"
                  let-column="column"
                  let-index="index"
                >
                  <form [formGroup]="inputLocaleLayoutFormLocale">
                    <bod-input-layout col="1">
                      <mat-form-field appearance="outline" fisStyle>
                        <mat-select
                          panelClass="fis-style"
                          [formControl]="
                            inputLocaleLayoutFormLocale.controls[
                              useExistingFormCtrlKeysLocale[index]
                            ]
                          "
                          name="localeCode"
                        >
                          <mat-option
                            *ngFor="let localeCode of localeCodes"
                            value="{{ localeCode.value }}"
                          >
                            {{ localeCode.label }}
                          </mat-option>
                        </mat-select>
                      </mat-form-field>
                    </bod-input-layout>
                  </form>
                </ng-template>

                <ng-template
                  #displayName1
                  let-element="element"
                  let-column="column"
                  let-index="index"
                >
                  <ng-container>
                    <form [formGroup]="inputLocaleLayoutFormDisplayName">
                      <mat-form-field appearance="outline" fisStyle>
                        <input
                          type="text"
                          matInput
                          fisStyle
                          [formControl]="
                            inputLocaleLayoutFormDisplayName.controls[
                              useExistingFormCtrlKeysDisplayName[index]
                            ]
                          "
                          name="displayName"
                        />
                      </mat-form-field>
                    </form>
                  </ng-container>
                </ng-template>

                <ng-template
                  #descriptionTemplate1
                  let-element="element"
                  let-column="column"
                  let-index="index"
                >
                  <ng-container>
                    <form [formGroup]="inputLocaleLayoutFormDesc">
                      <mat-form-field appearance="outline" fisStyle>
                        <input
                          type="text"
                          matInput
                          fisStyle
                          [formControl]="
                            inputLocaleLayoutFormDesc.controls[
                              useExistingFormCtrlKeysDesc[index]
                            ]
                          "
                          name="description"
                        />
                      </mat-form-field>
                    </form>
                  </ng-container>
                </ng-template>

                <ng-template
                  #actionBtnsTemplate
                  let-element="element"
                  let-column="column"
                  let-index="index"
                >
                  <bod-table-actions
                    [actions]="rowLevelActionsForlocaleEdit"
                    (onActionClick)="
                      handleRowLevelActionsforlocale($event.icon, index)
                    "
                  >
                  </bod-table-actions>
                </ng-template>
              </bod-table>
