          (onTableActionClick)="onTableActionClicked($event)"
          (onInlineFormAddSubmit)="inlineFormAddSubmit($event, 1)"
          (onInlineFormEditSubmit)="inlineFormEditSubmit($event, 1)"
          (onInlineEditRowActionClick)="inlineEditRowActionClick($event)"
          (onInlineAddRowActionClick)="inlineAddRowActionClick(1)"
          (editColumnViewEvent)="
            handleTableWithViewsEvent(
              $event,
              'Selected views',
              'Views available'
            )
          "
          (editColumnListEvent)="
            handleTableWithViewsEvent(
              $event,
              'ListBuilder view',
              'ListBuilder Delta'
            )
          "
          (viewChangeEvent)="
            handleTableWithViewsEvent($event, 'Current view', 'Current view')
          "
          (viewLoadEvent)="
            handleTableWithViewsEvent(
              $event,
              'Current view',
              'Current view',
              'Table with Input Views tab'
            )
          "
        >
        </bod-table>
