<bod-page-container title="Metadata Configurations"></bod-page-container>
<section demo fullWidth>
  <mat-tab-group fisStyle mat-stretch-tabs="false" tableDemoTabGroug>
    <mat-tab label="{{ 'BOD.metadataconfig.attributes' | translate }}">
      <bod-message-container
        rufId
        [messages]="messages"
      ></bod-message-container>
      <!-- Add Edit Form For Account Relationship-->
      <bod-table
        #customTable
        [customColumnTemplates]="[
          {
            columnName: 'actions',
            templateName: editActionTemplate
          }
        ]"
        [data]="balanceHoldsTableMetaData"
        [tableActions]="balanceHoldsTableActions"
        (onTableActionClick)="onTableActionClicked($event)"
        [expandedRowTemplate]="expandedRowTemplate"
        (onRowExpand)="rowExpanded($event)"
        (editColumnViewEvent)="
          handleTableWithViewsEvent($event, 'Selected views', 'Views available')
        "
        (editColumnListEvent)="
          handleTableWithViewsEvent(
            $event,
            'ListBuilder view',
            'ListBuilder Delta'
          )
        "
        (viewChangeEvent)="
          handleTableWithViewsEvent($event, 'Current view', 'Current view')
        "
        (viewLoadEvent)="
          handleTableWithViewsEvent(
            $event,
            'Current view',
            'Current view',
            'Table with Input Views tab'
          )
        "
      >
        <ng-template #expandedRowTemplate let-context="context">
          <div fullwidth>
            @if(context.element.objectTypeIdentifier){
            <h1>Additional Datatype</h1>
            <bod-inquiry-layout
              [columns]="2"
              [groups]="commonDataService.getExpandedData(context.element)"
              [softSeparator]="false"
              [direction]="direction"
              [information]="[]"
              (linkClick)="commonDataService.inquiryLayoutClick($event)"
            >
            </bod-inquiry-layout>

            <bod-table
              [data]="AttributeLocalTable"
              [alignContent]="'top'"
              [innerTableContext]="context"
              [expandedRowTemplate]="expandedRowTemplateTable"
            >
            </bod-table>
            }
            <h1>Product Type Relationship</h1>
            <bod-inquiry-layout
              [columns]="2"
              [groups]="commonDataService.getPrdReltData(context.element)"
              [softSeparator]="false"
              [direction]="direction"
              [information]="[]"
              (linkClick)="commonDataService.inquiryLayoutClick($event)"
            >
            </bod-inquiry-layout>
            <bod-table
              [data]="productRelationTable"
              [alignContent]="'top'"
              [innerTableContext]="context"
              [expandedRowTemplate]="expandedRowTemplateTable"
            >
            </bod-table>
          </div>
        </ng-template>
      </bod-table>
      <ng-template
        #editActionTemplate
        let-element="element"
        let-column="column"
        let-index="index"
      >
        <bod-table-actions
          sectionActions
          [actions]="editactions"
          (onActionClick)="iconActionClicked($event, element)"
        >
        </bod-table-actions>
      </ng-template>
