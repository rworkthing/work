<bod-message-container rufId [messages]="messages"></bod-message-container>

<bod-table
  #customTable
  [customColumnTemplates]="[
    {
      columnName: 'actions',
      templateName: editActionTemplate
    }
  ]"
  [data]="TransactionCategoryMetaData"
  [tableActions]="isStatusEditable() ? transactionCategoryTableActions : []"
  (onTableActionClick)="isStatusEditable() && onTableActionClicked1($event)"
  [expandedRowTemplate]="expandedRowTemplate"
  (onRowExpand)="rowExpanded($event)"
>
  <ng-template
    #editActionTemplate
    let-element="element"
    let-column="column"
    let-index="index"
  >
    <bod-table-actions
      sectionActions
      [actions]="isStatusEditable() ? editactions : []"
      (onActionClick)="isStatusEditable() && iconActionClicked($event, element)"
    >
    </bod-table-actions>
  </ng-template>
  
  <ng-template #expandedRowTemplate let-context="context">
    <div fullwidth>
      
        <bod-inquiry-layout
          [columns]="2"
          [groups]="transactionCategoryService.getTransactionCategoryData(context.element)"
          [softSeparator]="false"
          [direction]="direction"
          [information]="[]"
          (linkClick)="commonDataService.inquiryLayoutClick($event)"
        >
        </bod-inquiry-layout>

        <h1>Channel Configuration</h1>
        <!-- Display channel data similar to transaction type -->
        <ng-container>
          <bod-table
            [data]="getChannelsTableForCategory(context.element)"
            [alignContent]="'top'"
            [innerTableContext]="context"
            [expandedRowTemplate]="expandedChannelRowTemplate"
          >
          </bod-table>
        </ng-container>
      
    </div>
  </ng-template>
   <ng-template #expandedChannelRowTemplate
    let-channel="element"
    let-context="context"
  >
    <div style="margin-left: 32px">
      <bod-table
        *ngIf="context.element?.counters?.length"
        [data]="getCountersTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
      <bod-table
        *ngIf="context.element?.restrictions?.length"
        [data]="getRestrictionsTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
      <bod-table
        *ngIf="context.element?.conditions?.length"
        [data]="getConditionsTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
      <bod-table
        *ngIf="context.element?.communications?.length"
        [data]="getCommunicationsTableForChannel(context.element)"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplateTable"
      ></bod-table>
    </div>
  </ng-template>

