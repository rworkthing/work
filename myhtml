<bod-form
  [formGroup]="addExistingRoleTypeFormGroup"
  rufId
  [type]="formType"
  (onSubmit)="onExistingRoleType()"
  fisStyle
>
  <bod-page-container title="Product Type Relationship"></bod-page-container>
  <bod-input-layout col="2">
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.code'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="existingRoleCode"
          name="existingRoleCode"
        >
          <mat-option
            *ngFor="let existingRoleCode of existingRoleCodes"
            [value]="existingRoleCode.value"
          >
            {{ existingRoleCode.label }}
          </mat-option>
        </mat-select>
      </mat-form-field>
    </bod-control-group>
  </bod-input-layout>

  <bod-table
    #roleRelationshipTable
    [data]="roleRelationshipTabledataForExisting"
    [tableActions]="roleRelationshipTableActions"
    (onTableActionClick)="onValidTableActionClicked($event)"
    [expandedRowTemplate]="expandedRowTemplate"
    [inlineModal]="{
      formGroup: roleRelationshipForExistingForm,
      formTemplateName: roleRelationshipForExistingTemplate
    }"
    (onInlineFormAddSubmit)="
      onAddForExistingRoleRelationship(roleRelationshipForExistingForm.value)
    "
    (onInlineFormEditSubmit)="
      onAddForExistingRoleRelationship(roleRelationshipForExistingForm.value)
    "
    (onInlineEditRowActionClick)="inlineEditRowActionClick($event)"
    (onInlineAddRowActionClick)="inlineAddRowActionClick()"
    [customColumnTemplates]="[
      {
        columnName: 'actions',
        templateName: deleteRoleRelationshipForExistingActionTemplate
      }
    ]"
    [alignContent]="'top'"
  >
    <ng-template
      #deleteRoleRelationshipForExistingActionTemplate
      let-element="element"
      let-column="column"
      let-index="index"
    >
      <bod-table-actions
        [actions]="rowLevelActionsForBasicEdit"
        (onActionClick)="
          handleRowLevelActionsforRoleRelationshipForExisting(
            $event.icon,
            index
          )
        "
      >
      </bod-table-actions>
    </ng-template>
    <ng-template #expandedRowTemplate let-context="context">
      <div fullwidth>
        <bod-inquiry-layout
          [columns]="2"
          [groups]="roleTypeService.getExpandedaggregateData(context.element)"
          [softSeparator]="false"
          [direction]="direction"
          [information]="[]"
          (linkClick)="commonDataService.inquiryLayoutClick($event)"
        >
        </bod-inquiry-layout>
      </div>
    </ng-template>
  </bod-table>
  <form [formGroup]="roleRelationshipForExistingForm">
    <ng-template #roleRelationshipForExistingTemplate>
      <bod-input-layout col="2">
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.customerType'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <mat-select
              panelClass="fis-style"
              formControlName="customerType"
              name="customerType"
            >
              <mat-option
                *ngFor="let customerType of customerTypes"
                [value]="customerType.value"
              >
                {{ customerType.label }}
              </mat-option>
            </mat-select>
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.maximumAccountAllowed'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="text"
              matInput
              fisStyle
              formControlName="maximumAccountAllowed"
              name="maximumAccountAllowed"
              [disabled]="true"
            />
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.minimum'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="text"
              matInput
              fisStyle
              formControlName="minimum"
              name="minimum"
              [disabled]="true"
            />
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.maximum'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="text"
              matInput
              fisStyle
              formControlName="maximum"
              name="maximum"
              [disabled]="true"
            />
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.primary'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="primary"
            name="primary"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.percentageAllowed'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="percentageAllowed"
            name="percentageAllowed"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.applicableOrder'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="applicableOrder"
            name="applicableOrder"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.signatureRequired'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="signatureRequired"
            name="signatureRequired"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.ownerCategory'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="text"
              matInput
              fisStyle
              formControlName="ownerCategory"
              name="ownerCategory"
              [disabled]="true"
            />
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.ownerSubCategory'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="text"
              matInput
              fisStyle
              formControlName="ownerSubCategory"
              name="ownerSubCategory"
              [disabled]="true"
            />
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.additionalDetails'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="text"
              matInput
              fisStyle
              formControlName="additionalDetails"
              name="additionalDetails"
              [disabled]="true"
            />
          </mat-form-field>
        </bod-control-group>
      </bod-input-layout>
    </ng-template>
  </form>

  <bod-table
    #exstRoleCategoryTable
    [data]="exstRoleCategoryTableData"
    [modeOptions]="modeOptions"
    [tableActions]="exstRoleCategoryTableActions"
    (onTableActionClick)="onRoleCategoryTableActionClicked($event)"
    [primaryColumnName]="'id'"
    [truncateAfterLine]="1"
    [customColumnTemplates]="[
      {
        columnName: 'roleCategoryId',
        templateName: roleCategoryIdTemplate
      },
      {
        columnName: 'roleCategoryValue',
        templateName: roleCategoryValueTemplate
      },
      {
        columnName: 'actionBtns',
        templateName: actionBtnsTemplate
      }
    ]"
  >
    <ng-template
      #roleCategoryIdTemplate
      let-element="element"
      let-column="column"
      let-index="index"
    >
      <ng-container>
        <form [formGroup]="roleCategoryIdForm">
          <bod-input-layout col="1">
          <mat-form-field appearance="outline" fisStyle>
            <mat-select
              panelClass="fis-style"
              [formControl]="
                roleCategoryIdForm.controls[roleCategoryFormCtrlKeysId[index]]
              "
              name="roleCategoryId"
            >
              <mat-option
                *ngFor="let roleCategoryId of roleCategoryIds"
                value="{{ roleCategoryId.value }}"
              >
                {{ roleCategoryId.label }}
              </mat-option>
            </mat-select>
          </mat-form-field>
        </bod-input-layout>
        </form>
      </ng-container>
    </ng-template>
    <ng-template
      #roleCategoryValueTemplate
      let-element="element"
      let-column="column"
      let-index="index"
    >
      <form [formGroup]="roleCategoryValueForm">
        <bod-input-layout col="1">
          <mat-form-field appearance="outline" fisStyle>
            <mat-select
              panelClass="fis-style"
              [formControl]="
                roleCategoryValueForm.controls[
                  roleCategoryFormCtrlKeysValue[index]
                ]
              "
              name="roleCategoryValue"
            >
              <mat-option
                *ngFor="let roleCategoryValue of roleCategoryValues"
                value="{{ roleCategoryValue.value }}"
              >
                {{ roleCategoryValue.label }}
              </mat-option>
            </mat-select>
          </mat-form-field>
        </bod-input-layout>
      </form>
    </ng-template>

    <ng-template
      #actionBtnsTemplate
      let-element="element"
      let-column="column"
      let-index="index"
    >
      <bod-table-actions
        [actions]="rowLevelActionsForRoleCategory"
        (onActionClick)="deleteRoleCategory(index, element)"
      >
      </bod-table-actions>
    </ng-template>
  </bod-table>
</bod-form>
