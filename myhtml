                  {{ getError('code') | translate }}
                </mat-error>
              </mat-form-field>
            </bod-control-group>
            <bod-control-group
              [truncate]="false"
              [label]="translationKey + 'metadataconfig.name'"
              [forTextOnly]="true"
              [required]="false"
            >
              <mat-form-field appearance="outline" fisStyle>
                <input
                  type="text"
                  matInput
                  fisStyle
                  formControlName="name"
                  name="name"
                />
              </mat-form-field>
            </bod-control-group>
            <bod-control-group
              [truncate]="false"
              [label]="translationKey + 'metadataconfig.shortname'"
              [forTextOnly]="true"
              [required]="true"
