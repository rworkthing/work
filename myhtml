  <!-- {{textConditionData.datasource.data | json}} -->
  <div
    *ngIf="
      addNewConditionFormGroup.get('conditionType').value ===
      'TextAndNumberCondition'
    "
  >
    <bod-input-layout col="2">
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.validvalues'"
        [forTextOnly]="true"
        [required]="false"
      >
        <mat-slide-toggle
          fisStyle
          color="primary"
          formControlName="textnumbervalidvalue"
          name="textnumbervalidvalue"
        >
        </mat-slide-toggle>
      </bod-control-group>
      <bod-control-group
        *ngIf="!addNewConditionFormGroup.get('textnumbervalidvalue').value"
        [truncate]="false"
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.textvalue'"
        [forTextOnly]="true"
        [required]="true"
      >
        <mat-form-field appearance="outline" fisStyle>
          <input
            type="text"
            matInput
            fisStyle
            formControlName="defaultText"
            name="defaultText"
          />
        </mat-form-field>
      </bod-control-group>
      <bod-control-group
        *ngIf="!addNewConditionFormGroup.get('textnumbervalidvalue').value"
        [truncate]="false"
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.numbervalue'"
        [forTextOnly]="true"
        [required]="true"
      >
        <mat-form-field appearance="outline" fisStyle>
          <input
            type="number"
            matInput
            fisStyle
            formControlName="defaultNumber"
            name="defaultNumber"
          />
        </mat-form-field>
      </bod-control-group>
    </bod-input-layout>
    <bod-text-number-condition
      *ngIf="addNewConditionFormGroup.get('textnumbervalidvalue').value"
      #simpleEditTableTextNum
      [localeData1]="localeTableData1"
      (tableDirty)="onTableDirty()"
      (completeDeltaChange1)="handleCompleteDeltaChange1($event)"
    >
    </bod-text-number-condition>
  </div>
  <div
    *ngIf="
      addNewConditionFormGroup.get('conditionType').value ===
      'FrequencyCondition'
    "
  >
    <bod-input-layout col="2">
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.processingday'"
        [forTextOnly]="true"
        [required]="true"
      >
        <mat-form-field appearance="outline" fisStyle>
          <mat-select
            panelClass="fis-style"
            formControlName="processingday"
            name="processingday"
          >
            <mat-option
              *ngFor="let processingday of processingDays"
              [value]="processingday.value"
            >
              {{ processingday.label }}
            </mat-option>
          </mat-select>
          <mat-error>
            {{
              getError('processingday', addNewConditionFormGroup) | translate
            }}
          </mat-error>
        </mat-form-field>
      </bod-control-group>
    </bod-input-layout>
    <bod-primary-frequency-condition
      #simpleEditTablePrimFre
      (completeDeltaChangefrequency)="handleCompleteDeltaChangeFreq($event)"
      [primFreData]="primFreqTableData"
      (tableDirty)="onTableDirty()"
    >
    </bod-primary-frequency-condition>
    <bod-input-layout col="2">
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.secondaryfrequency'"
        [forTextOnly]="true"
        [required]="false"
      >
        <mat-slide-toggle
          fisStyle
          color="primary"
          formControlName="secondaryfre"
          name="secondaryfre"
        >
        </mat-slide-toggle>
      </bod-control-group>
    </bod-input-layout>

    <bod-secondory-frequency-condition
      *ngIf="addNewConditionFormGroup.get('secondaryfre').value"
      #simpleEditTableSecFre
      (completeDeltaChangeSecondaryfrequency)="
        handleCompleteDeltaChangeSecFreq($event)
      "
      [secFreData]="secFreqTableData"
      (tableDirty)="onTableDirty()"
    >
    </bod-secondory-frequency-condition>
    <bod-input-layout col="2">
      <bod-control-group
        *ngIf="addNewConditionFormGroup.get('secondaryfre').value"
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.subtract'"
        [forTextOnly]="true"
        [required]="false"
      >
        <mat-slide-toggle
          fisStyle
          color="primary"
          formControlName="subtract"
          name="subtract"
        >
        </mat-slide-toggle>
      </bod-control-group>
    </bod-input-layout>
  </div>
  <div
    *ngIf="
      addNewConditionFormGroup.get('conditionType').value ===
      'CurrencySpecificCondition'
    "
  >
    <bod-input-layout col="2">
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.validvalues'"
        [forTextOnly]="true"
        [required]="false"
      >
        <mat-slide-toggle
          fisStyle
          color="primary"
          formControlName="curspecificvalue"
          name="curspecificvalue"
          (change)="toggleVisibility()"
        >
        </mat-slide-toggle>
      </bod-control-group>
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.secondoryconditiontype'"
        [forTextOnly]="true"
        [required]="false"
      >
        <mat-form-field appearance="outline" fisStyle>
          <mat-select
            panelClass="fis-style"
            formControlName="seccondtype"
            name="seccondtype"
            [disabled]="true"
          >
              <mat-option value="amount" disabled>Amount</mat-option>  
          </mat-select>
        </mat-form-field>
      </bod-control-group>
    </bod-input-layout>
  </div>
  <bod-message-container [messages]="errorMessages4"></bod-message-container>
  <bod-table
    [hidden]="isHidden"
    #currencyConditions
    [data]="currencySpecificData"
    (onRowSelect)="rowSelection($event)"
    [rowSelectionStrategy]="rowSelectionStrategy"
    [allowSelectAll]="allowRowSelection"
    [inlineModal]="{
      formGroup: addNewConditionCurrencyForm,
      formTemplateName: addNewCurrencyTemplate
    }"
    (onInlineFormEditSubmit)="onAddCurrency($event, 0)"
    (onInlineEditRowActionClick)="inlineEditRowActionClick($event, 0)"
    [expandedRowTemplate]="expandedRowTemplate"
    [customColumnTemplates]="[
      {
        columnName: 'actions',
        templateName: editActionTemplate
      }
    ]"
    [alignContent]="'top'"
  >
    <ng-template
      #editActionTemplate
      let-element="element"
      let-column="column"
      let-index="index"
    >
      <bod-table-actions
        [actions]="rowLevelActionsForBasicEdit"
        (onActionClick)="handleRowLevelActionsforCurrency($event.icon, index)"
      >
      </bod-table-actions>
    </ng-template>

    <ng-template #expandedRowTemplate let-context="context">
      <div fullwidth>
        <bod-inquiry-layout
          [columns]="2"
          [groups]="conditionDetailService.getCurrencyInquiry(context.element)"
          [softSeparator]="false"
          [direction]="direction"
          [information]="[]"
          (linkClick)="commonDataService.inquiryLayoutClick($event)"
        >
        </bod-inquiry-layout>
      </div>
    </ng-template>
  </bod-table>

  <form [formGroup]="addNewConditionCurrencyForm">
    <ng-template #addNewCurrencyTemplate>
      <bod-input-layout col="2">
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.range'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="range"
            name="range"
            (change)="onRangeToggleChange()"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          *ngIf="!addNewConditionCurrencyForm.get('range').value"
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.defaultamount'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="number"
              matInput
              fisStyle
              formControlName="defaultValue"
              name="defaultValue"
            />

            <mat-error>
              {{
                getError('defaultValue', addNewConditionCurrencyForm)
                  | translate
              }}
            </mat-error>
            <mat-error
              *ngIf="
                addNewConditionCurrencyForm
                  .get('defaultValue')
                  .hasError('negativeValue')
              "
            >
            </mat-error>
          </mat-form-field>
        </bod-control-group>

        <bod-input-layout col="1">
          <bod-control-group
            *ngIf="addNewConditionCurrencyForm.get('range').value"
            [truncate]="false"
            [label]="translationKey + 'metadataconfig.minimumamount'"
            [forTextOnly]="true"
            [required]="true"
          >
            <mat-form-field appearance="outline" fisStyle>
              <input
                type="number"
                matInput
                fisStyle
                formControlName="minimumcspcf"
                name="minimumcspcf"
              />

              <mat-error>
                {{
                  getError('minimumcspcf', addNewConditionCurrencyForm)
                    | translate
                }}
              </mat-error>
              <mat-error
                *ngIf="
                  addNewConditionCurrencyForm
                    .get('minimumcspcf')
                    .hasError('negativeValue')
                "
              >
              </mat-error>
            </mat-form-field>
          </bod-control-group>
        </bod-input-layout>
        <bod-input-layou col="1">
          <bod-control-group
            *ngIf="addNewConditionCurrencyForm.get('range').value"
            [truncate]="false"
            [label]="translationKey + 'metadataconfig.maximumamount'"
            [forTextOnly]="true"
            [required]="true"
          >
            <mat-form-field appearance="outline" fisStyle>
              <input
                type="number"
                matInput
                fisStyle
                formControlName="maximumcspcf"
                name="maximumcspcf"
              />

              <mat-error>
                {{
                  getError('maximumcspcf', addNewConditionCurrencyForm)
                    | translate
                }}
              </mat-error>
              <mat-error
                *ngIf="
                  addNewConditionCurrencyForm
                    .get('maximumcspcf')
                    .hasError('zeroValue')
                "
              >
              </mat-error>
              <mat-error
                *ngIf="
                  addNewConditionCurrencyForm
                    .get('maximumcspcf')
                    .hasError('negativeValue')
                "
              >
              </mat-error>
            </mat-form-field>
          </bod-control-group>
        </bod-input-layou>
        <bod-input-layout>
          <bod-control-group
            *ngIf="addNewConditionCurrencyForm.get('range').value"
            [truncate]="false"
            [label]="translationKey + 'metadataconfig.defaultamount'"
            [forTextOnly]="true"
            [required]="true"
          >
            <mat-form-field appearance="outline" fisStyle>
              <input
                type="number"
                matInput
                fisStyle
                formControlName="defaultcspcf"
                name="defaultcspcf"
              />

              <mat-error>
                {{
                  getError('defaultcspcf', addNewConditionCurrencyForm)
                    | translate
                }}
                <!-- <mat-error
                  *ngIf="
                    addNewConditionCurrencyForm
                      .get('defaultcspcf')
                      .hasError('defaultValueOutOfRange')
                  "
                >
                </mat-error> -->
              </mat-error>
            </mat-form-field>
          </bod-control-group>
        </bod-input-layout>
      </bod-input-layout>
    </ng-template>
  </form>

  <bod-table
  *ngIf="
    addNewConditionFormGroup.get('conditionType')?.value ===
    'CurrencyCondition'
  "
  #currencyConditionsForCurr
  [data]="currencyDataSingleSelect"
  (onRowSelect)="rowSelectionSingleSelect($event)"
  [rowSelectionStrategy]="rowSelectionStrategy"
  [allowSelectAll]="allowRowSelection"
  [alignContent]="'top'"
>
  
</bod-table>

  <bod-condition-relationship
    #simpleEditTableRef
    [localeData]="localeTableData"
    (completeDeltaChange)="handleCompleteDeltaChange($event)"
    (tableDirty)="onTableDirty()"
  ></bod-condition-relationship>
</bod-form>
