      </bod-control-group>
    </bod-input-layout>
    <bod-text-condition
      *ngIf="addNewConditionFormGroup.get('validvalue').value"
      #simpleEditTableText
      (completeDeltaChange)="handleCompleteDeltaChangetext($event)"
      [localeData3]="localeTableData3"
      (tableDirty)="onTableDirty()"
    >
    </bod-text-condition>

