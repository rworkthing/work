  </div>
  <div
    *ngIf="
      addNewConditionFormGroup.get('conditionType').value === 'FlagCondition'
    "
  >
    <bod-input-layout col="2">
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.defaultvalue'"
        [forTextOnly]="true"
        [required]="false"
      >
        <mat-slide-toggle
          fisStyle
          color="primary"
          formControlName="defaultflag"
          name="defaultflag"
        >
        </mat-slide-toggle>
      </bod-control-group>
    </bod-input-layout>
  </div>
  <div
    *ngIf="
      addNewConditionFormGroup.get('conditionType').value === 'DateCondition'
    "
  >
    <bod-input-layout col="2">
      <bod-control-group
        label="{{ translationKey + 'metadataconfig.defaultvalue' }}"
        [forTextOnly]="true"
        [required]="true"
      >
        <mat-form-field appearance="outline" fisStyle bod-date>
          <input
            matInput
            formControlName="start"
            [matDatepicker]="datePicker"
            [matDatepickerFilter]="dateRange.filter"
          />
          <mat-datepicker-toggle
            fisStyle
            matSuffix
            [for]="datePicker"
          ></mat-datepicker-toggle>
          <mat-datepicker #datePicker [xPosition]="'end'"></mat-datepicker>

          <mat-error>
            {{ getError('start', addNewConditionFormGroup) | translate }}
          </mat-error>
        </mat-form-field>
      </bod-control-group>
    </bod-input-layout>
  </div>
