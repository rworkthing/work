              }}
            </mat-error>
            <!-- <mat-error
              *ngIf="
                addNewConditionFormGroup
                  .get('percentageDefaultValue')
                  .hasError('defaultValueOutOfRange')
              "
            >
            </mat-error> -->
          </mat-form-field>
        </bod-control-group>
      </bod-input-layout>
    </div>
  </div>
  <div
    *ngIf="
      addNewConditionFormGroup.get('conditionType').value === 'TextCondition'
    "
  >
    <bod-input-layout col="2">
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.validvalues'"
        [forTextOnly]="true"
        [required]="false"
      >
        <mat-slide-toggle
          fisStyle
          color="primary"
          formControlName="validvalue"
          name="validvalue"
        >
        </mat-slide-toggle>
      </bod-control-group>
      <bod-control-group
        *ngIf="!addNewConditionFormGroup.get('validvalue').value"
