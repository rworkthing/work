<bod-input-layout col="1">
                <bod-table
                  #Validvaltable2
                  [data]="ExistingValidvalueArray"
                  [tableActions]="balanceHoldsTableActions3"
                  (onTableActionClick)="onExsistingValidTableActionClicked($event)"
                  [inlineModal]="{
                    formGroup: inputExistingLayoutForm,
                    formTemplateName: inputExistingLayoutTemplate
                  }"
                  [customColumnTemplates]="[
                    {
                      columnName: 'actions',
                      templateName: deleteActionTemplate
                    }
                  ]"
                  [alignContent]="'top'"
                >
                  <ng-template
                    #deleteActionTemplate
                    let-element="element"
                    let-column="column"
                    let-index="index"
                  >
                    <bod-table-actions
                      [actions]="rowLevelActionsForBasicEdit"
                      (onActionClick)="
                        handleExistingRowLevelActions($event.icon, index)
                      "
                    >
                    </bod-table-actions>
                  </ng-template>
                </bod-table>
                 <form
                [formGroup]="inputExistingLayoutForm"
                [type]="formType"
                (onSubmit)="onExistingAdd(inputExistingLayoutForm.value)"
                (onReset)="onReset()"
                fisStyle
              >
               <ng-template #inputExistingLayoutTemplate>
                <bod-input-layout col="2">
                  <bod-control-group
                    [truncate]="false"
                    [label]="
                      translationKey + 'metadataconfig.additionaldatavalue'
                    "
                    [forTextOnly]="true"
                    [required]="true"
                  >
                    <mat-form-field appearance="outline" fisStyle>
                      <input
                        type="text"
                        matInput
                        fisStyle
                        formControlName="additionaldatavalue"
                        name="additionaldatavalue"
                      />
                    </mat-form-field>
                  </bod-control-group>
                  <bod-control-group
                    [truncate]="false"
                    [label]="translationKey + 'metadataconfig.percentagevalue'"
                    [forTextOnly]="true"
                    [required]="false"
                  >
                    <mat-form-field appearance="outline" fisStyle>
                      <input
                        type="number"
                        matInput
                        fisStyle
                        formControlName="percentagevalue"
                        name="percentagevalue"
                      />
                    </mat-form-field>
                  </bod-control-group>
                  <bod-control-group
                    [truncate]="false"
                    [label]="translationKey + 'metadataconfig.sequencenumber'"
                    [forTextOnly]="true"
                    [required]="false"
                  >
                    <mat-form-field appearance="outline" fisStyle>
                      <input
                        type="number"
                        matInput
                        fisStyle
                        formControlName="sequencenumber"
                        name="sequencenumber"
                      />
                    </mat-form-field>
                  </bod-control-group>
                  <bod-control-group
                    [truncate]="false"
                    [label]="
                      translationKey + 'metadataconfig.defaulatindicator'
                    "
                    [forTextOnly]="true"
                    [required]="false"
                  >
                    <mat-slide-toggle
                      fisStyle
                      color="primary"
                      formControlName="defaultindicator"
                      name="defaultindicator"
                    >
                    </mat-slide-toggle>
                  </bod-control-group>
                  <bod-control-group
                    [truncate]="false"
                    [label]="translationKey + 'metadataconfig.primaryindicator'"
                    [forTextOnly]="true"
                    [required]="false"
                  >
                    <mat-slide-toggle
                      fisStyle
                      color="primary"
                      formControlName="primaryindicator"
                      name="primaryindicator"
                    >
                    </mat-slide-toggle>
                  </bod-control-group>
                  <bod-control-group
                    [truncate]="false"
                    [label]="
                      translationKey + 'metadataconfig.overrideindicator'
                    "
                    [forTextOnly]="true"
                    [required]="false"
                  >
                    <mat-slide-toggle
                      fisStyle
                      color="primary"
                      formControlName="overrideindicator"
                      name="overrideindicator"
                    >
                    </mat-slide-toggle>
                  </bod-control-group>
                </bod-input-layout>
              </ng-template>
              </form>
              </bod-input-layout>
