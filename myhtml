export interface TaxDefinition {
  id: number;
  identifier: number;
  code: string;
  taxTypeIdentifier: number;
  region: string | null;
  partyClassification: string | null;
  rate: number;
  taxAmount: number;
  thresholdTaxAmount: number;
  currencyIdentifier: number;
}

@Component({
  selector: 'bod-tax-type-definition-table',
  standalone: true,
  imports: [
    CommonModule,
    BodTableModule,
    BodPageContainerModule,
    MatSlideToggleModule,
    ReactiveFormsModule,
    FormsModule,
    BodAutoCompleteModule,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
