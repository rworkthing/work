<bod-message-container [messages]="errorMessages"></bod-message-container>
<bod-message-container [messages]="errorMessages2"></bod-message-container>
<bod-message-container [messages]="errorMessages3"></bod-message-container>
<bod-message-container [messages]="errorMessages5"></bod-message-container>


<bod-form
  [formGroup]="addNewConditionFormGroup"
  rufId
  [type]="formType"
  (onSubmit)="onAddNewCondition(isAdd)"
  (onReset)="onReset(isAdd)"
  fisStyle
>
  <bod-input-layout col="2">
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.code'"
      [forTextOnly]="true"
      [required]="true"
    >
      <div *ngIf="isEdit">
        {{ addNewConditionFormGroup.get('code')?.value }}
      </div>
      <mat-form-field appearance="outline" fisStyle *ngIf="!isEdit">
        <input
          type="text"
          matInput
          fisStyle
          formControlName="code"
          name="code"
        />

        <mat-error>
          {{ getError('code', addNewConditionFormGroup) | translate }}
        </mat-error>
        <mat-error
          *ngIf="
            addNewConditionFormGroup.get('code').hasError('noSpecialCharacters')
          "
        >
        </mat-error>
      </mat-form-field>
    </bod-control-group>

    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.name'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <input
          type="text"
          matInput
          fisStyle
          formControlName="name"
          name="name"
        />
        <mat-error>
          {{ getError('name', addNewConditionFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>

    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.conditiontype'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="conditionType"
          name="conditionType"
        >
          <mat-option
            *ngFor="let conditionType of conditionTypes"
            [value]="conditionType.value"
          >
            {{ conditionType.label }}
          </mat-option>
        </mat-select>

        <mat-error>
          {{ getError('conditionType', addNewConditionFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.classificationtype'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="classificationType"
          name="classificationType"
        >
          <mat-option
            *ngFor="let classificationType of classificationTypes"
            [value]="classificationType.value"
          >
            {{ classificationType.label }}
          </mat-option>
        </mat-select>

        <mat-error>
          {{
            getError('classificationType', addNewConditionFormGroup) | translate
          }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.optionality'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="optionality"
          name="optionality"
        >
          <mat-option
            *ngFor="let optionality of optionalitys"
            [value]="optionality.value"
          >
            {{ optionality.label }}
          </mat-option>
        </mat-select>

        <mat-error>
          {{ getError('optionality', addNewConditionFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.applicableto'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="applicableTo"
          name="applicableTo"
        >
          <mat-option
            *ngFor="let applicableTo of applicableTos"
            [value]="applicableTo.value"
          >
            {{ applicableTo.label }}
          </mat-option>
        </mat-select>

        <mat-error>
          {{ getError('applicableTo', addNewConditionFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.customizable'"
      [forTextOnly]="true"
      [required]="false"
    >
      <mat-slide-toggle
        fisStyle
        color="primary"
        formControlName="customizable"
        name="customizable"
      >
      </mat-slide-toggle>
    </bod-control-group>
  </bod-input-layout>
  <div
    *ngIf="
      addNewConditionFormGroup.get('conditionType').value === 'NumberCondition'
    "
  >
    <bod-input-layout col="2">
      <bod-control-group
        [truncate]="false"
        [label]="translationKey + 'metadataconfig.validvaluestype'"
        [forTextOnly]="true"
        [required]="true"
      >
        <mat-form-field appearance="outline" fisStyle>
          <mat-select
            panelClass="fis-style"
            formControlName="validValuesTypeNumber"
            name="validValuesTypeNumber"
          >
            <mat-option
              *ngFor="let validValuesTypeNumber of validValuesTypeNumbers"
              [value]="validValuesTypeNumber.value"
            >
              {{ validValuesTypeNumber.label }}
            </mat-option>
          </mat-select>

          <mat-error>
            {{
              getError('validValuesTypeNumber', addNewConditionFormGroup)
                | translate
            }}
          </mat-error>
        </mat-form-field>
      </bod-control-group>
      <div
        *ngIf="
          addNewConditionFormGroup.get('validValuesTypeNumber').value === 'none'
        "
      >
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.value'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="number"
              matInput
              fisStyle
              formControlName="numberValue"
              name="numberValue"
            />

            <mat-error>
              {{
                getError('numberValue', addNewConditionFormGroup) | translate
              }}
            </mat-error>
          </mat-form-field>
        </bod-control-group>
      </div>
    </bod-input-layout>
    <div
      *ngIf="
        addNewConditionFormGroup.get('validValuesTypeNumber').value === 'range'
      "
    >
      <bod-input-layout col="1">
        <bod-page-container title="Range"></bod-page-container>
      </bod-input-layout>
      <bod-input-layout col="2">
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.low'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="number"
              matInput
              fisStyle
              formControlName="numberLow"
              name="numberLow"
            />

            <mat-error>
              {{ getError('numberLow', addNewConditionFormGroup) | translate }}
            </mat-error>
            <mat-error
              *ngIf="
                addNewConditionFormGroup
                  .get('numberLow')
                  .hasError('negativeValue')
              "
            >
            </mat-error>
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.high'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="number"
              matInput
              fisStyle
              formControlName="numberHigh"
              name="numberHigh"
            />

            <mat-error>
              {{ getError('numberHigh', addNewConditionFormGroup) | translate }}
            </mat-error>
            <mat-error
              *ngIf="
                addNewConditionFormGroup.get('numberHigh').hasError('zeroValue')
              "
            >
            </mat-error>
            <mat-error
              *ngIf="
                addNewConditionFormGroup
                  .get('numberHigh')
                  .hasError('negativeValue')
              "
            >
            </mat-error>
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.defaultvalue'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="number"
              matInput
              fisStyle
              formControlName="numberdefaultValue"
              name="numberdefaultValue"
            />

            <mat-error>
              {{
                getError('numberdefaultValue', addNewConditionFormGroup)
                  | translate
              }}
            </mat-error>
            <mat-error
              *ngIf="
                addNewConditionFormGroup
                  .get('numberdefaultValue')
                  .hasError('defaultValueOutOfRange')
              "
            >
            </mat-error>
          </mat-form-field>
        </bod-control-group>
      </bod-input-layout>
    </div>
    <bod-num-condition
      *ngIf="
        addNewConditionFormGroup.get('validValuesTypeNumber').value === 'set'
      "
      #simpleEditTableNum
      [localeData2]="localeTableData2"
      (tableDirty)="onTableDirty()"
      (completeNumberData)="handleCompleteNumberData($event)"
    >
    </bod-num-condition>
  </div>

