                getError('percentageValue', addNewConditionFormGroup)
                  | translate
              }}
            </mat-error>
          </mat-form-field>
        </bod-control-group>
      </div>
    </bod-input-layout>
    <div
      *ngIf="
        addNewConditionFormGroup.get('validValuesTypePercentage').value ===
        'range'
      "
    >
