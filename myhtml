@Component({
  selector: 'bod-transaction-category',
  standalone: true,
  imports: [
    CommonModule,
    AddEditTransactionCategoryComponent,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    MatDatepickerModule,
    BodCommonModule
  ],
  templateUrl: './transaction-category.component.html',
  styleUrl: './transaction-category.component.scss',
  schemas: [CUSTOM_ELEMENTS_SCHEMA]
})
export class TransactionCategoryComponent implements OnInit {
  public editactions: BodTableAction[] = editDeleteActions;
  public channels: any[] = [];
  public counters: any[] = [];
  public restrictions: any[] = [];
  public conditions: any[] = [];
  public communications: any[] = [];
  public countersMasterList: any[] = [];
  public restrictionsMasterList: any[] = [];
  public communicationsMasterList: any[] = [];
  public conditionsMasterList: any[] = [];

  @ViewChild('systemMessage', { static: true }) systemMessage: any;
  @Input() status = '';
  @ViewChild('addNewTransactionCategoryTemplate')
  public addNewTransactionCategoryTemp: TemplateRef<any>;

  constructor(
    private bodConfirmAlertDialogsService: BodConfirmAlertDialogsService,
    private metadataService: MetadataService,
    private transactionCategoryService: TransactionCategoryService,
    private transactionTypeService: TransactionTypeService,
    private addEditTransactiontypeservice: AddEditransactiontypeService,
    private cdr: ChangeDetectorRef,
    private bodCommonDialogService: BodCommonDialogService
  ) {}

  public transactionCategoryTableActions: BodTableAction[] =
    TransactionCategoryTableActions;

  public TransactionCategoryMetaData: BodTableMetadata = {
    title: 'Transaction Category',
    columns: [...this.transactionCategoryService.columns],
    enablePagination: true,
    paginationOptions: {
      pageSize: 4,
      length: 12,
      pageSizeOptions: [2, 3, 4, 6],
      showLastButton: true,
      showPageSizeOptions: true
    },
    datasource: new MatTableDataSource<any>(),
    noRecordsMessage: 'No Transaction Category Data Defined',
    rowLeftAction: RowLeftAction.expandableRows,
    enableSorting: true
  };
  public channelsTable: BodTableMetadata = {
    title: 'Channels',
    columns: [...this.addEditTransactiontypeservice.categorychannelsTable],
    enablePagination: false,
    datasource: new MatTableDataSource<BodSampleTable>(),
    rowLeftAction: RowLeftAction.expandableRows,
    noRecordsMessage: 'No Channels Defined'
  };

  public countersTable: BodTableMetadata = {
    title: 'Counters',
    columns: [...this.addEditTransactiontypeservice.countersTable],
    enablePagination: false,
    datasource: new MatTableDataSource<BodSampleTable>(),
    noRecordsMessage: 'No Channels Defined'
  };

  public restrictionsTable: BodTableMetadata = {
    title: 'Restrictions',
    columns: [...this.addEditTransactiontypeservice.restrictionsTable],
    enablePagination: false,
    datasource: new MatTableDataSource<BodSampleTable>(),
    noRecordsMessage: 'No Restrictions Defined'
  };
  public conditionsTable: BodTableMetadata = {
    title: 'Conditions',
    columns: [...this.addEditTransactiontypeservice.conditionsTable],
    enablePagination: false,
    datasource: new MatTableDataSource<BodSampleTable>(),
    noRecordsMessage: 'No Conditions Defined'
  };

  public communicationsTable: BodTableMetadata = {
    title: 'Communication Services',
    columns: [...this.addEditTransactiontypeservice.communicationServiceTable],
    enablePagination: false,
    datasource: new MatTableDataSource<BodSampleTable>(),
    noRecordsMessage: 'No Communication Services Defined'
  };

  ngOnInit() {
    this.loadDropdownData();
    this.transactionCategoryService.retrieveAll().subscribe((response: any) => {
      const firstStatus = response?.data?.[0]?.MetadataStatus;
      const statusToSet = firstStatus || 'NEW';
      this.statusControl.setValue(statusToSet);
      this.previousStatus = statusToSet;
      this.transactionCategoryService.updateCurrentStatus(statusToSet);
      console.log('TransactionCategory - Initial status set to:', statusToSet);
    });
    this.getTransactionCategories();
  }

  loadDropdownData() {
  forkJoin({
    channels: this.transactionTypeService.getDeliveryChannel(),
    counters: this.transactionTypeService.getCounters(),
    restrictions: this.transactionTypeService.getRestrictions(),
    conditions: this.transactionTypeService.getConditions(),
    communications: this.transactionTypeService.getCommunicationService()
  }).subscribe(results => {
    this.channels = results.channels
      .map((item: any) => ({
        label: item.code,
        value: item.identifier
      }))
      .sort((a, b) => a.label.localeCompare(b.label));

    this.counters = results.counters
      .map((item: any) => ({
        identifier: item.identifier,
        code: item.code,
        classificationType: item.classificationType
      }))
      .sort((a, b) => a.code.localeCompare(b.code));
    this.countersMasterList = results.counters;

    this.restrictions = results.restrictions;
    this.restrictionsMasterList = results.restrictions;

    this.conditions = results.conditions;
    this.conditionsMasterList = results.conditions;

    this.communications = results.communications;
    this.communicationsMasterList = results.communications;
  });
}

  isStatusEditable(): boolean {
    return this.status !== 'READY' && this.status !== 'GENERATED';
  }

  public commonDialogSize: string = 'Large';
  public closeOnCloseIconClick: boolean = false;

  private onCloseClick() {
    this.systemMessage.message = 'Custom Function called on close';
    this.systemMessage.show();
    this.dialogRef$.close();
  }

  private dialogRef$: MatDialogRef<CommonDialogComponent, any>;

  private openDialog(dialogModel: any) {
    let onClose = this.closeOnCloseIconClick
      ? this.onCloseClick.bind(this)
      : undefined;
    this.dialogRef$ = this.bodCommonDialogService.commonDialog(
      dialogModel,
      onClose,
      this.commonDialogSize
    );
  }

  isEdit = false;
  public messages: NotificationMessage[] = [];

  public onTableActionClicked1(event: BodTableAction) {
    this.isEdit = false;
    this.messages = [];
    if (event.id === 14) {
      this.addNewTransactionCategory();
    }
  }

  private addNewTransactionCategory() {
    this.editTransactionCategory = undefined;
    this.messages = [];
    let dialogModel: BodCommonDialogModel = {
      formTemplate: this.addNewTransactionCategoryTemp,
      title: 'Add New Transaction Category'
    };
    this.openDialog(dialogModel);
  }

  public msg: NotificationMessage | undefined;
  statusControl = new FormControl(null);
  public previousStatus: string | undefined;
  @Output() statusChanged = new EventEmitter<string>();

  addTransactionCategoryEvent(event: any) {
    if (event) {
      this.loadDropdownData();
      this.getTransactionCategories();
      const SuccessMsg = event.SuccessMsg;
      this.msg = {
        code: '',
        text: SuccessMsg,
        type: NotificationMessageType.SUCCESS
      };
      this.messages.push(this.msg);
      setTimeout(() => {
        this.messages = this.messages.filter(msg => msg.text !== SuccessMsg);
      }, 20000);
    }
    this.dialogRef$.close();

    this.metadataService.retrieveAll().subscribe((response: any) => {
      const firstStatus =
        response?.data &&
        response.data.length > 0 &&
        response.data[0]?.MetadataStatus
          ? response.data[0].MetadataStatus
          : null;
      const statusToSet = firstStatus || 'NEW';
      this.statusControl.setValue(statusToSet);
      this.previousStatus = statusToSet;
      this.statusChanged.emit(statusToSet);
      this.transactionCategoryService.updateCurrentStatus(statusToSet);
      console.log('TransactionCategory - Status updated to:', statusToSet);
    });
  }

  public rowExpanded(element: TransactionCategoryList) {
    // 1. Collect all unique resourceItemIdentifiers from all relationship lists
    const channelIds = new Set<string | number>();

    [
      ...(element.productTypePostingCategoryDSCounterRltnp || []),
      ...(element.productTypePostingCategoryDSRestrcitionRltnp || []),
      ...(element.productTypePostingCategoryDSCDRltnpList || []),
      ...(element.productTypePostingCategoryDSComsRltnp || [])
    ].forEach(rel => {
      if (
        rel.resourceItemIdentifier !== undefined &&
        rel.resourceItemIdentifier !== null
      ) {
        channelIds.add(rel.resourceItemIdentifier);
      }
    });

    // 2. Build channel objects for each unique channelId
    const mappedChannels = Array.from(channelIds).map(channelId => {
      // Find label for channel (from this.channels loaded in dropdown)
      let channelLabel =
        this.channels.find(c => String(c.value) === String(channelId))?.label ??
        channelId;
      if (channelId === 0 || channelId === '0') channelLabel = 'All';

      // Filter relationships for this channel
      const countersForChannel = (
        element.productTypePostingCategoryDSCounterRltnp || []
      )
        .filter(c => String(c.resourceItemIdentifier) === String(channelId))
        .map(counter => ({
          code: counter.counterIdentifier,
          classificationType: counter.classificationType || '',
          operatorType: counter.counterOperationType || ''
        }));

      const restrictionsForChannel = (
        element.productTypePostingCategoryDSRestrcitionRltnp || []
      )
        .filter(r => String(r.resourceItemIdentifier) === String(channelId))
        .map(restriction => ({
          restrictionIdentifier: restriction.restrictionIdentifier,
          restrictionClassificationType:
            restriction.restrictionClassificationType || ''
        }));

      const conditionsForChannel = (
        element.productTypePostingCategoryDSCDRltnpList || []
      )
        .filter(
          cond => String(cond.resourceItemIdentifier) === String(channelId)
        )
        .map(condition => ({
          conditionIdentifier: condition.conditionIdentifier,
          cdarValue: condition.cdarValue || '',
          optionalityType: condition.optionalityType || ''
        }));

      const communicationsForChannel = (
        element.productTypePostingCategoryDSComsRltnp || []
      )
        .filter(
          comm => String(comm.resourceItemIdentifier) === String(channelId)
        )
        .map(communication => {
          const commMaster = this.communications?.find(
            c =>
              String(c.serviceElementIdentifier) ===
              String(communication.serviceElementIdentifier)
          );
          return {
            serviceElementIdentifier: communication.serviceElementIdentifier,
            commServiceIdentifier: communication.commServiceIdentifier,
            serviceElementCode: commMaster ? commMaster.serviceElementCode : ''
          };
        });

      return {
        channel: channelLabel,
        option: '', // Option not available, set empty or default
        counters: countersForChannel,
        restrictions: restrictionsForChannel,
        conditions: conditionsForChannel,
        communications: communicationsForChannel
      };
    });
    const sortedChannels = mappedChannels.sort((a, b) => {
    if (a.channel === 'All') return -1;
    if (b.channel === 'All') return 1;
    return 0;
  });

    // 3. Set channelsTable data
    this.channelsTable.datasource.data = sortedChannels;

    this.cdr.detectChanges();
  }

  transactionCategoryData: TransactionCategoryList[] = [];

  getTransactionCategories(): void {
    this.transactionCategoryService
      .retrieveTransactionCategory()
      .subscribe(response => {
        console.log(
          'Transaction Category API response:',
          JSON.stringify(response, null, 2)
        );
        if (response.status === 'SUCCESS' && response.data) {
          this.transactionCategoryData = response.data.map((item: any) => {
            const postingCategory = item.PostingCategory?.postingCategory || {};
            const relationships = item.PostingCategory || {};

            const transactionCategoryData: TransactionCategoryList = {
              identifier: postingCategory.identifier,
              code: postingCategory.code || '',
              name: postingCategory.name || '',
              transactionCategoryInquiry: [
                {
                  id: 0,
                  label: 'Code',
                  value: postingCategory.code
                },
                {
                  id: 1,
                  label: 'Name',
                  value: postingCategory.name
                }
              ],
              productTypePostingCategoryDSCounterRltnp:
                relationships.productTypePostingCategoryDSCounterRltnpList ||
                [],
              productTypePostingCategoryDSRestrcitionRltnp:
                relationships.productTypePostingCategoryDSRestrcitionRltnpList ||
                [],
              productTypePostingCategoryDSCDRltnpList:
                relationships.productTypePostingCategoryDSCDRltnpList || [],
              productTypePostingCategoryDSComsRltnp:
                relationships.productTypePostingCategoryDSComsRltnpList || []
            };
            console.log(
              'Mapped TransactionCategoryData:',
              JSON.stringify(transactionCategoryData, null, 2)
            );
            return transactionCategoryData;
          });

          this.TransactionCategoryMetaData.datasource.data =
            this.transactionCategoryData;
        }
      });
  }

  public ConfirmData: BodConfirmDialogModel = {
    title: 'BOD.metadataconfig.title',
    message: 'BOD.metadataconfig.message',
    confirm: 'BOD.metadataconfig.delete',
    dismiss: 'BOD.metadataconfig.cancel'
  };
  getChannelsTableForCategory(
    element: TransactionCategoryList
  ): BodTableMetadata {
    console.log(
      'TransactionCategory Element:',
      JSON.stringify(element, null, 2)
    );
    const tableData: BodTableMetadata = {
      ...this.channelsTable,
      datasource: new MatTableDataSource(
        Array.isArray(this.channelsTable.datasource.data)
          ? [...this.channelsTable.datasource.data]
          : []
      )
    };

    // Print only the raw data array, not the whole MatTableDataSource object
    // console.log('Channels Table Data:', tableData.datasource.data);

    return tableData;
  }

 getCountersTableForChannel(channel: any): BodTableMetadata {
  const seen = new Set<string>();
  const mappedCounters = (channel.counters || [])
    .filter(counter => {
      const key = String(counter.identifier ?? counter.code);
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    })
    .map(counter => {
      // Use identifier for matching, fallback to code if not present
      const master = this.countersMasterList?.find(
        c => String(c.identifier) === String(counter.identifier ?? counter.code)
      );
      return {
        ...counter,
        code: master ? master.code : counter.code,
        classificationType: master
          ? master.classificationType
          : counter.classificationType
      };
    });

  return {
    ...this.countersTable,
    datasource: new MatTableDataSource(mappedCounters)
  };
}

getRestrictionsTableForChannel(channel: any): BodTableMetadata {
  const seen = new Set<string>();
  const mappedRestrictions = (channel.restrictions || [])
    .filter(restriction => {
      const key = String(restriction.restrictionIdentifier);
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    })
    .map(restriction => {
      const master = this.restrictionsMasterList?.find(
        r => String(r.identifier) === String(restriction.restrictionIdentifier)
      );
      return {
        code: master ? master.code : restriction.restrictionIdentifier, // <-- shows code
        type: restriction.restrictionClassificationType
      };
    });

  return {
    ...this.restrictionsTable,
    datasource: new MatTableDataSource(mappedRestrictions)
  };
}
  getConditionsTableForChannel(channel: any): BodTableMetadata {
    const seen = new Set<string>();
    const mappedConditions = (channel.conditions || [])
      .filter(condition => {
        const key = String(condition.conditionIdentifier);
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      })
      .map(condition => {
        const master = this.conditionsMasterList?.find(
          c => String(c.identifier) === String(condition.conditionIdentifier)
        );
        return {
          cdarValue: master
            ? master.cdarValue
            : condition.cdarValue || condition.conditionIdentifier,
          relationshipType: condition.optionalityType || ''
        };
      });

    return {
      ...this.conditionsTable,
      datasource: new MatTableDataSource(mappedConditions)
    };
  }
  getCommunicationsTableForChannel(channel: any): BodTableMetadata {
    // Deduplicate by commServiceIdentifier
    const seen = new Set<string>();
    const mappedCommunications = (channel.communications || [])
      .filter(comm => {
        const key = String(comm.commServiceIdentifier);
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      })
      .map(comm => {
        const master = this.communicationsMasterList?.find(
          c => String(c.identifier) === String(comm.commServiceIdentifier)
        );
        return {
          serviceElement: comm.serviceElementCode,
          communicationServices: master
            ? master.code
            : comm.commServiceIdentifier
        };
      });

    return {
      ...this.communicationsTable,
      datasource: new MatTableDataSource(mappedCommunications)
    };
  }

  iconActionClicked(event: BodTableAction, element: TransactionCategoryList) {
    this.isEdit = true;
    this.messages = [];
    if (event.id === BodTableActionType.EDIT) {
      this.editTransactionCategoryRow(element);
    } else if (event.id === 1) {
      const confirmDataWithCode: BodConfirmDialogModel = {
        ...this.ConfirmData,
        message: `${'Are you sure you want to delete'} ${element.code}`
      };
      this.bodConfirmAlertDialogsService
        .confirm(confirmDataWithCode)
        .subscribe(val => {
          if (val) {
            this.TransactionCategoryDelete(element);
          }
        });
    }
  }

  public message: NotificationMessage | undefined;

  TransactionCategoryDelete(element: TransactionCategoryList): void {
    if (element.identifier) {
      this.transactionCategoryService
        .deleteTransactionCategory('PostingCategory', element.identifier)
        .subscribe(response => {
          const successMsg = `${element.code} Deleted Successfully`;
          this.message = {
            code: '204',
            text: successMsg,
            type: NotificationMessageType.SUCCESS
          };
          this.messages.push(this.message);
          setTimeout(() => {
            this.messages = this.messages.filter(
              msg => msg.text !== successMsg
            );
          }, 20000);

          this.getTransactionCategories();
          this.metadataService.retrieveAll().subscribe((response: any) => {
            const firstStatus =
              response?.data &&
              response.data.length > 0 &&
              response.data[0]?.MetadataStatus
                ? response.data[0].MetadataStatus
                : null;
            const statusToSet = firstStatus || 'NEW';
            this.statusControl.setValue(statusToSet);
            this.previousStatus = statusToSet;
            this.statusChanged.emit(statusToSet);
            this.transactionCategoryService.updateCurrentStatus(statusToSet);
          });
        });
    }
  }

  editTransactionCategory: TransactionCategoryList | undefined;

  private editTransactionCategoryRow(element: TransactionCategoryList) {
    this.editTransactionCategory = element;
    const dialogModel: BodCommonDialogModel = {
      formTemplate: this.addNewTransactionCategoryTemp,
      title: 'Edit Transaction Category'
    };
    this.openDialog(dialogModel);
  }
}
























