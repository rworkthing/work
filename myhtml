<bod-message-container rufId [messages]="messages"></bod-message-container>
{{messages}}
<bod-page-container
  rufId
  [title]="'Role Type Details' | translate"
></bod-page-container>
<bod-table
  #customTable
  [customColumnTemplates]="[
    {
      columnName: 'actions',
      templateName: editActionTemplate
    }
  ]"
  [data]="roleTypeTableMetaData"
  [tableActions]="roleTypeTableActions"
  (onTableActionClick)="onTableActionClicked1($event)"
  [expandedRowTemplate]="expandedRowTemplate"
  (onRowExpand)="rowExpanded($event)"
>
  <ng-template
    #editActionTemplate
    let-element="element"
    let-column="column"
    let-index="index"
  >
    <bod-table-actions 
      sectionActions
      [actions]="editactions1"
      (onActionClick)="iconActionClicked($event, element)"
    >
    </bod-table-actions>
  </ng-template>
  <ng-template #expandedRowTemplate let-context="context">
    <div fullwidth>
      @if(context.element.name){
      <h1>Role Type</h1>
      <bod-inquiry-layout
        [columns]="2"
        [groups]="roleTypeService.getRoleTypeData(context.element)"
        [softSeparator]="false"
        [direction]="direction"
        [information]="[]"
        (linkClick)="commonDataService.inquiryLayoutClick($event)"
      >
      </bod-inquiry-layout>
      }

      <bod-table
        [data]="roleRelationshipTable"
        [alignContent]="'top'"
        [innerTableContext]="context"
        [expandedRowTemplate]="expandedRowTemplate"
      >
        <ng-template #expandedRowTemplate let-context="context">
          <bod-inquiry-layout
            [columns]="2"
            [groups]="
              roleTypeService.getRoleRelationshipTypeData(context.element)
            "
            [softSeparator]="false"
            [direction]="direction"
            [information]="[]"
            (linkClick)="commonDataService.inquiryLayoutClick($event)"
          >
          </bod-inquiry-layout>
        </ng-template>
      </bod-table>
      <h1>Role Category Relationships</h1>
      <bod-inquiry-layout
        [columns]="2"
        [groups]="roleTypeService.getAddtnlReltns(context.element)"
        [softSeparator]="false"
        [direction]="direction"
        [information]="[]"
        (linkClick)="commonDataService.inquiryLayoutClick($event)"
      >
      </bod-inquiry-layout>
    </div>
  </ng-template>
</bod-table>

<ng-template #addNewRoleTypeTemplate>
  <bod-add-edit-roletype 
  (apiResponse)="addRoleTypeEvent($event)"
  [editRoleTypeRow]="editRoleType">
  </bod-add-edit-roletype>
</ng-template>

<ng-template #addExistingRoleTypeTemplate>
  <bod-existing-role-type 
  (apiResponse)="addRoleTypeEvent($event)"
  [editRoleTypeRow]="editRoleType">
  </bod-existing-role-type>
</ng-template>
