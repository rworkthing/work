<bod-form
  [formGroup]="addNewRoleTypeFormGroup"
  rufId
  [type]="formType"
  (onSubmit)="onAddNewRoleType(isAdd)"
  fisStyle
>
  <bod-input-layout col="2">
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.code'"
      [forTextOnly]="true"
      [required]="true"
    >
      <div *ngIf="isEdit">
        {{ addNewRoleTypeFormGroup.get('roleTypeCode')?.value }}
      </div>
      <mat-form-field appearance="outline" fisStyle *ngIf="!isEdit">
        <input
          type="text"
          matInput
          fisStyle
          formControlName="roleTypeCode"
          name="roleTypeCode"
        />
        <mat-error>
          {{ getError('roleTypeCode',addNewRoleTypeFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
    <!-- <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.identifier'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <input
          type="text"
          matInput
          fisStyle
          formControlName="roleTypeIdentifier"
          name="roleTypeIdentifier"
        />
        <mat-icon
          class="fis-icon-md"
          matSuffix
          rufId
          fisIcon="search"
          (click)="identifierSearch('roleTypeIdentifier')"
        ></mat-icon>
        <mat-error>
          {{ getError('roleTypeIdentifier') | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group> -->
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.name'"
      [forTextOnly]="true"
      [required]="false"
    >
      <mat-form-field appearance="outline" fisStyle>
        <input
          type="text"
          matInput
          fisStyle
          formControlName="roleTypeName"
          name="roleTypeName"
        />
        <mat-error>
          {{ getError('roleTypeName',addNewRoleTypeFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.shortname'"
      [forTextOnly]="true"
      [required]="false"
    >
      <mat-form-field appearance="outline" fisStyle>
        <input
          type="text"
          matInput
          fisStyle
          formControlName="roleTypeShortName"
          name="roleTypeShortName"
        />
        <mat-error>
          {{ getError('roleTypeShortName',addNewRoleTypeFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.category'"
      [forTextOnly]="true"
      [required]="false"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="category"
          name="category"
        >
          <mat-option
            *ngFor="let category of categorys"
            [value]="category.value"
          >
            {{ category.label }}
          </mat-option>
        </mat-select>
      </mat-form-field>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.classification'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="classification"
          name="classification"
        >
          <mat-option
            *ngFor="let classification of classifications"
            [value]="classification.value"
          >
            {{ classification.label }}
          </mat-option>
        </mat-select>
        <mat-error>
          {{ getError('classification',addNewRoleTypeFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.systemDefined'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-slide-toggle
        fisStyle
        color="primary"
        formControlName="systemDefined"
        name="systemDefined"
      >
      </mat-slide-toggle>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.isCalculated'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-slide-toggle
        fisStyle
        color="primary"
        formControlName="isCalculated"
        name="isCalculated"
      >
      </mat-slide-toggle>
    </bod-control-group>
  </bod-input-layout>

  <bod-table
    #roleRelationshipTable
    [data]="roleRelationshipTabledata"
    [tableActions]="roleRelationshipTableActions"
    (onTableActionClick)="onValidTableActionClicked($event)"
    [expandedRowTemplate]="expandedRowTemplate"
    [inlineModal]="{
      addNewInlineRowTitle: 'New Role Relationship' | translate,
      formGroup: roleRelationshipForm,
      formTemplateName: roleRelationshipTemplate
    }"
    (onInlineFormAddSubmit)="onAddRoleRelationship(roleRelationshipForm.value)"
    (onInlineFormEditSubmit)="onAddRoleRelationship(roleRelationshipForm.value)"
    (onInlineEditRowActionClick)="inlineEditRowActionClick($event)"
    (onInlineAddRowActionClick)="inlineAddRowActionClick()"
    [customColumnTemplates]="[
      {
        columnName: 'actions',
        templateName: deleteRoleRelationshipActionTemplate
      }
    ]"
    [alignContent]="'top'"
  >
    <ng-template
      #deleteRoleRelationshipActionTemplate
      let-element="element"
      let-column="column"
      let-index="index"
    >
      <bod-table-actions
        [actions]="rowLevelActionsForBasicEdit"
        (onActionClick)="
          handleRowLevelActionsforRoleRelationship($event.icon, index)
        "
      >
      </bod-table-actions>
    </ng-template>
    <ng-template #expandedRowTemplate let-context="context">
      <div fullwidth>
        <bod-inquiry-layout
          [columns]="2"
          [groups]="
            roleTypeService.getExpandedRelationshipData(context.element)
          "
          [softSeparator]="false"
          [direction]="direction"
          [information]="[]"
          (linkClick)="commonDataService.inquiryLayoutClick($event)"
        >
        </bod-inquiry-layout>
      </div>
    </ng-template>
  </bod-table>
  <form [formGroup]="roleRelationshipForm">
    <ng-template #roleRelationshipTemplate>
      <bod-input-layout col="2">
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.customerType'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <mat-select
              panelClass="fis-style"
              formControlName="customerType"
              name="customerType"
            >
              <mat-option
                *ngFor="let customerType of customerTypes"
                [value]="customerType.value"
              >
                {{ customerType.label }}
              </mat-option>
            </mat-select>
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.maximumAccountAllowed'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="number"
              matInput
              fisStyle
              formControlName="maximumAccountAllowed"
              name="maximumAccountAllowed"
            />
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.minimum'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="number"
              matInput
              fisStyle
              formControlName="minimumRequired"
              name="minimumRequired"
            />
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.maximum'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="number"
              matInput
              fisStyle
              formControlName="maximumAllowed"
              name="maximumAllowed"
            />
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.primary'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="primary"
            name="primary"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.percentageAllowed'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="percentageAllowed"
            name="percentageAllowed"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.applicableOrder'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="applicableOrder"
            name="applicableOrder"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.signatureRequired'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-slide-toggle
            fisStyle
            color="primary"
            formControlName="signatureRequired"
            name="signatureRequired"
          >
          </mat-slide-toggle>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.ownerCategory'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="text"
              matInput
              fisStyle
              formControlName="ownerCategory"
              name="ownerCategory"
            />
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.ownerSubCategory'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="text"
              matInput
              fisStyle
              formControlName="ownerSubCategory"
              name="ownerSubCategory"
            />
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.additionalDetails'"
          [forTextOnly]="true"
          [required]="false"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="text"
              matInput
              fisStyle
              formControlName="additionalDetails"
              name="additionalDetails"
            />
          </mat-form-field>
        </bod-control-group>
      </bod-input-layout>
    </ng-template>
  </form>
  <bod-page-container title="Role Category Relationship"></bod-page-container>
  <bod-input-layout [col]="1">
    <bod-control-group
      label="{{ 'Category' | translate }}"
      [forTextOnly]="true"
      [required]="true"
    >
      <bod-auto-complete
        #nameElementRef
        formControlName="category1"
        name="category1"
        name="autoCompleteFieldMultiConv"
        [data]="roleCategoryMultidata"
      >
      </bod-auto-complete>
      <mat-error>
        {{ getError('category1',addNewRoleTypeFormGroup) | translate }}
      </mat-error>
    </bod-control-group>
  </bod-input-layout>

