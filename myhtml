export class TaxTypeDefinitionDialogComponent implements OnInit {
  taxDefinitionTableMetadata: BodTableMetadata;
  selectedTaxDefinitions: TaxDefinition[] = [];
  selectedTaxTypeIdentifier: number | null = null;
  loading = true;
  hasSelection = false;

  // Define columns for the tax definition table
  private taxDefinitionColumns: Column[] = [
    {
      name: 'code',
      title: 'Code',
      truncate: true,
      noOverflow: true,
      width: 12,
      widthUnit: 'rem'
    },
    {
      name: 'region',
      title: 'Region',
      truncate: true,
      noOverflow: true,
      width: 10,
      widthUnit: 'rem'
    },
    {
      name: 'partyClassification',
      title: 'Party Classification',
      truncate: true,
      noOverflow: true,
      width: 12,
      widthUnit: 'rem'
    },
    {
      name: 'rate',
      title: 'Rate',
      truncate: true,
      noOverflow: true,
      width: 8,
      widthUnit: 'rem'
    },
    {
      name: 'taxAmount',
      title: 'Tax Amount',
      truncate: true,
      noOverflow: true,
      width: 10,
      widthUnit: 'rem'
    },
    {
      name: 'thresholdTaxAmount',
      title: 'Threshold Tax Amount',
      truncate: true,
      noOverflow: true,
      width: 12,
      widthUnit: 'rem'
    }
  ];

  constructor(
    @Inject(MAT_DIALOG_DATA) public data: { selectedTaxTypeIdentifier?: number },
    private transactionTypeService: TransactionTypeService,
    private dialogRef: MatDialogRef<TaxTypeDefinitionDialogComponent>
  ) {
    this.selectedTaxTypeIdentifier = data?.selectedTaxTypeIdentifier || null;
  }

  ngOnInit() {
    this.loadTaxDefinitions();
  }

  private loadTaxDefinitions(): void {
    this.loading = true;
    
    this.transactionTypeService.getTaxDefinition().subscribe({
      next: (taxDefinitions: any[]) => {
        console.log('Raw tax definitions:', taxDefinitions);
        
        // Transform the raw data to match our TaxDefinition interface
        const transformedData: TaxDefinition[] = taxDefinitions.map((item, index) => ({
          id: item.identifier || index + 1,
          identifier: item.identifier,
          code: item.code,
          taxTypeIdentifier: item.taxTypeIdentifier,
          region: item.region,
          partyClassification: item.partyClassification,
          rate: item.rate || 0,
          taxAmount: item.taxAmount || 0,
          thresholdTaxAmount: item.thresholdTaxAmount || 0,
          currencyIdentifier: item.currencyIdentifier || 0
        }));

        console.log('Transformed tax definitions:', transformedData);
        console.log('Selected tax type identifier:', this.selectedTaxTypeIdentifier);

        // Create table metadata
        this.taxDefinitionTableMetadata = {
          title: 'Tax Definitions',
          columns: this.taxDefinitionColumns,
          rowLeftAction: undefined, // No row left action for selection
          enablePagination: true,
          paginationOptions: {
            pageSize: 10,
            length: transformedData.length,
            pageSizeOptions: [5, 10, 20],
            showLastButton: true,
            showPageSizeOptions: true
          },
          datasource: new MatTableDataSource<TaxDefinition>(transformedData),
          noRecordsMessage: 'No tax definitions available'
        };

        this.loading = false;
        console.log('Tax definition table metadata created:', this.taxDefinitionTableMetadata);
      },
      error: (error) => {
        console.error('Error loading tax definitions:', error);
        this.loading = false;
        
        // Create empty table metadata on error
        this.taxDefinitionTableMetadata = {
          title: 'Tax Definitions',
          columns: this.taxDefinitionColumns,
          datasource: new MatTableDataSource<TaxDefinition>([]),
          noRecordsMessage: 'Error loading tax definitions'
        };
      }
    });
  }

  onRowSelected(selectedDefinitions: TaxDefinition[]): void {
    console.log('Tax definitions selected in dialog:', selectedDefinitions);
    this.selectedTaxDefinitions = selectedDefinitions;
    this.hasSelection = selectedDefinitions.length > 0;
  }

  onTableDirtyChange(dirty: boolean): void {
    // Handle table dirty state if needed
    console.log('Tax definition table dirty state:', dirty);
  }
}





























