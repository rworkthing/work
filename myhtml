<bod-message-container [messages]="errorMessages"></bod-message-container>
<bod-form
  [formGroup]="existingRestrictionFormGroup"
  rufId
  [type]="formType"
  (onSubmit)="onRelateExistingRestriction()"
  (onReset)="onReset()"
  fisStyle
>
  <bod-input-layout col="2">
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.code'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="childRestriction"
          name="childRestriction"
          (selectionChange)="onChildRestrictionChange($event)"
        >
          <mat-option
            *ngFor="let restriction of availableRestrictions"
            [value]="restriction.identifier"
          >
            {{ restriction.code }}
          </mat-option>
        </mat-select>
        <mat-error>
         {{ getError('childRestriction', existingRestrictionFormGroup) | translate }}
        </mat-error>
      </mat-form-field>
    </bod-control-group>
   
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.name'"
      [forTextOnly]="true"
      [required]="true"
    >
      <div *ngIf="selectedRestrictionDetails">
        {{ selectedRestrictionDetails.name }}
      </div>
      <mat-form-field appearance="outline" fisStyle *ngIf="!selectedRestrictionDetails">
        <input
          type="text"
          matInput
          fisStyle
          formControlName="restrictionName"
          name="restrictionName"
          readonly
        />
      </mat-form-field>
    </bod-control-group>
  </bod-input-layout>
  
  <bod-input-layout col="2">
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.classificationtype'"
      [forTextOnly]="true"
      [required]="true"
    >
      <div *ngIf="selectedRestrictionDetails">
        {{ selectedRestrictionDetails.classificationType }}
      </div>
      <mat-form-field appearance="outline" fisStyle *ngIf="!selectedRestrictionDetails">
        <input
          type="text"
          matInput
          fisStyle
          formControlName="classificationtype"
          name="classificationtype"
          readonly
          
        />
      </mat-form-field>
    </bod-control-group>
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.description'"
      [forTextOnly]="true"
      [required]="true"
    >
      <div *ngIf="selectedRestrictionDetails">
        {{ selectedRestrictionDetails.description }}
      </div>
      <mat-form-field appearance="outline" fisStyle *ngIf="!selectedRestrictionDetails">
        <input
          type="text"
          matInput
          fisStyle
          formControlName="description"
          name="description"
          readonly
          
        />
      </mat-form-field>
    </bod-control-group>
    
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.processMode'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="processMode"
          name="processMode"
        >
          <mat-option
            *ngFor="let processMode of processModes"
            [value]="processMode.value"
          >
            {{ processMode.label }}
          </mat-option>
        </mat-select>
      </mat-form-field>
    </bod-control-group>
 
    <bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.activityType'"
      [forTextOnly]="true"
      [required]="true"
    >
      <mat-form-field appearance="outline" fisStyle>
        <mat-select
          panelClass="fis-style"
          formControlName="activityType"
          name="activityType"
        >
          <mat-option
            *ngFor="let activityType of activityTypes"
            [value]="activityType.value"
          >
            {{ activityType.label }}
          </mat-option>
        </mat-select>
      </mat-form-field>
    </bod-control-group>
  </bod-input-layout>

  <h1>Restriction Relationship</h1>
  <bod-input-layout col="1">
    <!--<bod-control-group
      [truncate]="false"
      [label]="translationKey + 'metadataconfig.isExclude'"
      [forTextOnly]="true"
      [required]="false"
    >
      <mat-slide-toggle
        fisStyle
        color="primary"
        formControlName="isExclude"
        name="isExclude"
      >
      </mat-slide-toggle>
    </bod-control-group>-->
  </bod-input-layout>

   <!-- Period Type Section -->
  <bod-period-type
    #periodTypeRef
    [periodTypeData]="periodTypeTableData"
    (completeDeltaChangePeriodType)="handleCompleteDeltaChangePeriodType($event)"
    (tableDirty)="onTableDirty()"
  ></bod-period-type>

</bod-form>




















import {
  ChangeDetectorRef,
  Component,
  EventEmitter,
  Output,
  ViewChild,
  OnInit
} from '@angular/core';
import { CommonModule } from '@angular/common';
import {
  AbstractControl,
  FormBuilder,
  FormControl,
  FormGroup,
  FormsModule,
  ReactiveFormsModule,
  UntypedFormControl,
  UntypedFormGroup,
  ValidationErrors,
  ValidatorFn,
  Validators
} from '@angular/forms';
import {
  BodCommonDialogService,
  BodCommonModule,
  BodCurrencyControlModule,
  BodDynamicFormModule,
  BodFormModule,
  BodFormStateService,
  BodFormTypes,
  BodPageContainerModule,
  BodTableAction,
  BodTableActionsModule,
  BodTableActionType,
  BodTableComponent,
  BodTableMetadata,
  BodTableModule,
  CommonDialogComponent,
  ControlGroupModule,
  DirectivesModule,
  EditTableAction,
  EditTableEventData,
  InlineEditOutput,
  InputLayoutModule,
  InquiryLayoutModule,
  MessageContainerModule,
  ModeOptions,
  NotificationMessage,
  NotificationMessageType,
  RowLeftAction,
  SearchFieldModule,
  SectionContainerModule
} from '@bod/common';
import { TranslationKey } from '../../metadat-config/codegen-config.constant';
import { RestrictionService } from '../restriction-service';
import { PeriodTypeComponent } from '../add-edit-restriction-details/period-type/period-type.component';

import { MatIconModule } from '@angular/material/icon';
import { RufIconModule } from '@ruf/shell/icon';
import { MatButtonModule } from '@angular/material/button';
import { MatSlideToggleModule } from '@angular/material/slide-toggle';
import { MatTabsModule } from '@angular/material/tabs';
import { TranslateModule } from '@ngx-translate/core';
import { MatDatepickerModule } from '@angular/material/datepicker';
import { MatInputModule } from '@angular/material/input';
import { MatSelectModule } from '@angular/material/select';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatButtonToggleModule } from '@angular/material/button-toggle';
import { MatTableDataSource } from '@angular/material/table';
import { FormUtilityService } from '../../metadat-config/form-utility.service';
import { MatDialogRef } from '@angular/material/dialog';
import { MetadataService } from '../../metadat-config/metada-config.service';

interface ExistingRestriction {
  identifier: number;
  code: string;
  name: string;
  classificationType: string;
  description: string;
}

@Component({
  selector: 'bod-existing-restriction',
  standalone: true,
  imports: [
    CommonModule,
    PeriodTypeComponent,
    InquiryLayoutModule,
        SearchFieldModule,
        MatIconModule,
        RufIconModule,
        DirectivesModule,
        MatButtonModule,
        MatSlideToggleModule,
        MatTabsModule,
        CommonModule,
        TranslateModule,
        BodPageContainerModule,
        BodTableModule,
        TranslateModule,
        BodTableActionsModule,
        FormsModule,
        InputLayoutModule,
        BodFormModule,
        ControlGroupModule,
        MatFormFieldModule,
        MatSelectModule,
        MatDatepickerModule,
        ReactiveFormsModule,
        BodDynamicFormModule,
        SectionContainerModule,
        MatInputModule,
        TranslateModule,
        MessageContainerModule,
        MatButtonToggleModule,
        BodCurrencyControlModule,
        MatDatepickerModule,
        BodCommonModule
  ],
  templateUrl: './existing-restriction.component.html',
  styleUrl: './existing-restriction.component.scss'
})
export class ExistingRestrictionComponent implements OnInit {
  public translationKey = TranslationKey;
  public existingRestrictionFormGroup: UntypedFormGroup;
  public errorMessages: NotificationMessage[] = [];
  public availableRestrictions: ExistingRestriction[] = [];
  public selectedRestrictionDetails: ExistingRestriction | null = null;
  public periodTypeTableData: any[] = [];
  public formType = 'edit';
  

  @ViewChild('periodTypeRef') periodTypeRef: PeriodTypeComponent;
  @Output() apiResponse: EventEmitter<any> = new EventEmitter<any>();

  
  processModes = [
    { label: 'Any', value: 'Any' },
    { label: 'Automatic', value: 'Automatic' },
    { label: 'Manual', value: 'Manual' }
  ];

  activityTypes = [
    { label: 'Non Monetory', value: 'Non Monetory' },
    { label: 'Inquiry', value: 'Inquiry' },
    { label: 'Monetory', value: 'Monetory' }
  ];
  public messages: NotificationMessage[] = [];
  public message: NotificationMessage | undefined;
  constructor(
    private fb: FormBuilder,
    private restrictionService: RestrictionService,
    private changeDetectorRef: ChangeDetectorRef,
    private metadataService: MetadataService
  ) {}

  ngOnInit() {
    this.initForm();
    this.loadAvailableRestrictions();
  }

  private initForm(): void {
    this.existingRestrictionFormGroup = this.fb.group({
      childRestriction: ['', Validators.required],
      restrictionName: [''],
      classificationtype: ['', Validators.required],
      description: ['', Validators.required],
      processMode: new UntypedFormControl('', [Validators.required]),
      activityType: new UntypedFormControl('', [Validators.required]),
      isExclude: [false]
    });
  }

  private getInvalidRequiredFields(formGroup: FormGroup): string[] {
    const invalidFields: string[] = [];

    Object.keys(formGroup.controls).forEach(key => {
      const control = formGroup.get(key);
      if (control && control.errors?.['required']) {
        invalidFields.push(key);
      }
    });

    return invalidFields;
  }
  private successResponse(resp, restrictionData) {
    const restrictionCode = this.selectedRestrictionDetails?.code;
    const SuccessMsg = `${restrictionCode} related successfully`;
    this.apiResponse.emit({ ...restrictionData, SuccessMsg });
  }
  
  private handleError(error: any) {
    let errorMsg = '';

    if (error.errorCode === 'FORM_INVALID' || error.status === 400) {
      if (error.missingFields?.length) {
        errorMsg = `Please fill the required fields.`;
      } else {
        errorMsg = 'Please fill the required fields.';
      }
    }
    else if (error.errorCode === 'NO_RESTRICTION_SELECTED') {
      errorMsg = 'Please select a restriction from the dropdown.';
    } else if (error.errorCode === 'PERIOD_TYPE_REQUIRED') {
      errorMsg = 'Child Restriction is required for all rows.';
    } else if (error.errorCode === 'DUPLICATE_PERIOD_TYPE') {
    errorMsg = 'Duplicate period types found: ' +
      (error.duplicateNames ? error.duplicateNames : '');
  } else if (error.errorCode === 'RESTRICTION_ALREADY_EXISTS') {
      errorMsg = 'Restriction relationship already exists.';
    }else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_005") {
      errorMsg = 'Restriction relationship already exists.';
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_004") {
      errorMsg = error.error?.errorDescription || 'Restriction relationship already exists.';
    } else if (error.error?.errorCode === "MBP_SDK_BUS_ERR_048") {
      errorMsg = error.error?.errorDescription || 'This Metadata cannot be created.';
    }else {
      errorMsg = 'Unknown error occurred.';
    }

    this.message = {
      code: error.errorCode,
      text: errorMsg,
      type: NotificationMessageType.ERROR
    };
    this.errorMessages.push(this.message);

    // Auto-remove error messages after 10 seconds
    setTimeout(() => {
      this.errorMessages = this.errorMessages.filter(msg => msg.text !== errorMsg);
    }, 10000);
  }

  private loadAvailableRestrictions(): void {
    this.restrictionService.getRestrictions().subscribe({
      next: (restrictions) => {
        this.availableRestrictions = restrictions.map((r: any) => ({
          identifier: r.identifier,
          code: r.code,
          name: r.name || r.description,
          classificationType: r.classificationType,
          description: r.description 
        }));
      },
      error: () => {
        // Fallback to mock data
        this.availableRestrictions = [
          { identifier: 1, code: 'CR001', name: 'Restriction 1', classificationType: 'Type A' , description: ''},
          { identifier: 2, code: 'CR002', name: 'Restriction 2', classificationType: 'Type B' , description: ''}
        ];
      }
    });
  }

  onChildRestrictionChange(event: any): void {
    const selectedId = event.value;
    this.selectedRestrictionDetails = this.availableRestrictions.find(r => r.identifier === selectedId) || null;
    this.existingRestrictionFormGroup.patchValue({
      restrictionName: this.selectedRestrictionDetails?.name || '',
      classificationtype: this.selectedRestrictionDetails?.classificationType || '',
      description: this.selectedRestrictionDetails?.description || ''
    });
  }

  getError(control: string, formGroup: FormGroup): string {
    const fc: AbstractControl = formGroup.get(control);
    if (fc && fc.errors && fc.touched) {
      return 'Please fill the required fields.'; // Replace with your error logic
    }
    return '';
  }

  handleCompleteDeltaChangePeriodType(data: any) {
    // Handle period type changes
  }

  onTableDirty(): void {
    // Handle table dirty state
  }

  onRelateExistingRestriction($event?: any) {
    this.submitForm();
  }

  submitForm() {
    this.errorMessages = [];

    if (this.existingRestrictionFormGroup.invalid) {
      this.existingRestrictionFormGroup.markAllAsTouched();
      const missingFields = this.getInvalidRequiredFields(this.existingRestrictionFormGroup);
      this.handleError({
        errorCode: 'FORM_INVALID',
        status: 400,
        missingFields
      });
      return;
    }

    // Get product type data from metadata service
    const productTypeKeys = this.metadataService.getProductTypeKeys();
    const productTypeValues = this.metadataService.getProductTypeValues();
    const formValue = this.existingRestrictionFormGroup.getRawValue();

    // Get period type data
    const periodTypeList = this.periodTypeRef?.getCurrentTablePeriodType() || [];

    // Check if any row has empty childRestriction
    const hasEmptyChildRestriction = periodTypeList.some(pt => !pt.childRestriction || pt.childRestriction.trim() === '');
    if (hasEmptyChildRestriction) {
      this.handleError({
        errorCode: 'PERIOD_TYPE_REQUIRED',
        status: 412
      });
      return;
    }

     if (!this.selectedRestrictionDetails) {
      this.handleError({
        errorCode: 'NO_RESTRICTION_SELECTED',
        status: 400
      });
      return;
    }

    // Check for duplicate childRestriction values
    const childRestrictions = periodTypeList.map(pt => pt.childRestriction?.trim());
    const duplicates = childRestrictions.filter((type, idx, arr) => type && arr.indexOf(type) !== idx && arr.lastIndexOf(type) === idx);
    if (duplicates.length > 0) {
      this.handleError({
        errorCode: 'DUPLICATE_PERIOD_TYPE',
        status: 413,
        duplicateNames: duplicates.join(', ')
      });
      return;
    }

    // Build productElementExceptionRltnList
    const productElementExceptionRltnList = productTypeKeys.map((code, index) => ({
      productTypeIdentifier: productTypeValues[index],
      exceptionIdentifier: this.selectedRestrictionDetails.identifier,
      exceptionCode: this.selectedRestrictionDetails.code,
      exceptionValue: this.selectedRestrictionDetails.classificationType,
      description : this.selectedRestrictionDetails.description,
      processMode: formValue.processMode, // or get from form/table if available
      activityType: formValue.activityType // or get from form/table if available
    }));

    // Build productElementExceptionTriggerList
    const productElementExceptionTriggerList = periodTypeList.map(period => {
      // Find the dropdown item matching the childRestriction label
      const dropdownItem = this.availableRestrictions.find(
        item => item.code === period.childRestriction
      );
      return {
        productTypeIdentifier: productTypeValues[0], // or map for each product type if needed
        exceptionParentIdentifier: this.selectedRestrictionDetails.identifier,
        exceptionChildIdentifier: dropdownItem ? dropdownItem.identifier : null, // Use id from dropdown data
        exceptionTriggerExclude: period.isExclude ? 'Y' : 'N'
      };
    });

    // Build productTypeList
    const productTypeListOut = productTypeKeys.map((code, index) => ({
      identifier: productTypeValues[index],
      code: code
    }));

    // Final request object (no exceptionDefinition)
    const restrictionData = {
      metadataType: 'Restriction',
      restrictionDetailList: [
        {
          productElementExceptionRltnList,
          productElementExceptionTriggerList
        }
      ],
      productTypeList: productTypeListOut
    };
    this.restrictionService.saveRestriction(restrictionData).subscribe({
      next: resp => this.successResponse(resp, restrictionData),
      error: (err: NotificationMessage[]) => this.handleError(err)
    });
  }

  onReset($event?: any): void {
    this.errorMessages = [];
    this.existingRestrictionFormGroup.reset();
    this.selectedRestrictionDetails = null;
    this.periodTypeTableData = [];
    if (this.periodTypeRef) {
      this.periodTypeRef.reset();
    }
    this.changeDetectorRef.detectChanges();
  }
}
