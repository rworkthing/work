@Component({
  selector: 'bod-communication-multiselect-dialog',
  standalone: true,
  imports: [
    CommunicationsMultiselectTableComponent,
    ReactiveFormsModule,
    BodFormModule,
    FormsModule,
    BodAutoCompleteModule,
    InquiryLayoutModule,
    SearchFieldModule,
    MatIconModule,
    RufIconModule,
    DirectivesModule,
    MatButtonModule,
    MatSlideToggleModule,
    MatTabsModule,
    CommonModule,
    TranslateModule,
    BodPageContainerModule,
    BodTableModule,
    TranslateModule,
    BodTableActionsModule,
    FormsModule,
    InputLayoutModule,
    BodFormModule,
    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    ReactiveFormsModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    TranslateModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    BodCommonModule
  ],
  templateUrl: './communication-multiselect-dialog.component.html',
  styleUrls: ['./communication-multiselect-dialog.component.scss']
})
export class CommunicationsMultiselectDialogComponent {
  public translationKey = TranslationKey;

  formType: BodFormTypes = BodFormTypes.FORM;
  @ViewChild('communicationsTable', { static: false }) communicationsTable: CommunicationsMultiselectTableComponent;
  @Output() rowSelected = new EventEmitter<CommunicationTable[]>();

  public initialSelectedRows: Communications[] = [];
  selectedRows: Communications[] = [];
  public addCommunicationsFormGroup: UntypedFormGroup;
  isDirty = false;

  constructor(
    public dialogRef: MatDialogRef<CommunicationsMultiselectDialogComponent>,
    @Inject(MAT_DIALOG_DATA) public data: any,
    private fb: UntypedFormBuilder
  ) {
    this.initForm();
    this.initialSelectedRows = [...(data.selectedRowSingleSelect || [])];
    this.selectedRows = [...this.initialSelectedRows];
  }

  private initForm(): void {
    const controls: { [key: string]: any } = {};
    // Always get the latest data
    const allRows = this.data?.communicationsDataSingleSelect?.datasource?.data || [];
    allRows.forEach((row: any, idx: number) => {
      controls['communicationServices_' + row.id] = [row.communicationServices || null];
    });
    this.addCommunicationsFormGroup = this.fb.group(controls);
    console.log('Dialog initForm - Form controls:', Object.keys(controls));
  }

  ngOnChanges(changes: SimpleChanges) {
    if (changes['data'] || changes['communicationData']) {
      this.initForm();
    }
  }

  onTableDirtyChange(dirty: boolean) {
    this.isDirty = dirty;
    if (dirty) {
      this.addCommunicationsFormGroup.markAsDirty();
    }
  }

  public isTableDirty = false;

  public onTableDirty(): void {
    this.isTableDirty = true;
    this.addCommunicationsFormGroup.markAsDirty();
  }

  onRowSelected(selectedRows: Communications[]) {
    console.log('onRowSelected called with:', selectedRows);
    this.selectedRows = selectedRows;
    this.isDirty = true;
    this.addCommunicationsFormGroup.markAsDirty();
    // this.initForm();
  }

  onSubmit() {
    // Pass the selectedRows object when closing the dialog
    this.dialogRef.close({ selectedCommunications: this.selectedRows });
  }

 onReset() {
    this.isDirty = false;
    // Restore to initial selection instead of clearing all
    this.selectedRows = [...this.initialSelectedRows];

    // Reset form controls to initial values
    Object.keys(this.addCommunicationsFormGroup.controls).forEach(key => {
      const rowId = Number(key.replace('communicationServices_', ''));
      const initialRow = this.initialSelectedRows.find(row => row.id === rowId);
      this.addCommunicationsFormGroup.get(key)?.setValue(initialRow ? initialRow.communicationServices : null);
    });

    // Also clear selection in the child table and re-select initial rows
    if (this.communicationsTable) {
      this.communicationsTable.resetSelection();
      setTimeout(() => {
        this.communicationsTable.selectedRowSingleSelect = [...this.initialSelectedRows];
        this.communicationsTable.selectCommunicationsRows?.();
      }, 0);
    }
  }
}

















