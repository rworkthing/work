    ControlGroupModule,
    MatFormFieldModule,
    MatSelectModule,
    MatDatepickerModule,
    BodDynamicFormModule,
    SectionContainerModule,
    MatInputModule,
    MessageContainerModule,
    MatButtonToggleModule,
    BodCurrencyControlModule,
    BodCommonModule
  ],
  templateUrl: './tax-type-definition-table.component.html',
  styleUrl: './tax-type-definition-table.component.scss'
})
export class TaxTypeDefinitionTableComponent implements OnInit, OnChanges {

  public modeOptions: ModeOptions = { input: false, reset: false };
  public modeOptionsSimple = this.modeOptions;

  @Input() taxDefinitionData: BodTableMetadata;
  @Input() selectedTaxDefinitions: TaxDefinition[] = [];
  @Input() selectedTaxTypeIdentifier: number | null = null;
  @Output() rowSelected = new EventEmitter<TaxDefinition[]>();
  @Output() dirtyChange = new EventEmitter<boolean>();
  @Input() formGroup: UntypedFormGroup;

  @ViewChild('taxDefinitionTable', { static: false })
  taxDefinitionTable: BodTableComponent;

  private isDirty = false;

  public allowRowSelection = true;
  public rowSelectionStrategy: SelectPageMode = SelectPageMode.ALL_PAGES;
  public showEdit = true;

  // Filtered data based on selected tax type identifier
  public filteredTaxDefinitions: TaxDefinition[] = [];

  constructor() { }

  ngOnInit() {
    this.filterTaxDefinitions();
  }

  ngOnChanges(changes: SimpleChanges): void {
    if (changes['selectedTaxTypeIdentifier'] || changes['taxDefinitionData']) {
      this.filterTaxDefinitions();
      if (this.selectedTaxDefinitions?.length) {
        setTimeout(() => this.selectTaxDefinitionRows(), 0);
      }
    }
  }

  private filterTaxDefinitions(): void {
    if (!this.selectedTaxTypeIdentifier || !this.taxDefinitionData?.datasource?.data) {
      this.filteredTaxDefinitions = [];
      return;
    }

    // Filter tax definitions based on selectedTaxTypeIdentifier
    const allData = this.taxDefinitionData.datasource.data as TaxDefinition[];
    this.filteredTaxDefinitions = allData.filter(
      item => item.taxTypeIdentifier === this.selectedTaxTypeIdentifier
    );

    // Update the table datasource with filtered data
    if (this.taxDefinitionData.datasource instanceof MatTableDataSource) {
      (this.taxDefinitionData.datasource as MatTableDataSource<TaxDefinition>).data = this.filteredTaxDefinitions;
    }
  }

  public selectTaxDefinitionRows(): void {
    const selection = this.taxDefinitionTable?.selection;

    if (!selection || this.filteredTaxDefinitions.length === 0) {
      return;
    }

    selection.clear();

    this.filteredTaxDefinitions.forEach(dataRow => {
      const match = this.selectedTaxDefinitions.find(
        sel => sel.id === dataRow.id
      );
      if (match) {
        selection.select(dataRow);
      }
    });
  }

  public resetSelection() {
    if (this.taxDefinitionTable?.selection) {
      this.taxDefinitionTable.selection.clear();
    }
    this.selectedTaxDefinitions = [];
    this.setDirty(false);
  }

  public rowSelection(selectedDefinitions: TaxDefinition[]) {
    console.log('Tax definition rowSelection called with:', selectedDefinitions);
    this.selectedTaxDefinitions = selectedDefinitions.length !== 0 ? selectedDefinitions : [];
    this.rowSelected.emit(this.selectedTaxDefinitions);
    this.setDirty(true);
  }

  private setDirty(dirty: boolean) {
    this.isDirty = dirty;
    this.dirtyChange.emit(this.isDirty);
  }
}






















