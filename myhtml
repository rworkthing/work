<bod-table
                #localetable
                [data]="tableWithSimpleEdit"
                [modeOptions]="modeOptions"
                [tableActions]="balanceHoldsTableActions1"
                (onTableActionClick)="onLocaleTableActionClicked($event)"
                [primaryColumnName]="'id'"
                [truncateAfterLine]="1"
                (onInlineFormAddSubmit)="inlineFormAddSubmit($event, 0)"
                (onInlineFormEditSubmit)="inlineFormEditSubmit($event, 0)"
                (onInlineEditRowActionClick)="inlineEditRowActionClick($event)"
                (onInlineAddRowActionClick)="inlineAddRowActionClick(0)"
                [customColumnTemplates]="[
                  {
                    columnName: 'locale',
                    templateName: localeTemplate
                  },
                  {
                    columnName: 'displayName',
                    templateName: displayNameTemplate
                  },
                  {
                    columnName: 'description',
                    templateName: descriptionTemplate
                  },
                  {
                    columnName: 'actionBtns',
                    templateName: actionBtnsTemplate
                  }
                ]"
              >
                <bod-form
                  [formGroup]="inputLocaleLayoutForm"
                  [type]="formType"
                  (onSubmit)="onLocaleAdd(inputLocaleLayoutForm.value)"
                  (onReset)="onReset()"
                  fisStyle
                >
                  <ng-template
                    #localeTemplate
                    let-element="element"
                    let-column="column"
                    let-index="index"
                  >
                    <bod-input-layout col="1">
                      <mat-form-field appearance="outline" fisStyle>
                        <mat-select
                          panelClass="fis-style"
                          formControlName="localeCode"
                          name="localeCode"
                        >
                          <mat-option
                            *ngFor="let localeCode of localeCodes"
                            value="{{ localeCode.value }}"
                          >
                            {{ localeCode.label }}
                          </mat-option>
                        </mat-select>
                      </mat-form-field>
                    </bod-input-layout>
                  </ng-template>

                  <ng-template
                    #displayNameTemplate
                    let-element="element"
                    let-column="column"
                    let-index="index"
                  >
                    <ng-container>
                      <mat-form-field appearance="outline" fisStyle>
                        <input
                          type="text"
                          matInput
                          fisStyle
                          formControlName="displayName"
                          name="displayName"
                        />
                      </mat-form-field>
                    </ng-container>
                  </ng-template>

                  <ng-template
                    #descriptionTemplate
                    let-element="element"
                    let-column="column"
                    let-index="index"
                  >
                    <ng-container>
                      <mat-form-field appearance="outline" fisStyle>
                        <input
                          type="text"
                          matInput
                          fisStyle
                          formControlName="description"
                          name="description"
                        />
                      </mat-form-field>
                    </ng-container>
                  </ng-template>

                  <ng-template
                    #actionBtnsTemplate
                    let-element="element"
                    let-column="column"
                    let-index="index"
                  >
                    <bod-table-actions
                      [actions]="rowLevelActionsForlocaleEdit"
                      (onActionClick)="
                        handleRowLevelActionsforlocale($event.icon, index)
                      "
                    >
                    </bod-table-actions>
                  </ng-template>
                </bod-form>
              </bod-table>
