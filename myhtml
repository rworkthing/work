                addNewConditionFormGroup.get('amountHigh').hasError('zeroValue')
              "
            >
            </mat-error>
            <mat-error
              *ngIf="
                addNewConditionFormGroup
                  .get('amountHigh')
                  .hasError('negativeValue')
              "
            >
            </mat-error>
          </mat-form-field>
        </bod-control-group>
        <bod-control-group
          [truncate]="false"
          [label]="translationKey + 'metadataconfig.defaultamount'"
          [forTextOnly]="true"
          [required]="true"
        >
          <mat-form-field appearance="outline" fisStyle>
            <input
              type="number"
              matInput
              fisStyle
              formControlName="amountDefaultValue"
              name="amountDefaultValue"
            />

            <mat-error>
              {{
                getError('amountDefaultValue', addNewConditionFormGroup)
                  | translate
              }}
            </mat-error>
            
          </mat-form-field>
        </bod-control-group>
      </bod-input-layout>
